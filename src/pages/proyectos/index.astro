---
/**
 * Projects Listing Page — Premium redesign
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import "../../styles/proyectos.css";
import { getProjects } from '../../lib/data';

const projects = await getProjects();
---

<BaseLayout
  title="Proyectos"
  description="Descubre nuestros proyectos de video marketing. Producción audiovisual para empresas en Sevilla, Cádiz y toda España."
>

    <!-- ═══ HERO ═══ -->
    <section class="pj-hero">
        <div class="pj-hero__dots"></div>
        <div class="pj-hero__glow"></div>
        <div class="section-container pj-hero__inner">
            <div class="pj-hero__badge">
                <span class="pj-hero__dot"></span>
                <span>Portfolio</span>
            </div>
            <h1 class="pj-hero__title">
                Nuestros <span class="text-gradient-carmin">proyectos</span>
            </h1>
            <p class="pj-hero__subtitle">
                Cada proyecto es una historia única. Descubre cómo hemos ayudado<br class="hidden md:block" />
                a empresas a comunicar su mensaje a través del vídeo.
            </p>
            <!-- Counter -->
            <div class="pj-hero__count">
                <span class="pj-hero__count-number">{projects.length}</span>
                <span class="pj-hero__count-label">proyectos realizados</span>
            </div>
        </div>
    </section>

    <!-- ═══ GRID ═══ -->
    <section class="pj-grid-section">
        <div class="pj-grid-section__dots"></div>
        <div class="section-container pj-grid-section__inner">

            {projects.length === 0 ? (
                <div class="pj-empty">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                    </svg>
                    <p>Próximamente nuevos proyectos</p>
                </div>
            ) : (
                <div class="pj-grid">
                    {projects.map((project: any, idx: number) => (
                        <a
                            href={`/proyectos/${project.slug}`}
                            class="pj-card reveal"
                            style={`animation-delay:${idx * 0.08}s`}
                        >
                            <!-- Thumbnail / video bg -->
                            <div class="pj-card__media">
                                {project.thumbnail ? (
                                    <img
                                        src={project.thumbnail}
                                        alt={project.title}
                                        class="pj-card__img"
                                        loading="lazy"
                                    />
                                ) : (
                                    <div class="pj-card__no-thumb">
                                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                                        </svg>
                                    </div>
                                )}
                                <!-- Overlay -->
                                <div class="pj-card__overlay"></div>
                                <!-- Play button -->
                                <div class="pj-card__play">
                                    <svg fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                                </div>
                            </div>

                            <!-- Info -->
                            <div class="pj-card__info">
                                <div class="pj-card__client">
                                    <span class="pj-card__client-avatar">
                                        {project.client_name?.charAt(0) ?? '?'}
                                    </span>
                                    <span class="pj-card__client-name">{project.client_name}</span>
                                </div>
                                <h3 class="pj-card__title">{project.title}</h3>
                                {project.subtitle && (
                                    <p class="pj-card__subtitle">{project.subtitle}</p>
                                )}
                                <div class="pj-card__cta">
                                    Ver proyecto
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                                    </svg>
                                </div>
                            </div>

                        </a>
                    ))}
                </div>
            )}

        </div>
    </section>

    <!-- ═══ CTA BOTTOM ═══ -->
    <section class="pj-cta">
        <div class="pj-cta__glow"></div>
        <div class="section-container pj-cta__inner">
            <h2 class="pj-cta__title">¿Quieres un proyecto como estos?</h2>
            <p class="pj-cta__text">Cuéntanos tu idea y creamos algo único para tu marca.</p>
            <a href="/contacto" class="pj-cta__btn">
                Solicitar presupuesto
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
            </a>
        </div>
    </section>

</BaseLayout>

