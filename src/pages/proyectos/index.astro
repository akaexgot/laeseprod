---
import BaseLayout from "../../layouts/BaseLayout.astro";
import VideoBackground from "../../components/ui/VideoBackground.astro";
import FeaturedProjects from "../../components/home/FeaturedProjects.astro";
import { getFeaturedProjects, getProjects } from "../../lib/data";
import { buildItemListSchema } from "../../lib/seo";
const [projects, featuredProjects] = await Promise.all([getProjects(), getFeaturedProjects()]);
const featuredIds = new Set(featuredProjects.map((project: any) => project.id));
const remainingProjects = projects.filter((project: any) => !featuredIds.has(project.id));
const projectScreens = [];
for (let index = 0; index < remainingProjects.length; index += 4) {
    projectScreens.push(remainingProjects.slice(index, index + 4));
}
---

<BaseLayout title="Proyectos" description="Proyectos audiovisuales de LaesePROD" structuredData={buildItemListSchema("Proyectos de LaesePROD", projects, "/proyectos")}>
    <section class="projects-page">
        <FeaturedProjects projects={featuredProjects} showAllLink={false} />

        {projectScreens.map((screen: any[], screenIndex: number) => (
            <section class="projects-screen" aria-label={`Pantalla de proyectos ${screenIndex + 1}`}>
                {screen.map((project: any) => (
                    <a class="project-card" href={`/proyectos/${project.slug}`} aria-label={project.title}>
                        <VideoBackground desktop={project.video_project} mobile={project.video_project} title={project.title} overlay="dark" />
                    </a>
                ))}
            </section>
        ))}

        {projects.length === 0 && (
            <section class="projects-empty">
                <p>Pronto nuevos proyectos.</p>
            </section>
        )}
    </section>
</BaseLayout>

<style>
    .projects-page { color: #fff; background: #000; }
    .projects-screen { min-height: 100svh; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(2, minmax(0, 1fr)); background: #000; }
    .project-card { position: relative; min-height: 50svh; overflow: hidden; color: #fff; text-decoration: none; border: 1px solid rgba(255, 255, 255, .12); background: #050505; }
    .project-card::after { content: ""; position: absolute; inset: 0; z-index: 2; background: rgba(0, 0, 0, .1); transition: opacity 260ms ease; pointer-events: none; }
    .project-card :global(.video-background) { filter: grayscale(1) contrast(1.04); transition: transform 700ms cubic-bezier(.16, 1, .3, 1), filter 700ms cubic-bezier(.16, 1, .3, 1); }
    .project-card:hover::after, .project-card:focus-visible::after { opacity: 0; }
    .project-card:hover :global(.video-background), .project-card:focus-visible :global(.video-background) { transform: scale(1.055); filter: grayscale(0) contrast(1.04); }
    .projects-empty { min-height: 100svh; display: grid; place-items: center; padding: 7rem 1rem; background: #000; }
    .projects-empty p { margin: 0; color: rgba(255, 255, 255, .72); font-size: clamp(1.4rem, 6vw, 4rem); font-weight: 800; text-transform: uppercase; }

    @media (max-width: 760px) {
        .projects-screen { min-height: auto; grid-template-columns: 1fr; grid-template-rows: none; }
        .project-card { min-height: 52svh; }
    }

    @media (prefers-reduced-motion: reduce) {
        .project-card,
        .project-card :global(.video-background) {
            animation: none;
            transition: none;
        }
    }
</style>
