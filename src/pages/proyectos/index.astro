---
/**
 * Projects Listing Page — Fullpage Scroll Mosaic
 * Only shows projects with video_project. Hides incomplete groups.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import "../../styles/proyectos.css";
import ContactFormBlock from '../../components/ui/ContactFormBlock.astro';
import { getProjects } from '../../lib/data';

const allProjects = await getProjects();

// Only show projects that have a video
const projects = allProjects.filter((p: any) => p.video_project);

function getVideoId(value: string | null | undefined): string | null {
  if (!value) return null;
  const match = value.match(/(?:youtube\.com\/(?:watch\?v=|embed\/)|youtu\.be\/)([A-Za-z0-9_-]{11})/);
  if (match) return match[1];
  if (/^[A-Za-z0-9_-]{11}$/.test(value.trim())) return value.trim();
  return null;
}

/**
 * Group projects into "screens" of 3-4 items.
 * Only creates complete groups — leftover projects that don't fill a screen are still shown.
 */
function groupIntoScreens(projects: any[]) {
  const screens: any[][] = [];
  let i = 0;
  let groupSize = 3;

  while (i < projects.length) {
    const remaining = projects.length - i;
    // If remaining items can't fill a full group, just put them all in one
    const size = remaining < groupSize ? remaining : groupSize;
    screens.push(projects.slice(i, i + size));
    i += size;
    groupSize = groupSize === 3 ? 4 : 3;
  }
  return screens;
}

const screens = groupIntoScreens(projects);
---

<BaseLayout
  title="Proyectos"
  description="Descubre nuestros proyectos de video marketing. Producción audiovisual para empresas en Sevilla, Cádiz y toda España."
>

    {projects.length === 0 ? (
        <section class="pj-screen pj-screen--empty">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
            <p>Próximamente nuevos proyectos</p>
        </section>
    ) : (
        screens.map((group, screenIdx) => {
            const isFirst = screenIdx === 0;
            const count = group.length;
            const layoutClass = count >= 3 ? 'pj-screen--split' : 'pj-screen--grid';
            const flipClass = (screenIdx % 2 !== 0 && count > 0 && count < 4) ? 'pj-screen--flip' : '';

            return (
                <section class={`pj-screen ${layoutClass} ${flipClass} ${isFirst ? 'pj-screen--first' : ''}`}>
                    {count >= 3 ? (
                        <Fragment>
                            {/* Large cell */}
                            {(() => {
                                const vid = getVideoId(group[0].video_project);
                                const makingOfId = getVideoId(group[0].video_explanation_mobile) || getVideoId(group[0].video_explanation_desktop) || vid;
                                if (!vid) return null;
                                return (
                                    <a href={`/proyectos/${group[0].slug}`} class="pj-cell pj-cell--large group"
                                       data-pm-title={group[0].title}
                                       data-pm-subtitle={group[0].subtitle || ''}
                                       data-pm-description={group[0].description || ''}
                                       data-pm-video={vid}
                                       data-pm-makingof={makingOfId}
                                       data-pm-slug={group[0].slug}
                                       data-pm-client={group[0].client_name || ''}>
                                        <div class="pj-cell__video">
                                            <iframe
                                                class="pj-cell__iframe"
                                                data-src={`https://www.youtube.com/embed/${vid}?autoplay=1&mute=1&loop=1&playlist=${vid}&controls=0&showinfo=0&rel=0&modestbranding=1&playsinline=1`}
                                                src=""
                                                frameborder="0" allow="autoplay; encrypted-media"
                                                loading="lazy"
                                            ></iframe>
                                            {group[0].thumbnail && <img src={group[0].thumbnail} alt={group[0].title} class="pj-cell__thumb" loading="lazy" />}
                                        </div>
                                        <div class="pj-cell__overlay"></div>
                                        <div class="pj-cell__info">
                                            <span class="pj-cell__client">{group[0].client_name}</span>
                                            <h3 class="pj-cell__title pj-cell__title--lg">{group[0].title}</h3>
                                            {group[0].subtitle && <p class="pj-cell__subtitle">{group[0].subtitle}</p>}
                                            <div class="pj-cell__cta">
                                                <span>Ver proyecto</span>
                                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                                            </div>
                                        </div>
                                    </a>
                                );
                            })()}

                            {/* Stacked cells */}
                            {group.length > 1 && (
                            <div class="pj-stack">
                                {group.slice(1).map((item: any) => {
                                    const vid = getVideoId(item.video_project);
                                    const makingOfId = getVideoId(item.video_explanation_mobile) || getVideoId(item.video_explanation_desktop) || vid;
                                    if (!vid) return null;
                                    return (
                                        <a href={`/proyectos/${item.slug}`} class="pj-cell pj-cell--stacked group"
                                           data-pm-title={item.title}
                                           data-pm-subtitle={item.subtitle || ''}
                                           data-pm-description={item.description || ''}
                                           data-pm-video={vid}
                                           data-pm-makingof={makingOfId}
                                           data-pm-slug={item.slug}
                                           data-pm-client={item.client_name || ''}>
                                            <div class="pj-cell__video">
                                                <iframe
                                                    class="pj-cell__iframe"
                                                    data-src={`https://www.youtube.com/embed/${vid}?autoplay=1&mute=1&loop=1&playlist=${vid}&controls=0&showinfo=0&rel=0&modestbranding=1&playsinline=1`}
                                                    src=""
                                                    frameborder="0" allow="autoplay; encrypted-media"
                                                    loading="lazy"
                                                ></iframe>
                                                {item.thumbnail && <img src={item.thumbnail} alt={item.title} class="pj-cell__thumb" loading="lazy" />}
                                            </div>
                                            <div class="pj-cell__overlay"></div>
                                            <div class="pj-cell__info">
                                                <span class="pj-cell__client">{item.client_name}</span>
                                                <h3 class="pj-cell__title">{item.title}</h3>
                                                <div class="pj-cell__cta">
                                                    <span>Ver proyecto</span>
                                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                                                </div>
                                            </div>
                                        </a>
                                    );
                                })}
                            </div>
                            )}
                        </Fragment>
                    ) : (
                        /* 4 items: 2x2 grid */
                        group.map((item: any) => {
                            const vid = getVideoId(item.video_project);
                            const makingOfId = getVideoId(item.video_explanation_mobile) || getVideoId(item.video_explanation_desktop) || vid;
                            if (!vid) return null;
                            return (
                                <a href={`/proyectos/${item.slug}`} class="pj-cell pj-cell--quarter group"
                                   data-pm-title={item.title}
                                   data-pm-subtitle={item.subtitle || ''}
                                   data-pm-description={item.description || ''}
                                   data-pm-video={vid}
                                   data-pm-makingof={makingOfId}
                                   data-pm-slug={item.slug}
                                   data-pm-client={item.client_name || ''}>
                                    <div class="pj-cell__video">
                                        <iframe
                                            class="pj-cell__iframe"
                                            data-src={`https://www.youtube.com/embed/${vid}?autoplay=1&mute=1&loop=1&playlist=${vid}&controls=0&showinfo=0&rel=0&modestbranding=1&playsinline=1`}
                                            src=""
                                            frameborder="0" allow="autoplay; encrypted-media"
                                            loading="lazy"
                                        ></iframe>
                                        {item.thumbnail && <img src={item.thumbnail} alt={item.title} class="pj-cell__thumb" loading="lazy" />}
                                    </div>
                                    <div class="pj-cell__overlay"></div>
                                    <div class="pj-cell__info">
                                        <span class="pj-cell__client">{item.client_name}</span>
                                        <h3 class="pj-cell__title">{item.title}</h3>
                                        <div class="pj-cell__cta">
                                            <span>Ver proyecto</span>
                                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                                        </div>
                                    </div>
                                </a>
                            );
                        })
                    )}

                    {/* Screen indicator */}
                    <div class="pj-screen__indicator">
                        <span>{String(screenIdx + 1).padStart(2, '0')}</span>
                        <span class="pj-screen__indicator-sep">/</span>
                        <span>{String(screens.length).padStart(2, '0')}</span>
                    </div>
                </section>
            );
        })
    )}

    <!-- CONTACT FORM (Replaces Empty CTA) -->
    <section class="pj-screen" style="height: 100svh; overflow-y: auto; display: flex; align-items: center; justify-content: center; background: #fff;">
        <div style="width: 100%;">
            <ContactFormBlock />
        </div>
    </section>

</BaseLayout>

<script>
    /* ── Lazy-load YouTube iframes ── */
    document.addEventListener('DOMContentLoaded', () => {
        const lazyIframes = document.querySelectorAll('.pj-cell__iframe[data-src]');
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const iframe = entry.target as HTMLIFrameElement;
                    if (!iframe.src || iframe.src === '' || iframe.src === window.location.href) {
                        iframe.src = iframe.dataset.src || '';
                    }
                    const thumb = iframe.closest('.pj-cell__video')?.querySelector('.pj-cell__thumb') as HTMLElement;
                    if (thumb) setTimeout(() => { thumb.style.opacity = '0'; }, 1500);
                    observer.unobserve(iframe);
                }
            });
        }, { threshold: 0.05, rootMargin: '300px 0px 300px 0px' });
        lazyIframes.forEach(el => observer.observe(el));
    });

    /* ── Fullpage Scroll ── */
    document.addEventListener('DOMContentLoaded', () => {
        const sections = Array.from(document.querySelectorAll('.pj-screen, footer'));
        if (sections.length === 0) return;

        let isScrolling = false;
        let scrollTimeout: ReturnType<typeof setTimeout>;
        let accumulatedDelta = 0;
        let deltaTimeout: ReturnType<typeof setTimeout> | null = null;

        function getVisibleSectionIndex() {
            let maxIdx = 0, maxArea = 0;
            sections.forEach((sec, idx) => {
                const r = sec.getBoundingClientRect();
                const visible = Math.max(0, Math.min(r.bottom, window.innerHeight) - Math.max(r.top, 0));
                if (visible > maxArea) { maxArea = visible; maxIdx = idx; }
            });
            return maxIdx;
        }

        function scrollTo(index: number) {
            if (index < 0 || index >= sections.length || isScrolling) return;
            isScrolling = true;
            sections[index].scrollIntoView({ behavior: 'smooth', block: 'start' });
            clearTimeout(scrollTimeout);
            scrollTimeout = setTimeout(() => { isScrolling = false; }, 1300);
        }

        window.addEventListener('wheel', (e) => {
            const target = e.target as HTMLElement;
            if (target.closest('.contact-body') || target.closest('footer')) return;

            e.preventDefault();
            if (isScrolling) return;

            accumulatedDelta += e.deltaY;
            if (deltaTimeout) clearTimeout(deltaTimeout);
            deltaTimeout = setTimeout(() => {
                if (isScrolling) { accumulatedDelta = 0; return; }
                const cur = getVisibleSectionIndex();
                if (accumulatedDelta > 25) scrollTo(cur + 1);
                else if (accumulatedDelta < -25) scrollTo(cur - 1);
                accumulatedDelta = 0;
            }, 120);
        }, { passive: false });

        let touchStartY = 0;
        window.addEventListener('touchstart', (e) => { touchStartY = e.changedTouches[0].screenY; }, { passive: false });
        window.addEventListener('touchmove', (e) => { e.preventDefault(); }, { passive: false });
        window.addEventListener('touchend', (e) => {
            const target = e.target as HTMLElement;
            if (target.closest('.contact-body') || target.closest('footer')) return;

            if (isScrolling) return;
            const delta = touchStartY - e.changedTouches[0].screenY;
            const cur = getVisibleSectionIndex();
            if (delta > 25) scrollTo(cur + 1);
            else if (delta < -25) scrollTo(cur - 1);
        }, { passive: false });

        window.addEventListener('keydown', (e) => {
            const keys = ['ArrowDown', 'ArrowUp', 'PageDown', 'PageUp', ' '];
            if (keys.includes(e.key)) {
                e.preventDefault();
                if (isScrolling) return;
                const cur = getVisibleSectionIndex();
                if (e.key === 'ArrowDown' || e.key === 'PageDown' || e.key === ' ') scrollTo(cur + 1);
                else scrollTo(cur - 1);
            }
        }, { passive: false });
    });
</script>
