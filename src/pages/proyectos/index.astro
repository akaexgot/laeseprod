---
/**
 * Projects Listing Page
 * Visual grid with project cards — Light Mode
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects } from '../../lib/data';

const projects = await getProjects();
---

<BaseLayout
  title="Proyectos"
  description="Descubre nuestros proyectos de video marketing. Producción audiovisual para empresas en Sevilla, Cádiz y toda España."
>
  <!-- Page Header -->
  <section class="pt-44 pb-16 relative overflow-hidden bg-gray-50">
    <!-- Dot pattern -->
    <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 20px 20px;"></div>
    <div class="absolute top-20 right-1/4 w-96 h-96 bg-carmin/5 rounded-full blur-[200px] pointer-events-none"></div>

    <div class="section-container relative z-10">
      <div class="flex flex-col items-center text-center max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-3 px-4 py-2 rounded-full border border-carmin/30 bg-carmin/10 mb-6 animate-fade-in">
          <div class="w-2 h-2 bg-carmin rounded-full animate-pulse shadow-[0_0_10px_rgba(232,54,79,0.8)]"></div>
          <span class="text-label text-carmin font-semibold">Portfolio</span>
        </div>
        <h1 class="text-5xl lg:text-7xl font-[Outfit] font-bold text-dark mb-6 animate-fade-up" style="text-align: center;">
          Nuestros <span class="text-gradient-carmin">proyectos</span>
        </h1>
        <p class="text-dark-subtle text-lg leading-relaxed animate-fade-up max-w-2xl" style="animation-delay: 0.2s; text-align: center;">
          Cada proyecto es una historia única. Descubre cómo hemos ayudado a empresas a comunicar su mensaje a través del vídeo.
        </p>
      </div>
    </div>
  </section>

  <!-- Projects Grid -->
  <section class="pb-24 bg-white relative">
    <!-- Dot pattern -->
    <div class="absolute inset-0 opacity-[0.06] pointer-events-none" style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 20px 20px;"></div>

    <div class="section-container relative z-10 pt-12">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {projects.map((project: any, idx: number) => (
          <a
            href={`/proyectos/${project.slug}`}
            class="group relative overflow-hidden rounded-3xl aspect-[4/3] reveal shadow-lg hover:shadow-2xl transition-shadow duration-500"
            style={`animation-delay: ${idx * 0.1}s`}
            id={`project-${project.slug}`}
          >
            <!-- Background -->
            <div class="absolute inset-0 bg-gray-100">
              {project.thumbnail ? (
                <img
                  src={project.thumbnail}
                  alt={project.title}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full bg-gradient-to-br from-gray-200 to-carmin-100/20 flex items-center justify-center">
                  <svg class="w-12 h-12 text-carmin/20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                </div>
              )}
            </div>

            <!-- Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-dark via-dark/40 to-transparent opacity-70 group-hover:opacity-85 transition-opacity duration-500"></div>

            <!-- Play button on hover -->
            <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-500 z-10">
              <div class="w-14 h-14 bg-carmin/90 rounded-full flex items-center justify-center backdrop-blur-sm scale-75 group-hover:scale-100 transition-transform duration-500 shadow-[0_10px_30px_rgba(155,27,48,0.4)]">
                <svg class="w-6 h-6 text-white ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              </div>
            </div>

            <!-- Content -->
            <div class="absolute bottom-0 left-0 right-0 p-6 z-10">
              <div class="flex items-center gap-2 mb-2">
                <div class="w-6 h-6 bg-carmin/20 rounded-md flex items-center justify-center backdrop-blur-sm">
                  <span class="text-carmin-100 text-xs font-bold">{project.client_name?.charAt(0)}</span>
                </div>
                <span class="text-white/80 text-xs font-medium">{project.client_name}</span>
              </div>
              <h3 class="text-lg font-[Outfit] font-bold text-white group-hover:text-carmin-100 transition-colors duration-300">
                {project.title}
              </h3>
              <p class="text-white/70 text-sm mt-1">{project.subtitle}</p>
            </div>

            <!-- Border -->
            <div class="absolute inset-0 border border-black/5 group-hover:border-carmin/20 rounded-3xl transition-colors duration-500"></div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
