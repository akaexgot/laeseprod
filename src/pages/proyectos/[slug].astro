---
/**
 * Project Detail Page — Cinematic Fullpage Scroll
 * Screen 1: Vertical making-of video + title + description + client info
 * Screen 2: Horizontal project video (fullscreen — plays in-place on click)
 * Screen 3: CTA
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactFormBlock from '../../components/ui/ContactFormBlock.astro';
import { getProjects } from '../../lib/data';

const { slug } = Astro.params;
const projects = await getProjects();
const project = projects.find((p: any) => p.slug === slug);

if (!project) {
    return Astro.redirect('/proyectos');
}

function getVideoId(value: string | null | undefined): string | null {
    if (!value) return null;
    const match = value.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([A-Za-z0-9_-]{11})/);
    if (match) return match[1];
    if (/^[A-Za-z0-9_-]{11}$/.test(value.trim())) return value.trim();
    return null;
}

const mainVideoId = getVideoId(project.video_project);
const expDesktopId = getVideoId(project.video_explanation_desktop);
const expMobileId = getVideoId(project.video_explanation_mobile);
const makingOfId = expMobileId || expDesktopId;
---

<BaseLayout title={project.title} description={project.subtitle || project.description || ''}>
    <article class="pj-detail" data-project-page>

        <!-- ═══ SCREEN 1: Hero — Vertical video + Project Info ═══ -->
        <section class="pj-detail__screen pj-detail__hero" id="pj-hero">
            <div class="pj-hero__layout">

                <!-- Left: Vertical Video (Making Of) -->
                <div class="pj-hero__video-col reveal-left">
                    {makingOfId ? (
                        <div class="pj-hero__video-frame">
                            <iframe
                                src={`https://www.youtube.com/embed/${makingOfId}?rel=0&modestbranding=1`}
                                class="pj-hero__video-iframe"
                                frameborder="0"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                allowfullscreen
                                title="Making Of"
                            ></iframe>
                        </div>
                    ) : mainVideoId ? (
                        <div class="pj-hero__video-frame pj-hero__video-frame--horizontal">
                            <iframe
                                src={`https://www.youtube.com/embed/${mainVideoId}?rel=0&modestbranding=1`}
                                class="pj-hero__video-iframe"
                                frameborder="0"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                allowfullscreen
                                title={project.title}
                            ></iframe>
                        </div>
                    ) : (
                        <div class="pj-hero__video-placeholder">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            <span>Vídeo próximamente</span>
                        </div>
                    )}
                </div>

                <!-- Right: Project info -->
                <div class="pj-hero__info-col reveal-right">
                    {project.client_name && (
                        <div class="pj-hero__badge">
                            <span class="pj-hero__dot"></span>
                            <span>{project.client_name}</span>
                        </div>
                    )}

                    <h1 class="pj-hero__title">{project.title}</h1>

                    {project.subtitle && (
                        <p class="pj-hero__subtitle">{project.subtitle}</p>
                    )}

                    {project.description && (
                        <p class="pj-hero__description">{project.description}</p>
                    )}

                    {project.client_logo && (
                        <div class="pj-hero__client-logo">
                            <img src={project.client_logo} alt={project.client_name || 'Cliente'} />
                        </div>
                    )}
                </div>
            </div>

            <!-- Scroll indicator -->
            <div class="pj-hero__scroll">
                <span>Ver proyecto</span>
                <div class="pj-hero__scroll-arrow">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                </div>
            </div>
        </section>

        <!-- ═══ SCREEN 2: Project Video — Fullscreen (plays in-place) ═══ -->
        {mainVideoId && (
        <section class="pj-detail__screen pj-detail__video-screen" id="pj-video">
            <!-- Background video (muted, autoplay, no controls) -->
            <div class="pj-video__bg" id="pjVideoBg">
                <iframe
                    src={`https://www.youtube.com/embed/${mainVideoId}?autoplay=1&mute=1&loop=1&playlist=${mainVideoId}&controls=0&showinfo=0&rel=0&modestbranding=1&playsinline=1`}
                    class="pj-video__bg-iframe"
                    frameborder="0"
                    allow="autoplay; encrypted-media"
                ></iframe>
            </div>
            <!-- Overlay (hides when playing) -->
            <div class="pj-video__overlay" id="pjVideoOverlay"></div>
            <!-- Play button + info (hides when playing) -->
            <div class="pj-video__content" id="pjVideoContent">
                <span class="pj-video__label">Reproducir proyecto</span>
                <h2 class="pj-video__title">{project.title}</h2>
                <button class="pj-video__play-btn" id="pjPlayBtn" aria-label="Reproducir vídeo">
                    <svg fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                </button>
            </div>
            <!-- Full interactive iframe (hidden until play, replaces bg) -->
            <iframe
                id="pjFullPlayer"
                class="pj-video__full-player"
                data-src={`https://www.youtube.com/embed/${mainVideoId}?rel=0&modestbranding=1&autoplay=1`}
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                title={project.title}
            ></iframe>
        </section>
        )}

        <!-- ═══ SCREEN 3: CONTACT FORM ═══ -->
        <section class="pj-detail__screen pj-detail__cta-screen" id="pj-cta">
            <ContactFormBlock />
        </section>
    </article>
</BaseLayout>

<style>
    .pj-detail {
        background: var(--color-dark);
        color: var(--color-light);
    }

    .pj-detail__screen {
        position: relative;
        width: 100%;
        height: 100vh;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* ═══ SCREEN 1: HERO ═══ */
    .pj-detail__hero {
        background: var(--color-dark-surface);
    }

    .pj-hero__layout {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 clamp(1.5rem, 4vw, 4rem);
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        align-items: center;
    }
    @media (min-width: 1024px) {
        .pj-hero__layout {
            grid-template-columns: auto 1fr;
            gap: 5rem;
        }
    }

    .pj-hero__video-col { display: flex; justify-content: center; }

    .pj-hero__video-frame {
        width: 340px;
        aspect-ratio: 9 / 16;
        border-radius: 1.5rem;
        overflow: hidden;
        background: var(--color-dark-card);
        border: 1px solid rgba(255, 255, 255, 0.06);
        box-shadow: 0 25px 80px rgba(0,0,0,0.6), 0 0 60px rgba(155,27,48,0.1);
        position: relative;
    }
    .pj-hero__video-frame--horizontal {
        width: 100%;
        max-width: 540px;
        aspect-ratio: 16 / 9;
    }
    @media (min-width: 768px) { .pj-hero__video-frame { width: 380px; } }
    @media (min-width: 1024px) { .pj-hero__video-frame { width: 420px; } }
    @media (max-width: 1023px) {
        .pj-hero__video-frame { width: 240px; }
        .pj-hero__video-frame--horizontal { width: 100%; max-width: 440px; }
    }

    .pj-hero__video-iframe {
        position: absolute; inset: 0; width: 100%; height: 100%; border: 0;
    }

    .pj-hero__video-placeholder {
        width: 380px; aspect-ratio: 9 / 16; border-radius: 1.5rem;
        background: var(--color-dark-card); border: 1px solid rgba(255,255,255,0.06);
        display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem;
        color: rgba(255,255,255,0.2);
    }
    .pj-hero__video-placeholder svg { width: 3rem; height: 3rem; }
    .pj-hero__video-placeholder span { font-size: 0.8125rem; font-weight: 500; }

    .pj-hero__info-col { display: flex; flex-direction: column; gap: 1.25rem; }
    @media (max-width: 1023px) { .pj-hero__info-col { text-align: center; align-items: center; } }

    .pj-hero__badge {
        display: inline-flex; align-items: center; gap: 0.5rem;
        padding: 0.375rem 1.125rem; border-radius: 9999px;
        border: 1px solid rgba(155,27,48,0.5); background: rgba(155,27,48,0.12);
        backdrop-filter: blur(8px);
        font-size: 0.7rem; font-weight: 600; letter-spacing: 0.15em;
        text-transform: uppercase; color: rgba(255,255,255,0.8); width: fit-content;
    }
    .pj-hero__dot {
        display: block; width: 6px; height: 6px; border-radius: 50%;
        background: var(--color-carmin-light); box-shadow: 0 0 8px rgba(232,54,79,0.8);
        animation: pj-pulse 2s infinite;
    }
    @keyframes pj-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

    .pj-hero__title {
        font-family: 'Outfit', sans-serif; font-size: clamp(2rem, 5vw, 4rem);
        font-weight: 800; color: #fff; line-height: 1.05; letter-spacing: -0.03em; margin: 0;
    }
    .pj-hero__subtitle {
        font-size: clamp(1rem, 1.5vw, 1.25rem); color: rgba(255,255,255,0.5);
        font-style: italic; font-weight: 300; margin: 0; line-height: 1.5;
    }
    .pj-hero__description {
        font-size: clamp(0.875rem, 1.2vw, 1rem); color: rgba(255,255,255,0.4);
        line-height: 1.75; margin: 0.5rem 0 0; max-width: 520px; white-space: pre-line;
    }
    @media (max-width: 1023px) { .pj-hero__description { max-width: 480px; } }

    .pj-hero__client-logo { margin-top: 0.5rem; }
    .pj-hero__client-logo img {
        height: 2rem; object-fit: contain; opacity: 0.5;
        filter: grayscale(1) brightness(2); transition: opacity 0.3s, filter 0.3s;
    }
    .pj-hero__client-logo img:hover { opacity: 0.9; filter: none; }

    .pj-hero__scroll {
        position: absolute; bottom: 2rem; left: 50%; transform: translateX(-50%);
        z-index: 10; display: flex; flex-direction: column; align-items: center; gap: 0.4rem;
        color: rgba(255,255,255,0.35); animation: pj-float 3s ease-in-out infinite;
    }
    .pj-hero__scroll span {
        font-size: 0.65rem; font-weight: 600; letter-spacing: 0.18em;
        text-transform: uppercase; font-family: 'Space Grotesk', monospace;
    }
    .pj-hero__scroll-arrow svg { width: 1.25rem; height: 1.25rem; }
    @keyframes pj-float {
        0%, 100% { transform: translateX(-50%) translateY(0); }
        50% { transform: translateX(-50%) translateY(6px); }
    }

    /* ═══ SCREEN 2: PROJECT VIDEO — FULLSCREEN IN-PLACE ═══ */
    .pj-detail__video-screen { background: #000; }

    .pj-video__bg {
        position: absolute; inset: 0; z-index: 1; background: #0a0a0f;
    }
    .pj-video__bg-iframe {
        position: absolute; top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        width: 177.78vh; height: 56.25vw; min-width: 100%; min-height: 100%;
        pointer-events: none;
    }
    .pj-video__overlay {
        position: absolute; inset: 0; z-index: 2;
        background:
            linear-gradient(to bottom, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0.05) 30%, rgba(0,0,0,0.4) 100%),
            radial-gradient(ellipse 80% 60% at 50% 50%, transparent 0%, rgba(0,0,0,0.25) 100%);
        transition: opacity 0.5s ease;
    }
    .pj-video__content {
        position: relative; z-index: 10;
        display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1.25rem;
        transition: opacity 0.5s ease;
    }
    .pj-video__label {
        font-family: 'Space Grotesk', monospace; font-size: 0.7rem; font-weight: 500;
        letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.4);
    }
    .pj-video__title {
        font-family: 'Outfit', sans-serif; font-size: clamp(2rem, 5vw, 4rem);
        font-weight: 800; color: #fff; margin: 0; line-height: 1.1;
        text-shadow: 0 8px 30px rgba(0,0,0,0.5);
    }
    .pj-video__play-btn {
        width: 80px; height: 80px; border-radius: 50%;
        background: rgba(155,27,48,0.9); border: 2px solid rgba(255,255,255,0.2);
        color: #fff; cursor: pointer; display: flex; align-items: center; justify-content: center;
        transition: transform 0.3s, box-shadow 0.3s, background 0.3s; margin-top: 0.5rem;
    }
    .pj-video__play-btn svg { width: 2rem; height: 2rem; margin-left: 4px; }
    .pj-video__play-btn:hover {
        transform: scale(1.1);
        box-shadow: 0 0 60px rgba(155,27,48,0.5);
        background: rgba(232,54,79,1);
    }

    /* Full player — fills section, hidden by default */
    .pj-video__full-player {
        position: absolute; inset: 0; z-index: 30;
        width: 100%; height: 100%; border: 0;
        opacity: 0; pointer-events: none;
        transition: opacity 0.5s ease;
    }
    .pj-video__full-player.is-playing {
        opacity: 1; pointer-events: all;
    }

    /* When playing, hide overlay and content */
    .pj-detail__video-screen.is-playing .pj-video__overlay,
    .pj-detail__video-screen.is-playing .pj-video__content {
        opacity: 0; pointer-events: none;
    }

    /* ═══ SCREEN 3: CTA / CONTACT ═══ */
    .pj-detail__cta-screen { 
        background: var(--color-dark-surface); 
        padding-top: 5vh;
    }

    /* Dark Theme Overrides for ContactFormBlock inside projects */
    .pj-detail__cta-screen :global(.contact-body) {
        background: transparent !important;
        min-height: auto !important;
        padding: 0 !important;
    }

    .pj-detail__cta-screen :global(.contact-form),
    .pj-detail__cta-screen :global(.contact-card) {
        background: var(--color-dark-card) !important;
        border: 1px solid rgba(255, 255, 255, 0.05) !important;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4) !important;
    }

    .pj-detail__cta-screen :global(.contact-form__label),
    .pj-detail__cta-screen :global(.contact-card__title),
    .pj-detail__cta-screen :global(.contact-info-list__item),
    .pj-detail__cta-screen :global(.contact-form__input) {
        color: #fff !important;
    }

    .pj-detail__cta-screen :global(.contact-form__input) {
        background: rgba(255, 255, 255, 0.03) !important;
        border-color: rgba(255, 255, 255, 0.08) !important;
    }

    .pj-detail__cta-screen :global(.contact-form__input:focus) {
        border-color: var(--color-carmin) !important;
        background: rgba(255, 255, 255, 0.05) !important;
    }

    .pj-detail__cta-screen :global(.contact-form__label),
    .pj-detail__cta-screen :global(.contact-card__title--info) {
        color: rgba(255, 255, 255, 0.9) !important;
    }

    .pj-detail__cta-screen :global(.contact-card__text),
    .pj-detail__cta-screen :global(.contact-trust__item),
    .pj-detail__cta-screen :global(.contact-info-list__item span) {
        color: rgba(255, 255, 255, 0.5) !important;
    }

    .pj-detail__cta-screen :global(.contact-form__input::placeholder) {
        color: rgba(255, 255, 255, 0.2) !important;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        /* ── Fullpage Scroll ── */
        const sections = Array.from(document.querySelectorAll('.pj-detail__screen'));
        if (sections.length === 0) return;

        // Solo activar scroll snap en escritorio (>1024px)
        if (window.innerWidth <= 1024) return;

        let isScrolling = false;
        let scrollTimeout: ReturnType<typeof setTimeout>;

        function getVisibleSectionIndex() {
            let maxIdx = 0, maxArea = 0;
            sections.forEach((sec, idx) => {
                const r = sec.getBoundingClientRect();
                const v = Math.max(0, Math.min(r.bottom, window.innerHeight) - Math.max(r.top, 0));
                if (v > maxArea) { maxArea = v; maxIdx = idx; }
            });
            return maxIdx;
        }
        function scrollToSection(index: number) {
            if (index < 0 || index >= sections.length || isScrolling) return;
            isScrolling = true;
            sections[index].scrollIntoView({ behavior: 'smooth', block: 'start' });
            clearTimeout(scrollTimeout);
            scrollTimeout = setTimeout(() => {
                isScrolling = false;
            }, 1300);
        }

        window.addEventListener('wheel', (e) => {
            e.preventDefault();
            if (isScrolling) return;
            const cur = getVisibleSectionIndex();
            scrollToSection(e.deltaY > 0 ? cur + 1 : cur - 1);
        }, { passive: false });

        let touchStartY = 0;
        window.addEventListener('touchstart', (e) => { touchStartY = e.changedTouches[0].screenY; }, { passive: false });
        window.addEventListener('touchmove', (e) => { e.preventDefault(); }, { passive: false });
        window.addEventListener('touchend', (e) => {
            if (isScrolling) return;
            const delta = touchStartY - e.changedTouches[0].screenY;
            const cur = getVisibleSectionIndex();
            if (delta > 50) scrollToSection(cur + 1);
            else if (delta < -50) scrollToSection(cur - 1);
        }, { passive: false });

        window.addEventListener('keydown', (e) => {
            const keys = ['ArrowDown', 'ArrowUp', 'PageDown', 'PageUp', 'Home', 'End', ' '];
            if (keys.includes(e.key)) {
                e.preventDefault();
                if (isScrolling) return;
                const cur = getVisibleSectionIndex();
                if (['ArrowDown', 'PageDown', ' '].includes(e.key)) scrollToSection(cur + 1);
                else if (['ArrowUp', 'PageUp'].includes(e.key)) scrollToSection(cur - 1);
                else if (e.key === 'Home') scrollToSection(0);
                else if (e.key === 'End') scrollToSection(sections.length - 1);
            }
        }, { passive: false });

        /* ── In-place Play Button ── */
        const playBtn = document.getElementById('pjPlayBtn');
        const fullPlayer = document.getElementById('pjFullPlayer') as HTMLIFrameElement;
        const videoScreen = document.getElementById('pj-video');

        if (playBtn && fullPlayer && videoScreen) {
            playBtn.addEventListener('click', () => {
                if (fullPlayer.dataset.src) {
                    fullPlayer.src = fullPlayer.dataset.src;
                }
                fullPlayer.classList.add('is-playing');
                videoScreen.classList.add('is-playing');
            });
        }

        /* ── Force navbar transparent on project pages ── */
        const navbar = document.getElementById('navbar');
        const navBg = document.getElementById('nav-bg');
        if (navbar && navBg && document.querySelector('[data-project-page]')) {
            // Override navbar to stay transparent always
            const forceTransparent = () => {
                navBg.style.background = 'linear-gradient(to bottom, rgba(5,5,8,0.55) 0%, rgba(5,5,8,0.12) 65%, transparent 100%)';
                navBg.style.backdropFilter = 'none';
                (navBg.style as any).webkitBackdropFilter = 'none';
                navBg.style.boxShadow = 'none';
            };
            forceTransparent();
            window.addEventListener('scroll', forceTransparent, { passive: true });
        }
    });
</script>
