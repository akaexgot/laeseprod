---
/**
 * Project Detail Page — Cinematic layout
 * Shows main video, description, making-of video
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects } from '../../lib/data';

const { slug } = Astro.params;
const projects = await getProjects();
const project = projects.find((p: any) => p.slug === slug);

if (!project) {
    return Astro.redirect('/proyectos');
}

function getVideoId(value: string | null | undefined): string | null {
    if (!value) return null;
    const match = value.match(/(?:youtube\.com\/(?:watch\?v=|embed\/)|youtu\.be\/)([A-Za-z0-9_-]{11})/);
    if (match) return match[1];
    if (/^[A-Za-z0-9_-]{11}$/.test(value.trim())) return value.trim();
    return null;
}

const mainVideoId = getVideoId(project.video_project);
const expDesktopId = getVideoId(project.video_explanation_desktop);
const expMobileId = getVideoId(project.video_explanation_mobile);
---

<BaseLayout title={project.title} description={project.subtitle || project.description || ''}>
    <article class="bg-dark text-white min-h-screen">

        <!-- Hero: Main Video -->
        {mainVideoId && (
        <section class="relative w-full h-screen min-h-[500px] max-h-[90vh] overflow-hidden">
            <div class="absolute inset-0 bg-dark">
                <iframe
                    src={`https://www.youtube.com/embed/${mainVideoId}?autoplay=1&mute=1&loop=1&playlist=${mainVideoId}&controls=0&showinfo=0&rel=0&modestbranding=1&playsinline=1`}
                    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none"
                    style="width: 177.78vh; height: 56.25vw; min-width: 100%; min-height: 100%;"
                    frameborder="0"
                    allow="autoplay; encrypted-media"
                ></iframe>
                <div class="absolute inset-0 bg-gradient-to-t from-dark via-dark/20 to-transparent"></div>
            </div>

            <!-- Video overlay info -->
            <div class="absolute bottom-0 left-0 right-0 p-8 md:p-16 z-10">
                <div class="max-w-4xl">
                    {project.client_name && (
                        <div class="flex items-center gap-4 mb-4">
                            {project.client_logo && <img src={project.client_logo} alt={project.client_name} class="h-8 object-contain opacity-80" />}
                            <span class="text-white/60 text-xs font-mono tracking-[0.2em] uppercase">{project.client_name}</span>
                        </div>
                    )}
                    <h1 class="text-4xl md:text-6xl lg:text-7xl font-[Outfit] font-bold leading-[0.95] mb-3">{project.title}</h1>
                    {project.subtitle && (
                        <p class="text-xl md:text-2xl text-white/60 font-light italic">{project.subtitle}</p>
                    )}
                </div>
            </div>
        </section>
        )}

        <!-- Info + Description -->
        <section class="max-w-5xl mx-auto px-6 md:px-12 py-20 md:py-32">
            {!mainVideoId && (
                <div class="mb-12">
                    {project.client_name && (
                        <div class="flex items-center gap-4 mb-6">
                            {project.client_logo && <img src={project.client_logo} alt={project.client_name} class="h-8 object-contain opacity-80" />}
                            <span class="text-white/60 text-xs font-mono tracking-[0.2em] uppercase">{project.client_name}</span>
                        </div>
                    )}
                    <h1 class="text-4xl md:text-6xl font-[Outfit] font-bold leading-tight mb-4">{project.title}</h1>
                    {project.subtitle && <p class="text-xl text-white/60 font-light italic">{project.subtitle}</p>}
                </div>
            )}

            {project.description && (
                <div class="prose prose-invert prose-lg max-w-none">
                    <p class="text-light-muted text-lg md:text-xl leading-relaxed whitespace-pre-line">{project.description}</p>
                </div>
            )}

            <!-- Playable version -->
            {mainVideoId && (
                <div class="mt-16">
                    <h3 class="text-sm font-mono tracking-[0.2em] uppercase text-white/40 mb-6">Reproducir vídeo</h3>
                    <div class="aspect-video rounded-2xl overflow-hidden bg-dark-card border border-dark-border shadow-2xl">
                        <iframe
                            src={`https://www.youtube.com/embed/${mainVideoId}?rel=0&modestbranding=1`}
                            class="w-full h-full"
                            frameborder="0"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen
                        ></iframe>
                    </div>
                </div>
            )}
        </section>

        <!-- Making Of / Explanation Video -->
        {(expDesktopId || expMobileId) && (
            <section class="max-w-5xl mx-auto px-6 md:px-12 pb-20 md:pb-32">
                <h3 class="text-sm font-mono tracking-[0.2em] uppercase text-white/40 mb-6">Making Of</h3>
                <div class="aspect-video rounded-2xl overflow-hidden bg-dark-card border border-dark-border shadow-2xl">
                    <iframe
                        src={`https://www.youtube.com/embed/${expDesktopId || expMobileId}?rel=0&modestbranding=1`}
                        class="w-full h-full"
                        frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen
                    ></iframe>
                </div>
            </section>
        )}

        <!-- CTA -->
        <section class="border-t border-dark-border">
            <div class="max-w-5xl mx-auto px-6 md:px-12 py-20 md:py-32">
                <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-8">
                    <div>
                        <h2 class="text-3xl md:text-4xl font-[Outfit] font-bold mb-3">¿Te gustaría un proyecto así?</h2>
                        <p class="text-light-muted text-lg">Cuéntanos tu idea y lo hacemos realidad.</p>
                    </div>
                    <div class="flex gap-4">
                        <a href="/contacto" class="inline-flex items-center gap-3 px-8 py-4 bg-gradient-carmin text-white font-semibold rounded-xl hover:shadow-glow-strong transition-all duration-300 text-sm">
                            Solicitar presupuesto
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                        </a>
                        <a href="/proyectos" class="inline-flex items-center gap-2 px-6 py-4 border border-dark-border text-white/80 hover:text-white hover:border-white/30 rounded-xl transition-all duration-300 text-sm">
                            Ver más proyectos
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </article>
</BaseLayout>
