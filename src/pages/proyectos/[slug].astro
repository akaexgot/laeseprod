---
import BaseLayout from "../../layouts/BaseLayout.astro";
import VideoBackground from "../../components/ui/VideoBackground.astro";
import InteractiveProjectVideo from "../../components/ui/InteractiveProjectVideo.astro";
import { getProjectBySlug, getProjects } from "../../lib/data";
import { buildBreadcrumbSchema, buildProjectSchemas } from "../../lib/seo";

const { slug } = Astro.params;
const [project, projects] = await Promise.all([
    getProjectBySlug(slug || ""),
    getProjects(),
]);

if (!project) return Astro.redirect("/proyectos");

const path = `/proyectos/${project.slug}`;
const orderedProjects = projects.filter((item: any) => item.slug);
const currentIndex = orderedProjects.findIndex((item: any) => item.slug === project.slug);
const caseNumber = String(Math.max(currentIndex + 1, 1)).padStart(2, "0");
const previousProject = currentIndex > 0 ? orderedProjects[currentIndex - 1] : orderedProjects.at(-1);
const nextProject = currentIndex >= 0 && currentIndex < orderedProjects.length - 1 ? orderedProjects[currentIndex + 1] : orderedProjects[0];
const relatedProjects = orderedProjects.filter((item: any) => item.slug !== project.slug).slice(0, 3);
const explanationDesktop = project.video_explanation_desktop;
const explanationMobile = project.video_explanation_mobile;
const hasExplanationVideo = Boolean(explanationDesktop || explanationMobile);
const projectType = project.subtitle || "Producción audiovisual";
const projectDescription = project.description || "Proyecto audiovisual desarrollado por LaesePROD con una mirada cercana, ritmo visual y una pieza final pensada para verse con intención.";
---

<BaseLayout
    title={project.title}
    description={project.description || project.subtitle}
    image={project.thumbnail}
    structuredData={[
        buildBreadcrumbSchema([
            { name: "Inicio", path: "/" },
            { name: "Proyectos", path: "/proyectos" },
            { name: project.title, path },
        ]),
        ...buildProjectSchemas(project, path),
    ]}
>
    <main class="project-case">
        <section class="project-case-hero" aria-labelledby="project-title">
            <div class="project-case-hero__top">
                <a href="/proyectos">Archivo de proyectos</a>
                <span>Case {caseNumber}</span>
            </div>

            <div class="project-case-hero__grid">
                <article class="project-case-hero__copy">
                    <p>{project.client_name || "LaesePROD"} / {projectType}</p>
                    <h1 id="project-title">{project.title}</h1>
                    <div class="project-case-hero__summary">
                        <span>Resumen</span>
                        <p>{projectDescription}</p>
                    </div>
                </article>

                <figure class="project-case-hero__media">
                    <div class="project-case-hero__frame">
                        {project.video_project ? (
                            <InteractiveProjectVideo url={project.video_project} title={project.title} poster={project.thumbnail} />
                        ) : project.thumbnail ? (
                            <img src={project.thumbnail} alt={`Imagen de ${project.title}`} />
                        ) : (
                            <div class="project-case-hero__empty">Pieza en preparación</div>
                        )}
                    </div>
                    <figcaption>
                        <span>00:{caseNumber}</span>
                        <strong>{project.video_project ? "Pieza principal" : "Archivo visual"}</strong>
                    </figcaption>
                </figure>

                <aside class="project-case-hero__sheet" aria-label="Datos del proyecto">
                    <dl>
                        <div>
                            <dt>Cliente</dt>
                            <dd>{project.client_name || "Proyecto propio"}</dd>
                        </div>
                        <div>
                            <dt>Formato</dt>
                            <dd>{projectType}</dd>
                        </div>
                        <div>
                            <dt>Estado</dt>
                            <dd>{project.video_project ? "Publicado" : "En preparación"}</dd>
                        </div>
                    </dl>
                    <div class="project-case-hero__actions">
                        {project.video_project && <a href={project.video_project} target="_blank" rel="noreferrer">Ver vídeo</a>}
                        <a href="/contacto">Hablar de un proyecto</a>
                    </div>
                </aside>
            </div>
        </section>

        <section class="project-case-notes" aria-label="Notas del proyecto">
            <div class="project-case-notes__intro">
                <p>Notas de producción</p>
                <h2>Lo que sostiene la pieza.</h2>
            </div>

            <div class="project-case-notes__cards">
                <article>
                    <span>01</span>
                    <h3>Mirada</h3>
                    <p>La intención visual se adapta al cliente, al ritmo de la historia y al lugar donde la pieza va a vivir.</p>
                </article>
                <article>
                    <span>02</span>
                    <h3>Montaje</h3>
                    <p>El corte busca que cada plano tenga peso, sin rellenar por rellenar ni perder la energía del proyecto.</p>
                </article>
                <article>
                    <span>03</span>
                    <h3>Entrega</h3>
                    <p>La pieza queda preparada para web, portfolio, redes o campaña, según el uso real del proyecto.</p>
                </article>
            </div>
        </section>

        {(hasExplanationVideo || project.thumbnail) && (
            <section class="project-case-process" aria-label="Material adicional">
                <div class="project-case-process__label">
                    <span>Material adicional</span>
                    <strong>{hasExplanationVideo ? "Making of" : "Imagen principal"}</strong>
                </div>
                <figure class="project-case-process__media">
                    {hasExplanationVideo ? (
                        <InteractiveProjectVideo
                            desktop={explanationDesktop}
                            mobile={explanationMobile}
                            title={`Making of de ${project.title}`}
                            poster={project.thumbnail}
                        />
                    ) : (
                        <img src={project.thumbnail} alt={`Imagen de ${project.title}`} />
                    )}
                </figure>
            </section>
        )}

        <nav class="project-case-nav" aria-label="Navegación de proyectos">
            {previousProject && (
                <a href={`/proyectos/${previousProject.slug}`}>
                    <span>Anterior</span>
                    <strong>{previousProject.title}</strong>
                </a>
            )}
            <a href="/proyectos">
                <span>Archivo</span>
                <strong>Todos los proyectos</strong>
            </a>
            {nextProject && (
                <a href={`/proyectos/${nextProject.slug}`}>
                    <span>Siguiente</span>
                    <strong>{nextProject.title}</strong>
                </a>
            )}
        </nav>

        {relatedProjects.length > 0 && (
            <section class="project-case-related">
                <div class="project-case-related__heading">
                    <p>Más archivo</p>
                    <h2>Otros trabajos</h2>
                </div>
                <div class="project-case-related__grid">
                    {relatedProjects.map((item: any) => (
                        <a href={`/proyectos/${item.slug}`} class="project-case-related__item">
                            {item.video_project ? (
                                <VideoBackground desktop={item.video_project} mobile={item.video_project} title={item.title} overlay="none" />
                            ) : item.thumbnail ? (
                                <img src={item.thumbnail} alt="" aria-hidden="true" />
                            ) : null}
                            <span>{item.client_name || "LaesePROD"}</span>
                            <strong>{item.title}</strong>
                        </a>
                    ))}
                </div>
            </section>
        )}
    </main>
</BaseLayout>

<style>
    .project-case {
        --paper: #f4f4f0;
        --ink: #080808;
        --line: rgba(8, 8, 8, .18);
        --muted: rgba(8, 8, 8, .58);
        --signal: #e0312f;
        color: var(--ink);
        background:
            linear-gradient(rgba(8, 8, 8, .045) 1px, transparent 1px),
            linear-gradient(90deg, rgba(8, 8, 8, .045) 1px, transparent 1px),
            var(--paper);
        background-size: 48px 48px;
    }

    .project-case-hero {
        position: relative;
        min-height: 100svh;
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
        gap: clamp(1.2rem, 3vh, 2rem);
        padding: clamp(6rem, 10vh, 7.5rem) clamp(1rem, 4vw, 4.5rem) clamp(1rem, 3vh, 2rem);
        overflow: hidden;
    }

    .project-case-hero::before {
        content: "CASE";
        position: absolute;
        right: -2vw;
        bottom: -5vw;
        color: rgba(8, 8, 8, .045);
        font-size: clamp(10rem, 28vw, 32rem);
        font-weight: 950;
        line-height: .72;
        pointer-events: none;
    }

    .project-case-hero__top {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        border-bottom: 1px solid var(--line);
        padding-bottom: .75rem;
        font-size: .72rem;
        font-weight: 850;
        text-transform: uppercase;
    }

    .project-case-hero__top a {
        color: var(--ink);
        text-decoration: none;
    }

    .project-case-hero__top a:hover,
    .project-case-hero__top a:focus-visible {
        color: var(--signal);
    }

    .project-case-hero__top span {
        color: var(--muted);
    }

    .project-case-hero__grid {
        position: relative;
        z-index: 2;
        min-height: 0;
        display: grid;
        grid-template-columns: minmax(0, .66fr) minmax(540px, 1fr);
        grid-template-rows: minmax(0, 1fr) auto;
        gap: clamp(1.4rem, 3vw, 3rem);
        align-items: end;
    }

    .project-case-hero__copy {
        align-self: center;
        min-width: 0;
        display: grid;
        gap: clamp(1rem, 2.5vh, 1.6rem);
    }

    .project-case-hero__copy > p,
    .project-case-notes__intro p,
    .project-case-related__heading p {
        margin: 0;
        color: var(--muted);
        font-size: .72rem;
        font-weight: 850;
        text-transform: uppercase;
    }

    .project-case-hero h1 {
        max-width: 100%;
        margin: 0;
        font-size: clamp(3.25rem, 5.25vw, 6.35rem);
        font-weight: 950;
        line-height: .88;
        letter-spacing: 0;
        text-transform: uppercase;
        overflow-wrap: anywhere;
    }

    .project-case-hero__summary {
        max-width: 540px;
        display: grid;
        grid-template-columns: auto 1fr;
        gap: .85rem;
        align-items: start;
        border-top: 2px solid var(--ink);
        padding-top: 1rem;
    }

    .project-case-hero__summary span {
        color: var(--signal);
        font-size: .68rem;
        font-weight: 900;
        text-transform: uppercase;
    }

    .project-case-hero__summary p {
        margin: 0;
        color: rgba(8, 8, 8, .72);
        font-size: clamp(.98rem, 1.25vw, 1.18rem);
        line-height: 1.42;
    }

    .project-case-hero__media {
        position: relative;
        min-height: 0;
        align-self: stretch;
        min-width: 0;
        display: grid;
        grid-template-rows: minmax(0, 1fr) auto;
        gap: .65rem;
        margin: 0;
    }

    .project-case-hero__frame {
        position: relative;
        min-height: min(64svh, 620px);
        width: min(100%, 1080px);
        justify-self: end;
        overflow: hidden;
        background: #050505;
        border: 2px solid var(--ink);
        box-shadow: 12px 12px 0 var(--signal);
    }

    .project-case-hero__frame::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 2;
        border: 10px solid rgba(244, 244, 240, .9);
        pointer-events: none;
        mix-blend-mode: screen;
    }

    .project-case-hero__frame img,
    .project-case-process__media img,
    .project-case-related__item > img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .project-case-hero__empty {
        min-height: inherit;
        display: grid;
        place-items: center;
        color: #fff;
        font-weight: 900;
        text-transform: uppercase;
    }

    .project-case-hero__media figcaption {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        color: var(--muted);
        font-size: .68rem;
        font-weight: 850;
        text-transform: uppercase;
    }

    .project-case-hero__sheet {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 1px;
        border: 1px solid var(--line);
        background: var(--line);
    }

    .project-case-hero__sheet dl {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1px;
        margin: 0;
    }

    .project-case-hero__sheet div,
    .project-case-nav a {
        background: rgba(244, 244, 240, .86);
        backdrop-filter: blur(12px);
    }

    .project-case-hero__sheet dl div {
        display: grid;
        gap: .25rem;
        padding: .8rem .9rem;
    }

    .project-case-hero__sheet dt,
    .project-case-nav span {
        color: var(--muted);
        font-size: .62rem;
        font-weight: 850;
        text-transform: uppercase;
    }

    .project-case-hero__sheet dd {
        margin: 0;
        font-size: .92rem;
        font-weight: 850;
        line-height: 1.12;
    }

    .project-case-hero__actions {
        display: flex;
        align-items: stretch;
        gap: 1px;
    }

    .project-case-hero__actions a {
        min-width: 152px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: .8rem 1rem;
        color: #fff;
        background: var(--ink);
        text-decoration: none;
        font-size: .72rem;
        font-weight: 900;
        text-transform: uppercase;
        transition: background 160ms ease, color 160ms ease;
    }

    .project-case-hero__actions a:hover,
    .project-case-hero__actions a:focus-visible {
        background: var(--signal);
    }

    .project-case-notes {
        display: grid;
        grid-template-columns: minmax(260px, .45fr) minmax(0, 1fr);
        gap: clamp(1rem, 4vw, 4rem);
        padding: clamp(4rem, 8vh, 6rem) clamp(1rem, 4vw, 4.5rem);
        border-top: 1px solid var(--line);
    }

    .project-case-notes__intro {
        display: grid;
        align-content: start;
        gap: .8rem;
    }

    .project-case-notes__intro h2,
    .project-case-related__heading h2 {
        margin: 0;
        font-size: clamp(2.2rem, 4.6vw, 5.2rem);
        font-weight: 950;
        line-height: .9;
        text-transform: uppercase;
    }

    .project-case-notes__cards {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1px;
        border: 1px solid var(--line);
        background: var(--line);
    }

    .project-case-notes__cards article {
        min-height: 260px;
        display: grid;
        align-content: space-between;
        gap: 1.5rem;
        padding: 1rem;
        background: rgba(255, 255, 255, .64);
    }

    .project-case-notes__cards span {
        color: var(--signal);
        font-size: .72rem;
        font-weight: 900;
    }

    .project-case-notes__cards h3 {
        margin: auto 0 0;
        font-size: clamp(1.55rem, 2.4vw, 2.8rem);
        font-weight: 950;
        line-height: .9;
        text-transform: uppercase;
    }

    .project-case-notes__cards p {
        margin: 0;
        color: rgba(8, 8, 8, .68);
        font-size: .95rem;
        line-height: 1.42;
    }

    .project-case-process {
        display: grid;
        grid-template-columns: minmax(200px, .25fr) minmax(0, 1fr);
        gap: 1px;
        padding: 0 clamp(1rem, 4vw, 4.5rem) clamp(4rem, 8vh, 6rem);
    }

    .project-case-process__label {
        display: grid;
        align-content: start;
        gap: .5rem;
        padding: 1rem;
        color: #fff;
        background: var(--ink);
    }

    .project-case-process__label span {
        color: rgba(255, 255, 255, .56);
        font-size: .66rem;
        font-weight: 850;
        text-transform: uppercase;
    }

    .project-case-process__label strong {
        font-size: clamp(1.6rem, 2.8vw, 3rem);
        line-height: .94;
        text-transform: uppercase;
    }

    .project-case-process__media {
        position: relative;
        min-height: min(78svh, 720px);
        margin: 0;
        overflow: hidden;
        background: #050505;
    }

    .project-case-nav {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1px;
        padding: 0 clamp(1rem, 4vw, 4.5rem) clamp(4rem, 8vh, 6rem);
    }

    .project-case-nav a {
        min-height: 88px;
        display: grid;
        align-content: center;
        gap: .3rem;
        padding: 1rem;
        color: var(--ink);
        border: 1px solid var(--line);
        text-decoration: none;
        transition: color 160ms ease, border-color 160ms ease;
    }

    .project-case-nav a:hover,
    .project-case-nav a:focus-visible {
        color: var(--signal);
        border-color: var(--signal);
    }

    .project-case-nav strong {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: clamp(.95rem, 1.35vw, 1.25rem);
        line-height: 1.05;
    }

    .project-case-related {
        display: grid;
        gap: 1.2rem;
        padding: clamp(4rem, 8vh, 6rem) clamp(1rem, 4vw, 4.5rem);
        color: #fff;
        background: #080808;
    }

    .project-case-related__heading p {
        color: rgba(255, 255, 255, .48);
    }

    .project-case-related__grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1px;
        background: rgba(255, 255, 255, .2);
        border: 1px solid rgba(255, 255, 255, .2);
    }

    .project-case-related__item {
        position: relative;
        min-height: 46svh;
        display: grid;
        align-content: end;
        gap: .28rem;
        padding: 1rem;
        color: #fff;
        text-decoration: none;
        overflow: hidden;
        background: #050505;
    }

    .project-case-related__item::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 1;
        background: linear-gradient(180deg, transparent, rgba(0, 0, 0, .82));
    }

    .project-case-related__item span,
    .project-case-related__item strong {
        position: relative;
        z-index: 2;
    }

    .project-case-related__item span {
        color: rgba(255, 255, 255, .62);
        font-size: .64rem;
        font-weight: 850;
        text-transform: uppercase;
    }

    .project-case-related__item strong {
        font-size: clamp(1.4rem, 3vw, 3rem);
        line-height: .95;
        text-transform: uppercase;
    }

    .project-case-related__item :global(.video-background) {
        filter: grayscale(1) contrast(1.06);
        transition: filter 500ms ease, transform 500ms ease;
    }

    .project-case-related__item:hover :global(.video-background),
    .project-case-related__item:focus-visible :global(.video-background) {
        filter: grayscale(0) contrast(1.06);
        transform: scale(1.04);
    }

    @media (max-width: 1180px) {
        .project-case-hero__grid,
        .project-case-notes,
        .project-case-process {
            grid-template-columns: 1fr;
        }

        .project-case-hero__copy {
            align-self: end;
        }

        .project-case-hero h1 {
            max-width: 100%;
        }

        .project-case-hero__sheet,
        .project-case-hero__sheet dl,
        .project-case-notes__cards,
        .project-case-nav,
        .project-case-related__grid {
            grid-template-columns: 1fr;
        }

        .project-case-hero__actions {
            flex-wrap: wrap;
        }
    }

    @media (max-width: 680px) {
        .project-case-hero {
            min-height: auto;
            padding-top: 6rem;
        }

        .project-case-hero__top,
        .project-case-hero__summary,
        .project-case-hero__sheet {
            grid-template-columns: 1fr;
        }

        .project-case-hero__top {
            align-items: flex-start;
        }

        .project-case-hero__frame {
            min-height: 54svh;
            box-shadow: 7px 7px 0 var(--signal);
        }

        .project-case-hero__actions a {
            width: 100%;
        }

        .project-case-process__media {
            min-height: 62svh;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .project-case-related__item :global(.video-background),
        .project-case-hero__actions a,
        .project-case-nav a {
            transition: none;
        }
    }
</style>
