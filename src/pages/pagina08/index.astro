---
import ConceptLayout from "../../layouts/ConceptLayout.astro";
import Navbar from "../../components/ui/Navbar.astro";
---

<ConceptLayout
    concept={8}
    title="Concepto 08 — Rolling Optics"
    description="Una óptica cinematográfica 3D descubre la identidad de LaesePROD sobre un escenario blanco."
    switcherTone="light"
>
    <Navbar />

    <section class="lens-hero" data-lens-hero aria-labelledby="lens-title">
        <div class="lens-hero__frame" aria-hidden="true">
            <span class="corner corner--tl"></span>
            <span class="corner corner--tr"></span>
            <span class="corner corner--bl"></span>
            <span class="corner corner--br"></span>
        </div>

        <div class="lens-hero__meta lens-hero__meta--left" aria-hidden="true">
            <span class="lens-hero__dot"></span>
            <span>OPTICS IN MOTION</span>
        </div>
        <div class="lens-hero__meta lens-hero__meta--right" aria-hidden="true">
            <span>35 MM</span>
            <span>FRAME 08</span>
        </div>

        <div class="lens-hero__identity">
            <img
                class="lens-hero__ghost"
                src="/logonegativo.png"
                alt=""
                width="1992"
                height="669"
                aria-hidden="true"
            />
            <h1 id="lens-title" class="lens-hero__logo" data-reveal-logo>
                <img
                    src="/logonegativo.png"
                    alt="LaesePROD — Vídeo y visual art"
                    width="1992"
                    height="669"
                />
            </h1>
        </div>

        <div class="lens-hero__shadow" data-lens-shadow aria-hidden="true"></div>
        <canvas class="lens-hero__canvas" data-lens-canvas aria-hidden="true"></canvas>

        <div class="lens-hero__loading" aria-live="polite">
            <span data-lens-status>Preparando óptica</span>
            <i><b data-lens-progress></b></i>
        </div>

        <p class="lens-hero__counter" aria-hidden="true">
            <span>08</span>
            <i></i>
            <span>ROLL / REVEAL</span>
        </p>
    </section>
</ConceptLayout>

<script>
    import "../../scripts/lens-reveal";
</script>

<noscript>
    <style>
        .lens-hero__logo {
            clip-path: none !important;
        }

        .lens-hero__loading {
            display: none !important;
        }
    </style>
</noscript>

<style>
    .lens-hero {
        position: relative;
        min-height: 100svh;
        overflow: hidden;
        color: #080808;
        background:
            radial-gradient(circle at 50% 52%, rgba(0, 0, 0, .028), transparent 30%),
            #fff;
        font-family: Arial, Helvetica, sans-serif;
        isolation: isolate;
    }

    .lens-hero::before {
        content: "";
        position: absolute;
        z-index: -1;
        inset: 0;
        opacity: .28;
        background-image:
            linear-gradient(rgba(0, 0, 0, .022) 1px, transparent 1px),
            linear-gradient(90deg, rgba(0, 0, 0, .022) 1px, transparent 1px);
        background-size: 8vw 8vw;
        mask-image: radial-gradient(circle at center, #000, transparent 68%);
        pointer-events: none;
    }

    .lens-hero__frame {
        position: absolute;
        z-index: 6;
        inset: 102px clamp(22px, 3vw, 46px) clamp(22px, 3vw, 46px);
        pointer-events: none;
    }

    .corner {
        position: absolute;
        width: 34px;
        height: 34px;
        border-color: rgba(0, 0, 0, .3);
        border-style: solid;
    }

    .corner--tl { top: 0; left: 0; border-width: 1px 0 0 1px; }
    .corner--tr { top: 0; right: 0; border-width: 1px 1px 0 0; }
    .corner--bl { bottom: 0; left: 0; border-width: 0 0 1px 1px; }
    .corner--br { right: 0; bottom: 0; border-width: 0 1px 1px 0; }

    .lens-hero__meta {
        position: absolute;
        z-index: 7;
        top: 126px;
        display: flex;
        align-items: center;
        gap: 12px;
        color: rgba(0, 0, 0, .48);
        font-family: "Courier New", monospace;
        font-size: 8px;
        letter-spacing: .15em;
    }

    .lens-hero__meta--left {
        left: clamp(34px, 4vw, 68px);
    }

    .lens-hero__meta--right {
        right: clamp(34px, 4vw, 68px);
    }

    .lens-hero__dot {
        width: 6px;
        height: 6px;
        background: #090909;
        border-radius: 50%;
        animation: optic-pulse 1.5s ease-in-out infinite;
    }

    .lens-hero__identity {
        position: absolute;
        z-index: 2;
        top: 50%;
        left: 50%;
        width: min(70vw, 1040px);
        transform: translate(-50%, -50%);
    }

    .lens-hero__ghost,
    .lens-hero__logo img {
        width: 100%;
        height: auto;
        object-fit: contain;
    }

    .lens-hero__ghost {
        position: absolute;
        inset: 0;
        opacity: .035;
        filter: grayscale(1);
    }

    .lens-hero__logo {
        --logo-reveal: 0%;
        position: relative;
        z-index: 1;
        margin: 0;
        clip-path: inset(0 calc(100% - var(--logo-reveal)) 0 0);
        filter: drop-shadow(0 18px 30px rgba(0, 0, 0, .06));
        will-change: clip-path;
    }

    .lens-hero__logo::after {
        content: "";
        position: absolute;
        top: -10%;
        bottom: -10%;
        left: var(--logo-reveal);
        width: 1px;
        background: linear-gradient(transparent, rgba(0, 0, 0, .32), transparent);
        opacity: .5;
        transform: translateX(-1px);
        transition: opacity 400ms ease;
    }

    .lens-hero.is-revealed .lens-hero__logo::after {
        opacity: 0;
    }

    .lens-hero__canvas {
        position: absolute;
        z-index: 4;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        pointer-events: none;
        transition: opacity 650ms ease, filter 650ms ease;
    }

    .lens-hero.is-model-ready .lens-hero__canvas {
        opacity: 1;
    }

    .lens-hero__shadow {
        position: absolute;
        z-index: 3;
        top: 0;
        left: 0;
        background: radial-gradient(ellipse, rgba(0, 0, 0, .19), rgba(0, 0, 0, .06) 45%, transparent 72%);
        border-radius: 50%;
        filter: blur(7px);
        opacity: 0;
        pointer-events: none;
        will-change: transform;
        transition: opacity 500ms ease;
    }

    .lens-hero.is-model-ready .lens-hero__shadow {
        opacity: 1;
    }

    .lens-hero.is-lens-finished .lens-hero__canvas {
        opacity: 0;
        filter: blur(5px);
    }

    .lens-hero.is-lens-finished .lens-hero__shadow {
        opacity: 0;
    }

    .lens-hero__loading {
        position: absolute;
        z-index: 8;
        right: clamp(34px, 4vw, 68px);
        bottom: clamp(38px, 5vh, 66px);
        width: min(240px, 38vw);
        display: grid;
        gap: 9px;
        color: rgba(0, 0, 0, .48);
        font-family: "Courier New", monospace;
        font-size: 8px;
        letter-spacing: .13em;
        text-transform: uppercase;
        transition: opacity 500ms ease, transform 500ms ease;
    }

    .lens-hero.is-model-ready .lens-hero__loading,
    .lens-hero.is-status-hidden .lens-hero__loading {
        opacity: 0;
        transform: translateY(8px);
        pointer-events: none;
    }

    .lens-hero__loading i {
        position: relative;
        width: 100%;
        height: 1px;
        overflow: hidden;
        background: rgba(0, 0, 0, .12);
    }

    .lens-hero__loading b {
        position: absolute;
        inset: 0;
        background: #090909;
        transform: scaleX(.08);
        transform-origin: left;
        transition: transform 180ms ease;
    }

    .lens-hero__counter {
        position: absolute;
        z-index: 7;
        bottom: clamp(38px, 5vh, 66px);
        left: clamp(34px, 4vw, 68px);
        display: flex;
        align-items: center;
        gap: 13px;
        margin: 0;
        color: rgba(0, 0, 0, .4);
        font-family: "Courier New", monospace;
        font-size: 8px;
        letter-spacing: .14em;
    }

    .lens-hero__counter i {
        width: 38px;
        height: 1px;
        background: rgba(0, 0, 0, .24);
    }

    .lens-hero.is-fallback .lens-hero__canvas,
    .lens-hero.is-fallback .lens-hero__shadow {
        display: none;
    }

    @keyframes optic-pulse {
        50% {
            opacity: .28;
            transform: scale(.72);
        }
    }

    @media (max-width: 680px) {
        .lens-hero__frame {
            inset: 82px 12px 64px;
        }

        .lens-hero__meta {
            top: 98px;
        }

        .lens-hero__meta--left {
            left: 26px;
        }

        .lens-hero__meta--right {
            display: none;
        }

        .lens-hero__identity {
            width: min(90vw, 560px);
        }

        .lens-hero__loading {
            right: 26px;
            bottom: 82px;
            width: 190px;
        }

        .lens-hero__counter {
            bottom: 82px;
            left: 26px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .lens-hero__dot {
            animation: none;
        }

        .lens-hero__logo {
            clip-path: none;
        }

        .lens-hero__logo::after {
            display: none;
        }
    }
</style>

<style is:global>
    .concept-page--08 {
        background: #fff;
    }

    .concept-page--08 .site-nav__brand {
        display: none !important;
    }

    @media (min-width: 1081px) {
        .concept-page--08 .site-nav {
            width: 620px;
            display: flex;
            justify-content: center;
            gap: 14px;
            padding: 0 10px 0 18px;
        }

        .concept-page--08 .site-nav__desktop {
            position: static;
            top: auto;
            bottom: auto;
            left: auto;
            flex: 0 0 auto;
            transform: none;
        }

        .concept-page--08 .site-nav__actions {
            flex: 0 0 auto;
            justify-self: auto;
        }
    }

    @media (max-width: 1080px) {
        .concept-page--08 .site-header {
            justify-content: flex-end;
        }

        .concept-page--08 .site-nav {
            width: 126px;
            grid-template-columns: 1fr;
            padding: 0 10px;
        }

        .concept-page--08 .site-nav__actions {
            grid-column: 1;
            justify-self: end;
        }
    }
</style>
