---
/**
 * Contacto Page — Light Mode
 * Contact form + WhatsApp CTA
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSettings } from "../lib/data";

const settings = await getSettings();
---

<BaseLayout
    title="Contacto"
    description="Contacta con VideoMarketing Sevilla. Cuéntanos tu proyecto de video marketing y te enviamos un presupuesto personalizado."
>
    <!-- Header -->
    <section class="pt-44 pb-16 relative overflow-hidden bg-gray-50">
        <!-- Dot pattern -->
        <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 20px 20px;"></div>
        <div class="absolute top-20 right-1/3 w-96 h-96 bg-carmin/5 rounded-full blur-[200px] pointer-events-none"></div>

        <div class="section-container relative z-10">
            <div class="flex flex-col items-center text-center max-w-3xl mx-auto">
                <div class="inline-flex items-center gap-3 px-4 py-2 rounded-full border border-carmin/30 bg-carmin/10 mb-6 animate-fade-in">
                    <div class="w-2 h-2 bg-carmin rounded-full animate-pulse shadow-[0_0_10px_rgba(232,54,79,0.8)]"></div>
                    <span class="text-label text-carmin font-semibold">Hablemos</span>
                </div>
                <h1
                    class="text-5xl lg:text-7xl font-[Outfit] font-bold text-dark mb-6 animate-fade-up"
                    style="text-align: center;"
                >
                    Contacta con <span class="text-gradient-carmin">nosotros</span>
                </h1>
                <p
                    class="text-dark-subtle text-lg leading-relaxed animate-fade-up max-w-2xl"
                    style="animation-delay: 0.2s; text-align: center;"
                >
                    ¿Tienes un proyecto en mente? Cuéntanos y te respondemos en
                    menos de 24 horas.
                </p>
            </div>
        </div>
    </section>

    <!-- Contact Form + WhatsApp -->
    <section class="pb-24 bg-white relative pt-12">
        <!-- Dot pattern -->
        <div class="absolute inset-0 opacity-[0.06] pointer-events-none" style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 20px 20px;"></div>

        <div class="section-container relative z-10">
            <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">
                <!-- Form -->
                <div class="lg:col-span-3">
                    <form id="contact-form" class="space-y-6 reveal bg-white rounded-3xl p-8 lg:p-10 border border-gray-200 shadow-lg">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                            <div>
                                <label
                                    for="contact-name"
                                    class="block text-sm font-medium text-dark mb-2"
                                    >Nombre *</label
                                >
                                <input
                                    type="text"
                                    id="contact-name"
                                    name="name"
                                    required
                                    class="w-full px-5 py-3.5 bg-gray-50 border border-gray-200 rounded-2xl text-dark placeholder-dark-subtle/50 focus:outline-none focus:border-carmin focus:ring-2 focus:ring-carmin/10 transition-all duration-300"
                                    placeholder="Tu nombre"
                                />
                            </div>
                            <div>
                                <label
                                    for="contact-email"
                                    class="block text-sm font-medium text-dark mb-2"
                                    >Email *</label
                                >
                                <input
                                    type="email"
                                    id="contact-email"
                                    name="email"
                                    required
                                    class="w-full px-5 py-3.5 bg-gray-50 border border-gray-200 rounded-2xl text-dark placeholder-dark-subtle/50 focus:outline-none focus:border-carmin focus:ring-2 focus:ring-carmin/10 transition-all duration-300"
                                    placeholder="tu@email.com"
                                />
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                            <div>
                                <label
                                    for="contact-phone"
                                    class="block text-sm font-medium text-dark mb-2"
                                    >Teléfono</label
                                >
                                <input
                                    type="tel"
                                    id="contact-phone"
                                    name="phone"
                                    class="w-full px-5 py-3.5 bg-gray-50 border border-gray-200 rounded-2xl text-dark placeholder-dark-subtle/50 focus:outline-none focus:border-carmin focus:ring-2 focus:ring-carmin/10 transition-all duration-300"
                                    placeholder="+34 600 000 000"
                                />
                            </div>
                            <div>
                                <label
                                    for="contact-company"
                                    class="block text-sm font-medium text-dark mb-2"
                                    >Empresa</label
                                >
                                <input
                                    type="text"
                                    id="contact-company"
                                    name="company"
                                    class="w-full px-5 py-3.5 bg-gray-50 border border-gray-200 rounded-2xl text-dark placeholder-dark-subtle/50 focus:outline-none focus:border-carmin focus:ring-2 focus:ring-carmin/10 transition-all duration-300"
                                    placeholder="Nombre de tu empresa"
                                />
                            </div>
                        </div>

                        <div>
                            <label
                                for="contact-message"
                                class="block text-sm font-medium text-dark mb-2"
                                >Mensaje *</label
                            >
                            <textarea
                                id="contact-message"
                                name="message"
                                required
                                rows="5"
                                class="w-full px-5 py-3.5 bg-gray-50 border border-gray-200 rounded-2xl text-dark placeholder-dark-subtle/50 focus:outline-none focus:border-carmin focus:ring-2 focus:ring-carmin/10 transition-all duration-300 resize-none"
                                placeholder="Cuéntanos sobre tu proyecto..."
                            ></textarea>
                        </div>

                        <!-- Status message -->
                        <div
                            id="form-status"
                            class="hidden rounded-2xl p-4 text-sm"
                        >
                        </div>

                        <button
                            type="submit"
                            id="contact-submit"
                            class="group inline-flex items-center gap-3 px-8 py-4 bg-gradient-to-r from-carmin-light to-carmin text-white font-semibold rounded-full hover:shadow-[0_0_40px_rgba(155,27,48,0.3)] transition-all duration-300 hover:scale-105 disabled:opacity-50 disabled:cursor-not-allowed"
                        >
                            <span>Enviar mensaje</span>
                            <svg
                                class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"
                                ></path></svg
                            >
                        </button>
                    </form>
                </div>

                <!-- WhatsApp CTA + Info -->
                <div class="lg:col-span-2 space-y-6 reveal-right">
                    <!-- WhatsApp card -->
                    <a
                        href={`https://wa.me/${settings.whatsapp_number}?text=Hola,%20me%20gustaría%20saber%20más%20sobre%20vuestros%20servicios%20de%20video%20marketing.`}
                        target="_blank"
                        rel="noopener"
                        class="group block bg-white rounded-3xl p-8 border border-gray-200 shadow-sm hover:shadow-lg hover:border-[#25D366]/30 transition-all duration-300"
                        id="whatsapp-cta"
                    >
                        <div
                            class="w-14 h-14 bg-[#25D366]/10 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300"
                        >
                            <svg
                                class="w-7 h-7 text-[#25D366]"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                                ></path></svg
                            >
                        </div>
                        <h3
                            class="text-xl font-[Outfit] font-bold text-dark mb-2 group-hover:text-[#25D366] transition-colors"
                        >
                            ¿Prefieres WhatsApp?
                        </h3>
                        <p
                            class="text-dark-subtle text-sm leading-relaxed mb-4"
                        >
                            Escríbenos directamente y te respondemos al
                            instante. Es la forma más rápida de contactarnos.
                        </p>
                        <span
                            class="inline-flex items-center gap-2 text-[#25D366] text-sm font-medium"
                        >
                            Abrir WhatsApp
                            <svg
                                class="w-4 h-4"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg
                            >
                        </span>
                    </a>

                    <!-- Contact info -->
                    <div class="bg-white rounded-3xl p-8 border border-gray-200 shadow-sm">
                        <h3
                            class="text-lg font-[Outfit] font-bold text-dark mb-6"
                        >
                            Información de contacto
                        </h3>
                        <div class="space-y-4">
                            <div class="flex items-center gap-3">
                                <svg
                                    class="w-5 h-5 text-carmin flex-shrink-0"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                    ><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                    ></path><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                    ></path></svg
                                >
                                <span class="text-dark-subtle text-sm"
                                    >{settings.address}</span
                                >
                            </div>
                            <div class="flex items-center gap-3">
                                <svg
                                    class="w-5 h-5 text-carmin flex-shrink-0"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                    ><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                                    ></path></svg
                                >
                                <span class="text-dark-subtle text-sm"
                                    >{settings.phone}</span
                                >
                            </div>
                            <div class="flex items-center gap-3">
                                <svg
                                    class="w-5 h-5 text-carmin flex-shrink-0"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                    ><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                    ></path></svg
                                >
                                <span class="text-dark-subtle text-sm"
                                    >{settings.email}</span
                                >
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>

<script>
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const status = document.getElementById("form-status")!;
    const submitBtn = document.getElementById(
        "contact-submit",
    ) as HTMLButtonElement;

    form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        submitBtn.disabled = true;
        submitBtn.querySelector("span")!.textContent = "Enviando...";

        const formData = new FormData(form);
        const data = Object.fromEntries(formData);

        try {
            const res = await fetch("/api/contact", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(data),
            });

            if (res.ok) {
                status.textContent =
                    "✅ ¡Mensaje enviado con éxito! Te responderemos pronto.";
                status.className =
                    "rounded-2xl p-4 text-sm bg-green-50 text-green-700 border border-green-200";
                form.reset();
            } else {
                throw new Error("Error sending");
            }
        } catch {
            status.textContent =
                "❌ Error al enviar. Intenta de nuevo o contacta por WhatsApp.";
            status.className =
                "rounded-2xl p-4 text-sm bg-red-50 text-red-700 border border-red-200";
        }

        status.classList.remove("hidden");
        submitBtn.disabled = false;
        submitBtn.querySelector("span")!.textContent = "Enviar mensaje";
    });
</script>
