---
import ConceptLayout from "../../layouts/ConceptLayout.astro";
import Navbar from "../../components/ui/Navbar.astro";
---

<ConceptLayout
    concept={9}
    title="Concepto 09 — Object Study"
    description="Un visor editorial e interactivo para explorar la óptica 3D de LaesePROD."
>
    <Navbar />

    <section class="object-hero" aria-labelledby="object-title">
        <div
            class="object-viewer"
            data-lens-explorer
            aria-label="Visor interactivo del objetivo cinematográfico"
        >
            <canvas
                class="object-viewer__canvas"
                data-explorer-canvas
                tabindex="0"
                aria-label="Objetivo 3D interactivo. Arrastra para girarlo, usa la rueda para acercarlo o las flechas del teclado para rotarlo."
            ></canvas>

            <div class="object-viewer__rings" aria-hidden="true">
                <span></span><span></span><span></span>
            </div>

            <p class="object-viewer__index" aria-hidden="true">
                <span>OBJ / 09</span>
                <span>35 MM · INTERACTIVE</span>
            </p>

            <div class="object-viewer__loading" aria-live="polite">
                <span data-explorer-status>Cargando objeto</span>
                <i><b data-explorer-progress></b></i>
            </div>

            <p class="object-viewer__hint">
                <span class="object-viewer__drag" aria-hidden="true">
                    <i></i><i></i><i></i>
                </span>
                Arrastra para girar · rueda para acercar
            </p>
        </div>

        <div class="object-copy">
            <p class="object-copy__eyebrow"><span>09</span> Object study</p>
            <h1 id="object-title">
                La mirada<br />
                <em>lo cambia todo.</em>
            </h1>
            <p class="object-copy__text">
                Explora la óptica que convierte cada instante en una imagen capaz de permanecer.
            </p>
            <div class="object-copy__footer" aria-hidden="true">
                <span>LAESEPROD®</span>
                <span>SEVILLA · ESP</span>
                <span>2026</span>
            </div>
        </div>
    </section>
</ConceptLayout>

<script>
    import "../../scripts/lens-explorer";
</script>

<noscript>
    <style>
        .object-viewer__loading {
            display: none !important;
        }
    </style>
</noscript>

<style>
    .object-hero {
        min-height: 100svh;
        display: grid;
        grid-template-columns: minmax(0, 1.04fr) minmax(0, .96fr);
        overflow: hidden;
        background: #0a0a0a;
        font-family: Arial, Helvetica, sans-serif;
    }

    .object-viewer {
        position: relative;
        min-height: 100svh;
        overflow: hidden;
        background:
            radial-gradient(circle at 50% 46%, rgba(255, 255, 255, .96), rgba(237, 237, 233, .9) 43%, rgba(219, 219, 215, .88) 100%),
            #ecece8;
        isolation: isolate;
    }

    .object-viewer::before {
        content: "";
        position: absolute;
        z-index: -1;
        inset: 0;
        opacity: .22;
        background-image:
            linear-gradient(rgba(0, 0, 0, .08) 1px, transparent 1px),
            linear-gradient(90deg, rgba(0, 0, 0, .08) 1px, transparent 1px);
        background-size: 80px 80px;
        mask-image: linear-gradient(90deg, transparent, #000 18%, #000 82%, transparent);
    }

    .object-viewer__canvas {
        position: absolute;
        z-index: 2;
        inset: 0;
        width: 100%;
        height: 100%;
        cursor: grab;
        opacity: 0;
        outline: none;
        touch-action: none;
        transition: opacity 650ms ease;
    }

    .object-viewer__canvas:active,
    .object-viewer.is-interacting .object-viewer__canvas {
        cursor: grabbing;
    }

    .object-viewer__canvas:focus-visible {
        outline: 2px solid #0a0a0a;
        outline-offset: -8px;
    }

    .object-viewer.is-model-ready .object-viewer__canvas {
        opacity: 1;
    }

    .object-viewer__rings {
        position: absolute;
        z-index: 0;
        top: 50%;
        left: 50%;
        width: min(72vw, 720px);
        aspect-ratio: 1;
        transform: translate(-50%, -50%);
        opacity: .3;
        pointer-events: none;
    }

    .object-viewer__rings span {
        position: absolute;
        border: 1px solid rgba(0, 0, 0, .12);
        border-radius: 50%;
    }

    .object-viewer__rings span:nth-child(1) { inset: 0; }
    .object-viewer__rings span:nth-child(2) { inset: 15%; }
    .object-viewer__rings span:nth-child(3) { inset: 34%; background: rgba(255, 255, 255, .18); }

    .object-viewer__index,
    .object-viewer__hint {
        position: absolute;
        z-index: 4;
        right: clamp(24px, 3.4vw, 52px);
        left: clamp(24px, 3.4vw, 52px);
        display: flex;
        justify-content: space-between;
        margin: 0;
        color: rgba(0, 0, 0, .46);
        font-family: "Courier New", monospace;
        font-size: 8px;
        letter-spacing: .14em;
        text-transform: uppercase;
        pointer-events: none;
    }

    .object-viewer__index {
        top: 124px;
    }

    .object-viewer__hint {
        right: auto;
        bottom: clamp(38px, 5vh, 62px);
        align-items: center;
        justify-content: flex-start;
        gap: 12px;
    }

    .object-viewer__drag {
        display: flex;
        align-items: center;
        gap: 2px;
        height: 18px;
    }

    .object-viewer__drag i {
        width: 1px;
        height: 8px;
        background: currentColor;
        animation: drag-wave 1.2s ease-in-out infinite;
    }

    .object-viewer__drag i:nth-child(2) {
        height: 16px;
        animation-delay: 120ms;
    }

    .object-viewer__drag i:nth-child(3) {
        height: 11px;
        animation-delay: 240ms;
    }

    .object-viewer.is-user-controlled .object-viewer__drag i {
        animation: none;
    }

    .object-viewer__loading {
        position: absolute;
        z-index: 4;
        right: clamp(24px, 3.4vw, 52px);
        bottom: clamp(38px, 5vh, 62px);
        width: 190px;
        display: grid;
        gap: 9px;
        color: rgba(0, 0, 0, .5);
        font-family: "Courier New", monospace;
        font-size: 8px;
        letter-spacing: .13em;
        text-align: right;
        text-transform: uppercase;
        transition: opacity 450ms ease, transform 450ms ease;
    }

    .object-viewer.is-model-ready .object-viewer__loading {
        opacity: 0;
        transform: translateY(8px);
        pointer-events: none;
    }

    .object-viewer__loading i {
        position: relative;
        height: 1px;
        overflow: hidden;
        background: rgba(0, 0, 0, .12);
    }

    .object-viewer__loading b {
        position: absolute;
        inset: 0;
        background: #0a0a0a;
        transform: scaleX(.08);
        transform-origin: left;
        transition: transform 180ms ease;
    }

    .object-copy {
        position: relative;
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 136px clamp(42px, 6.5vw, 118px) 92px;
        color: #fff;
        background:
            radial-gradient(circle at 76% 30%, rgba(255, 255, 255, .075), transparent 27%),
            #0a0a0a;
    }

    .object-copy::before {
        content: "35";
        position: absolute;
        right: -2vw;
        bottom: -8vh;
        color: rgba(255, 255, 255, .025);
        font-size: clamp(18rem, 31vw, 36rem);
        font-weight: 900;
        letter-spacing: -.11em;
        line-height: .72;
        pointer-events: none;
    }

    .object-copy__eyebrow {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 13px;
        margin: 0 0 28px;
        color: rgba(255, 255, 255, .52);
        font-family: "Courier New", monospace;
        font-size: 9px;
        letter-spacing: .16em;
        text-transform: uppercase;
    }

    .object-copy__eyebrow span {
        display: grid;
        place-items: center;
        width: 30px;
        height: 30px;
        color: #0a0a0a;
        background: #fff;
        border-radius: 50%;
        font-weight: 700;
    }

    .object-copy h1 {
        position: relative;
        z-index: 1;
        margin: 0;
        font-size: clamp(4rem, 6.3vw, 8rem);
        font-weight: 850;
        letter-spacing: -.075em;
        line-height: .81;
    }

    .object-copy h1 em {
        display: inline-block;
        color: transparent;
        -webkit-text-stroke: 1px rgba(255, 255, 255, .7);
        font-family: Georgia, "Times New Roman", serif;
        font-weight: 400;
        letter-spacing: -.055em;
    }

    .object-copy__text {
        position: relative;
        z-index: 1;
        max-width: 390px;
        margin: 42px 0 0;
        padding-top: 20px;
        color: rgba(255, 255, 255, .58);
        border-top: 1px solid rgba(255, 255, 255, .2);
        font-size: 13px;
        line-height: 1.65;
    }

    .object-copy__footer {
        position: absolute;
        z-index: 1;
        right: clamp(42px, 6.5vw, 118px);
        bottom: clamp(38px, 5vh, 62px);
        left: clamp(42px, 6.5vw, 118px);
        display: flex;
        justify-content: space-between;
        color: rgba(255, 255, 255, .35);
        font-family: "Courier New", monospace;
        font-size: 8px;
        letter-spacing: .13em;
    }

    @keyframes drag-wave {
        50% {
            opacity: .28;
            transform: scaleY(.55);
        }
    }

    @media (max-width: 900px) {
        .object-hero {
            grid-template-columns: 1fr;
            overflow: visible;
        }

        .object-viewer {
            min-height: 56svh;
        }

        .object-viewer__index {
            top: 96px;
        }

        .object-viewer__rings {
            width: min(100vw, 560px);
        }

        .object-viewer__hint {
            bottom: 24px;
        }

        .object-viewer__loading {
            bottom: 24px;
        }

        .object-copy {
            min-height: 50svh;
            padding: 76px 24px 116px;
        }

        .object-copy h1 {
            font-size: clamp(3.8rem, 15vw, 6.8rem);
        }

        .object-copy__text {
            margin-top: 30px;
        }

        .object-copy__footer {
            right: 24px;
            bottom: 76px;
            left: 24px;
        }
    }

    @media (max-width: 520px) {
        .object-viewer {
            min-height: 58svh;
        }

        .object-viewer__index {
            top: 92px;
            right: 18px;
            left: 18px;
        }

        .object-viewer__hint {
            left: 18px;
            font-size: 7px;
        }

        .object-viewer__loading {
            right: 18px;
            width: 150px;
        }

        .object-copy {
            padding-top: 66px;
        }

        .object-copy__eyebrow {
            margin-bottom: 20px;
        }

        .object-copy__text {
            display: none;
        }

        .object-copy__footer span:nth-child(2) {
            display: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .object-viewer__drag i {
            animation: none;
        }
    }
</style>

<style is:global>
    @media (min-width: 1081px) {
        .concept-page--09 .site-nav {
            width: min(900px, calc(100vw - 36px));
        }

        .concept-page--09 .site-nav__actions {
            grid-column: 3;
        }
    }
</style>
