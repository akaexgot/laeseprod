---
/**
 * Quiénes Somos / About Us — Light Mode
 * Video corporativo, Google Maps, contact info, social links
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSettings } from "../lib/data";

const settings = await getSettings();
---

<BaseLayout
    title="Quiénes Somos"
    description="Conoce a VideoMarketing Sevilla. Somos una productora audiovisual especializada en video marketing para empresas en Sevilla y toda España."
>
    <!-- Header -->
    <section class="pt-44 pb-16 relative overflow-hidden bg-gray-50">
        <!-- Dot pattern -->
        <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 20px 20px;"></div>
        <div class="absolute top-20 left-1/4 w-96 h-96 bg-carmin/5 rounded-full blur-[200px] pointer-events-none"></div>

        <div class="section-container relative z-10">
            <div class="flex flex-col items-center text-center max-w-3xl mx-auto">
                <div class="inline-flex items-center gap-3 px-4 py-2 rounded-full border border-carmin/30 bg-carmin/10 mb-6 animate-fade-in">
                    <div class="w-2 h-2 bg-carmin rounded-full animate-pulse shadow-[0_0_10px_rgba(232,54,79,0.8)]"></div>
                    <span class="text-label text-carmin font-semibold">Nosotros</span>
                </div>
                <h1
                    class="text-5xl lg:text-7xl font-[Outfit] font-bold text-dark mb-6 animate-fade-up"
                    style="text-align: center;"
                >
                    Quiénes <span class="text-gradient-carmin">somos</span>
                </h1>
                <p
                    class="text-dark-subtle text-lg leading-relaxed animate-fade-up max-w-2xl"
                    style="animation-delay: 0.2s; text-align: center;"
                >
                    Somos una productora audiovisual con sede en Sevilla,
                    especializados en crear contenido que conecta marcas con
                    personas.
                </p>
            </div>
        </div>
    </section>

    <!-- Corporate Video -->
    <section class="pb-24 bg-white relative pt-12">
        <!-- Dot pattern -->
        <div class="absolute inset-0 opacity-[0.06] pointer-events-none" style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 20px 20px;"></div>

        <div class="section-container relative z-10">
            <div
                class="relative rounded-3xl overflow-hidden aspect-video bg-gray-100 border border-gray-200 shadow-lg reveal"
            >
                <div
                    class="w-full h-full bg-gradient-to-br from-gray-100 to-carmin-100/10 flex items-center justify-center"
                >
                    <div class="text-center">
                        <div
                            class="w-20 h-20 bg-carmin/10 rounded-full flex items-center justify-center mx-auto mb-6 shadow-[0_10px_30px_rgba(155,27,48,0.1)]"
                        >
                            <svg
                                class="w-10 h-10 text-carmin"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                                ><path d="M8 5v14l11-7z"></path></svg
                            >
                        </div>
                        <p class="text-dark-subtle text-lg font-medium">
                            Vídeo corporativo
                        </p>
                        <p class="text-dark-subtle/60 text-sm mt-2">
                            Próximamente
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- About Content -->
    <section class="pb-24 bg-white relative">
        <!-- Dot pattern -->
        <div class="absolute inset-0 opacity-[0.06] pointer-events-none" style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 20px 20px;"></div>

        <div class="section-container relative z-10">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                <!-- Text -->
                <div class="reveal-left">
                    <h2
                        class="text-3xl lg:text-4xl font-[Outfit] font-bold text-dark mb-6"
                    >
                        Transformamos ideas en <span
                            class="text-gradient-carmin"
                            >contenido audiovisual</span
                        >
                    </h2>
                    <div class="space-y-4 text-dark-subtle leading-relaxed">
                        <p>
                            En VideoMarketing Sevilla creemos que cada empresa
                            tiene una historia que merece ser contada. Desde
                            nuestra fundación, nos hemos dedicado a crear
                            contenido audiovisual de calidad cinematográfica
                            para empresas que quieren destacar.
                        </p>
                        <p>
                            Nuestro equipo combina creatividad, tecnología y
                            estrategia para producir vídeos que no solo se ven
                            bien, sino que generan resultados medibles para tu
                            negocio.
                        </p>
                        <p>
                            Trabajamos con empresas de todos los sectores en
                            Sevilla, Cádiz y toda España, ofreciendo un servicio
                            personalizado y cercano.
                        </p>
                    </div>
                </div>

                <!-- Stats / Info Cards -->
                <div class="grid grid-cols-2 gap-4 reveal-right">
                    <div
                        class="bg-white rounded-3xl p-6 text-center border border-gray-200 shadow-sm hover:shadow-lg hover:border-carmin/20 transition-all duration-300"
                    >
                        <div
                            class="text-4xl font-[Outfit] font-bold text-gradient-carmin mb-2"
                        >
                            100+
                        </div>
                        <div class="text-dark-subtle text-sm">
                            Proyectos realizados
                        </div>
                    </div>
                    <div
                        class="bg-white rounded-3xl p-6 text-center border border-gray-200 shadow-sm hover:shadow-lg hover:border-carmin/20 transition-all duration-300"
                    >
                        <div
                            class="text-4xl font-[Outfit] font-bold text-gradient-carmin mb-2"
                        >
                            50+
                        </div>
                        <div class="text-dark-subtle text-sm">
                            Clientes satisfechos
                        </div>
                    </div>
                    <div
                        class="bg-white rounded-3xl p-6 text-center border border-gray-200 shadow-sm hover:shadow-lg hover:border-carmin/20 transition-all duration-300"
                    >
                        <div
                            class="text-4xl font-[Outfit] font-bold text-gradient-carmin mb-2"
                        >
                            6+
                        </div>
                        <div class="text-dark-subtle text-sm">Sectores</div>
                    </div>
                    <div
                        class="bg-white rounded-3xl p-6 text-center border border-gray-200 shadow-sm hover:shadow-lg hover:border-carmin/20 transition-all duration-300"
                    >
                        <div
                            class="text-4xl font-[Outfit] font-bold text-gradient-carmin mb-2"
                        >
                            4K
                        </div>
                        <div class="text-dark-subtle text-sm">
                            Calidad cinematográfica
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact Info + Map -->
    <section class="pb-24 bg-gray-50 pt-16 relative">
        <!-- Dot pattern -->
        <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 20px 20px;"></div>

        <div class="section-container relative z-10">
            <div class="flex flex-col items-center mb-12">
                <h2
                    class="text-3xl font-[Outfit] font-bold text-dark text-center reveal"
                    style="text-align: center;"
                >
                    Encuéntranos
                </h2>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <!-- Google Maps -->
                <div class="rounded-3xl overflow-hidden h-96 reveal-left shadow-lg border border-gray-200">
                    <iframe
                        src={settings.google_maps_embed}
                        class="w-full h-full border-0"
                        allowfullscreen
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        title="Ubicación VideoMarketing Sevilla"
                    ></iframe>
                </div>

                <!-- Contact Cards -->
                <div class="flex flex-col gap-4 reveal-right">
                    <a
                        href={`https://wa.me/${settings.whatsapp_number}`}
                        target="_blank"
                        rel="noopener"
                        class="group bg-white rounded-2xl p-6 flex items-center gap-4 border border-gray-200 shadow-sm hover:shadow-lg hover:border-[#25D366]/30 transition-all duration-300"
                    >
                        <div
                            class="w-12 h-12 bg-[#25D366]/10 rounded-xl flex items-center justify-center flex-shrink-0"
                        >
                            <svg
                                class="w-6 h-6 text-[#25D366]"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                                ></path></svg
                            >
                        </div>
                        <div>
                            <div
                                class="text-dark font-semibold group-hover:text-[#25D366] transition-colors"
                            >
                                WhatsApp
                            </div>
                            <div class="text-dark-subtle text-sm">
                                Respuesta inmediata
                            </div>
                        </div>
                    </a>

                    <a
                        href={settings.instagram}
                        target="_blank"
                        rel="noopener"
                        class="group bg-white rounded-2xl p-6 flex items-center gap-4 border border-gray-200 shadow-sm hover:shadow-lg hover:border-pink-500/30 transition-all duration-300"
                    >
                        <div
                            class="w-12 h-12 bg-pink-500/10 rounded-xl flex items-center justify-center flex-shrink-0"
                        >
                            <svg
                                class="w-6 h-6 text-pink-500"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                                ></path></svg
                            >
                        </div>
                        <div>
                            <div
                                class="text-dark font-semibold group-hover:text-pink-500 transition-colors"
                            >
                                Instagram
                            </div>
                            <div class="text-dark-subtle text-sm">
                                @videomarketingsevilla
                            </div>
                        </div>
                    </a>

                    <a
                        href={settings.linkedin}
                        target="_blank"
                        rel="noopener"
                        class="group bg-white rounded-2xl p-6 flex items-center gap-4 border border-gray-200 shadow-sm hover:shadow-lg hover:border-blue-500/30 transition-all duration-300"
                    >
                        <div
                            class="w-12 h-12 bg-blue-500/10 rounded-xl flex items-center justify-center flex-shrink-0"
                        >
                            <svg
                                class="w-6 h-6 text-blue-500"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                                ></path></svg
                            >
                        </div>
                        <div>
                            <div
                                class="text-dark font-semibold group-hover:text-blue-500 transition-colors"
                            >
                                LinkedIn
                            </div>
                            <div class="text-dark-subtle text-sm">
                                VideoMarketing Sevilla
                            </div>
                        </div>
                    </a>

                    <a
                        href={`tel:${settings.phone}`}
                        class="group bg-white rounded-2xl p-6 flex items-center gap-4 border border-gray-200 shadow-sm hover:shadow-lg hover:border-carmin/30 transition-all duration-300"
                    >
                        <div
                            class="w-12 h-12 bg-carmin/10 rounded-xl flex items-center justify-center flex-shrink-0"
                        >
                            <svg
                                class="w-6 h-6 text-carmin"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                                ></path></svg
                            >
                        </div>
                        <div>
                            <div
                                class="text-dark font-semibold group-hover:text-carmin transition-colors"
                            >
                                Teléfono
                            </div>
                            <div class="text-dark-subtle text-sm">
                                {settings.phone}
                            </div>
                        </div>
                    </a>

                    <a
                        href={`mailto:${settings.email}`}
                        class="group bg-white rounded-2xl p-6 flex items-center gap-4 border border-gray-200 shadow-sm hover:shadow-lg hover:border-carmin/30 transition-all duration-300"
                    >
                        <div
                            class="w-12 h-12 bg-carmin/10 rounded-xl flex items-center justify-center flex-shrink-0"
                        >
                            <svg
                                class="w-6 h-6 text-carmin"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                ></path></svg
                            >
                        </div>
                        <div>
                            <div
                                class="text-dark font-semibold group-hover:text-carmin transition-colors"
                            >
                                Email
                            </div>
                            <div class="text-dark-subtle text-sm">
                                {settings.email}
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
