---
/**
 * Portal Cliente Page
 * Grid of clients with long-press password modal → Dropbox embed
 */
import BaseLayout from '../layouts/BaseLayout.astro';

// In production this comes from Supabase
const clients = [
  { id: '1', client_name: 'Hotel Royal', image: '', dropbox_link: 'https://www.dropbox.com/home' },
  { id: '2', client_name: 'Restaurante La Barca', image: '', dropbox_link: 'https://www.dropbox.com/home' },
  { id: '3', client_name: 'Abengoa', image: '', dropbox_link: 'https://www.dropbox.com/home' },
  { id: '4', client_name: 'Inversiones Sur', image: '', dropbox_link: 'https://www.dropbox.com/home' },
];
---

<BaseLayout
  title="Portal Cliente"
  description="Portal exclusivo para clientes de VideoMarketing Sevilla. Accede a tus archivos y materiales audiovisuales."
  noindex={true}
>
  <!-- Header -->
  <section class="pt-32 pb-16 relative overflow-hidden">
    <div class="absolute top-0 left-0 w-full h-full bg-gradient-radial opacity-50"></div>
    <div class="section-container relative z-10">
      <div class="max-w-3xl">
        <p class="text-carmin text-sm tracking-widest uppercase font-medium mb-3 animate-fade-in">Acceso exclusivo</p>
        <h1 class="text-5xl lg:text-7xl font-[Outfit] font-bold text-white mb-6 animate-fade-up">
          Portal <span class="text-gradient-carmin">cliente</span>
        </h1>
        <p class="text-light-muted text-lg leading-relaxed animate-fade-up" style="animation-delay: 0.2s;">
          Mantén pulsada tu imagen durante 2 segundos para acceder a tus archivos
        </p>
      </div>

      <!-- Search -->
      <div class="mt-8 max-w-md animate-fade-up" style="animation-delay: 0.3s;">
        <div class="relative">
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-light-subtle" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input
            type="text"
            id="client-search"
            placeholder="Buscar cliente..."
            class="w-full pl-12 pr-5 py-3.5 bg-dark-card border border-dark-border rounded-2xl text-white placeholder-light-subtle focus:outline-none focus:border-carmin transition-colors duration-300"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Clients Grid -->
  <section class="pb-24">
    <div class="section-container">
      <div id="clients-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6">
        {clients.map((client: any, idx: number) => (
          <div
            class="client-card group relative cursor-pointer reveal"
            data-client-id={client.id}
            data-client-name={client.client_name}
            style={`animation-delay: ${idx * 0.1}s`}
          >
            <div class="glass rounded-3xl p-6 text-center hover:border-carmin/20 transition-all duration-300 select-none">
              <!-- Avatar -->
              <div class="w-24 h-24 mx-auto mb-4 rounded-full overflow-hidden bg-dark-card border-2 border-dark-border group-hover:border-carmin/30 transition-colors duration-300">
                {client.image ? (
                  <img src={client.image} alt={client.client_name} class="w-full h-full object-cover" />
                ) : (
                  <div class="w-full h-full bg-gradient-to-br from-carmin-900/30 to-carmin-700/10 flex items-center justify-center">
                    <span class="text-3xl font-[Outfit] font-bold text-carmin/50">{client.client_name.charAt(0)}</span>
                  </div>
                )}
              </div>
              <h3 class="text-white font-[Outfit] font-semibold">{client.client_name}</h3>
              <p class="text-light-subtle text-xs mt-1">Mantén pulsado</p>

              <!-- Progress ring on long-press -->
              <div class="long-press-indicator absolute inset-0 rounded-3xl border-2 border-carmin opacity-0 transition-opacity duration-300 pointer-events-none"></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Password Modal -->
  <div id="password-modal" class="fixed inset-0 z-50 flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300">
    <div class="absolute inset-0 bg-dark/90 backdrop-blur-xl" id="modal-backdrop"></div>
    <div class="relative glass rounded-3xl p-8 max-w-md w-full mx-4 scale-95 transition-transform duration-300" id="modal-content">
      <button id="modal-close" class="absolute top-4 right-4 w-8 h-8 flex items-center justify-center text-light-subtle hover:text-white transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
      <h3 class="text-xl font-[Outfit] font-bold text-white mb-2" id="modal-title">Acceso cliente</h3>
      <p class="text-light-muted text-sm mb-6">Introduce tu contraseña para acceder a tus archivos</p>
      <form id="password-form">
        <input
          type="password"
          id="password-input"
          placeholder="Contraseña"
          class="w-full px-5 py-3.5 bg-dark-card border border-dark-border rounded-2xl text-white placeholder-light-subtle focus:outline-none focus:border-carmin transition-colors duration-300 mb-4"
          autocomplete="off"
        />
        <div id="password-error" class="text-red-400 text-sm mb-4 hidden">Contraseña incorrecta</div>
        <button
          type="submit"
          class="w-full px-6 py-3.5 bg-gradient-carmin text-white font-semibold rounded-2xl hover:shadow-glow-strong transition-all duration-300"
        >
          Acceder
        </button>
      </form>
    </div>
  </div>

  <!-- Dropbox Modal -->
  <div id="dropbox-modal" class="fixed inset-0 z-50 flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300">
    <div class="absolute inset-0 bg-dark/95 backdrop-blur-xl" id="dropbox-backdrop"></div>
    <div class="relative bg-dark-surface rounded-3xl max-w-5xl w-full mx-4 h-[80vh] overflow-hidden scale-95 transition-transform duration-300" id="dropbox-content">
      <div class="flex items-center justify-between p-6 border-b border-dark-border">
        <h3 class="text-lg font-[Outfit] font-bold text-white" id="dropbox-title">Archivos</h3>
        <button id="dropbox-close" class="w-8 h-8 flex items-center justify-center text-light-subtle hover:text-white transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <iframe id="dropbox-iframe" class="w-full h-full" src="" title="Archivos del cliente"></iframe>
    </div>
  </div>
</BaseLayout>

<script>
  // Real-time search
  const searchInput = document.getElementById('client-search') as HTMLInputElement;
  const clientCards = document.querySelectorAll('.client-card');

  searchInput?.addEventListener('input', () => {
    const query = searchInput.value.toLowerCase();
    clientCards.forEach(card => {
      const name = (card as HTMLElement).dataset.clientName?.toLowerCase() || '';
      (card as HTMLElement).style.display = name.includes(query) ? '' : 'none';
    });
  });

  // Long-press detection (2 seconds)
  let pressTimer: ReturnType<typeof setTimeout>;
  let pressedCard: HTMLElement | null = null;

  clientCards.forEach(card => {
    const startPress = (e: Event) => {
      e.preventDefault();
      pressedCard = card as HTMLElement;
      const indicator = card.querySelector('.long-press-indicator') as HTMLElement;
      if (indicator) {
        indicator.style.opacity = '1';
        indicator.style.animation = 'pulse-glow 1s ease-in-out infinite';
      }

      pressTimer = setTimeout(() => {
        if (indicator) {
          indicator.style.opacity = '0';
          indicator.style.animation = '';
        }
        openPasswordModal(pressedCard!);
      }, 2000);
    };

    const endPress = () => {
      clearTimeout(pressTimer);
      const indicator = card.querySelector('.long-press-indicator') as HTMLElement;
      if (indicator) {
        indicator.style.opacity = '0';
        indicator.style.animation = '';
      }
    };

    card.addEventListener('mousedown', startPress);
    card.addEventListener('touchstart', startPress);
    card.addEventListener('mouseup', endPress);
    card.addEventListener('mouseleave', endPress);
    card.addEventListener('touchend', endPress);
    card.addEventListener('touchcancel', endPress);
  });

  // Password Modal
  const passwordModal = document.getElementById('password-modal')!;
  const modalTitle = document.getElementById('modal-title')!;
  const passwordInput = document.getElementById('password-input') as HTMLInputElement;
  const passwordError = document.getElementById('password-error')!;
  const passwordForm = document.getElementById('password-form') as HTMLFormElement;
  let currentClientId = '';

  function openPasswordModal(card: HTMLElement) {
    currentClientId = card.dataset.clientId || '';
    const name = card.dataset.clientName || '';
    modalTitle.textContent = `Acceso: ${name}`;
    passwordInput.value = '';
    passwordError.classList.add('hidden');

    passwordModal.classList.remove('opacity-0', 'pointer-events-none');
    passwordModal.classList.add('opacity-100', 'pointer-events-auto');
    document.getElementById('modal-content')?.classList.remove('scale-95');
    document.getElementById('modal-content')?.classList.add('scale-100');
    passwordInput.focus();
  }

  function closePasswordModal() {
    passwordModal.classList.add('opacity-0', 'pointer-events-none');
    passwordModal.classList.remove('opacity-100', 'pointer-events-auto');
    document.getElementById('modal-content')?.classList.add('scale-95');
    document.getElementById('modal-content')?.classList.remove('scale-100');
  }

  document.getElementById('modal-close')?.addEventListener('click', closePasswordModal);
  document.getElementById('modal-backdrop')?.addEventListener('click', closePasswordModal);

  passwordForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const password = passwordInput.value;

    // TODO: Verify password via Supabase API
    // For now, accept any non-empty password
    if (password.length > 0) {
      closePasswordModal();
      openDropboxModal(currentClientId);
    } else {
      passwordError.classList.remove('hidden');
    }
  });

  // Dropbox Modal
  const dropboxModal = document.getElementById('dropbox-modal')!;
  const dropboxIframe = document.getElementById('dropbox-iframe') as HTMLIFrameElement;

  function openDropboxModal(clientId: string) {
    // TODO: Get dropbox link from data
    dropboxIframe.src = 'https://www.dropbox.com/home';
    document.getElementById('dropbox-title')!.textContent = 'Archivos del cliente';

    dropboxModal.classList.remove('opacity-0', 'pointer-events-none');
    dropboxModal.classList.add('opacity-100', 'pointer-events-auto');
    document.getElementById('dropbox-content')?.classList.remove('scale-95');
    document.getElementById('dropbox-content')?.classList.add('scale-100');
  }

  function closeDropboxModal() {
    dropboxModal.classList.add('opacity-0', 'pointer-events-none');
    dropboxModal.classList.remove('opacity-100', 'pointer-events-auto');
    document.getElementById('dropbox-content')?.classList.add('scale-95');
    document.getElementById('dropbox-content')?.classList.remove('scale-100');
    dropboxIframe.src = '';
  }

  document.getElementById('dropbox-close')?.addEventListener('click', closeDropboxModal);
  document.getElementById('dropbox-backdrop')?.addEventListener('click', closeDropboxModal);
</script>
