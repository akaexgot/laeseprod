---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ServicesSection from "../../components/home/ServicesSection.astro";
import { getServices } from "../../lib/data";
import { buildItemListSchema } from "../../lib/seo";
const services = await getServices();
---

<BaseLayout title="Bodas y videoclips" description="Servicios audiovisuales de LaesePROD" structuredData={buildItemListSchema("Servicios de LaesePROD", services, "/servicios")}>
    <div class="services-page"><ServicesSection /></div>
</BaseLayout>

<style>.services-page { background: #000; }</style>
