---
/**
 * Service Detail Page — Fullscreen Video Hero + Fullpage Scroll
 * Screen 1: Video hero with title
 * Screen 2: White content with description, CTA, related services
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/detail.css";
import { getServiceBySlug, getServices } from "../../lib/data";

const { slug } = Astro.params;
const service = await getServiceBySlug(slug || "");

if (!service) {
    return Astro.redirect("/servicios");
}

const allServices = await getServices();
const otherServices = allServices.filter((s: any) => s.slug !== slug).slice(0, 3);

function getVideoId(value: string | null | undefined): string | null {
    if (!value) return null;
    const match = value.match(/(?:youtube\.com\/(?:watch\?v=|embed\/)|youtu\.be\/)([A-Za-z0-9_-]{11})/);
    if (match) return match[1];
    if (/^[A-Za-z0-9_-]{11}$/.test(value.trim())) return value.trim();
    return null;
}

const videoId = getVideoId(service.video);
---

<BaseLayout
    title={`${service.title} en Sevilla`}
    description={`${service.description} Servicio de ${service.title.toLowerCase()} en Sevilla, Cádiz y toda España.`}
>

    <!-- ═══ SCREEN 1: VIDEO HERO ═══ -->
    <section class="detail-hero" id="detail-hero">
        <div class="detail-hero__bg">
            {videoId ? (
                <iframe
                    src={`https://www.youtube.com/embed/${videoId}?autoplay=1&mute=1&loop=1&playlist=${videoId}&controls=0&showinfo=0&rel=0&modestbranding=1&playsinline=1`}
                    class="detail-hero__iframe"
                    frameborder="0"
                    allow="autoplay; encrypted-media"
                    title={`Vídeo de ${service.title}`}
                ></iframe>
            ) : (
                <div class="detail-hero__fallback">
                    <span class="detail-hero__fallback-icon">{service.icon}</span>
                </div>
            )}
        </div>
        <div class="detail-hero__overlay"></div>

        <!-- Back link -->
        <a href="/servicios" class="detail-hero__back">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            Volver a servicios
        </a>

        <!-- Content -->
        <div class="detail-hero__content">
            <div class="detail-hero__badge">
                <span class="detail-hero__dot"></span>
                <span>Servicio</span>
            </div>
            <h1 class="detail-hero__title">{service.title}</h1>
            <p class="detail-hero__subtitle">{service.description}</p>
        </div>

        <!-- Scroll indicator -->
        <div class="detail-hero__scroll">
            <span>Descubre más</span>
            <div class="detail-hero__scroll-arrow">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
            </div>
        </div>
    </section>

    <!-- ═══ SCREEN 2: CONTENT ═══ -->
    <section class="detail-content" id="detail-content">
        <div class="detail-content__dots"></div>
        <div class="detail-content__inner">

            <!-- Description -->
            <div class="detail-desc reveal">
                <h2 class="detail-desc__heading">
                    ¿Qué incluye nuestro servicio de
                    <span class="detail-desc__heading-accent">{service.title.toLowerCase()}</span>?
                </h2>
                <div class="detail-desc__body">
                    <p>{service.description}</p>
                    <p>
                        En VideoMarketing Sevilla, nuestro servicio de {service.title.toLowerCase()} está diseñado para ayudar a tu empresa a comunicar su mensaje de forma efectiva y memorable. Cada proyecto es único y se adapta a las necesidades específicas de tu marca.
                    </p>
                </div>
            </div>

            <!-- CTA -->
            <div class="detail-cta reveal">
                <h3 class="detail-cta__title">¿Necesitas {service.title.toLowerCase()}?</h3>
                <p class="detail-cta__text">Solicita tu presupuesto personalizado sin compromiso</p>
                <a href="/contacto" class="detail-cta__btn">
                    Solicitar presupuesto
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                    </svg>
                </a>
            </div>

            <!-- Related Services -->
            <div class="detail-related reveal">
                <h2 class="detail-related__title">Otros servicios</h2>
                <div class="detail-related__grid">
                    {otherServices.map((s: any) => (
                        <a href={`/servicios/${s.slug}`} class="detail-related__card">
                            <div class="detail-related__icon">{s.icon}</div>
                            <div>
                                <div class="detail-related__name">{s.title}</div>
                                <div class="detail-related__sub">{s.description}</div>
                            </div>
                            <svg class="detail-related__arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                            </svg>
                        </a>
                    ))}
                </div>
            </div>

        </div>
    </section>

</BaseLayout>

<script>
    /* ── Fullpage Scroll ── */
    document.addEventListener('DOMContentLoaded', () => {
        const sections = Array.from(document.querySelectorAll('section'));
        if (sections.length === 0) return;

        let isScrolling = false;
        let scrollTimeout: ReturnType<typeof setTimeout>;

        function getVisibleSectionIndex() {
            let maxIdx = 0, maxArea = 0;
            sections.forEach((sec, idx) => {
                const r = sec.getBoundingClientRect();
                const visible = Math.max(0, Math.min(r.bottom, window.innerHeight) - Math.max(r.top, 0));
                if (visible > maxArea) { maxArea = visible; maxIdx = idx; }
            });
            return maxIdx;
        }

        function scrollTo(index: number) {
            if (index < 0 || index >= sections.length || isScrolling) return;
            isScrolling = true;
            sections[index].scrollIntoView({ behavior: 'smooth', block: 'start' });
            clearTimeout(scrollTimeout);
            scrollTimeout = setTimeout(() => { isScrolling = false; }, 1300);
        }

        window.addEventListener('wheel', (e) => {
            e.preventDefault();
            if (isScrolling) return;
            const cur = getVisibleSectionIndex();
            scrollTo(e.deltaY > 0 ? cur + 1 : cur - 1);
        }, { passive: false });

        let touchStartY = 0;
        window.addEventListener('touchstart', (e) => { touchStartY = e.changedTouches[0].screenY; }, { passive: false });
        window.addEventListener('touchmove', (e) => { e.preventDefault(); }, { passive: false });
        window.addEventListener('touchend', (e) => {
            if (isScrolling) return;
            const delta = touchStartY - e.changedTouches[0].screenY;
            const cur = getVisibleSectionIndex();
            if (delta > 50) scrollTo(cur + 1);
            else if (delta < -50) scrollTo(cur - 1);
        }, { passive: false });

        window.addEventListener('keydown', (e) => {
            const keys = ['ArrowDown', 'ArrowUp', 'PageDown', 'PageUp', ' '];
            if (keys.includes(e.key)) {
                e.preventDefault();
                if (isScrolling) return;
                const cur = getVisibleSectionIndex();
                if (e.key === 'ArrowDown' || e.key === 'PageDown' || e.key === ' ') scrollTo(cur + 1);
                else scrollTo(cur - 1);
            }
        }, { passive: false });
    });
</script>
