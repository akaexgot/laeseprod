---
import BaseLayout from "../../layouts/BaseLayout.astro";
import VideoBackground from "../../components/ui/VideoBackground.astro";
import InteractiveProjectVideo from "../../components/ui/InteractiveProjectVideo.astro";
import FaqsSection from "../../components/home/FaqsSection.astro";
import { getProjects, getServiceBySlug, getSettings } from "../../lib/data";
import { buildBreadcrumbSchema, buildServiceSchema } from "../../lib/seo";

const { slug } = Astro.params;
const [service, settings, projects] = await Promise.all([getServiceBySlug(slug || ""), getSettings(), getProjects()]);
if (!service) return Astro.redirect("/servicios");

const path = `/servicios/${service.slug}`;
const serviceCopy: Record<string, any> = {
    bodas: {
        back: "Servicios / Bodas",
        kicker: "Historias para volver a vivirlas",
        title: ["Bodas", "con pulso real"],
        briefLabel: "Empezamos por tu fecha",
        briefTitle: "Cu\u00e9ntanos d\u00f3nde, cu\u00e1ndo y qu\u00e9 quer\u00e9is recordar.",
        notes: ["01 Preparativos", "02 Ceremonia", "03 Celebraci\u00f3n"],
        processDetails: [
            { title: "01 Preparativos", text: "La calma previa, los gestos peque\u00f1os y el ambiente antes de salir. Rodamos sin invadir para conservar la verdad del momento." },
            { title: "02 Ceremonia", text: "Cuidamos entradas, miradas, votos y reacciones con una cobertura discreta, pensada para que el recuerdo tenga ritmo y emoci\u00f3n." },
            { title: "03 Celebraci\u00f3n", text: "El pulso cambia: abrazos, brindis, baile y detalles de familia. Buscamos una pieza viva, elegante y fiel a vuestra noche." },
        ],
        afterLabel: "Bodas",
        afterTitle: "Lo importante no se posa. Se acompa\u00f1a.",
    },
    videoclips: {
        back: "Servicios / Videoclips",
        kicker: "Imagen para canciones con identidad",
        title: ["Videoclips", "con car\u00e1cter"],
        briefLabel: "Empezamos por tu canci\u00f3n",
        briefTitle: "Cu\u00e9ntanos el tema, la idea y el universo visual.",
        notes: ["01 Concepto", "02 Rodaje", "03 Edici\u00f3n"],
        processDetails: [
            { title: "01 Concepto", text: "Partimos de la canción, la letra y la identidad del artista para construir una idea visual clara, con referencias, tono y ritmo antes de grabar." },
            { title: "02 Rodaje", text: "Preparamos localizaciones, luz, dirección y puesta en escena para que cada plano tenga intención y el videoclip respire con la música." },
            { title: "03 Edición", text: "Montaje, color y acabado final para convertir el material en una pieza con pulso, preparada para YouTube, redes y lanzamiento." },
        ],
        afterLabel: "Videoclips",
        afterTitle: "Una canci\u00f3n tambi\u00e9n se mira.",
    },
};

const copy = serviceCopy[service.slug] || {
    back: "Servicios",
    kicker: service.title,
    title: [service.title],
    briefLabel: "Empezamos por tu idea",
    briefTitle: "Cu\u00e9ntanos qu\u00e9 tienes en mente.",
    notes: ["01 Concepto", "02 Rodaje", "03 Entrega"],
    afterLabel: service.title,
    afterTitle: "Cada proyecto pide una mirada propia.",
};
const heroKicker = String(service.hero_kicker || "").trim() || copy.kicker;
const heroTitle = String(service.hero_title || "").trim();
const heroTitleLines = heroTitle ? heroTitle.split(/\r?\n/).map((line) => line.trim()).filter(Boolean) : copy.title;

const inferProjectCategory = (project: any) => {
    const explicit = String(project.category || project.project_category || "").toLowerCase();
    if (explicit === "bodas" || explicit === "videoclips") return explicit;
    const haystack = `${project.slug || ""} ${project.subtitle || ""} ${project.title || ""}`.toLowerCase();
    return /\bboda|wedding|ceremonia|celebraci[oó]n/.test(haystack) ? "bodas" : "videoclips";
};
const serviceProjects = projects
    .filter((project: any) => inferProjectCategory(project) === service.slug)
    .sort((a: any, b: any) => {
        const dateA = Date.parse(a.published_at || a.created_at || a.updated_at || "") || 0;
        const dateB = Date.parse(b.published_at || b.created_at || b.updated_at || "") || 0;
        if (dateA !== dateB) return dateB - dateA;
        return Number(a.order || 0) - Number(b.order || 0);
    })
    .slice(0, 3);
const latestProjectsTitle = service.slug === "bodas" ? "\u00daltimas bodas" : "\u00daltimos videoclips";
const serviceSeoContent: Record<string, { ariaLabel: string; eyebrow: string; title: string; paragraphs: string[]; videoTitle: string }> = {
    bodas: {
        ariaLabel: "Videos de boda en Sevilla",
        eyebrow: "Videos de boda en Sevilla",
        title: "Peliculas de boda naturales, cuidadas y con emocion real",
        paragraphs: [
            "Trabajamos cada boda con una mirada documental y cinematografica: preparativos, ceremonia, celebracion y todos esos gestos que hacen que el recuerdo vuelva con fuerza.",
            "El objetivo es crear una pelicula de boda elegante, cercana y fiel a vuestra historia, cuidando el ritmo, el sonido, el color y la forma de contar el dia sin interrumpir lo que esta pasando.",
        ],
        videoTitle: "Video explicativo de bodas",
    },
    videoclips: {
        ariaLabel: "Produccion de videoclips",
        eyebrow: "Videoclips en Sevilla",
        title: "Produccion visual para canciones con identidad propia",
        paragraphs: [
            "Trabajamos cada videoclip desde el concepto: escuchamos la cancion, definimos el tono, buscamos referencias y preparamos una pieza pensada para YouTube, redes y lanzamiento.",
            "La direccion, el rodaje, el montaje y el color se ajustan al artista para que el resultado tenga ritmo, presencia y una imagen reconocible sin sobrecargar la produccion.",
        ],
        videoTitle: "Video explicativo de videoclips",
    },
};
const getText = (value: unknown, fallbackText: string) => String(value || "").trim() || fallbackText;
const defaultSeoContent = serviceSeoContent[service.slug];
const seoContent = defaultSeoContent ? {
    ariaLabel: getText(service.seo_eyebrow, defaultSeoContent.ariaLabel),
    eyebrow: getText(service.seo_eyebrow, defaultSeoContent.eyebrow),
    title: getText(service.seo_title, defaultSeoContent.title),
    paragraphs: [
        getText(service.seo_paragraph_1, defaultSeoContent.paragraphs[0] || ""),
        getText(service.seo_paragraph_2, defaultSeoContent.paragraphs[1] || ""),
    ].filter(Boolean),
    videoTitle: getText(service.seo_video_title, defaultSeoContent.videoTitle),
} : null;
const seoVideoDesktop = service.seo_video || service.video || settings.hero_video_desktop;
const seoVideoMobile = service.seo_video_mobile || service.seo_video || service.video_vertical || service.video || settings.hero_video_mobile || settings.hero_video_desktop;
const whatsappNumber = String(settings.whatsapp_number || settings.phone || "34662908416").replace(/\D/g, "");
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=Hola%20LaeseProd,%20quiero%20hablar%20sobre%20un%20proyecto.`;
---

<BaseLayout title={service.title} description={service.description} structuredData={[buildBreadcrumbSchema([{ name: "Inicio", path: "/" }, { name: "Servicios", path: "/servicios" }, { name: service.title, path }]), buildServiceSchema(service, path)]}>
    <section class={`service-detail service-detail--cinematic service-detail--${service.slug}`}>
        <VideoBackground desktop={service.video || settings.hero_video_desktop} mobile={service.video_vertical || service.video || settings.hero_video_mobile} title={service.title} overlay="none" />
        <div class="service-detail__shade" aria-hidden="true"></div>

        <div class="service-detail__stage">
            <article class="service-detail__hero" aria-labelledby="service-title">
                <a class="service-detail__back" href="/servicios">{copy.back}</a>
                <p class="service-detail__kicker">{heroKicker}</p>
                <h1 id="service-title">
                    {heroTitleLines.map((line: string) => <span>{line}</span>)}
                </h1>
                {service.description && <p class="service-detail__description">{service.description}</p>}
            </article>

            <aside class="service-detail__brief" aria-label={`Contacto para ${service.title}`}>
                <p class="service-detail__brief-label">{copy.briefLabel}</p>
                <h2>{copy.briefTitle}</h2>
                <div class="service-detail__actions">
                    <a href="/contacto">Contactar</a>
                    <a class="service-detail__whatsapp" href={whatsappUrl} target="_blank" rel="noreferrer">WhatsApp</a>
                </div>
            </aside>
        </div>

        {copy.processDetails ? (
            <div class="service-detail__notes service-detail__notes--accordion" aria-label="Proceso">
                {copy.processDetails.map((item: any) => (
                    <details class="service-detail__note">
                        <summary>{item.title}</summary>
                        <p>{item.text}</p>
                    </details>
                ))}
            </div>
        ) : (
            <div class="service-detail__notes" aria-label="Proceso">
                {copy.notes.map((note: string) => <span>{note}</span>)}
            </div>
        )}
    </section>

    <section class:list={["service-detail__after", { "service-detail__after--no-projects": serviceProjects.length === 0 }]}>
        <div class="service-detail__after-content">
            {seoContent && (
                <section class="service-detail__seo-block" aria-label={seoContent.ariaLabel}>
                    <div class="service-detail__seo-copy">
                        <p>{seoContent.eyebrow}</p>
                        <h2>{seoContent.title}</h2>
                        <div>
                            {seoContent.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                        </div>
                    </div>
                    <figure class="service-detail__seo-video">
                        <InteractiveProjectVideo desktop={seoVideoDesktop} mobile={seoVideoMobile} title={seoContent.videoTitle} />
                    </figure>
                </section>
            )}
            {serviceProjects.length > 0 && (
                <section class="service-detail__related" aria-label={`Últimos proyectos de ${service.title}`}>
                    <div class="service-detail__related-heading">
                        <h2>{latestProjectsTitle}</h2>
                    </div>
                    <div class="service-detail__related-grid">
                        {serviceProjects.map((project: any) => (
                            <a class="service-detail__related-item" href={`/proyectos/${project.slug}`} aria-label={`Ver ${project.title}`}>
                                {project.video_project ? (
                                    <VideoBackground desktop={project.video_project} mobile={project.video_project} title={project.title} overlay="none" />
                                ) : project.thumbnail ? (
                                    <img src={project.thumbnail} alt="" aria-hidden="true" />
                                ) : null}
                                <span>{project.title}</span>
                            </a>
                        ))}
                    </div>
                </section>
            )}
            <FaqsSection serviceSlug={service.slug} serviceId={service.id} />
        </div>
    </section>

    <script>
        document.querySelectorAll<HTMLDetailsElement>('.service-detail__note').forEach((item) => {
            item.addEventListener('mouseenter', () => {
                if (!window.matchMedia('(hover: hover)').matches) return;
                item.parentElement?.querySelectorAll<HTMLDetailsElement>('.service-detail__note').forEach((sibling) => {
                    sibling.open = sibling === item;
                });
            });
            item.addEventListener('mouseleave', () => {
                if (window.matchMedia('(hover: hover)').matches) item.open = false;
            });
        });
    </script>
</BaseLayout>

<style>
    .service-detail { position: relative; background: #000; overflow: hidden; }
    .service-detail--cinematic { min-height: 100svh; display: grid; padding: clamp(5.8rem, 9.6vh, 7rem) clamp(1rem, 4vw, 4rem) clamp(.7rem, 1.4vh, 1rem); color: #fff; isolation: isolate; }
    .service-detail__shade { position: absolute; inset: 0; z-index: 1; background: linear-gradient(90deg, rgba(0, 0, 0, .9) 0%, rgba(0, 0, 0, .5) 48%, rgba(0, 0, 0, .82) 100%), linear-gradient(180deg, rgba(0, 0, 0, .06) 0%, rgba(0, 0, 0, .8) 100%); }
    .service-detail--videoclips .service-detail__shade { background: linear-gradient(90deg, rgba(0, 0, 0, .86) 0%, rgba(0, 0, 0, .42) 48%, rgba(0, 0, 0, .88) 100%), linear-gradient(180deg, rgba(0, 0, 0, .1) 0%, rgba(0, 0, 0, .82) 100%); }
    .service-detail__stage { position: relative; z-index: 2; min-height: 0; display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(320px, .55fr); gap: clamp(1rem, 3vw, 3rem); align-items: center; padding-bottom: clamp(4.5rem, 11vh, 7rem); }
    .service-detail__hero { display: grid; align-content: end; gap: clamp(.55rem, 1.2vh, .9rem); max-width: 980px; }
    .service-detail__back { width: max-content; color: inherit; text-decoration: none; font-size: .68rem; font-weight: 800; letter-spacing: .02em; text-transform: uppercase; opacity: .78; }
    .service-detail__back:hover, .service-detail__back:focus-visible { opacity: 1; text-decoration: underline; text-underline-offset: 4px; }
    .service-detail__kicker { margin: 0; color: rgba(255, 255, 255, .74); font-size: clamp(.72rem, 1vw, .9rem); font-weight: 850; text-transform: uppercase; }
    .service-detail--cinematic h1 { display: grid; gap: .035em; margin: 0; font-family: var(--font-display); font-size: clamp(4.8rem, 10vw, min(11rem, 21vh)); font-weight: 400; line-height: .86; text-transform: uppercase; }
    .service-detail--cinematic h1 span { display: block; }
    .service-detail__description { max-width: 720px; margin: 0; color: rgba(255, 255, 255, .84); font-size: clamp(.98rem, 1.35vw, 1.25rem); line-height: 1.35; }
    .service-detail__brief { display: grid; gap: .85rem; padding: clamp(1rem, 2vw, 1.35rem) 0 clamp(1rem, 2vw, 1.35rem) clamp(1rem, 2vw, 1.6rem); border-left: 1px solid rgba(255, 255, 255, .28); }
    .service-detail__brief-label { margin: 0; color: rgba(255, 255, 255, .55); font-size: .65rem; font-weight: 850; text-transform: uppercase; }
    .service-detail__brief h2 { max-width: 420px; margin: 0; font-size: clamp(1.45rem, 2.4vw, 2.5rem); font-weight: 900; line-height: .98; text-transform: uppercase; }
    .service-detail__actions { display: flex; flex-wrap: wrap; gap: .55rem; }
    .service-detail__actions a, .service-detail__actions button { min-height: 44px; display: inline-flex; align-items: center; justify-content: center; padding: 0 1rem; color: #000; background: #fff; border: 1px solid #fff; border-radius: 999px; text-decoration: none; font: inherit; font-size: .75rem; font-weight: 900; text-transform: uppercase; cursor: pointer; transition: color 160ms ease, background 160ms ease, transform 160ms ease; }
    .service-detail__actions a:hover, .service-detail__actions button:hover, .service-detail__actions a:focus-visible, .service-detail__actions button:focus-visible { color: #fff; background: #000; transform: translateY(-2px); }
    .service-detail__actions .service-detail__whatsapp { color: #fff; background: #25d366; border-color: #25d366; }
    .service-detail__notes { position: absolute; right: clamp(1rem, 4vw, 4rem); bottom: clamp(.7rem, 1.4vh, 1rem); left: clamp(1rem, 4vw, 4rem); z-index: 2; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; border: 1px solid rgba(255, 255, 255, .24); background: rgba(255, 255, 255, .2); }
    .service-detail__notes span { min-height: 58px; display: grid; place-items: center; padding: .65rem; color: rgba(255, 255, 255, .82); background: rgba(0, 0, 0, .55); font-size: .7rem; font-weight: 850; text-align: center; text-transform: uppercase; backdrop-filter: blur(14px); }
    .service-detail__notes--accordion { display: flex; gap: .75rem; align-items: stretch; border: 0; background: transparent; }
    .service-detail__note {
        flex: 1 1 0;
        min-height: 86px;
        display: grid;
        align-content: end;
        color: rgba(255, 255, 255, .82);
        background: linear-gradient(180deg, rgba(255, 255, 255, .075), rgba(0, 0, 0, .68));
        border: 1px solid rgba(255, 255, 255, .24);
        backdrop-filter: blur(16px);
        overflow: hidden;
        transition: flex 240ms ease, background 180ms ease, border-color 180ms ease;
    }
    .service-detail__note[open] { flex-grow: 1.25; background: linear-gradient(180deg, rgba(255, 255, 255, .12), rgba(0, 0, 0, .82)); border-color: rgba(255, 255, 255, .44); }
    .service-detail__note summary { position: relative; min-height: 84px; display: grid; place-items: center; padding: .95rem 2.3rem; font-size: clamp(1rem, 1.25vw, 1.35rem); font-weight: 950; line-height: .95; text-align: center; text-transform: uppercase; cursor: pointer; list-style: none; }
    .service-detail__note summary::after { content: "+"; position: absolute; right: 1rem; top: 50%; color: rgba(255, 255, 255, .62); font-size: 1.25rem; line-height: 1; transform: translateY(-50%); }
    .service-detail__note[open] summary::after { content: "-"; }
    .service-detail__note summary::-webkit-details-marker { display: none; }
    .service-detail__note p { max-width: 620px; margin: 0; padding: 0 1rem 1rem; color: rgba(255, 255, 255, .72); font-size: .84rem; line-height: 1.42; }
    .service-detail__after { display: grid; gap: clamp(2rem, 5vw, 4rem); align-items: start; padding: 0 0 clamp(3rem, 6vh, 4.8rem); color: #000; background: #fff; }
    .service-detail__after--no-projects {
        padding-top: clamp(4.5rem, 10vh, 7rem);
    }
    .service-detail__after-content > :global(.service-faqs) { margin-inline: clamp(1rem, 4vw, 4rem); }
    .service-detail__after-content { display: grid; gap: clamp(2rem, 5vw, 4rem); }
    .service-detail__seo-block {
        display: grid;
        grid-template-columns: minmax(0, .92fr) minmax(320px, .8fr);
        gap: clamp(1.2rem, 4vw, 4rem);
        align-items: center;
        padding: clamp(4rem, 8vh, 6rem) clamp(1rem, 4vw, 4.5rem) 0;
        color: #080808;
        background: #fff;
    }
    .service-detail__seo-copy { display: grid; gap: 1rem; }
    .service-detail__seo-copy > p { margin: 0; color: rgba(8, 8, 8, .52); font-size: .72rem; font-weight: 850; text-transform: uppercase; }
    .service-detail__seo-copy h2 { max-width: 760px; margin: 0; font-size: clamp(2.2rem, 5.4vw, 5.8rem); font-weight: 950; line-height: .88; text-transform: uppercase; }
    .service-detail__seo-copy div { display: grid; gap: .85rem; max-width: 700px; color: rgba(8, 8, 8, .7); font-size: clamp(1rem, 1.3vw, 1.16rem); line-height: 1.46; }
    .service-detail__seo-copy div p { margin: 0; }
    .service-detail__seo-video { position: relative; aspect-ratio: 16 / 9; margin: 0; overflow: hidden; background: #050505; border: 1px solid rgba(0, 0, 0, .14); }
    .service-detail__related {
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
        gap: 1.2rem;
        min-height: auto;
        padding: clamp(4rem, 8vh, 6rem) clamp(1rem, 4vw, 4.5rem);
        color: #fff;
        background: #080808;
    }
    .service-detail__related-heading h2 {
        margin: 0;
        font-size: clamp(2.2rem, 4.6vw, 5.2rem);
        font-weight: 950;
        line-height: .9;
        text-transform: uppercase;
    }
    .service-detail__related-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1px;
        min-height: 0;
        background: rgba(255, 255, 255, .2);
        border: 1px solid rgba(255, 255, 255, .2);
    }
    .service-detail__related-item {
        position: relative;
        aspect-ratio: 16 / 9;
        min-height: 0;
        display: grid;
        align-content: end;
        padding: .9rem;
        color: #fff;
        text-decoration: none;
        overflow: hidden;
        background: #050505;
    }
    .service-detail__related-item::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 1;
        background: linear-gradient(180deg, transparent, rgba(0, 0, 0, .82));
    }
    .service-detail__related-item > img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .service-detail__related-item span {
        position: relative;
        z-index: 2;
        color: #fff;
        font-size: clamp(.9rem, 1.3vw, 1.1rem);
        font-weight: 950;
        line-height: .98;
        text-transform: uppercase;
        text-shadow: 0 2px 18px rgba(0, 0, 0, .7);
    }
    .service-detail__related-item :global(.video-background) {
        filter: grayscale(1) contrast(1.06);
        transition: filter 500ms ease, transform 500ms ease;
    }
    .service-detail__related-item:hover :global(.video-background),
    .service-detail__related-item:focus-visible :global(.video-background) {
        filter: grayscale(0) contrast(1.06);
        transform: scale(1.04);
    }
    .service-detail__after :global(.service-faqs) { margin-block: 0; }
    .service-detail__after :global(.service-faqs h2) { margin-bottom: 1rem; font-family: inherit; font-size: .82rem; font-weight: 850; text-transform: uppercase; }

    @media (max-width: 940px) {
        .service-detail--cinematic { height: auto; min-height: 100svh; overflow: visible; }
        .service-detail__stage { grid-template-columns: 1fr; }
        .service-detail__brief { padding: 1rem 0 0; border-top: 1px solid rgba(255, 255, 255, .28); border-left: 0; }
        .service-detail__seo-block { grid-template-columns: 1fr; }
        .service-detail__related-grid { grid-template-columns: 1fr; }
    }

    @media (max-width: 700px) {
        .service-detail--cinematic { padding: 6rem 1rem 1rem; }
        .service-detail--cinematic h1 {
            display: grid;
            gap: .08em;
            font-size: clamp(3.5rem, 17vw, 5.6rem);
            line-height: .94;
        }
        .service-detail__stage { padding-bottom: 2rem; }
        .service-detail__notes {
            position: relative;
            inset: auto;
            grid-template-columns: 1fr;
        }
        .service-detail__notes--accordion { flex-direction: column; gap: .5rem; }
        .service-detail__note { flex: none; width: 100%; min-height: 72px; }
        .service-detail__note summary { min-height: 70px; }
        .service-detail__related { min-height: auto; padding-block: 3rem; }
        .service-detail__related-item { min-height: 0; }
    }

    @media (prefers-reduced-motion: reduce) {
        .service-detail__related-item :global(.video-background) {
            transition: none;
        }
    }
</style>
