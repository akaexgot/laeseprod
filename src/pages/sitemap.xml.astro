---
/**
 * Dynamic Sitemap
 * Auto-generates sitemap.xml from database
 */
import { getProjects, getServices, getSectors } from "../lib/data";

const site = import.meta.env.SITE || "https://videomarketingsevilla.es";

const projects = await getProjects();
const services = await getServices();
const sectors = await getSectors();

// Static pages
const staticPages = [
    { url: "/", priority: "1.0", changefreq: "weekly" },
    { url: "/proyectos", priority: "0.9", changefreq: "weekly" },
    { url: "/servicios", priority: "0.9", changefreq: "monthly" },
    { url: "/sectores", priority: "0.9", changefreq: "monthly" },
    { url: "/quienes-somos", priority: "0.8", changefreq: "monthly" },
    { url: "/contacto", priority: "0.8", changefreq: "monthly" },
];

// Dynamic pages
const projectPages = projects.map((p: any) => ({
    url: `/proyectos/${p.slug}`,
    priority: "0.7",
    changefreq: "monthly",
    lastmod: p.updated_at || p.created_at,
}));

const servicePages = services.map((s: any) => ({
    url: `/servicios/${s.slug}`,
    priority: "0.8",
    changefreq: "monthly",
    lastmod: s.updated_at || s.created_at,
}));

const sectorPages = sectors.map((s: any) => ({
    url: `/sectores/${s.slug}`,
    priority: "0.8",
    changefreq: "monthly",
    lastmod: s.updated_at || s.created_at,
}));

const allPages = [
    ...staticPages,
    ...projectPages,
    ...servicePages,
    ...sectorPages,
];

const today = new Date().toISOString().split("T")[0];

const xml = `<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
${allPages
    .map(
        (page) => `  <url>
    <loc>${site}${page.url}</loc>
    <lastmod>${(page as any).lastmod ? new Date((page as any).lastmod).toISOString().split("T")[0] : today}</lastmod>
    <changefreq>${page.changefreq}</changefreq>
    <priority>${page.priority}</priority>
  </url>`,
    )
    .join("\n")}
</urlset>`;
---

<Fragment set:html={xml} />
