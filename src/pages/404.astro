---
import BaseLayout from "../layouts/BaseLayout.astro";
import VideoBackground from "../components/ui/VideoBackground.astro";
import { getSettings } from "../lib/data";

const settings = await getSettings();
---

<BaseLayout title="404 - Página no encontrada" description="La página que buscas no existe en LaeseProd S.L." noindex={true}>
    <section class="not-found">
        <VideoBackground
            desktop={settings.hero_video_desktop || settings.contact_hero_video}
            mobile={settings.hero_video_mobile || settings.hero_video_desktop || settings.contact_hero_video}
            title="Fondo 404"
            overlay="none"
        />
        <div class="not-found__shade" aria-hidden="true"></div>

        <div class="not-found__content">
            <p class="not-found__kicker">Error 404</p>
            <h1><span>Fuera</span><span>de plano</span></h1>
            <p class="not-found__text">La página que buscas no existe, ha cambiado de ruta o se ha quedado fuera del montaje final.</p>
        </div>

        <aside class="not-found__panel" aria-label="Rutas recomendadas">
            <p>Volver a escena</p>
            <nav>
                <a href="/">Inicio</a>
                <a href="/proyectos">Proyectos</a>
                <a href="/servicios">Servicios</a>
                <a href="/contacto">Contacto</a>
            </nav>
        </aside>
    </section>
</BaseLayout>

<style>
    .not-found { position: relative; min-height: 100svh; display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, 420px); gap: clamp(1rem, 4vw, 4rem); align-items: center; padding: clamp(6rem, 10vh, 7rem) clamp(1rem, 5vw, 5rem) clamp(1rem, 4vh, 3rem); color: #fff; background: #000; overflow: hidden; isolation: isolate; }
    .not-found__shade { position: absolute; inset: 0; z-index: 1; background: linear-gradient(90deg, rgba(0,0,0,.88), rgba(0,0,0,.5) 48%, rgba(0,0,0,.84)), linear-gradient(180deg, rgba(0,0,0,.08), rgba(0,0,0,.78)); }
    .not-found__content, .not-found__panel { position: relative; z-index: 2; }
    .not-found__content { display: grid; gap: .9rem; max-width: 920px; }
    .not-found__kicker { margin: 0; color: rgba(255,255,255,.62); font-size: .72rem; font-weight: 850; text-transform: uppercase; }
    .not-found h1 { margin: 0; font-family: var(--font-display); font-size: clamp(5rem, 13vw, min(14rem, 24vh)); font-weight: 400; line-height: .82; text-transform: uppercase; }
    .not-found h1 span { display: block; }
    .not-found__text { max-width: 620px; margin: 0; color: rgba(255,255,255,.78); font-size: clamp(1rem, 1.5vw, 1.35rem); line-height: 1.38; }
    .not-found__panel { display: grid; gap: 1rem; padding: clamp(1rem, 2vw, 1.4rem) 0 clamp(1rem, 2vw, 1.4rem) clamp(1rem, 2vw, 1.5rem); border-left: 1px solid rgba(255,255,255,.28); }
    .not-found__panel p { margin: 0; color: rgba(255,255,255,.58); font-size: .68rem; font-weight: 850; text-transform: uppercase; }
    .not-found__panel nav { display: grid; gap: .6rem; }
    .not-found__panel a { min-height: 44px; display: inline-flex; align-items: center; width: fit-content; padding: 0 1rem; color: #000; background: #fff; border: 1px solid #fff; border-radius: 999px; text-decoration: none; font-size: .76rem; font-weight: 900; text-transform: uppercase; transition: color 160ms ease, background 160ms ease, transform 160ms ease; }
    .not-found__panel a:hover, .not-found__panel a:focus-visible { color: #fff; background: #000; transform: translateY(-2px); }

    @media (max-width: 820px) {
        .not-found { grid-template-columns: 1fr; align-items: end; }
        .not-found__panel { padding: 1rem 0 0; border-top: 1px solid rgba(255,255,255,.28); border-left: 0; }
        .not-found__panel nav { display: flex; flex-wrap: wrap; }
    }

    @media (max-width: 560px) {
        .not-found { padding-bottom: 6rem; }
        .not-found h1 { font-size: clamp(4rem, 20vw, 6rem); }
    }
</style>
