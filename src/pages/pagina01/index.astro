---
import { Play } from "@lucide/astro";
import ConceptLayout from "../../layouts/ConceptLayout.astro";
import Navbar from "../../components/ui/Navbar.astro";
import VideoBackground from "../../components/ui/VideoBackground.astro";
import { getSettings } from "../../lib/data";

const settings = await getSettings();
const fallbackVideo = "https://www.youtube.com/watch?v=D91q99QK11k";
const desktopVideo = settings.hero_video_desktop || fallbackVideo;
const mobileVideo = settings.hero_video_mobile || desktopVideo;
---

<ConceptLayout
    concept={1}
    title="Concepto 01 — Director's Cut"
    description="Propuesta cinematográfica editorial para el hero de LaesePROD."
>
    <Navbar />

    <section class="director-hero" aria-labelledby="director-title">
        <VideoBackground desktop={desktopVideo} mobile={mobileVideo} title="Showreel de LaesePROD" overlay="none" />
        <div class="director-hero__grade" aria-hidden="true"></div>
        <div class="director-hero__grain" aria-hidden="true"></div>

        <a class="director-brand" href="/" aria-label="LaesePROD, inicio">
            <img src="/logopositivo.png" alt="LaesePROD — Vídeo y visual art" width="1992" height="669" />
        </a>

        <div class="director-hero__frame" aria-hidden="true">
            <span class="corner corner--tl"></span>
            <span class="corner corner--tr"></span>
            <span class="corner corner--bl"></span>
            <span class="corner corner--br"></span>
        </div>

        <div class="director-hero__meta director-hero__meta--left" aria-hidden="true">
            <span class="rec-dot"></span>
            <span>REC 00:00:01:24</span>
        </div>
        <div class="director-hero__meta director-hero__meta--right" aria-hidden="true">
            <span>4K RAW</span>
            <span>25 FPS</span>
        </div>

        <div class="director-hero__content">
            <p class="director-hero__kicker"><span>01</span> Productora audiovisual · Sevilla</p>
            <h1 id="director-title">
                Historias que<br />
                <em>se sienten</em> reales.
            </h1>
            <div class="director-hero__footer">
                <p>Creamos películas de boda y videoclips con pulso, intención y una mirada que permanece.</p>
            </div>
        </div>

        <a class="director-play" href="/proyectos" aria-label="Reproducir showreel">
            <span><Play size={20} fill="currentColor" stroke-width={1.5} /></span>
            <small>Showreel · 01:47</small>
        </a>
    </section>
</ConceptLayout>

<style>
    .director-hero {
        position: relative;
        min-height: 100svh;
        overflow: hidden;
        isolation: isolate;
        color: #fff;
        background: #050505;
        font-family: Arial, Helvetica, sans-serif;
    }

    .director-hero__grade,
    .director-hero__grain {
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
    }

    .director-hero__grade {
        background:
            linear-gradient(90deg, rgba(0, 0, 0, .83) 0%, rgba(0, 0, 0, .5) 42%, rgba(0, 0, 0, .08) 72%),
            linear-gradient(180deg, rgba(0, 0, 0, .58) 0%, transparent 30%, transparent 66%, rgba(0, 0, 0, .7) 100%);
    }

    .director-hero__grain {
        opacity: .13;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.92' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.5'/%3E%3C/svg%3E");
        mix-blend-mode: soft-light;
    }

    .director-brand {
        position: absolute;
        z-index: 9;
        top: 18px;
        left: clamp(24px, 3.2vw, 52px);
        width: clamp(128px, 10vw, 158px);
        color: #fff;
        text-decoration: none;
        animation: director-fade 900ms ease 200ms both;
        transition: transform 400ms cubic-bezier(.16, 1, .3, 1);
    }

    .director-brand:hover {
        transform: translateY(-2px) scale(1.025);
    }

    .director-brand img {
        width: 100%;
        height: auto;
        object-fit: contain;
    }

    .director-hero__frame {
        position: absolute;
        z-index: 2;
        inset: 102px clamp(22px, 3vw, 46px) clamp(22px, 3vw, 46px);
        pointer-events: none;
    }

    .corner {
        position: absolute;
        width: 34px;
        height: 34px;
        border-color: rgba(255, 255, 255, .52);
        border-style: solid;
    }

    .corner--tl { top: 0; left: 0; border-width: 1px 0 0 1px; }
    .corner--tr { top: 0; right: 0; border-width: 1px 1px 0 0; }
    .corner--bl { bottom: 0; left: 0; border-width: 0 0 1px 1px; }
    .corner--br { right: 0; bottom: 0; border-width: 0 1px 1px 0; }

    .director-hero__meta {
        position: absolute;
        z-index: 4;
        top: 126px;
        display: flex;
        align-items: center;
        gap: 12px;
        color: rgba(255, 255, 255, .68);
        font-family: "Courier New", monospace;
        font-size: 9px;
        letter-spacing: .13em;
    }

    .director-hero__meta--left { left: clamp(34px, 4vw, 68px); }
    .director-hero__meta--right { right: clamp(34px, 4vw, 68px); }
    .rec-dot { width: 7px; height: 7px; background: #ff3b1f; border-radius: 50%; box-shadow: 0 0 14px #ff3b1f; animation: rec-pulse 1.5s ease infinite; }

    .director-hero__content {
        position: relative;
        z-index: 3;
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 150px clamp(34px, 6.6vw, 110px) clamp(76px, 9vh, 110px);
    }

    .director-hero__kicker {
        display: flex;
        align-items: center;
        gap: 15px;
        margin: 0 0 18px;
        color: rgba(255, 255, 255, .72);
        font-size: clamp(9px, .7vw, 11px);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .16em;
        animation: director-rise 800ms cubic-bezier(.16, 1, .3, 1) 300ms both;
    }

    .director-hero__kicker span {
        display: inline-grid;
        width: 32px;
        height: 32px;
        place-items: center;
        color: #0a0a0a;
        background: #ff3b1f;
        border-radius: 50%;
    }

    .director-hero h1 {
        max-width: 1050px;
        margin: 0;
        font-family: Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
        font-size: clamp(4.6rem, 9.4vw, 10.6rem);
        font-weight: 400;
        line-height: .79;
        text-transform: uppercase;
        letter-spacing: -.035em;
        text-wrap: balance;
        animation: director-title 1100ms cubic-bezier(.16, 1, .3, 1) 130ms both;
    }

    .director-hero h1 em {
        color: transparent;
        -webkit-text-stroke: 1.5px rgba(255, 255, 255, .92);
        font-style: normal;
    }

    .director-hero__footer {
        max-width: 450px;
        margin-top: clamp(24px, 4vh, 48px);
        animation: director-rise 900ms cubic-bezier(.16, 1, .3, 1) 600ms both;
    }

    .director-hero__footer > p {
        width: min(100%, 450px);
        margin: 0;
        color: rgba(255, 255, 255, .72);
        font-size: clamp(14px, 1vw, 17px);
        line-height: 1.45;
    }

    .director-play {
        position: absolute;
        z-index: 5;
        right: clamp(50px, 9vw, 160px);
        top: 48%;
        display: grid;
        justify-items: center;
        gap: 12px;
        color: #fff;
        text-decoration: none;
        transform: translateY(-50%);
        animation: director-fade 900ms ease 900ms both;
    }

    .director-play > span {
        position: relative;
        width: clamp(82px, 8vw, 116px);
        height: clamp(82px, 8vw, 116px);
        display: grid;
        place-items: center;
        color: #111;
        background: rgba(255, 255, 255, .92);
        border-radius: 50%;
        transition: color 220ms ease, background 220ms ease, transform 400ms cubic-bezier(.16, 1, .3, 1);
    }

    .director-play > span::before {
        content: "";
        position: absolute;
        inset: -10px;
        border: 1px solid rgba(255, 255, 255, .4);
        border-radius: inherit;
        transition: inset 400ms cubic-bezier(.16, 1, .3, 1), opacity 300ms ease;
    }

    .director-play:hover > span {
        color: #fff;
        background: #ff3b1f;
        transform: scale(1.06);
    }

    .director-play:hover > span::before { inset: -18px; opacity: .5; }

    .director-play small {
        font-size: 9px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .13em;
    }

    @keyframes director-title {
        from { opacity: 0; transform: translateY(80px); clip-path: inset(0 0 100%); }
        to { opacity: 1; transform: translateY(0); clip-path: inset(0); }
    }

    @keyframes director-rise {
        from { opacity: 0; transform: translateY(28px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @keyframes director-fade {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @keyframes rec-pulse {
        50% { opacity: .35; }
    }

    @media (max-width: 900px) {
        .director-play { right: 48px; top: 37%; }
    }

    @media (max-width: 640px) {
        .director-hero__grade {
            background: linear-gradient(180deg, rgba(0, 0, 0, .55), rgba(0, 0, 0, .22) 32%, rgba(0, 0, 0, .86) 72%);
        }

        .director-brand {
            position: fixed;
            z-index: 61;
            top: 24px;
            left: 16px;
            width: 112px;
        }
        .director-hero__frame { inset: 82px 12px 64px; }
        .director-hero__meta { top: 98px; }
        .director-hero__meta--left { left: 26px; }
        .director-hero__meta--right { display: none; }
        .director-hero__content { padding: 230px 24px 118px; }
        .director-hero__kicker { margin-bottom: 13px; }
        .director-hero h1 { font-size: clamp(4.25rem, 19.5vw, 7rem); line-height: .82; }
        .director-hero h1 em { -webkit-text-stroke-width: 1px; }
        .director-hero__footer { margin-top: 22px; }
        .director-hero__footer > p { max-width: 340px; font-size: 13px; }
        .director-play { top: 20%; right: 28px; }
        .director-play > span { width: 62px; height: 62px; }
        .director-play small { display: none; }
    }
</style>

<style is:global>
    .concept-page--01 .site-nav__brand {
        display: none !important;
    }

    @media (min-width: 1081px) {
        .concept-page--01 .site-nav {
            width: 620px;
            display: flex;
            justify-content: center;
            gap: 14px;
            padding: 0 10px 0 18px;
        }

        .concept-page--01 .site-nav__desktop {
            position: static;
            top: auto;
            bottom: auto;
            left: auto;
            flex: 0 0 auto;
            transform: none;
        }

        .concept-page--01 .site-nav__actions {
            flex: 0 0 auto;
            justify-self: auto;
        }
    }

    @media (max-width: 1080px) {
        .concept-page--01 .site-header {
            justify-content: flex-end;
        }

        .concept-page--01 .site-nav {
            width: 126px;
            grid-template-columns: 1fr;
            padding: 0 10px;
        }

        .concept-page--01 .site-nav__actions {
            grid-column: 1;
            justify-self: end;
        }
    }
</style>
