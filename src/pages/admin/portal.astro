---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getPortalClientsAdmin } from "../../lib/data";

const clients = await getPortalClientsAdmin();
---

<AdminLayout title="Portal Clientes" activeSection="portal">
    <header class="portal-admin-header">
        <div>
            <p class="portal-admin-kicker">Accesos privados</p>
            <h1>Portal Clientes</h1>
            <p>Crea codigos que desbloquean una carpeta de Dropbox para cada cliente.</p>
        </div>
        <button id="btn-add-client" class="portal-primary-button" type="button">
            <i data-lucide="plus" class="w-4 h-4"></i>
            Nuevo cliente
        </button>
    </header>

    <section class="portal-table-shell">
        <div class="portal-table-meta">
            <span>{clients.length} {clients.length === 1 ? "cliente" : "clientes"}</span>
            <span>Arrastra para ordenar</span>
        </div>

        <div class="portal-table-wrap">
            <table id="clients-table" class="portal-table">
                <thead>
                    <tr>
                        <th></th>
                        <th>Cliente</th>
                        <th>Dropbox</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {clients.length === 0 ? (
                        <tr>
                            <td colspan="5" class="portal-empty">No hay clientes aun. Pulsa "Nuevo cliente" para empezar.</td>
                        </tr>
                    ) : (
                        clients.map((client: any) => (
                            <tr class="drag-row" data-id={client.id} draggable="true">
                                <td>
                                    <button class="drag-handle" type="button" title="Arrastrar para ordenar" aria-label="Arrastrar para ordenar">
                                        <i data-lucide="grip-vertical" class="w-4 h-4"></i>
                                    </button>
                                </td>
                                <td>
                                    <button
                                        class="portal-client-button btn-edit"
                                        type="button"
                                        data-id={client.id}
                                        data-name={client.client_name}
                                        data-dropbox={client.dropbox_link || ""}
                                        data-active={client.is_active ? "true" : "false"}
                                    >
                                        <span>{client.client_name.charAt(0)}</span>
                                        <strong>{client.client_name}</strong>
                                    </button>
                                </td>
                                <td>
                                    {client.dropbox_link ? (
                                        <a class="portal-dropbox-link" href={client.dropbox_link} target="_blank" rel="noopener noreferrer">
                                            Configurado
                                            <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                                        </a>
                                    ) : (
                                        <span class="portal-warning">Sin enlace</span>
                                    )}
                                </td>
                                <td>
                                    <span class:list={["portal-state", client.is_active ? "is-active" : "is-inactive"]}>
                                        <span></span>
                                        {client.is_active ? "Activo" : "Inactivo"}
                                    </span>
                                </td>
                                <td>
                                    <div class="portal-actions">
                                        <button
                                            class="portal-icon-button btn-edit"
                                            type="button"
                                            title="Editar"
                                            data-id={client.id}
                                            data-name={client.client_name}
                                            data-dropbox={client.dropbox_link || ""}
                                            data-active={client.is_active ? "true" : "false"}
                                        >
                                            <i data-lucide="edit-3" class="w-4 h-4"></i>
                                        </button>
                                        <button class="portal-icon-button btn-delete" type="button" title="Eliminar" data-id={client.id}>
                                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        ))
                    )}
                </tbody>
            </table>
        </div>
    </section>

    <div id="modal-overlay" class="portal-modal hidden" aria-hidden="true">
        <div class="portal-modal__backdrop"></div>
        <div class="portal-modal__panel" role="dialog" aria-modal="true" aria-labelledby="modal-title">
            <div class="portal-modal__header">
                <div>
                    <p id="modal-kicker">Nuevo acceso</p>
                    <h2 id="modal-title">Nuevo cliente</h2>
                </div>
                <button id="modal-close-icon" class="portal-icon-button" type="button" aria-label="Cerrar">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <input type="hidden" id="client-id" />

            <div class="portal-modal__body">
                <label class="portal-field">
                    <span>Nombre del cliente</span>
                    <input type="text" id="c-name" placeholder="Ej: Maria y Jose" autocomplete="off" />
                </label>

                <label class="portal-field">
                    <span>Codigo de acceso</span>
                    <div class="portal-password">
                        <input type="password" id="c-password" placeholder="Codigo privado" autocomplete="new-password" />
                        <button type="button" id="btn-toggle-pw" aria-label="Mostrar u ocultar codigo">
                            <i data-lucide="eye" class="w-4 h-4" data-eye></i>
                            <i data-lucide="eye-off" class="w-4 h-4 hidden" data-eye-off></i>
                        </button>
                    </div>
                    <small id="pw-hint">Se pedira este codigo para abrir el Dropbox.</small>
                </label>

                <label class="portal-field">
                    <span>Enlace de Dropbox</span>
                    <input type="url" id="c-dropbox" placeholder="https://dropbox.com/..." />
                </label>

                <label class="portal-check">
                    <input type="checkbox" id="c-active" checked />
                    <span>Acceso activo</span>
                </label>

                <p id="modal-error" class="portal-error hidden"></p>
            </div>

            <div class="portal-modal__footer">
                <button type="button" id="modal-delete" class="portal-danger-button hidden">Eliminar</button>
                <button type="button" id="modal-cancel" class="portal-secondary-button">Cancelar</button>
                <button type="button" id="modal-save" class="portal-primary-button">Guardar</button>
            </div>
        </div>
    </div>

    <div id="confirm-overlay" class="portal-confirm hidden" aria-hidden="true">
        <div class="portal-modal__backdrop"></div>
        <div class="portal-confirm__panel" role="dialog" aria-modal="true">
            <div class="portal-confirm__icon">
                <i data-lucide="triangle-alert" class="w-7 h-7"></i>
            </div>
            <h2>Eliminar cliente</h2>
            <p>Esta accion no se puede deshacer. El codigo dejara de funcionar.</p>
            <div class="portal-confirm__actions">
                <button id="confirm-cancel" class="portal-secondary-button" type="button">Cancelar</button>
                <button id="confirm-yes" class="portal-danger-fill-button" type="button">Eliminar</button>
            </div>
        </div>
    </div>

    <div id="toast-container" class="portal-toast-container"></div>
</AdminLayout>

<style>
    .portal-admin-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 1.5rem; margin-bottom: 2rem; padding-bottom: 1.4rem; border-bottom: 1px solid rgba(255,255,255,.08); }
    .portal-admin-kicker { margin: 0 0 .45rem; color: #8b8b92; font-size: .68rem; font-weight: 850; text-transform: uppercase; letter-spacing: .08em; }
    .portal-admin-header h1 { margin: 0; color: #fff; font-size: clamp(1.8rem, 3vw, 2.6rem); line-height: .95; }
    .portal-admin-header p:not(.portal-admin-kicker) { margin: .65rem 0 0; max-width: 58ch; color: #a1a1aa; font-size: .92rem; }
    .portal-primary-button, .portal-secondary-button, .portal-danger-button, .portal-danger-fill-button { min-height: 42px; display: inline-flex; align-items: center; justify-content: center; gap: .55rem; padding: 0 1rem; border-radius: 999px; font: inherit; font-size: .78rem; font-weight: 900; text-transform: uppercase; cursor: pointer; transition: color 160ms ease, background 160ms ease, border-color 160ms ease, transform 160ms ease; }
    .portal-primary-button { color: #000; background: #fff; border: 1px solid #fff; }
    .portal-primary-button:hover, .portal-primary-button:focus-visible { color: #fff; background: #000; transform: translateY(-1px); }
    .portal-secondary-button { color: #e4e4e7; background: #18181b; border: 1px solid #3f3f46; }
    .portal-secondary-button:hover, .portal-secondary-button:focus-visible { color: #000; background: #fff; border-color: #fff; }
    .portal-danger-button { color: #fb7185; background: transparent; border: 1px solid rgba(251,113,133,.3); margin-right: auto; }
    .portal-danger-button:hover, .portal-danger-button:focus-visible, .portal-danger-fill-button { color: #fff; background: #dc2626; border: 1px solid #dc2626; }
    .portal-table-shell { background: #101012; border: 1px solid #27272a; border-radius: 16px; overflow: hidden; box-shadow: 0 18px 44px rgba(0,0,0,.22); }
    .portal-table-meta { min-height: 50px; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0 1rem; color: #8b8b92; border-bottom: 1px solid #27272a; font-size: .72rem; font-weight: 850; text-transform: uppercase; letter-spacing: .06em; }
    .portal-table-wrap { overflow-x: auto; }
    .portal-table { width: 100%; min-width: 760px; border-collapse: collapse; color: #e4e4e7; font-size: .9rem; }
    .portal-table th { padding: 1rem; color: #71717a; background: rgba(255,255,255,.015); font-size: .68rem; font-weight: 900; text-align: left; text-transform: uppercase; letter-spacing: .08em; }
    .portal-table th:first-child, .portal-table td:first-child { width: 48px; text-align: center; }
    .portal-table th:last-child, .portal-table td:last-child { text-align: right; }
    .portal-table td { padding: 1rem; border-top: 1px solid rgba(255,255,255,.07); vertical-align: middle; }
    .portal-table tr { transition: background 160ms ease, box-shadow 160ms ease; }
    .portal-table tbody tr:hover { background: rgba(255,255,255,.035); }
    .portal-table .drag-row.drag-over { background: rgba(255,255,255,.07); box-shadow: inset 0 -2px 0 #fff; }
    .drag-handle, .portal-icon-button { width: 36px; height: 36px; display: inline-grid; place-items: center; color: #a1a1aa; background: #111113; border: 1px solid #303036; border-radius: 10px; cursor: pointer; transition: color 160ms ease, background 160ms ease, border-color 160ms ease, transform 160ms ease; }
    .drag-handle { cursor: grab; }
    .drag-handle:active { cursor: grabbing; }
    .drag-handle:hover, .portal-icon-button:hover, .portal-icon-button:focus-visible { color: #000; background: #fff; border-color: #fff; transform: translateY(-1px); }
    .portal-client-button { min-width: 0; display: inline-flex; align-items: center; gap: .8rem; width: 100%; color: #fff; background: transparent; border: 0; padding: 0; text-align: left; cursor: pointer; }
    .portal-client-button span { width: 42px; height: 42px; display: grid; place-items: center; flex: 0 0 auto; color: #000; background: #fff; border-radius: 12px; font-weight: 950; }
    .portal-client-button strong { min-width: 0; overflow: hidden; font-size: .96rem; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
    .portal-dropbox-link { display: inline-flex; align-items: center; gap: .4rem; color: #d4d4d8; text-decoration: none; font-weight: 750; }
    .portal-dropbox-link:hover, .portal-dropbox-link:focus-visible { color: #fff; text-decoration: underline; }
    .portal-warning { color: #fbbf24; font-size: .82rem; font-weight: 750; }
    .portal-state { display: inline-flex; align-items: center; gap: .45rem; color: #a1a1aa; font-size: .78rem; font-weight: 800; }
    .portal-state span { width: 9px; height: 9px; border-radius: 999px; background: currentColor; box-shadow: 0 0 12px currentColor; }
    .portal-state.is-active { color: #34d399; }
    .portal-state.is-inactive { color: #fb7185; }
    .portal-actions { display: inline-flex; justify-content: flex-end; gap: .4rem; }
    .portal-empty { padding: 3rem 1rem !important; color: #71717a; text-align: center !important; }
    .portal-modal, .portal-confirm { position: fixed; inset: 0; z-index: 80; display: grid; place-items: center; padding: 1rem; }
    .portal-modal.hidden, .portal-confirm.hidden { display: none; }
    .portal-modal__backdrop { position: absolute; inset: 0; background: rgba(0,0,0,.78); backdrop-filter: blur(12px); }
    .portal-modal__panel, .portal-confirm__panel { position: relative; z-index: 1; width: min(100%, 520px); color: #fff; background: #101012; border: 1px solid #303036; border-radius: 18px; overflow: hidden; box-shadow: 0 26px 90px rgba(0,0,0,.45); }
    .portal-modal__header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.2rem 1.3rem; border-bottom: 1px solid rgba(255,255,255,.08); }
    .portal-modal__header p { margin: 0 0 .3rem; color: #8b8b92; font-size: .65rem; font-weight: 900; text-transform: uppercase; letter-spacing: .08em; }
    .portal-modal__header h2 { margin: 0; font-size: 1.25rem; line-height: 1; }
    .portal-modal__body { display: grid; gap: 1rem; padding: 1.3rem; }
    .portal-field { display: grid; gap: .45rem; color: #a1a1aa; font-size: .72rem; font-weight: 900; text-transform: uppercase; letter-spacing: .04em; }
    .portal-field input { width: 100%; min-height: 46px; padding: .78rem .9rem; color: #fff; background: #09090b; border: 1px solid #3f3f46; border-radius: 10px; outline: none; font: inherit; font-size: .9rem; font-weight: 650; text-transform: none; letter-spacing: 0; transition: border-color 160ms ease, box-shadow 160ms ease; }
    .portal-field input:focus { border-color: #fff; box-shadow: 0 0 0 3px rgba(255,255,255,.08); }
    .portal-field small { color: #71717a; font-size: .72rem; font-weight: 700; text-transform: none; letter-spacing: 0; }
    .portal-password { position: relative; }
    .portal-password input { padding-right: 3rem; }
    .portal-password button { position: absolute; right: .4rem; top: 50%; transform: translateY(-50%); width: 38px; height: 38px; display: grid; place-items: center; color: #a1a1aa; background: transparent; border: 0; border-radius: 999px; cursor: pointer; }
    .portal-password button:hover, .portal-password button:focus-visible { color: #fff; background: #18181b; }
    .portal-check { display: inline-flex; align-items: center; gap: .55rem; color: #e4e4e7; font-size: .86rem; font-weight: 800; cursor: pointer; }
    .portal-check input { width: 17px; height: 17px; accent-color: #fff; }
    .portal-error { margin: 0; color: #fb7185; font-size: .82rem; font-weight: 800; }
    .portal-modal__footer { display: flex; align-items: center; justify-content: flex-end; gap: .75rem; padding: 1rem 1.3rem; background: #09090b; border-top: 1px solid rgba(255,255,255,.08); }
    .portal-confirm__panel { max-width: 360px; display: grid; justify-items: center; gap: .85rem; padding: 1.5rem; text-align: center; }
    .portal-confirm__icon { width: 58px; height: 58px; display: grid; place-items: center; color: #fb7185; background: rgba(251,113,133,.1); border: 1px solid rgba(251,113,133,.22); border-radius: 50%; }
    .portal-confirm__panel h2 { margin: 0; font-size: 1.25rem; }
    .portal-confirm__panel p { margin: 0; color: #a1a1aa; line-height: 1.45; }
    .portal-confirm__actions { width: 100%; display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; margin-top: .4rem; }
    .portal-toast-container { position: fixed; right: 1.5rem; bottom: 1.5rem; z-index: 100; display: grid; gap: .55rem; pointer-events: none; }
    .portal-toast { padding: .85rem 1rem; color: #000; background: #fff; border-radius: 999px; box-shadow: 0 22px 60px rgba(0,0,0,.4); font-size: .84rem; font-weight: 850; }
    @media (max-width: 760px) {
        .portal-admin-header { align-items: stretch; flex-direction: column; }
        .portal-primary-button { width: fit-content; }
        .portal-table { min-width: 620px; }
        .portal-table th:nth-child(3), .portal-table td:nth-child(3) { display: none; }
        .portal-modal__footer { flex-wrap: wrap; }
        .portal-danger-button { width: 100%; margin-right: 0; }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const overlay = document.getElementById('modal-overlay')!;
        const confirmOverlay = document.getElementById('confirm-overlay')!;
        const modalTitle = document.getElementById('modal-title')!;
        const modalKicker = document.getElementById('modal-kicker')!;
        const modalError = document.getElementById('modal-error')!;
        const modalDeleteBtn = document.getElementById('modal-delete')!;
        const saveBtn = document.getElementById('modal-save')!;
        const confirmYes = document.getElementById('confirm-yes')!;
        const $ = (id: string) => document.getElementById(id) as HTMLInputElement;

        let pendingDeleteId: string | null = null;

        function showToast(message: string) {
            const container = document.getElementById('toast-container')!;
            const toast = document.createElement('div');
            toast.className = 'portal-toast';
            toast.textContent = message;
            container.appendChild(toast);
            setTimeout(() => toast.remove(), 2800);
        }

        function showModalError(message: string) {
            modalError.textContent = message;
            modalError.classList.remove('hidden');
        }

        function clearModalError() {
            modalError.textContent = '';
            modalError.classList.add('hidden');
        }

        function openModal(data?: any) {
            const isEdit = Boolean(data);
            modalKicker.textContent = isEdit ? 'Editar acceso' : 'Nuevo acceso';
            modalTitle.textContent = isEdit ? 'Editar cliente' : 'Nuevo cliente';
            $('client-id').value = data?.id || '';
            $('c-name').value = data?.name || '';
            $('c-dropbox').value = data?.dropbox || '';
            $('c-password').value = '';
            $('c-password').type = 'password';
            $('c-active').checked = isEdit ? data.active === 'true' : true;
            document.querySelector('[data-eye]')?.classList.remove('hidden');
            document.querySelector('[data-eye-off]')?.classList.add('hidden');
            document.getElementById('pw-hint')!.textContent = isEdit
                ? 'Dejalo vacio para mantener el codigo actual.'
                : 'Se pedira este codigo para abrir el Dropbox.';
            modalDeleteBtn.classList.toggle('hidden', !isEdit);
            clearModalError();
            overlay.classList.remove('hidden');
            overlay.setAttribute('aria-hidden', 'false');
            window.setTimeout(() => $('c-name').focus(), 80);
        }

        function closeModal() {
            overlay.classList.add('hidden');
            overlay.setAttribute('aria-hidden', 'true');
        }

        function openConfirm(id: string) {
            pendingDeleteId = id;
            confirmYes.textContent = 'Eliminar';
            (confirmYes as HTMLButtonElement).disabled = false;
            confirmOverlay.classList.remove('hidden');
            confirmOverlay.setAttribute('aria-hidden', 'false');
        }

        function closeConfirm() {
            pendingDeleteId = null;
            confirmOverlay.classList.add('hidden');
            confirmOverlay.setAttribute('aria-hidden', 'true');
        }

        document.getElementById('btn-add-client')?.addEventListener('click', () => openModal());
        document.getElementById('modal-cancel')?.addEventListener('click', closeModal);
        document.getElementById('modal-close-icon')?.addEventListener('click', closeModal);
        overlay.querySelector('.portal-modal__backdrop')?.addEventListener('click', closeModal);

        document.querySelectorAll<HTMLElement>('.btn-edit').forEach((button) => {
            button.addEventListener('click', () => {
                openModal({
                    id: button.dataset.id,
                    name: button.dataset.name,
                    dropbox: button.dataset.dropbox,
                    active: button.dataset.active,
                });
            });
        });

        document.querySelectorAll<HTMLElement>('.btn-delete').forEach((button) => {
            button.addEventListener('click', () => openConfirm(button.dataset.id!));
        });

        modalDeleteBtn.addEventListener('click', () => {
            const id = $('client-id').value;
            closeModal();
            if (id) openConfirm(id);
        });

        document.getElementById('confirm-cancel')?.addEventListener('click', closeConfirm);
        confirmOverlay.querySelector('.portal-modal__backdrop')?.addEventListener('click', closeConfirm);

        confirmYes.addEventListener('click', async () => {
            if (!pendingDeleteId) return;
            confirmYes.textContent = 'Eliminando...';
            (confirmYes as HTMLButtonElement).disabled = true;
            try {
                const response = await fetch('/api/admin/portal', {
                    method: 'DELETE',
                    credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: pendingDeleteId }),
                });
                if (!response.ok) throw new Error('delete failed');
                location.reload();
            } catch {
                showToast('No se pudo eliminar.');
                closeConfirm();
            }
        });

        document.getElementById('btn-toggle-pw')?.addEventListener('click', () => {
            const input = $('c-password');
            const isPassword = input.type === 'password';
            input.type = isPassword ? 'text' : 'password';
            document.querySelector('[data-eye]')?.classList.toggle('hidden', isPassword);
            document.querySelector('[data-eye-off]')?.classList.toggle('hidden', !isPassword);
        });

        saveBtn.addEventListener('click', async () => {
            const name = $('c-name').value.trim();
            const code = $('c-password').value.trim();
            const dropbox = $('c-dropbox').value.trim();
            const id = $('client-id').value;
            const isEdit = Boolean(id);

            if (!name) return showModalError('El nombre del cliente es obligatorio.');
            if (!isEdit && !code) return showModalError('El codigo de acceso es obligatorio.');
            if (!dropbox) return showModalError('El enlace de Dropbox es obligatorio.');

            clearModalError();
            const originalText = saveBtn.textContent || 'Guardar';
            saveBtn.textContent = 'Guardando...';
            saveBtn.setAttribute('disabled', 'true');

            const body: any = {
                client_name: name,
                dropbox_link: dropbox,
                is_active: $('c-active').checked,
                image: null,
                image_type: 'logo',
            };
            if (code) body.password_hash = code;
            if (isEdit) body.id = id;

            try {
                const response = await fetch('/api/admin/portal', {
                    method: isEdit ? 'PUT' : 'POST',
                    credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body),
                });
                const result = await response.json().catch(() => ({}));
                if (!response.ok) throw new Error(result.error || 'No se pudo guardar.');
                location.reload();
            } catch (error) {
                showModalError(error instanceof Error ? error.message : 'No se pudo guardar.');
                saveBtn.textContent = originalText;
                saveBtn.removeAttribute('disabled');
            }
        });

        const tbody = document.querySelector('#clients-table tbody') as HTMLTableSectionElement | null;
        if (tbody) {
            let draggedRow: HTMLTableRowElement | null = null;

            tbody.addEventListener('dragstart', (event) => {
                const target = (event.target as HTMLElement).closest('tr.drag-row') as HTMLTableRowElement | null;
                if (!target) return;
                draggedRow = target;
                target.classList.add('opacity-50');
                event.dataTransfer?.setData('text/plain', target.dataset.id || '');
            });

            tbody.addEventListener('dragend', () => {
                draggedRow?.classList.remove('opacity-50');
                draggedRow = null;
                tbody.querySelectorAll('.drag-over').forEach((element) => element.classList.remove('drag-over'));
            });

            tbody.addEventListener('dragover', (event) => {
                event.preventDefault();
                const target = (event.target as HTMLElement).closest('tr.drag-row') as HTMLTableRowElement | null;
                if (!target || target === draggedRow) return;
                tbody.querySelectorAll('.drag-over').forEach((element) => element.classList.remove('drag-over'));
                target.classList.add('drag-over');
            });

            tbody.addEventListener('drop', async (event) => {
                event.preventDefault();
                const target = (event.target as HTMLElement).closest('tr.drag-row') as HTMLTableRowElement | null;
                if (!target || !draggedRow || target === draggedRow) return;

                const rows = Array.from(tbody.querySelectorAll('tr.drag-row'));
                const dragIndex = rows.indexOf(draggedRow);
                const dropIndex = rows.indexOf(target);
                target.parentNode?.insertBefore(draggedRow, dragIndex < dropIndex ? target.nextSibling : target);
                tbody.querySelectorAll('.drag-over').forEach((element) => element.classList.remove('drag-over'));

                const orderedIds = Array.from(tbody.querySelectorAll('tr.drag-row'))
                    .map((row) => (row as HTMLElement).dataset.id)
                    .filter((rowId): rowId is string => Boolean(rowId));

                try {
                    const response = await fetch('/api/admin/portal', {
                        method: 'PATCH',
                        credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ orderedIds }),
                    });
                    showToast(response.ok ? 'Orden actualizado.' : 'No se pudo guardar el orden.');
                } catch {
                    showToast('No se pudo guardar el orden.');
                }
            });
        }
    });
</script>
