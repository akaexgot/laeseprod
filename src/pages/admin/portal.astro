---
/**
 * Admin - Portal Clients Management
 */
import AdminLayout from "../../layouts/AdminLayout.astro";

const clients = [
    {
        id: "1",
        client_name: "Hotel Royal",
        image: "",
        dropbox_link: "https://dropbox.com/home",
        is_active: true,
    },
    {
        id: "2",
        client_name: "Restaurante La Barca",
        image: "",
        dropbox_link: "https://dropbox.com/home",
        is_active: true,
    },
    {
        id: "3",
        client_name: "Abengoa",
        image: "",
        dropbox_link: "",
        is_active: false,
    },
];
---

<AdminLayout title="Portal Clientes" activeSection="portal">
    <div class="flex items-center justify-between mb-6">
        <p class="text-light-muted text-sm">{clients.length} clientes</p>
        <button
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-carmin text-white text-sm font-semibold rounded-xl hover:shadow-glow transition-all duration-300"
        >
            <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 4v16m8-8H4"></path></svg
            >
            Nuevo cliente
        </button>
    </div>

    <div class="glass rounded-2xl overflow-hidden">
        <table class="w-full">
            <thead>
                <tr class="border-b border-dark-border">
                    <th
                        class="text-left px-6 py-3 text-light-subtle text-xs font-medium uppercase tracking-wider"
                        >Cliente</th
                    >
                    <th
                        class="text-left px-6 py-3 text-light-subtle text-xs font-medium uppercase tracking-wider hidden sm:table-cell"
                        >Dropbox</th
                    >
                    <th
                        class="text-left px-6 py-3 text-light-subtle text-xs font-medium uppercase tracking-wider"
                        >Estado</th
                    >
                    <th
                        class="text-right px-6 py-3 text-light-subtle text-xs font-medium uppercase tracking-wider"
                        >Acciones</th
                    >
                </tr>
            </thead>
            <tbody>
                {
                    clients.map((client) => (
                        <tr class="border-b border-dark-border/50 hover:bg-dark-hover transition-colors">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 bg-carmin/10 rounded-full flex items-center justify-center">
                                        <span class="text-carmin font-bold text-sm">
                                            {client.client_name.charAt(0)}
                                        </span>
                                    </div>
                                    <span class="text-white text-sm font-medium">
                                        {client.client_name}
                                    </span>
                                </div>
                            </td>
                            <td class="px-6 py-4 hidden sm:table-cell">
                                <span
                                    class:list={[
                                        "text-sm",
                                        client.dropbox_link
                                            ? "text-light-muted"
                                            : "text-yellow-400",
                                    ]}
                                >
                                    {client.dropbox_link
                                        ? "✓ Configurado"
                                        : "⚠ Sin enlace"}
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                <span
                                    class:list={[
                                        "inline-flex px-2.5 py-1 rounded-full text-xs font-medium",
                                        client.is_active
                                            ? "bg-green-500/10 text-green-400"
                                            : "bg-red-500/10 text-red-400",
                                    ]}
                                >
                                    {client.is_active ? "Activo" : "Inactivo"}
                                </span>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex items-center gap-1 justify-end">
                                    <button class="p-2 hover:bg-dark-card rounded-lg transition-colors">
                                        <svg
                                            class="w-4 h-4 text-light-subtle hover:text-carmin-light"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                                            />
                                        </svg>
                                    </button>
                                    <button class="p-2 hover:bg-dark-card rounded-lg transition-colors">
                                        <svg
                                            class="w-4 h-4 text-light-subtle hover:text-red-400"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                                            />
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    ))
                }
            </tbody>
        </table>
    </div>
</AdminLayout>
