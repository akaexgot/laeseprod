---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getSettings } from "../../lib/data";
const settings = await getSettings();
const value = (key: string) => String((settings as Record<string, unknown>)[key] ?? "");
---

<AdminLayout title="Ajustes" activeSection="ajustes">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-10">
        <div><h1 class="text-2xl font-bold text-white">Ajustes</h1><p class="text-sm text-zinc-400 mt-2">Marca, vídeos y datos públicos de LaesePROD.</p></div>
        <button id="save-settings" class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-white text-black rounded-md text-sm font-semibold"><i data-lucide="save" class="w-4 h-4"></i>Guardar</button>
    </div>

    <form id="settings-form" class="bg-zinc-900 border border-zinc-800 rounded-lg divide-y divide-zinc-800">
        <section class="p-6 space-y-5">
            <h2 class="text-lg font-semibold text-white">Marca</h2>
            <div class="grid md:grid-cols-2 gap-5">
                <label class="admin-field">Nombre<input name="site_name" value={value("site_name")} /></label>
                <label class="admin-field">Descripción corta<input name="site_description" value={value("site_description")} /></label>
            </div>
            <label class="admin-field">URL del logotipo
                <div class="flex gap-2"><input id="logo_url" name="logo_url" value={value("logo_url")} /><button type="button" class="upload-button" data-upload-target="logo_url" data-accept="image/*" data-folder="logos"><i data-lucide="upload" class="w-4 h-4"></i>Subir</button></div>
            </label>
        </section>

        <section class="p-6 space-y-5">
            <h2 class="text-lg font-semibold text-white">Vídeo de inicio</h2>
            <label class="admin-field">Escritorio
                <div class="flex gap-2"><input id="hero_video_desktop" name="hero_video_desktop" value={value("hero_video_desktop")} /><button type="button" class="upload-button" data-upload-target="hero_video_desktop" data-accept="video/mp4,video/webm" data-folder="background_videos"><i data-lucide="upload" class="w-4 h-4"></i>Subir</button></div>
            </label>
            <label class="admin-field">Móvil / vertical
                <div class="flex gap-2"><input id="hero_video_mobile" name="hero_video_mobile" value={value("hero_video_mobile")} /><button type="button" class="upload-button" data-upload-target="hero_video_mobile" data-accept="video/mp4,video/webm" data-folder="background_videos"><i data-lucide="upload" class="w-4 h-4"></i>Subir</button></div>
            </label>
        </section>

        <section class="p-6 space-y-5">
            <h2 class="text-lg font-semibold text-white">Contacto y presentación</h2>
            <label class="admin-field">Resumen de LaesePROD<textarea name="about_summary" rows="4">{value("about_summary")}</textarea></label>
            <label class="admin-field">Vídeo de fondo de contacto
                <div class="flex gap-2"><input id="contact_hero_video" name="contact_hero_video" value={value("contact_hero_video")} /><button type="button" class="upload-button" data-upload-target="contact_hero_video" data-accept="video/mp4,video/webm" data-folder="background_videos"><i data-lucide="upload" class="w-4 h-4"></i>Subir</button></div>
            </label>
            <div class="grid md:grid-cols-2 gap-5">
                <label class="admin-field">Email<input type="email" name="email" value={value("email")} /></label>
                <label class="admin-field">Teléfono<input name="phone" value={value("phone")} /></label>
                <label class="admin-field">WhatsApp<input name="whatsapp_number" value={value("whatsapp_number")} /></label>
                <label class="admin-field">Dirección<input name="address" value={value("address")} /></label>
                <label class="admin-field">Instagram<input type="url" name="instagram" value={value("instagram")} /></label>
                <label class="admin-field">LinkedIn<input type="url" name="linkedin" value={value("linkedin")} /></label>
            </div>
            <label class="admin-field">Google Maps<input name="google_maps_embed" value={value("google_maps_embed")} /></label>
        </section>

        <section class="p-6 space-y-5">
            <h2 class="text-lg font-semibold text-white">Contratos</h2>
            <label class="admin-field">Texto de aceptación<textarea name="contract_terms_text" rows="3">{value("contract_terms_text")}</textarea></label>
        </section>
    </form>
    <input id="settings-upload" type="file" class="hidden" />
    <p id="settings-status" class="mt-4 text-sm text-zinc-400" aria-live="polite"></p>
</AdminLayout>

<style>
    .admin-field { display: grid; gap: .45rem; color: #d4d4d8; font-size: .8rem; font-weight: 600; }
    .admin-field input, .admin-field textarea { width: 100%; padding: .65rem .75rem; color: #f4f4f5; background: #09090b; border: 1px solid #3f3f46; border-radius: 4px; outline: none; }
    .admin-field input:focus, .admin-field textarea:focus { border-color: #fff; }
    .upload-button { display: inline-flex; align-items: center; gap: .4rem; flex: 0 0 auto; padding: 0 .9rem; color: #fff; background: #27272a; border: 1px solid #52525b; border-radius: 4px; }
</style>

<script>
    const form = document.getElementById('settings-form') as HTMLFormElement;
    const saveButton = document.getElementById('save-settings') as HTMLButtonElement;
    const status = document.getElementById('settings-status')!;
    const fileInput = document.getElementById('settings-upload') as HTMLInputElement;
    let uploadTarget = '';
    let uploadFolder = '';

    document.querySelectorAll<HTMLButtonElement>('.upload-button').forEach((button) => {
        button.addEventListener('click', () => {
            uploadTarget = button.dataset.uploadTarget || '';
            uploadFolder = button.dataset.folder || '';
            fileInput.accept = button.dataset.accept || '';
            fileInput.click();
        });
    });

    fileInput.addEventListener('change', async () => {
        const file = fileInput.files?.[0];
        const target = document.getElementById(uploadTarget) as HTMLInputElement | null;
        if (!file || !target) return;
        status.textContent = 'Subiendo archivo...';
        const body = new FormData();
        body.append('file', file);
        body.append('folder', uploadFolder);
        const response = await fetch('/api/admin/upload', { method: 'POST', body });
        const result = await response.json();
        if (response.ok) { target.value = result.url; status.textContent = 'Archivo subido. Guarda los cambios.'; }
        else status.textContent = result.error || 'No se pudo subir el archivo.';
        fileInput.value = '';
    });

    saveButton.addEventListener('click', async () => {
        saveButton.disabled = true;
        status.textContent = 'Guardando...';
        const data = Object.fromEntries(new FormData(form));
        const response = await fetch('/api/admin/settings', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
        const result = await response.json().catch(() => ({}));
        status.textContent = response.ok ? 'Ajustes guardados.' : (result.error || 'No se pudieron guardar los ajustes.');
        saveButton.disabled = false;
    });
</script>
