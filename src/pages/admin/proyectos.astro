---
/**
 * Admin - Projects Management
 * Full CRUD for portfolio projects + custom SaaS dark styling
 */
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getProjects } from "../../lib/data";
import { supabase, getServiceSupabase } from "../../lib/supabase";

const cookie = Astro.request?.headers.get("cookie") || "";
if (!Astro.request) return Astro.redirect('/admin/login');
if (!supabase) return Astro.redirect('/admin/login');
const { data: userData } = await supabase.auth.getUser({ cookie });
const user = userData?.user;
if (!user) return Astro.redirect('/admin/login');
const serviceSupabase = getServiceSupabase();
if (!serviceSupabase) return Astro.redirect('/admin/login');
const { data: profile } = await serviceSupabase.from('profiles').select('is_admin').eq('id', user.id).maybeSingle();
if (!profile?.is_admin) return Astro.redirect('/admin/login');

const projects = await getProjects();
---

<AdminLayout title="Proyectos" activeSection="proyectos">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between" style="margin-bottom: 1.5rem; gap: 1rem;">
        <div>
            <p class="text-zinc-400 text-sm">Gestiona tus proyectos. Total: <span class="text-zinc-100 font-medium">{projects.length}</span></p>
        </div>
        <button id="btn-add"
            class="inline-flex items-center justify-center bg-rose-600 text-white text-sm font-medium rounded-md hover:bg-rose-500 transition-colors shadow-sm"
            style="padding: 0.5rem 1rem; gap: 0.5rem;"
        >
            <i data-lucide="plus" class="w-4 h-4"></i>
            Nuevo proyecto
        </button>
    </div>

    <div class="bg-zinc-900 border border-zinc-800 rounded-xl overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left" id="projects-table">
                <thead class="text-xs text-zinc-400 bg-zinc-950/50 uppercase border-b border-zinc-800">
                    <tr>
                        <th class="font-semibold w-24" style="padding: 1rem 1.5rem;">Imagen</th>
                        <th class="font-semibold" style="padding: 1rem 1.5rem;">Proyecto</th>
                        <th class="font-semibold hidden sm:table-cell w-40" style="padding: 1rem 1.5rem;">Estado</th>
                        <th class="font-semibold hidden md:table-cell text-center w-24" style="padding: 1rem 1.5rem;">Inicio</th>
                        <th class="font-semibold text-right w-24" style="padding: 1rem 1.5rem;">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-800">
                    {projects.map((project: any) => (
                        <tr class="hover:bg-zinc-800/30 transition-colors group" data-id={project.id}>
                            <td style="padding: 1rem 1.5rem;">
                                <div class="w-16 h-10 bg-zinc-950 rounded bg-cover bg-center border border-zinc-800 shrink-0" 
                                     style={project.thumbnail ? `background-image: url('${project.thumbnail}')` : ''}>
                                     {!project.thumbnail && <span class="w-full h-full flex items-center justify-center text-zinc-600 text-xs">Sin img</span>}
                                </div>
                            </td>
                            <td style="padding: 1rem 1.5rem;">
                                <div class="font-medium text-zinc-100 mb-0.5">{project.title}</div>
                                <div class="text-xs text-zinc-500" title={project.slug}>/{project.slug}</div>
                            </td>
                            <td class="hidden sm:table-cell align-top" style="padding: 1rem 1.5rem;">
                                <span class="block text-zinc-300 mb-0.5">{project.client_name || '-'}</span>
                                <span class="inline-flex px-2 py-0.5 rounded text-[10px] font-medium bg-zinc-800 text-zinc-400 border border-zinc-700">{project.category || 'General'}</span>
                            </td>
                            <td class="hidden md:table-cell text-center align-top" style="padding: 1rem 1.5rem;">
                                {project.video_project ? (
                                    <span class="inline-flex items-center gap-1 text-emerald-400 text-xs bg-emerald-400/10 px-2 py-1 rounded border border-emerald-400/20">
                                        <i data-lucide="check" class="w-3 h-3"></i> Listo
                                    </span>
                                ) : (
                                    <span class="inline-flex items-center gap-1 text-amber-400 text-xs bg-amber-400/10 px-2 py-1 rounded border border-amber-400/20">
                                        <i data-lucide="alert-circle" class="w-3 h-3"></i> Faltan datos
                                    </span>
                                )}
                            </td>
                            <td class="text-center align-top" style="padding: 1rem 1.5rem;">
                                <button class="btn-toggle-featured p-1.5 rounded hover:bg-zinc-800 transition-colors" data-id={project.id} data-state={project.featured_home ? "1" : "0"} title={project.featured_home ? "Quitar del inicio" : "Destacar en inicio"}>
                                    <i data-lucide="star" class:list={["w-4 h-4", project.featured_home ? "text-amber-400 fill-amber-400" : "text-zinc-600"]}></i>
                                </button>
                            </td>
                            <td style="padding: 1rem 1.5rem;" class="align-top">
                                <div class="flex items-center justify-end opacity-0 group-hover:opacity-100 transition-opacity" style="gap: 0.5rem;">
                                    <button class="p-1.5 text-zinc-400 hover:text-rose-400 hover:bg-rose-400/10 rounded-md transition-colors btn-edit" data-project={JSON.stringify(project)} title="Editar">
                                        <i data-lucide="edit-2" class="w-4 h-4"></i>
                                    </button>
                                    <button class="p-1.5 text-zinc-400 hover:text-red-400 hover:bg-red-400/10 rounded-md transition-colors btn-delete" data-id={project.id} title="Eliminar">
                                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    ))}
                </tbody>
            </table>
        </div>
    </div>
</AdminLayout>

<div id="modal-overlay" class="fixed inset-0 bg-zinc-950/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-zinc-900 border border-zinc-800 rounded-xl w-full max-w-4xl max-h-[90vh] overflow-y-auto shadow-2xl">
        <!-- Header -->
        <div class="flex items-center justify-between border-b border-zinc-800" style="padding: 1rem 1.5rem;">
            <h3 class="text-lg font-semibold text-white" id="modal-title">Nuevo proyecto</h3>
            <button id="modal-close-icon" class="p-1.5 text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800 rounded-md transition-colors">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>
        <!-- Body -->
        <div class="overflow-y-auto" style="scrollbar-width: thin; padding: 1.5rem;">
            <form id="project-form" style="display: flex; flex-direction: column; gap: 1.5rem;">
                <input type="hidden" name="id" id="project-id" />
                
                <div class="grid grid-cols-1 lg:grid-cols-2" style="display: grid; gap: 2rem;">
                    <!-- Left Column -->
                    <div class="col-span-1" style="display: flex; flex-direction: column; gap: 1rem;">
                        <h4 class="text-xs font-semibold text-zinc-500 uppercase tracking-wider" style="margin-bottom: 0.5rem;">INFO PRINCIPAL</h4>
                        <div>
                            <label class="block text-sm font-medium text-zinc-300" style="margin-bottom: 0.25rem;">Título *</label>
                            <input type="text" id="p-title" class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-all text-sm" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-zinc-300" style="margin-bottom: 0.25rem;">Slug (opcional)</label>
                            <input type="text" id="p-slug" class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-all text-sm" placeholder="auto-generado si vacío" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-zinc-300" style="margin-bottom: 0.25rem;">Categoría</label>
                            <input type="text" id="p-category" class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-all text-sm" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-zinc-300" style="margin-bottom: 0.25rem;">Cliente</label>
                            <input type="text" id="p-client" class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-all text-sm" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-zinc-300" style="margin-bottom: 0.25rem;">Descripción Corta</label>
                            <textarea id="p-shortdesc" rows="2" class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-all text-sm resize-none"></textarea>
                        </div>
                    </div>
                    <!-- Right Column (Media) -->
                    <div class="col-span-1" style="display: flex; flex-direction: column; gap: 1rem;">
                        <h4 class="text-xs font-semibold text-zinc-500 uppercase tracking-wider" style="margin-bottom: 0.5rem;">CONTENIDO MULTIMEDIA</h4>
                        <div>
                            <label class="block text-sm font-medium text-zinc-300" style="margin-bottom: 0.25rem;">Imagen Miniatura (URL)</label>
                            <input type="url" id="p-thumbnail" class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-all text-sm" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-zinc-300" style="margin-bottom: 0.25rem;">Vídeo Hero (YouTube)</label>
                            <input type="url" id="p-video" class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-all text-sm" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-zinc-300" style="margin-bottom: 0.25rem;">Vídeo Making Of (YouTube)</label>
                            <input type="url" id="p-makingof" class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-all text-sm" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-zinc-300" style="margin-bottom: 0.25rem;">Color de Fondo (Opcional)</label>
                            <input type="text" id="p-color" class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-all text-sm" placeholder="#0f172a / slate-900 / etc" />
                        </div>
                        <div style="padding-top: 0.5rem;">
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input type="checkbox" id="p-featured" class="w-4 h-4 rounded border-zinc-700 bg-zinc-950 text-rose-500 focus:ring-rose-500 focus:ring-offset-zinc-900" />
                                <span class="text-sm font-medium text-zinc-300">Destacar en la página de inicio</span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="col-span-1 lg:col-span-2" style="margin-top: 1rem;">
                    <label class="block text-sm font-medium text-zinc-300" style="margin-bottom: 0.25rem;">Contenido / Descripción Completa (Markdown soportado)</label>
                    <textarea id="p-content" rows="4" class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-all text-sm resize-y"></textarea>
                </div>
            </form>
        </div>
        <!-- Footer -->
        <div class="border-t border-zinc-800 bg-zinc-950 flex justify-start sm:justify-end mt-auto" style="padding: 1rem 1.5rem; gap: 0.75rem;">
            <p id="modal-error" class="text-rose-400 text-sm hidden font-medium"></p>
            <button type="button" id="modal-cancel" class="text-sm font-medium text-zinc-400 hover:text-white transition-colors" style="padding: 0.5rem 1rem;">Cancelar</button>
            <button type="submit" id="modal-save" class="bg-rose-600 hover:bg-rose-500 text-white text-sm font-semibold rounded-lg shadow-glow transition-all" style="padding: 0.5rem 1rem;">Guardar</button>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="confirm-overlay" class="fixed inset-0 bg-zinc-950/80 backdrop-blur-sm z-[60] hidden flex items-center justify-center p-4">
    <div class="bg-zinc-900 border border-zinc-800 rounded-xl w-full max-w-sm shadow-2xl overflow-hidden">
        <div class="text-center" style="padding: 2rem 1.5rem 1rem;">
            <div class="w-12 h-12 rounded-full bg-red-500/10 border border-red-500/20 flex items-center justify-center mx-auto mb-4">
                <i data-lucide="alert-triangle" class="w-6 h-6 text-red-400"></i>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">¿Eliminar permanentemente?</h3>
            <p class="text-sm text-zinc-400">Esta acción no se puede deshacer.</p>
        </div>
        <div class="flex justify-end border-t border-zinc-800 bg-zinc-950" style="padding: 1rem 1.5rem; gap: 0.75rem;">
            <button id="confirm-cancel" class="text-sm font-medium text-zinc-400 hover:text-white transition-colors" style="padding: 0.5rem 1rem;">Cancelar</button>
            <button id="confirm-yes" class="bg-red-600 hover:bg-red-500 text-white text-sm font-semibold rounded-lg transition-all" style="padding: 0.5rem 1rem;">Eliminar</button>
        </div>
    </div>
</div>

<!-- Toast Container -->
<div id="toast-container" class="fixed top-4 right-4 z-[70] flex flex-col gap-2" style="pointer-events: none;"></div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const overlay = document.getElementById('modal-overlay')!;
        const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
        const errEl = document.getElementById('modal-error')!;

        function openModal(data?: any) {
            document.getElementById('modal-title')!.textContent = data ? 'Editar proyecto' : 'Nuevo proyecto';
            
            $('project-id').value = data?.id || '';
            $('p-title').value = data?.title || '';
            $('p-slug').value = data?.slug || '';
            $('p-category').value = data?.category || '';
            $('p-client').value = data?.client_name || '';
            $('p-shortdesc').value = data?.short_description || '';
            $('p-thumbnail').value = data?.thumbnail || '';
            $('p-video').value = data?.video_project || '';
            $('p-makingof').value = data?.video_makingof || '';
            $('p-color').value = data?.bg_color || '';
            $('p-featured').checked = data?.featured_home || false;
            ($('p-content') as unknown as HTMLTextAreaElement).value = data?.content || '';
            
            errEl.classList.add('hidden');
            overlay.classList.remove('hidden');
        }

        function closeModal() { overlay.classList.add('hidden'); }

        document.getElementById('btn-add')?.addEventListener('click', () => openModal());
        document.getElementById('modal-cancel')?.addEventListener('click', closeModal);
        document.getElementById('modal-close-icon')?.addEventListener('click', closeModal);

        // Close on outside click
        overlay.addEventListener('click', (e) => {
            if (e.target === overlay) closeModal();
        });

        document.querySelectorAll('.btn-edit').forEach(btn => {
            btn.addEventListener('click', () => {
                const data = JSON.parse((btn as HTMLElement).dataset.project || '{}');
                openModal(data);
            });
        });

        document.querySelectorAll('.btn-toggle-featured').forEach(btn => {
            btn.addEventListener('click', async (e) => {
                e.preventDefault();
                const id = (btn as HTMLElement).dataset.id;
                const state = (btn as HTMLElement).dataset.state === "1";
                const newState = !state;
                
                btn.innerHTML = '<i data-lucide="loader-2" class="w-4 h-4 animate-spin text-zinc-400"></i>';
                // @ts-ignore
                if (typeof lucide !== 'undefined') lucide.createIcons();

                try {
                    const body = { id, featured_home: newState };
                    const res = await fetch('/api/admin/projects', {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(body),
                    });
                    if (res.ok) location.reload();
                    else showToast('Error al actualizar estado', 'error');
                } catch(error) {
                    showToast('Error de conexión', 'error');
                }
            });
        });

        // Confirm modal logic
        const confirmOverlay = document.getElementById('confirm-overlay')!;
        const confirmYes = document.getElementById('confirm-yes')!;
        const confirmCancel = document.getElementById('confirm-cancel')!;
        let pendingDeleteId: string | null = null;

        function openConfirm(id: string) {
            pendingDeleteId = id;
            confirmOverlay.classList.remove('hidden');
        }
        function closeConfirm() {
            pendingDeleteId = null;
            confirmOverlay.classList.add('hidden');
        }
        confirmCancel.addEventListener('click', closeConfirm);
        confirmOverlay.addEventListener('click', (e) => { if (e.target === confirmOverlay) closeConfirm(); });

        confirmYes.addEventListener('click', async () => {
            if (!pendingDeleteId) return;
            confirmYes.textContent = 'Eliminando...';
            (confirmYes as HTMLButtonElement).disabled = true;
            const res = await fetch('/api/admin/projects', {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: pendingDeleteId }),
            });
            if (res.ok) location.reload();
            else {
                showToast('Error al eliminar', 'error');
                closeConfirm();
                confirmYes.textContent = 'Eliminar';
                (confirmYes as HTMLButtonElement).disabled = false;
            }
        });

        document.querySelectorAll('.btn-delete').forEach(btn => {
            btn.addEventListener('click', () => {
                openConfirm((btn as HTMLElement).dataset.id!);
            });
        });

        // Toast notification
        function showToast(message: string, type: 'error' | 'success' = 'error') {
            const container = document.getElementById('toast-container')!;
            const toast = document.createElement('div');
            toast.className = `flex items-center gap-3 px-4 py-3 rounded-lg shadow-xl border text-sm font-medium pointer-events-auto ${
                type === 'error' ? 'bg-red-500/10 border-red-500/20 text-red-400' : 'bg-emerald-500/10 border-emerald-500/20 text-emerald-400'
            }`;
            toast.style.cssText = 'backdrop-filter:blur(12px); animation: toast-in 0.3s ease-out;';
            toast.textContent = message;
            container.appendChild(toast);
            setTimeout(() => { toast.style.animation = 'toast-out 0.3s ease-in forwards'; setTimeout(() => toast.remove(), 300); }, 4000);
        }

        document.getElementById('modal-save')?.addEventListener('click', async () => {
            const title = $('p-title').value.trim();
            if (!title) {
                errEl.textContent = 'El título es obligatorio';
                errEl.classList.remove('hidden');
                return;
            }

            const btn = document.getElementById('modal-save')!;
            const oHtml = btn.innerHTML;
            btn.innerHTML = 'Guardando...';
            btn.setAttribute('disabled', 'true');

            const body: any = {
                title,
                slug: $('p-slug').value.trim() || null,
                category: $('p-category').value.trim() || null,
                client_name: $('p-client').value.trim() || null,
                short_description: $('p-shortdesc').value.trim() || null,
                thumbnail: $('p-thumbnail').value.trim() || null,
                video_project: $('p-video').value.trim() || null,
                video_makingof: $('p-makingof').value.trim() || null,
                bg_color: $('p-color').value.trim() || null,
                featured_home: $('p-featured').checked,
                content: ($('p-content') as unknown as HTMLTextAreaElement).value.trim() || null,
            };

            const isEdit = !!$('project-id').value;
            if (isEdit) body.id = $('project-id').value;

            try {
                const res = await fetch('/api/admin/projects', {
                    method: isEdit ? 'PUT' : 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body),
                });
                if (res.ok) {
                    location.reload();
                } else {
                    const err = await res.json();
                    errEl.textContent = err.error || 'Error';
                    errEl.classList.remove('hidden');
                    btn.innerHTML = oHtml;
                    btn.removeAttribute('disabled');
                }
            } catch (e) {
                errEl.textContent = 'Error conexión';
                errEl.classList.remove('hidden');
                btn.innerHTML = oHtml;
                btn.removeAttribute('disabled');
            }
        });
    });
</script>
