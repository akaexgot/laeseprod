---
/**
 * Admin - Projects Management
 * Full CRUD for portfolio projects + custom SaaS dark styling
 */
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getProjects } from "../../lib/data";
import { getServiceSupabase } from "../../lib/supabase";
import { getUserFromCookie } from "../../lib/auth";

// SSR auth is handled by middleware
const serviceSupabase = getServiceSupabase()!;

const projects = await getProjects();
---

<AdminLayout title="Proyectos" activeSection="proyectos">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between" style="margin-bottom: 1.5rem; gap: 1rem;">
        <div class="flex flex-col sm:flex-row sm:items-center gap-4 flex-1">
            <p class="text-zinc-400 text-sm whitespace-nowrap">Gestiona tus proyectos. Total: <span class="text-zinc-100 font-medium">{projects.length}</span></p>
            
            <!-- Real-time Search -->
            <div class="relative w-full max-w-xs">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i data-lucide="search" class="w-4 h-4 text-zinc-500"></i>
                </div>
                <input 
                    type="text" 
                    id="project-search" 
                    class="block w-full pl-10 pr-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-all text-sm" 
                    placeholder="Buscar proyectos..."
                />
            </div>
        </div>
        <button id="btn-add"
            class="inline-flex items-center justify-center bg-rose-600 text-white text-sm font-medium rounded-md hover:bg-rose-500 transition-colors shadow-sm"
            style="padding: 0.5rem 1rem; gap: 0.5rem;"
        >
            <i data-lucide="plus" class="w-4 h-4"></i>
            Nuevo proyecto
        </button>
    </div>

    <div class="bg-zinc-900 border border-zinc-800 rounded-xl overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left" id="projects-table">
                <thead class="text-xs text-zinc-500 uppercase tracking-wider font-semibold bg-zinc-900/50">
                    <tr class="border-b border-zinc-800/50">
                        <th style="padding: 1.25rem 1.5rem;">Proyecto</th>
                        <th class="hidden sm:table-cell" style="padding: 1.25rem 1.5rem;">Cliente</th>
                        <th class="hidden md:table-cell w-32" style="padding: 1.25rem 1.5rem;">Multimedia</th>
                        <th class="hidden lg:table-cell text-center w-24" style="padding: 1.25rem 1.5rem;">Inicio</th>
                        <th class="text-right hidden sm:table-cell w-24" style="padding: 1.25rem 1.5rem;">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-800">
                    {projects.map((project: any) => (
                        <tr class="hover:bg-zinc-800/30 transition-colors group mobile-row-click sm:cursor-default" data-id={project.id} onclick="const btn = this.querySelector('.btn-edit'); if(btn && !event.target.closest('button')) btn.click();">
                            <td style="padding: 1.25rem 1.5rem;">
                                <div class="flex items-center justify-between">
                                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                                        <div class="w-10 h-10 bg-zinc-950 rounded bg-cover bg-center border border-zinc-800 shrink-0"
                                             style={project.thumbnail ? `background-image: url('${project.thumbnail}')` : ''}>
                                             {!project.thumbnail && <span class="w-full h-full flex items-center justify-center text-zinc-600 text-xs">Sin</span>}
                                        </div>
                                        <div class="min-w-0">
                                            <div class="font-medium text-zinc-100 mb-0.5 truncate">{project.title}</div>
                                            <div class="text-xs text-zinc-500">/{project.slug}</div>
                                        </div>
                                    </div>
                                    <i data-lucide="chevron-right" class="w-5 h-5 text-zinc-600 sm:hidden flex-shrink-0"></i>
                                </div>
                            </td>
                            <td class="hidden sm:table-cell" style="padding: 1.25rem 1.5rem;">
                                <div>
                                    <span class="block text-zinc-300 mb-0.5">{project.client_name || '-'}</span>
                                </div>
                            </td>
                            <td class="hidden md:table-cell" style="padding: 1.25rem 1.5rem;">
                                {project.video_project ? (
                                    <span class="inline-flex items-center gap-1 text-emerald-400 text-xs bg-emerald-400/10 px-2 py-1 rounded border border-emerald-400/20">
                                        <i data-lucide="check" class="w-3 h-3"></i> Listo
                                    </span>
                                ) : (
                                    <span class="inline-flex items-center gap-1 text-amber-400 text-xs bg-amber-400/10 px-2 py-1 rounded border border-amber-400/20">
                                        <i data-lucide="alert-circle" class="w-3 h-3"></i> Faltan datos
                                    </span>
                                )}
                            </td>
                            <td class="hidden lg:table-cell text-center" style="padding: 1.25rem 1.5rem;">
                                <button class="btn-toggle-featured p-1.5 rounded hover:bg-zinc-800 transition-colors" data-id={project.id} data-state={project.featured_home ? "1" : "0"} title={project.featured_home ? "Quitar del inicio" : "Destacar en inicio"}>
                                    <i data-lucide="star" class:list={["w-4 h-4", project.featured_home ? "text-amber-400 fill-amber-400" : "text-zinc-600"]}></i>
                                </button>
                            </td>
                            <td class="hidden sm:table-cell text-right" style="padding: 1.25rem 1.5rem;">
                                <div class="flex items-center justify-end gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                                    <button class="p-2 text-zinc-500 hover:text-rose-500 hover:bg-rose-500/10 rounded-lg transition-all btn-edit" data-project={JSON.stringify(project)} title="Editar">
                                        <i data-lucide="edit-3" class="w-4.5 h-4.5"></i>
                                    </button>
                                    <button class="p-2 text-zinc-500 hover:text-red-500 hover:bg-red-500/10 rounded-lg transition-all btn-delete" data-id={project.id} title="Eliminar">
                                        <i data-lucide="trash-2" class="w-4.5 h-4.5"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    ))}
                </tbody>
            </table>
        </div>
    </div>
</AdminLayout>

<div id="modal-overlay" class="fixed inset-0 bg-zinc-950/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-zinc-900 border border-zinc-800 rounded-xl w-[calc(100%-2rem)] sm:w-full max-w-4xl max-h-[90vh] overflow-y-auto shadow-2xl">
        <!-- Header -->
        <div class="flex items-center justify-between border-b border-zinc-800" style="padding: 1rem 1.5rem;">
            <h3 class="text-lg font-semibold text-white" id="modal-title">Nuevo proyecto</h3>
            <button id="modal-close-icon" class="p-1.5 text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800 rounded-md transition-colors">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>
        <!-- Body -->
        <div class="overflow-y-auto" style="scrollbar-width: thin; padding: 1.5rem;">
            <form id="project-form" style="display: flex; flex-direction: column; gap: 1.5rem;">
                <input type="hidden" name="id" id="project-id" />
                
                <div class="grid grid-cols-1 lg:grid-cols-2" style="display: grid; gap: 2rem;">
                    <!-- Left Column -->
                    <div class="col-span-1" style="display: flex; flex-direction: column; gap: 1rem;">
                        <h4 class="text-xs font-semibold text-zinc-500 uppercase tracking-wider" style="margin-bottom: 0.5rem;">INFO PRINCIPAL</h4>
                        <div>
                            <label class="block text-sm font-medium text-zinc-300" style="margin-bottom: 0.25rem;">Título *</label>
                            <input type="text" id="p-title" class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-all text-sm" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-zinc-300" style="margin-bottom: 0.25rem;">Slug (opcional)</label>
                            <input type="text" id="p-slug" class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-all text-sm" placeholder="auto-generado si vacío" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-zinc-300" style="margin-bottom: 0.25rem;">Cliente</label>
                            <input type="text" id="p-client" class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-all text-sm" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-zinc-300" style="margin-bottom: 0.25rem;">Descripción</label>
                            <textarea id="p-description" rows="5" class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-all text-sm resize-none"></textarea>
                        </div>
                    </div>
                    <!-- Right Column (Media) -->
                    <div class="col-span-1" style="display: flex; flex-direction: column; gap: 1rem;">
                        <!-- Drag & Drop Portada -->
                        <div>
                            <label class="block text-sm font-medium text-zinc-300" style="margin-bottom: 0.5rem;">Imagen de Portada</label>
                            <div id="drop-zone-thumb" class="relative group cursor-pointer border-2 border-dashed border-zinc-800 hover:border-rose-500/50 bg-zinc-950/50 rounded-xl transition-all overflow-hidden" style="height: 160px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.5rem;">
                                <input type="file" id="file-thumb" class="hidden" accept="image/*" />
                                <input type="hidden" id="p-thumbnail" />
                                <div id="preview-thumb" class="absolute inset-0 bg-cover bg-center hidden opacity-40 group-hover:opacity-60 transition-opacity"></div>
                                <div id="empty-thumb" class="relative z-10 flex flex-direction: column; align-items: center; gap: 0.25rem; text-zinc-500 group-hover:text-zinc-300 transition-colors">
                                    <i data-lucide="image-plus" class="w-8 h-8"></i>
                                    <span class="text-sm font-medium">Arrastrar o click para subir portada</span>
                                </div>
                                <div id="loading-thumb" class="absolute inset-0 bg-zinc-950/80 hidden items-center justify-center z-20">
                                    <i data-lucide="loader-2" class="w-6 h-6 animate-spin text-rose-500"></i>
                                </div>
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-zinc-300" style="margin-bottom: 0.25rem;">Vídeo Hero (YouTube)</label>
                            <input type="url" id="p-video" class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-all text-sm" placeholder="URL o ID de YouTube" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-zinc-300" style="margin-bottom: 0.25rem;">Vídeo Making Of (Shorts/YouTube)</label>
                            <input type="url" id="p-makingof" class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-all text-sm" placeholder="Acepta Shorts" />
                        </div>
                        <div style="padding-top: 0.5rem;">
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input type="checkbox" id="p-featured" class="w-4 h-4 rounded border-zinc-700 bg-zinc-950 text-rose-500 focus:ring-rose-500 focus:ring-offset-zinc-900" />
                                <span class="text-sm font-medium text-zinc-300">Destacar en la página de inicio</span>
                            </label>
                        </div>
                    </div>
                </div>
            </form>
        </div>
        <div class="border-t border-zinc-800 bg-zinc-950 flex justify-end mt-auto relative" style="padding: 1rem 1.5rem; gap: 0.75rem;">
            <p id="modal-error" class="text-rose-400 text-sm hidden font-medium absolute left-6 top-4"></p>
            <button type="button" id="modal-delete" class="text-sm font-medium text-rose-500 hover:text-rose-400 transition-colors hidden mr-auto" style="padding: 0.5rem 1rem;">Eliminar</button>
            <button type="button" id="modal-cancel" class="text-sm font-medium text-zinc-400 hover:text-white transition-colors" style="padding: 0.5rem 1rem;">Cancelar</button>
            <button type="submit" id="modal-save" class="bg-rose-600 hover:bg-rose-500 text-white text-sm font-semibold rounded-lg shadow-glow transition-all" style="padding: 0.5rem 1rem;">Guardar</button>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="confirm-overlay" class="fixed inset-0 bg-zinc-950/80 backdrop-blur-md z-[60] hidden flex items-center justify-center p-4">
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl w-[calc(100%-2rem)] sm:w-full max-w-[340px] shadow-2xl overflow-hidden" style="animation: toast-in 0.3s cubic-bezier(0.16, 1, 0.3, 1);">
        <div style="padding: 2rem 1.5rem 1.5rem; display: flex; flex-direction: column; align-items: center; text-align: center;">
            <div style="width: 56px; height: 56px; border-radius: 50%; background: rgba(225,29,72,0.1); border: 1px solid rgba(225,29,72,0.2); display: flex; justify-content: center; align-items: center; margin-bottom: 1.25rem;">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#fb7185" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
            </div>
            <h3 style="font-size: 1.15rem; font-weight: 600; color: #fff; margin-bottom: 0.5rem;">¿Eliminar permanentemente?</h3>
            <p style="font-size: 0.875rem; color: #a1a1aa; line-height: 1.4; margin: 0;">Esta acción no se puede deshacer. Los datos serán borrados del sistema.</p>
        </div>
        <div style="display: flex; border-top: 1px solid #27272a; padding: 1rem; gap: 0.75rem; background: #09090b;">
            <button id="confirm-cancel" style="flex: 1; padding: 0.75rem; border-radius: 12px; background: #27272a; color: #e4e4e7; font-weight: 500; font-size: 0.9rem; border: 1px solid #3f3f46; cursor: pointer;">Cancelar</button>
            <button id="confirm-yes" style="flex: 1; padding: 0.75rem; border-radius: 12px; background: #e11d48; color: #fff; font-weight: 600; font-size: 0.9rem; border: 1px solid #be123c; cursor: pointer; box-shadow: 0 4px 12px rgba(225,29,72,0.3);">Eliminar</button>
        </div>
    </div>
</div>
</div>

<!-- Toast Container -->
<div id="toast-container" class="fixed bottom-6 right-6 z-[70] flex flex-col gap-2" style="pointer-events: none;"></div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // --- REAL-TIME SEARCH (PROJECTS) ---
        const searchInput = document.getElementById('project-search') as HTMLInputElement;
        const totalSpan = document.querySelector('.text-zinc-100.font-medium');
        
        searchInput?.addEventListener('input', (e) => {
            const q = (e.target as HTMLInputElement).value.toLowerCase();
            const rows = document.querySelectorAll('#projects-table tbody tr');
            let visibleCount = 0;
            
            rows.forEach(row => {
                // Get relevant columns for search
                const title = row.querySelector('.font-medium')?.textContent?.toLowerCase() || '';
                const slug = row.querySelector('.text-xs.text-zinc-500')?.textContent?.toLowerCase() || '';
                const client = row.querySelector('.hidden.sm\\:table-cell')?.textContent?.toLowerCase() || '';
                
                const match = title.includes(q) || slug.includes(q) || client.includes(q);
                (row as HTMLElement).style.display = match ? '' : 'none';
                if (match) visibleCount++;
            });

            if (totalSpan) totalSpan.textContent = visibleCount.toString();
        });

        const overlay = document.getElementById('modal-overlay')!;
        const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
        const errEl = document.getElementById('modal-error')!;
        const modalDeleteBtn = document.getElementById('modal-delete')!;

        function openModal(data?: any) {
            document.getElementById('modal-title')!.textContent = data ? 'Editar proyecto' : 'Nuevo proyecto';
            
            $('project-id').value = data?.id || '';
            $('p-title').value = data?.title || '';
            $('p-slug').value = data?.slug || '';
            $('p-client').value = data?.client_name || '';
            $('p-description').value = data?.description || '';
            
            // Cover handling
            const thumbUrl = data?.thumbnail || '';
            $('p-thumbnail').value = thumbUrl;
            const previewThumb = document.getElementById('preview-thumb')!;
            const emptyThumb = document.getElementById('empty-thumb')!;
            if (thumbUrl) {
                previewThumb.style.backgroundImage = `url('${thumbUrl}')`;
                previewThumb.classList.remove('hidden');
                emptyThumb.classList.add('hidden');
            } else {
                previewThumb.classList.add('hidden');
                emptyThumb.classList.remove('hidden');
            }

            $('p-video').value = data?.video_project || '';
            $('p-makingof').value = data?.video_explanation_mobile || '';
            $('p-featured').checked = data?.featured_home || false;
            
            if (data) modalDeleteBtn.classList.remove('hidden');
            else modalDeleteBtn.classList.add('hidden');
            
            errEl.classList.add('hidden');
            overlay.classList.remove('hidden');
        }

        function closeModal() { overlay.classList.add('hidden'); }

        // Drag & Drop Logic
        const dropZoneThumb = document.getElementById('drop-zone-thumb')!;
        const fileInputThumb = document.getElementById('file-thumb') as HTMLInputElement;

        function setupDropZone(dropZone: HTMLElement, fileInput: HTMLInputElement, inputId: string, previewId: string, emptyId: string, loadingId: string) {
            dropZone.addEventListener('click', () => fileInput.click());
            dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('border-rose-500', 'bg-rose-500/5'); });
            dropZone.addEventListener('dragleave', () => { dropZone.classList.remove('border-rose-500', 'bg-rose-500/5'); });
            dropZone.addEventListener('drop', (e) => {
                e.preventDefault();
                dropZone.classList.remove('border-rose-500', 'bg-rose-500/5');
                const file = e.dataTransfer?.files[0];
                if (file) handleUpload(file, inputId, previewId, emptyId, loadingId);
            });
            fileInput.addEventListener('change', () => {
                const file = fileInput.files?.[0];
                if (file) handleUpload(file, inputId, previewId, emptyId, loadingId);
            });
        }

        setupDropZone(dropZoneThumb, fileInputThumb, 'p-thumbnail', 'preview-thumb', 'empty-thumb', 'loading-thumb');

        async function handleUpload(file: File, inputId: string, previewId: string, emptyId: string, loadingId: string) {
            const loading = document.getElementById(loadingId)!;
            loading.classList.remove('hidden');
            loading.classList.add('flex');

            const formData = new FormData();
            formData.append('file', file);

            try {
                const res = await fetch('/api/admin/upload', {
                    method: 'POST',
                    body: formData
                });

                if (res.ok) {
                    const data = await res.json();
                    $(inputId).value = data.url;
                    updatePreview(data.url, previewId, emptyId);
                    showToast('Imagen subida correctamente', 'success');
                } else {
                    const err = await res.json();
                    showToast(err.error || 'Error al subir', 'error');
                }
            } catch (error) {
                showToast('Error de conexión al subir', 'error');
            } finally {
                loading.classList.add('hidden');
                loading.classList.remove('flex');
            }
        }

        function updatePreview(url: string, previewId: string, emptyId: string) {
            const preview = document.getElementById(previewId)!;
            const empty = document.getElementById(emptyId)!;
            if (url) {
                preview.style.backgroundImage = `url('${url}')`;
                preview.classList.remove('hidden');
                empty.classList.add('hidden');
            } else {
                preview.classList.add('hidden');
                empty.classList.remove('hidden');
            }
        }

        document.getElementById('btn-add')?.addEventListener('click', () => openModal());
        document.getElementById('modal-cancel')?.addEventListener('click', closeModal);
        document.getElementById('modal-close-icon')?.addEventListener('click', closeModal);

        // Close on outside click
        overlay.addEventListener('click', (e) => {
            if (e.target === overlay) closeModal();
        });

        document.querySelectorAll('.btn-edit').forEach(btn => {
            btn.addEventListener('click', () => {
                const data = JSON.parse((btn as HTMLElement).dataset.project || '{}');
                openModal(data);
            });
        });

        modalDeleteBtn.addEventListener('click', () => {
            closeModal();
            const id = $('project-id').value;
            if (id) {
                const deleteBtn = document.querySelector(`.btn-delete[data-id="${id}"]`) as HTMLButtonElement;
                if (deleteBtn) deleteBtn.click();
            }
        });

        document.querySelectorAll('.btn-toggle-featured').forEach(btn => {
            btn.addEventListener('click', async (e) => {
                e.preventDefault();
                const id = (btn as HTMLElement).dataset.id;
                const state = (btn as HTMLElement).dataset.state === "1";
                const newState = !state;
                
                btn.innerHTML = '<i data-lucide="loader-2" class="w-4 h-4 animate-spin text-zinc-400"></i>';
                // @ts-ignore
                if (typeof (window as any).lucide !== 'undefined') (window as any).lucide.createIcons();

                try {
                    // Check limit
                    if (newState) {
                        const featuredCount = document.querySelectorAll('.btn-toggle-featured[data-state="1"]').length;
                        if (featuredCount >= 3) {
                            showToast('Límite de 3 destacados alcanzado. Desmarca uno primero.', 'error');
                            btn.innerHTML = state ? '<i data-lucide="star" class="w-4 h-4 text-amber-400 fill-amber-400"></i>' : '<i data-lucide="star" class="w-4 h-4 text-zinc-600"></i>';
                            if (typeof lucide !== 'undefined') lucide.createIcons();
                            return;
                        }
                    }

                    const body = { id, featured_home: newState };
                    const res = await fetch('/api/admin/projects', {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(body),
                    });
                    if (res.ok) location.reload();
                    else showToast('Error al actualizar estado', 'error');
                } catch(error) {
                    showToast('Error de conexión', 'error');
                }
            });
        });

        // Confirm modal logic
        const confirmOverlay = document.getElementById('confirm-overlay')!;
        const confirmYes = document.getElementById('confirm-yes')!;
        const confirmCancel = document.getElementById('confirm-cancel')!;
        let pendingDeleteId: string | null = null;

        function openConfirm(id: string) {
            pendingDeleteId = id;
            confirmOverlay.classList.remove('hidden');
        }
        function closeConfirm() {
            pendingDeleteId = null;
            confirmOverlay.classList.add('hidden');
        }
        confirmCancel.addEventListener('click', closeConfirm);
        confirmOverlay.addEventListener('click', (e) => { if (e.target === confirmOverlay) closeConfirm(); });

        confirmYes.addEventListener('click', async () => {
            if (!pendingDeleteId) return;
            confirmYes.textContent = 'Eliminando...';
            (confirmYes as HTMLButtonElement).disabled = true;
            const res = await fetch('/api/admin/projects', {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: pendingDeleteId }),
            });
            if (res.ok) location.reload();
            else {
                showToast('Error al eliminar', 'error');
                closeConfirm();
                confirmYes.textContent = 'Eliminar';
                (confirmYes as HTMLButtonElement).disabled = false;
            }
        });

        document.querySelectorAll('.btn-delete').forEach(btn => {
            btn.addEventListener('click', () => {
                openConfirm((btn as HTMLElement).dataset.id!);
            });
        });

        // Toast notification
                                function showToast(message: string, type: 'error' | 'success' = 'error') {
            const container = document.getElementById('toast-container')!;
            const toast = document.createElement('div');
            toast.className = `flex items-center shadow-2xl font-semibold pointer-events-auto ${
                type === 'success' ? 'bg-emerald-500 text-white shadow-emerald-500/30' : 'bg-rose-500 text-white shadow-rose-500/30'
            }`;
            toast.style.cssText = 'padding: 16px 24px; gap: 16px; border-radius: 16px; font-size: 16px; animation: toast-in 0.4s cubic-bezier(0.16, 1, 0.3, 1);';
            if (type === 'success') {
                toast.innerHTML = `<div class="bg-white/20 p-1.5 rounded-full flex items-center justify-center"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-5 h-5" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg></div><span>${message}</span>`;
            } else {
                toast.innerHTML = `<div class="bg-white/20 p-1.5 rounded-full flex items-center justify-center"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-5 h-5" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg></div><span>${message}</span>`;
            }
            container.appendChild(toast);
            setTimeout(() => { toast.style.animation = 'toast-out 0.3s ease-in forwards'; setTimeout(() => toast.remove(), 300); }, 4000);
        }

        document.getElementById('modal-save')?.addEventListener('click', async () => {
            const title = $('p-title').value.trim();
            if (!title) {
                errEl.textContent = 'El título es obligatorio';
                errEl.classList.remove('hidden');
                return;
            }

            const btn = document.getElementById('modal-save')!;
            const isEdit = !!$('project-id').value;
            const isFeatured = $('p-featured').checked;

            if (isFeatured) {
                const currentFeatured = document.querySelectorAll('.btn-toggle-featured[data-state="1"]');
                const alreadyFeaturedInList = Array.from(currentFeatured).some(el => (el as HTMLElement).dataset.id === $('project-id').value);
                
                if (!alreadyFeaturedInList && currentFeatured.length >= 3) {
                    errEl.textContent = 'Límite de 3 destacados alcanzado.';
                    errEl.classList.remove('hidden');
                    return;
                }
            }

            const oHtml = btn.innerHTML;
            btn.innerHTML = 'Guardando...';
            btn.setAttribute('disabled', 'true');

            const body: any = {
                title,
                slug: $('p-slug').value.trim() || null,
                client_name: $('p-client').value.trim() || null,
                description: $('p-description').value.trim() || null,
                thumbnail: $('p-thumbnail').value.trim() || null,
                video_project: $('p-video').value.trim() || null,
                video_explanation_mobile: $('p-makingof').value.trim() || null,
                featured_home: $('p-featured').checked
            };

            if (isEdit) body.id = $('project-id').value;

            try {
                const res = await fetch('/api/admin/projects', {
                    method: isEdit ? 'PUT' : 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body),
                });
                if (res.ok) {
                    location.reload();
                } else {
                    const err = await res.json();
                    errEl.textContent = err.error || 'Error';
                    errEl.classList.remove('hidden');
                    btn.innerHTML = oHtml;
                    btn.removeAttribute('disabled');
                }
            } catch (e) {
                errEl.textContent = 'Error conexión';
                errEl.classList.remove('hidden');
                btn.innerHTML = oHtml;
                btn.removeAttribute('disabled');
            }
        });
    });
</script>
