---
/**
 * Admin - Live Chat
 * View conversations and reply to visitors in real time
 */
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Chat en Vivo" activeSection="chat">

    <div class="flex gap-4 h-[calc(100vh-10rem)]">

        <!-- LEFT: Conversation List -->
        <div class="w-80 flex-shrink-0 flex flex-col glass rounded-2xl overflow-hidden">
            <div class="p-4 border-b border-dark-border">
                <h3 class="text-white font-[Outfit] font-bold text-sm">Conversaciones</h3>
                <p class="text-light-subtle text-xs mt-1" id="conv-count">Cargando...</p>
            </div>
            <div id="conv-list" class="flex-1 overflow-y-auto divide-y divide-dark-border/50">
                <!-- Conversations loaded dynamically -->
                <div class="p-4 text-center text-light-subtle text-xs">Cargando conversaciones...</div>
            </div>
        </div>

        <!-- RIGHT: Chat Area -->
        <div class="flex-1 flex flex-col glass rounded-2xl overflow-hidden">
            <!-- Header -->
            <div class="p-4 border-b border-dark-border flex items-center gap-3" id="chat-header">
                <div class="w-9 h-9 bg-carmin/10 rounded-full flex items-center justify-center">
                    <span class="text-carmin text-sm font-bold" id="chat-avatar">?</span>
                </div>
                <div>
                    <h3 class="text-white font-medium text-sm" id="chat-name">Selecciona una conversación</h3>
                    <p class="text-light-subtle text-xs" id="chat-status">Haz clic en una conversación para empezar</p>
                </div>
            </div>

            <!-- Messages -->
            <div id="admin-messages" class="flex-1 overflow-y-auto p-4 space-y-3">
                <div class="text-center text-light-subtle text-sm py-8">
                    <svg class="w-12 h-12 mx-auto mb-3 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                    </svg>
                    Selecciona una conversación para ver los mensajes
                </div>
            </div>

            <!-- Input -->
            <div class="p-4 border-t border-dark-border flex gap-3" id="admin-input-area" style="display:none">
                <input
                    type="text"
                    id="admin-input"
                    placeholder="Escribe una respuesta..."
                    class="flex-1 px-4 py-3 bg-dark-card border border-dark-border rounded-xl text-white text-sm placeholder-light-subtle focus:outline-none focus:border-carmin transition-colors"
                    maxlength="500"
                />
                <button
                    id="admin-send"
                    disabled
                    class="px-5 py-3 bg-gradient-carmin text-white font-semibold text-sm rounded-xl hover:shadow-glow-strong transition-all duration-300 disabled:opacity-40 disabled:cursor-not-allowed"
                >
                    Enviar
                </button>
            </div>
        </div>
    </div>

</AdminLayout>

<script>
    let activeConversationId: string | null = null;
    let convPollInterval: ReturnType<typeof setInterval> | null = null;
    let msgPollInterval: ReturnType<typeof setInterval> | null = null;

    const convList = document.getElementById('conv-list')!;
    const convCount = document.getElementById('conv-count')!;
    const chatName = document.getElementById('chat-name')!;
    const chatStatus = document.getElementById('chat-status')!;
    const chatAvatar = document.getElementById('chat-avatar')!;
    const adminMessages = document.getElementById('admin-messages')!;
    const adminInputArea = document.getElementById('admin-input-area')!;
    const adminInput = document.getElementById('admin-input') as HTMLInputElement;
    const adminSend = document.getElementById('admin-send') as HTMLButtonElement;

    // Load conversations
    async function loadConversations() {
        try {
            const res = await fetch('/api/chat?list=1');
            const conversations = await res.json();

            convCount.textContent = `${conversations.length} conversación${conversations.length !== 1 ? 'es' : ''}`;

            if (conversations.length === 0) {
                convList.innerHTML = `
                    <div class="p-6 text-center text-light-subtle text-xs">
                        <p>No hay conversaciones aún</p>
                        <p class="mt-1 opacity-50">Los visitantes pueden escribirte desde /contacto</p>
                    </div>
                `;
                return;
            }

            convList.innerHTML = conversations.map((conv: any) => {
                const isActive = conv.id === activeConversationId;
                const date = new Date(conv.updated_at).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
                const lastText = conv.last_message
                    ? (conv.last_message.length > 40 ? conv.last_message.substring(0, 40) + '...' : conv.last_message)
                    : 'Sin mensajes';
                const senderIcon = conv.last_sender === 'visitor' ? '→ ' : '← ';

                return `
                    <button
                        class="w-full p-4 text-left hover:bg-white/[0.02] transition-colors ${isActive ? 'bg-carmin/5 border-l-2 border-l-carmin' : ''}"
                        data-conv-id="${conv.id}"
                        data-conv-name="${conv.visitor_name}"
                    >
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 bg-carmin/10 rounded-full flex items-center justify-center flex-shrink-0">
                                <span class="text-carmin text-xs font-bold">${conv.visitor_name.charAt(0).toUpperCase()}</span>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center justify-between gap-2">
                                    <span class="text-white text-sm font-medium truncate">${conv.visitor_name}</span>
                                    <span class="text-light-subtle text-[10px] flex-shrink-0">${date}</span>
                                </div>
                                <p class="text-light-subtle text-xs mt-0.5 truncate">${senderIcon}${lastText}</p>
                            </div>
                        </div>
                    </button>
                `;
            }).join('');

            // Bind click events
            convList.querySelectorAll('button[data-conv-id]').forEach(btn => {
                btn.addEventListener('click', () => {
                    const id = (btn as HTMLElement).dataset.convId!;
                    const name = (btn as HTMLElement).dataset.convName!;
                    selectConversation(id, name);
                });
            });
        } catch (err) {
            console.error('Load conversations error:', err);
        }
    }

    function selectConversation(id: string, name: string) {
        activeConversationId = id;
        chatName.textContent = name;
        chatAvatar.textContent = name.charAt(0).toUpperCase();
        chatStatus.textContent = 'Conversación activa';
        adminInputArea.style.display = 'flex';
        adminInput.focus();

        // Highlight active in list
        loadConversations();

        // Load messages
        loadAdminMessages();

        // Start polling messages
        if (msgPollInterval) clearInterval(msgPollInterval);
        msgPollInterval = setInterval(loadAdminMessages, 3000);
    }

    async function loadAdminMessages() {
        if (!activeConversationId) return;
        try {
            const res = await fetch(`/api/chat?conversation_id=${activeConversationId}`);
            const messages = await res.json();

            if (messages.length === 0) {
                adminMessages.innerHTML = `
                    <div class="text-center text-light-subtle text-sm py-8">
                        No hay mensajes aún
                    </div>
                `;
                return;
            }

            // Check for new messages
            const existing = adminMessages.querySelectorAll('[data-msg-id]');
            const existingIds = new Set(Array.from(existing).map(el => (el as HTMLElement).dataset.msgId));

            let hasNew = false;
            messages.forEach((msg: any) => {
                if (!existingIds.has(msg.id)) {
                    if (!hasNew && existing.length > 0) {
                        // Only append new ones
                    } else if (existing.length === 0) {
                        adminMessages.innerHTML = '';
                    }

                    const isAdmin = msg.sender_type === 'admin';
                    const time = new Date(msg.created_at).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });

                    const div = document.createElement('div');
                    div.dataset.msgId = msg.id;
                    div.className = `flex ${isAdmin ? 'justify-end' : 'justify-start'}`;
                    div.innerHTML = `
                        <div class="max-w-[70%] px-4 py-2.5 rounded-2xl text-sm ${isAdmin
                            ? 'bg-gradient-to-r from-carmin to-carmin-900 text-white rounded-br-sm'
                            : 'glass text-light-muted rounded-bl-sm'
                        }">
                            <p>${msg.message}</p>
                            <span class="text-[10px] ${isAdmin ? 'text-white/50' : 'text-light-subtle'} mt-1 block">${time}</span>
                        </div>
                    `;
                    adminMessages.appendChild(div);
                    hasNew = true;
                }
            });

            if (hasNew) {
                adminMessages.scrollTop = adminMessages.scrollHeight;
            }
        } catch (err) {
            console.error('Load admin messages error:', err);
        }
    }

    // Send admin message
    adminInput.addEventListener('input', () => {
        adminSend.disabled = !adminInput.value.trim();
    });
    adminInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !adminSend.disabled) sendAdminMessage();
    });
    adminSend.addEventListener('click', sendAdminMessage);

    async function sendAdminMessage() {
        const text = adminInput.value.trim();
        if (!text || !activeConversationId) return;

        adminInput.value = '';
        adminSend.disabled = true;

        try {
            await fetch('/api/chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    action: 'send',
                    conversation_id: activeConversationId,
                    sender_type: 'admin',
                    message: text,
                }),
            });
            await loadAdminMessages();
            await loadConversations();
        } catch (err) {
            console.error('Send admin message error:', err);
        }
    }

    // Initial load
    loadConversations();
    convPollInterval = setInterval(loadConversations, 10000);
</script>
