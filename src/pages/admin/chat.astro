---
/**
 * Admin - Live Chat
 * View conversations and reply to visitors in real time
 */
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getServiceSupabase } from "../../lib/supabase";
import { getUserFromCookie } from "../../lib/auth";

const cookie = Astro.request?.headers.get("cookie") || "";
if (!Astro.request) return Astro.redirect('/admin/login');
const { user, error } = await getUserFromCookie(cookie);
if (!user) return Astro.redirect('/admin/login');
const serviceSupabase = getServiceSupabase();
if (!serviceSupabase) return Astro.redirect('/admin/login');
const { data: profile } = await serviceSupabase.from('profiles').select('is_admin').eq('id', user.id).maybeSingle();
if (!profile?.is_admin) return Astro.redirect('/admin/login');
---

<AdminLayout title="Chat en Vivo" activeSection="chat">

    <div class="chat-layout flex" style="gap: 1.5rem; height: calc(100vh - 8rem); padding-top: 0.5rem;">

        <!-- LEFT: Conversation List -->
        <div id="chat-conv-panel" class="chat-conv-panel flex-shrink-0 flex flex-col bg-zinc-950 border border-zinc-800 rounded-xl overflow-hidden shadow-sm" style="width: 20rem;">
            <div class="border-b border-zinc-800 bg-zinc-900/50" style="padding: 1rem;">
                <h3 class="text-zinc-100 font-medium text-sm">Conversaciones</h3>
                <p class="text-zinc-400 text-xs mt-1" id="conv-count">Cargando...</p>
            </div>
            <div id="conv-list" class="flex-1 overflow-y-auto divide-y divide-zinc-800">
                <!-- Conversations loaded dynamically -->
                <div class="text-center text-zinc-500 text-xs" style="padding: 1rem;">Cargando conversaciones...</div>
            </div>
        </div>

        <!-- RIGHT: Chat Area -->
        <div id="chat-messages-panel" class="chat-messages-panel flex-1 flex flex-col bg-zinc-950 border border-zinc-800 rounded-xl overflow-hidden shadow-sm">
            <!-- Header -->
            <div class="border-b border-zinc-800 bg-zinc-900/50 flex items-center" id="chat-header" style="padding: 1rem; gap: 0.75rem;">
                <button id="chat-back-btn" class="chat-back-btn hidden p-2 text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800 rounded-lg transition-colors" style="margin-right: 0.25rem;">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                </button>
                <div class="flex items-center justify-center bg-zinc-900 border border-zinc-800 rounded-full" style="width: 2.25rem; height: 2.25rem;">
                    <span class="text-rose-500 text-sm font-bold" id="chat-avatar">?</span>
                </div>
                <div class="flex-1">
                    <h3 class="text-zinc-100 font-medium text-sm" id="chat-name">Selecciona una conversación</h3>
                    <p class="text-zinc-400 text-xs" id="chat-status">Haz clic en una conversación para empezar</p>
                </div>
                <button
                    id="close-conv-btn"
                    style="display: none; padding: 0.5rem 1rem; gap: 0.4rem;"
                    class="flex items-center bg-zinc-900 border border-zinc-700 text-zinc-300 text-xs font-medium rounded-lg hover:bg-red-900/30 hover:border-red-700 hover:text-red-400 transition-all"
                >
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                    Cerrar chat
                </button>
            </div>

            <!-- Messages -->
            <div id="admin-messages" class="flex-1 overflow-y-auto" style="padding: 1.25rem; gap: 1rem; display: flex; flex-direction: column;">
                <div class="text-center text-zinc-500 text-sm py-12 flex flex-col items-center">
                    <svg class="w-12 h-12 mb-3 text-zinc-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                    </svg>
                    <span>Selecciona una conversación para ver los mensajes</span>
                </div>
            </div>

            <!-- Input -->
            <div class="border-t border-zinc-800 bg-zinc-900/50 flex" id="admin-input-area" style="display:none; padding: 1rem; gap: 0.75rem;">
                <input
                    type="text"
                    id="admin-input"
                    placeholder="Escribe una respuesta..."
                    class="flex-1 px-4 py-2.5 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 text-sm placeholder-zinc-500 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-all shadow-sm"
                    maxlength="500"
                />
                <button
                    id="admin-send"
                    disabled
                    class="px-5 py-2.5 bg-rose-600 text-white font-medium text-sm rounded-lg hover:bg-rose-500 transition-colors disabled:opacity-50 disabled:cursor-not-allowed shadow-sm"
                >
                    Enviar
                </button>
            </div>
        </div>
    </div>

    <!-- Chat responsive styles -->
    <style>
        @media (max-width: 768px) {
            .chat-layout {
                flex-direction: column !important;
                height: calc(100vh - 6rem) !important;
                gap: 0 !important;
                padding-top: 0 !important;
            }
            .chat-conv-panel {
                width: 100% !important;
                flex: 1;
                border-radius: 12px !important;
            }
            .chat-messages-panel {
                display: none !important;
                width: 100% !important;
                flex: 1;
                border-radius: 12px !important;
            }
            /* When a conversation is selected on mobile */
            .chat-layout.chat-active .chat-conv-panel {
                display: none !important;
            }
            .chat-layout.chat-active .chat-messages-panel {
                display: flex !important;
            }
            .chat-layout.chat-active .chat-back-btn {
                display: flex !important;
            }
        }
    </style>

    <!-- Cerrar Conversación Confirmation Modal -->
    <div id="confirm-overlay" class="fixed inset-0 bg-zinc-950/80 backdrop-blur-md z-[60] hidden flex items-center justify-center p-4">
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl w-[calc(100%-2rem)] sm:w-full max-w-[340px] shadow-2xl overflow-hidden" style="animation: toast-in 0.3s cubic-bezier(0.16, 1, 0.3, 1);">
            <div style="padding: 2rem 1.5rem 1.5rem; display: flex; flex-direction: column; align-items: center; text-align: center;">
                <div style="width: 56px; height: 56px; border-radius: 50%; background: rgba(225,29,72,0.1); border: 1px solid rgba(225,29,72,0.2); display: flex; justify-content: center; align-items: center; margin-bottom: 1.25rem;">
                    <svg class="w-7 h-7 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                </div>
                <h3 style="font-size: 1.15rem; font-weight: 600; color: #fff; margin-bottom: 0.5rem;">¿Cerrar conversación?</h3>
                <p style="font-size: 0.875rem; color: #a1a1aa; line-height: 1.4; margin: 0;">La conversación se cerrará. Si el visitante vuelve a escribir en unas horas, la conversación se reactivará y te notificará.</p>
            </div>
            <div style="display: flex; border-top: 1px solid #27272a; padding: 1rem; gap: 0.75rem; background: #09090b;">
                <button id="confirm-cancel" style="flex: 1; padding: 0.75rem; border-radius: 12px; background: #27272a; color: #e4e4e7; font-weight: 500; font-size: 0.9rem; border: 1px solid #3f3f46; cursor: pointer;">Cancelar</button>
                <button id="confirm-yes" style="flex: 1; padding: 0.75rem; border-radius: 12px; background: #e11d48; color: #fff; font-weight: 600; font-size: 0.9rem; border: 1px solid #be123c; cursor: pointer; box-shadow: 0 4px 12px rgba(225,29,72,0.3);">Cerrar Chat</button>
            </div>
        </div>
    </div>
</AdminLayout>

<script>
    let activeConversationId: string | null = null;
    let convPollInterval: ReturnType<typeof setInterval> | null = null;
    let msgPollInterval: ReturnType<typeof setInterval> | null = null;

    const convList = document.getElementById('conv-list')!;
    const convCount = document.getElementById('conv-count')!;
    const chatName = document.getElementById('chat-name')!;
    const chatStatus = document.getElementById('chat-status')!;
    const chatAvatar = document.getElementById('chat-avatar')!;
    const adminMessages = document.getElementById('admin-messages')!;
    const adminInputArea = document.getElementById('admin-input-area')!;
    const adminInput = document.getElementById('admin-input') as HTMLInputElement;
    const adminSend = document.getElementById('admin-send') as HTMLButtonElement;

    // Load conversations
    async function loadConversations() {
        try {
            const res = await fetch('/api/chat?list=1');
            const conversations = await res.json();

            if (!Array.isArray(conversations)) {
                convCount.textContent = 'Error al cargar';
                convList.innerHTML = `<div class="text-center text-zinc-500 text-xs" style="padding: 1rem;">No se encontraron tablas de chat ('chat_conversations') en la base de datos de Supabase.</div>`;
                return;
            }

            convCount.textContent = `${conversations.length} conversación${conversations.length !== 1 ? 'es' : ''}`;

            if (conversations.length === 0) {
                convList.innerHTML = `
                    <div class="p-6 text-center text-zinc-500 text-xs flex flex-col items-center">
                        <svg class="w-8 h-8 mb-3 text-zinc-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"></path></svg>
                        <p>No hay conversaciones aún</p>
                    </div>
                `;
                return;
            }

            convList.innerHTML = conversations.map((conv: any) => {
                const isActive = conv.id === activeConversationId;
                const date = new Date(conv.updated_at).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
                const lastText = conv.last_message
                    ? (conv.last_message.length > 40 ? conv.last_message.substring(0, 40) + '...' : conv.last_message)
                    : 'Sin mensajes';
                const senderIcon = conv.last_sender === 'visitor' ? '→ ' : '← ';

                return `
                    <button
                        class="w-full text-left hover:bg-zinc-800/30 transition-colors ${isActive ? 'bg-zinc-800/50 border-l-2 border-l-rose-500' : ''}"
                        data-conv-id="${conv.id}"
                        data-conv-name="${conv.visitor_name}"
                        style="padding: 1rem;"
                    >
                        <div class="flex items-center" style="gap: 0.75rem;">
                            <div class="bg-zinc-900 border border-zinc-800 rounded-full flex items-center justify-center flex-shrink-0" style="width: 2.5rem; height: 2.5rem;">
                                <span class="text-rose-400 text-sm font-bold">${conv.visitor_name.charAt(0).toUpperCase()}</span>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center justify-between gap-2">
                                    <span class="text-zinc-100 text-sm font-medium truncate">${conv.visitor_name}</span>
                                    <span class="text-zinc-500 text-[10px] flex-shrink-0">${date}</span>
                                </div>
                                <p class="text-zinc-400 text-xs mt-0.5 truncate">${senderIcon}${lastText}</p>
                            </div>
                        </div>
                    </button>
                `;
            }).join('');

            // Bind click events
            convList.querySelectorAll('button[data-conv-id]').forEach(btn => {
                btn.addEventListener('click', () => {
                    const id = (btn as HTMLElement).dataset.convId!;
                    const name = (btn as HTMLElement).dataset.convName!;
                    selectConversation(id, name);
                });
            });
        } catch (err) {
            console.error('Load conversations error:', err);
        }
    }

    const closeConvBtn = document.getElementById('close-conv-btn') as HTMLButtonElement;
    const chatLayout = document.querySelector('.chat-layout') as HTMLElement;
    const chatBackBtn = document.getElementById('chat-back-btn') as HTMLButtonElement;

    // Mobile back button handler
    chatBackBtn?.addEventListener('click', () => {
        chatLayout?.classList.remove('chat-active');
    });

    function selectConversation(id: string, name: string) {
        activeConversationId = id;
        chatName.textContent = name;
        chatAvatar.textContent = name.charAt(0).toUpperCase();
        chatStatus.textContent = 'Conversación activa';
        adminInputArea.style.display = 'flex';
        closeConvBtn.style.display = 'flex';
        adminInput.focus();

        // Mobile: activate chat view
        chatLayout?.classList.add('chat-active');

        // Highlight active in list
        loadConversations();

        // Load messages
        loadAdminMessages();

        // Start polling messages
        if (msgPollInterval) clearInterval(msgPollInterval);
        msgPollInterval = setInterval(loadAdminMessages, 3000);
    }

    // Modal elements
    const confirmOverlay = document.getElementById('confirm-overlay')!;
    const confirmCancel = document.getElementById('confirm-cancel')!;
    const confirmYes = document.getElementById('confirm-yes')!;

    // Close conversation handler
    closeConvBtn.addEventListener('click', () => {
        if (!activeConversationId) return;
        confirmOverlay.classList.remove('hidden');
    });

    confirmCancel.addEventListener('click', () => {
        confirmOverlay.classList.add('hidden');
    });

    confirmYes.addEventListener('click', async () => {
        if (!activeConversationId) return;
        confirmOverlay.classList.add('hidden');

        try {
            const res = await fetch('/api/chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: 'close', conversation_id: activeConversationId }),
            });
            if (res.ok) {
                // Reset UI
                activeConversationId = null;
                chatName.textContent = 'Conversación cerrada';
                chatStatus.textContent = 'Selecciona otra conversación';
                chatAvatar.textContent = '✓';
                adminInputArea.style.display = 'none';
                closeConvBtn.style.display = 'none';
                chatLayout?.classList.remove('chat-active');
                adminMessages.innerHTML = `
                    <div class="text-center text-zinc-500 text-sm py-12 flex flex-col items-center">
                        <svg class="w-10 h-10 mb-3 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7"/></svg>
                        <span>Conversación cerrada correctamente.</span>
                        <span class="text-zinc-600 text-xs mt-1">El visitante podrá iniciar una nueva conversación más adelante.</span>
                    </div>
                `;
                if (msgPollInterval) clearInterval(msgPollInterval);
                await loadConversations();
            }
        } catch (err) {
            console.error('Error closing conversation:', err);
        }
    });

    async function loadAdminMessages() {
        if (!activeConversationId) return;
        try {
            const res = await fetch(`/api/chat?conversation_id=${activeConversationId}`);
            const messages = await res.json();

            if (messages.length === 0) {
                adminMessages.innerHTML = `
                    <div class="text-center text-zinc-500 text-sm py-12">
                        No hay mensajes registrados aún en esta conversación.
                    </div>
                `;
                return;
            }

            // Check for new messages
            const existing = adminMessages.querySelectorAll('[data-msg-id]');
            const existingIds = new Set(Array.from(existing).map(el => (el as HTMLElement).dataset.msgId));

            let hasNew = false;
            messages.forEach((msg: any) => {
                if (!existingIds.has(msg.id)) {
                    if (!hasNew && existing.length > 0) {
                        // Only append new ones
                    } else if (existing.length === 0) {
                        adminMessages.innerHTML = '';
                    }

                    const isAdmin = msg.sender_type === 'admin';
                    const time = new Date(msg.created_at).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });

                    const div = document.createElement('div');
                    div.dataset.msgId = msg.id;
                    div.className = `flex ${isAdmin ? 'justify-end' : 'justify-start'}`;
                    div.innerHTML = `
                        <div class="max-w-[75%] px-4 py-2.5 shadow-sm text-sm ${isAdmin
                            ? 'bg-rose-600 text-white rounded-2xl rounded-tr-sm'
                            : 'bg-zinc-900 border border-zinc-800 text-zinc-300 rounded-2xl rounded-tl-sm'
                        }">
                            <p class="whitespace-pre-wrap ${isAdmin ? '' : 'leading-relaxed'}">${msg.message}</p>
                            <span class="text-[10px] flex justify-end ${isAdmin ? 'text-rose-200' : 'text-zinc-500'} mt-1.5 block">${time}</span>
                        </div>
                    `;
                    adminMessages.appendChild(div);
                    hasNew = true;
                }
            });

            if (hasNew) {
                adminMessages.scrollTop = adminMessages.scrollHeight;
            }
        } catch (err) {
            console.error('Load admin messages error:', err);
        }
    }

    // Send admin message
    adminInput.addEventListener('input', () => {
        adminSend.disabled = !adminInput.value.trim();
    });
    adminInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !adminSend.disabled) sendAdminMessage();
    });
    adminSend.addEventListener('click', sendAdminMessage);

    async function sendAdminMessage() {
        const text = adminInput.value.trim();
        if (!text || !activeConversationId) return;

        adminInput.value = '';
        adminSend.disabled = true;

        try {
            await fetch('/api/chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    action: 'send',
                    conversation_id: activeConversationId,
                    sender_type: 'admin',
                    message: text,
                }),
            });
            await loadAdminMessages();
            await loadConversations();
        } catch (err) {
            console.error('Send admin message error:', err);
        }
    }

    // Initial load
    loadConversations();
    convPollInterval = setInterval(loadConversations, 10000);
</script>
