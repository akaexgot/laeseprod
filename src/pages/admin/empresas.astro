---
/**
 * Admin - Companies (Logo Carousel) Management
 */
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getCompanies } from "../../lib/data";

const companies = await getCompanies();
---

<AdminLayout title="Empresas" activeSection="empresas">
    <div class="flex items-center justify-between mb-6">
        <p class="text-light-muted text-sm">
            {companies.length} empresas en carrusel
        </p>
        <button
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-carmin text-white text-sm font-semibold rounded-xl hover:shadow-glow transition-all duration-300"
        >
            <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 4v16m8-8H4"></path></svg
            >
            Añadir empresa
        </button>
    </div>

    <div class="glass rounded-2xl overflow-hidden">
        <table class="w-full">
            <thead>
                <tr class="border-b border-dark-border">
                    <th
                        class="text-left px-6 py-3 text-light-subtle text-xs font-medium uppercase tracking-wider"
                        >Logo</th
                    >
                    <th
                        class="text-left px-6 py-3 text-light-subtle text-xs font-medium uppercase tracking-wider"
                        >Nombre</th
                    >
                    <th
                        class="text-left px-6 py-3 text-light-subtle text-xs font-medium uppercase tracking-wider hidden sm:table-cell"
                        >Web</th
                    >
                    <th
                        class="text-left px-6 py-3 text-light-subtle text-xs font-medium uppercase tracking-wider"
                        >Orden</th
                    >
                    <th
                        class="text-right px-6 py-3 text-light-subtle text-xs font-medium uppercase tracking-wider"
                        >Acciones</th
                    >
                </tr>
            </thead>
            <tbody>
                {
                    companies.map((company: any) => (
                        <tr class="border-b border-dark-border/50 hover:bg-dark-hover transition-colors">
                            <td class="px-6 py-4">
                                <div class="w-12 h-8 bg-dark-card rounded-lg flex items-center justify-center">
                                    {company.logo_url ? (
                                        <img
                                            src={company.logo_url}
                                            alt={company.name}
                                            class="max-w-full max-h-full object-contain"
                                        />
                                    ) : (
                                        <span class="text-light-subtle text-xs">
                                            Logo
                                        </span>
                                    )}
                                </div>
                            </td>
                            <td class="px-6 py-4 text-white text-sm">
                                {company.name}
                            </td>
                            <td class="px-6 py-4 hidden sm:table-cell">
                                <span class="text-light-muted text-sm">
                                    {company.website || "-"}
                                </span>
                            </td>
                            <td class="px-6 py-4 text-light-muted text-sm">
                                {company.order}
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex items-center gap-1 justify-end">
                                    <button class="p-2 hover:bg-dark-card rounded-lg transition-colors">
                                        <svg
                                            class="w-4 h-4 text-light-subtle hover:text-carmin-light"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                                            />
                                        </svg>
                                    </button>
                                    <button class="p-2 hover:bg-dark-card rounded-lg transition-colors">
                                        <svg
                                            class="w-4 h-4 text-light-subtle hover:text-red-400"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                                            />
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    ))
                }
            </tbody>
        </table>
    </div>
</AdminLayout>
