---
/**
 * Admin Login Page - Premium Redesign
 * Cinematic Dark Aesthetic with Glassmorphism
 */
import "../../styles/global.css";
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="robots" content="noindex, nofollow" />
        <title>Acceso Admin | LaesePROD</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600&family=Space+Grotesk:wght@300;500;700&display=swap"
            rel="stylesheet"
        />
        <style>
            :root {
                --bg-dark: #050508;
            }
            body {
                background-color: var(--bg-dark);
                font-family: 'Inter', sans-serif;
                overflow: hidden;
                color: #fff;
            }
            .login-bg {
                position: fixed;
                inset: 0;
                z-index: -1;
                background: 
                    radial-gradient(circle at 18% 28%, rgba(255, 255, 255, 0.08) 0%, transparent 32%),
                    radial-gradient(circle at 80% 70%, rgba(255, 255, 255, 0.05) 0%, transparent 36%),
                    linear-gradient(135deg, rgba(255, 255, 255, 0.035), transparent 42%),
                    #050508;
            }
            .login-grid {
                position: absolute;
                inset: 0;
                background-image:
                    linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px),
                    linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px);
                background-size: 48px 48px;
                opacity: 0.38;
            }
            .login-container {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 1.5rem;
                perspective: 1000px;
            }
            .login-card {
                width: 100%;
                max-width: 470px;
                color: #000;
                background: rgba(255, 255, 255, 0.96);
                backdrop-filter: blur(24px);
                -webkit-backdrop-filter: blur(24px);
                border: 1px solid rgba(0, 0, 0, 0.1);
                border-radius: 2rem;
                padding: 3rem 2.4rem 2.4rem;
                box-shadow: 
                    0 28px 70px rgba(0, 0, 0, 0.38),
                    0 0 0 1px rgba(255, 255, 255, 0.7) inset;
                animation: cardEntry 1.2s cubic-bezier(0.16, 1, 0.3, 1);
                transition: background 220ms ease, color 220ms ease, border-color 220ms ease, box-shadow 220ms ease, transform 220ms ease;
            }
            @keyframes cardEntry {
                from { opacity: 0; transform: translateY(30px) rotateX(-5deg); }
                to { opacity: 1; transform: translateY(0) rotateX(0); }
            }
            .login-logo-wrapper {
                position: relative;
                width: min(250px, 72vw);
                height: 78px;
                margin: 0 auto 2.35rem;
                display: block;
                outline: none;
            }
            .login-logo {
                position: absolute;
                inset: 0;
                width: 100%;
                height: 100%;
                object-fit: contain;
                transition: opacity 180ms ease, transform 420ms cubic-bezier(.16, 1, .3, 1), filter 220ms ease;
            }
            .login-logo--dark { opacity: 1; filter: drop-shadow(0 10px 22px rgba(0,0,0,0.08)); }
            .login-logo--white { opacity: 0; }
            
            .input-group { margin-bottom: 1.75rem; }
            .input-label {
                display: block;
                font-family: 'Space Grotesk', sans-serif;
                font-size: 0.75rem;
                font-weight: 500;
                color: rgba(0,0,0,0.58);
                text-transform: uppercase;
                letter-spacing: 0.08em;
                margin-bottom: 0.75rem;
                transition: color 180ms ease;
            }
            .input-wrapper {
                position: relative;
                transition: transform 0.3s ease;
            }
            .input-wrapper:focus-within {
                transform: translateY(-2px);
            }
            .input-field {
                width: 100%;
                background: rgba(0, 0, 0, 0.045);
                border: 1px solid rgba(0, 0, 0, 0.12);
                border-radius: 999px;
                padding: 1.125rem 1.5rem;
                color: #000;
                font-size: 0.9375rem;
                outline: none;
                transition: color 180ms ease, background 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
                box-sizing: border-box;
            }
            .input-field:focus {
                background: #fff;
                border-color: #000;
                color: #000;
                box-shadow: 0 14px 34px rgba(0, 0, 0, 0.18);
            }
            .input-field::placeholder {
                color: rgba(0, 0, 0, 0.38);
            }
            .login-btn {
                width: 100%;
                background: #000;
                color: #fff;
                border: 1px solid #000;
                border-radius: 999px;
                padding: 1.125rem;
                font-family: 'Outfit', sans-serif;
                font-size: 1rem;
                font-weight: 700;
                cursor: pointer;
                transition: color 180ms ease, background 180ms ease, border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
                box-shadow: 0 18px 38px rgba(0, 0, 0, 0.18);
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 0.75rem;
            }
            .login-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 24px 46px rgba(0, 0, 0, 0.28);
            }
            .login-btn:active { transform: translateY(0); }
            .login-btn:disabled { opacity: 0.6; cursor: not-allowed; transform: none; box-shadow: none; }

            .error-box {
                background: rgba(239, 68, 68, 0.1);
                border: 1px solid rgba(239, 68, 68, 0.2);
                color: #f87171;
                padding: 1rem;
                border-radius: 1rem;
                font-size: 0.8125rem;
                margin-bottom: 1.75rem;
                display: none;
                animation: shake 0.5s ease;
            }
            @keyframes shake {
                0%, 100% { transform: translateX(0); }
                25%, 75% { transform: translateX(-4px); }
                50% { transform: translateX(4px); }
            }
            .back-link {
                display: inline-block;
                margin-top: 2rem;
                color: rgba(0,0,0,0.42);
                font-size: 0.8125rem;
                text-decoration: none;
                transition: color 0.3s;
                font-family: 'Space Grotesk', sans-serif;
                letter-spacing: 0.05em;
            }
            .back-link:hover { color: currentColor; opacity: .72; }
            @media (max-width: 560px) {
                body { overflow: auto; }
                .login-card { padding: 2.4rem 1.25rem 1.8rem; border-radius: 1.5rem; }
                .login-logo-wrapper { width: min(220px, 76vw); height: 68px; }
            }
        </style>
    </head>
    <body>
        <div class="login-bg"></div>
        <div class="login-grid"></div>

        <main class="login-container">
            <div class="login-card">
                <div class="flex flex-col items-center text-center">
                    <a class="login-logo-wrapper" href="/" aria-label="Volver a LaesePROD">
                        <img class="login-logo login-logo--white" src="/logopositivo.png" alt="LaesePROD" width="386" height="353" />
                        <img class="login-logo login-logo--dark" src="/logonegativo.png" alt="" width="386" height="353" aria-hidden="true" />
                    </a>
                    
                    <div id="login-error" class="error-box"></div>

                    <form id="login-form" class="w-full text-left" method="post" action="/api/auth/login">
                        <div class="input-group">
                            <label for="login-email" class="input-label">Identidad</label>
                            <div class="input-wrapper">
                                <input
                                    type="email"
                                    id="login-email"
                                    name="email"
                                    autocomplete="email"
                                    autocapitalize="off"
                                    spellcheck="false"
                                    required
                                    class="input-field"
                                    placeholder="admin@laeseprod.com"
                                />
                            </div>
                        </div>

                        <div class="input-group">
                            <label for="login-password" class="input-label">Clave de acceso</label>
                            <div class="input-wrapper">
                                <input
                                    type="password"
                                    id="login-password"
                                    name="password"
                                    autocomplete="current-password"
                                    required
                                    class="input-field"
                                    placeholder="••••••••"
                                />
                            </div>
                        </div>

                        <button type="submit" id="login-submit" class="login-btn">
                            <span>Ingresar al panel</span>
                            <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width: 20px; height: 20px;">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                            </svg>
                        </button>
                    </form>

                    <a href="/" class="back-link">
                        VOLVER
                    </a>
                </div>
            </div>
        </main>

        <script>
            document.getElementById('login-form')?.addEventListener('submit', async (e) => {
                e.preventDefault();
                const form = e.target as HTMLFormElement;
                const submitBtn = document.getElementById('login-submit') as HTMLButtonElement;
                const errorDiv = document.getElementById('login-error')!;
                
                errorDiv.style.display = 'none';
                submitBtn.disabled = true;
                const originalContent = submitBtn.innerHTML;
                submitBtn.innerHTML = '<span>Verificando...</span>';

                try {
                    const formData = new FormData(form);
                    const payload = Object.fromEntries(formData.entries());

                    const res = await fetch(form.action, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    const data = await res.json();

                    if (res.ok) {
                        window.location.href = data.redirect || '/admin';
                    } else {
                        errorDiv.textContent = data.error || 'Autenticación fallida';
                        errorDiv.style.display = 'block';
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = originalContent;
                    }
                } catch (err) {
                    console.error('Login connection error:', err);
                    errorDiv.textContent = 'No se pudo conectar con el servidor. Verifica tu conexión o las variables de entorno.';
                    errorDiv.style.display = 'block';
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalContent;
                }
            });

            // Catch URL errors
            (function(){
                const params = new URLSearchParams(window.location.search);
                const err = params.get('error');
                if (err) {
                    const errorDiv = document.getElementById('login-error');
                    if (errorDiv) {
                        errorDiv.textContent = decodeURIComponent(err);
                        errorDiv.style.display = 'block';
                    }
                }
            })();
        </script>
    </body>
</html>
