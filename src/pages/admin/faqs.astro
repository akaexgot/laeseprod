---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getFaqs, getServices, getSettings } from "../../lib/data";
const [services, settings] = await Promise.all([getServices(), getSettings()]);
const grouped = await Promise.all(services.map(async (service: any) => ({ service, faqs: await getFaqs(service.id, true) })));
---

<AdminLayout title="Preguntas frecuentes" activeSection="faqs">
    <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-10">
        <div><h1 class="text-2xl font-bold text-white">FAQ por servicio</h1><p class="text-sm text-zinc-400 mt-2">Bodas y Videoclips se gestionan de forma independiente.</p></div>
        <label class="flex items-center gap-3 text-sm text-zinc-300"><input id="faq-enabled" type="checkbox" checked={settings.faq_section_enabled !== false} class="w-4 h-4" />Mostrar FAQ en la web</label>
    </header>
    <div class="grid xl:grid-cols-2 gap-8">
        {grouped.map(({ service, faqs }) => (
            <section>
                <div class="flex items-center gap-3 mb-4"><i data-lucide={service.slug === "bodas" ? "heart" : "music-2"} class="w-5 h-5 text-white"></i><h2 class="text-xl font-semibold text-white">{service.title}</h2><span class="text-xs text-zinc-500">{faqs.length}</span></div>
                <div class="space-y-4">
                    {faqs.map((faq: any) => (
                        <form class="faq-editor bg-zinc-900 border border-zinc-800 rounded-lg p-5 space-y-4" data-id={faq.id} data-service-id={service.id}>
                            <div class="flex items-center justify-between"><strong class="text-sm text-zinc-200">Editar pregunta</strong><button type="button" class="delete-faq text-zinc-500 hover:text-red-400" title="Eliminar"><i data-lucide="trash-2" class="w-4 h-4"></i></button></div>
                            <label class="faq-field">Pregunta<input name="question" value={faq.question} required /></label>
                            <label class="faq-field">Respuesta<textarea name="answer" rows="4" required>{faq.answer}</textarea></label>
                            <div class="grid grid-cols-2 gap-4"><label class="faq-field">Orden<input type="number" name="order" min="0" value={faq.order ?? 0} /></label><label class="flex items-center gap-2 pt-6 text-sm text-zinc-300"><input type="checkbox" name="is_active" checked={faq.is_active} />Activa</label></div>
                            <button type="submit" class="w-full py-2 bg-white text-black rounded font-semibold text-sm">Guardar</button>
                        </form>
                    ))}
                    <form class="faq-editor bg-zinc-950 border border-dashed border-zinc-700 rounded-lg p-5 space-y-4" data-service-id={service.id}>
                        <strong class="text-sm text-zinc-200">Nueva pregunta</strong>
                        <label class="faq-field">Pregunta<input name="question" required /></label>
                        <label class="faq-field">Respuesta<textarea name="answer" rows="4" required></textarea></label>
                        <div class="grid grid-cols-2 gap-4"><label class="faq-field">Orden<input type="number" name="order" min="0" value="0" /></label><label class="flex items-center gap-2 pt-6 text-sm text-zinc-300"><input type="checkbox" name="is_active" checked />Activa</label></div>
                        <button type="submit" class="w-full py-2 bg-white text-black rounded font-semibold text-sm">Añadir</button>
                    </form>
                </div>
            </section>
        ))}
    </div>
    <p id="faq-status" class="fixed bottom-6 right-6 z-50 px-4 py-3 bg-white text-black rounded shadow-xl text-sm font-semibold hidden" aria-live="polite"></p>
</AdminLayout>

<style>
    .faq-field { display: grid; gap: .4rem; color: #d4d4d8; font-size: .75rem; font-weight: 600; }
    .faq-field input, .faq-field textarea { width: 100%; padding: .6rem .7rem; color: #fff; background: #09090b; border: 1px solid #3f3f46; border-radius: 4px; }
</style>

<script>
    const toast = document.getElementById('faq-status')!;
    function showStatus(message: string) { toast.textContent = message; toast.classList.remove('hidden'); setTimeout(() => toast.classList.add('hidden'), 2500); }
    document.querySelectorAll<HTMLFormElement>('.faq-editor').forEach((form) => {
        form.addEventListener('submit', async (event) => {
            event.preventDefault();
            const values = Object.fromEntries(new FormData(form));
            const body = { ...values, id: form.dataset.id || undefined, service_id: form.dataset.serviceId, order: Number(values.order || 0), is_active: (form.elements.namedItem('is_active') as HTMLInputElement).checked };
            const response = await fetch('/api/admin/faqs', { method: form.dataset.id ? 'PUT' : 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
            const result = await response.json().catch(() => ({}));
            if (!response.ok) return showStatus(result.error || 'No se pudo guardar.');
            showStatus('FAQ guardada.'); setTimeout(() => window.location.reload(), 500);
        });
        form.querySelector<HTMLButtonElement>('.delete-faq')?.addEventListener('click', async () => {
            if (!confirm('¿Eliminar esta pregunta?')) return;
            const response = await fetch('/api/admin/faqs', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: form.dataset.id }) });
            if (response.ok) form.remove(); else showStatus('No se pudo eliminar.');
        });
    });
    document.getElementById('faq-enabled')?.addEventListener('change', async (event) => {
        const enabled = (event.target as HTMLInputElement).checked;
        const response = await fetch('/api/admin/settings', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ faq_section_enabled: enabled }) });
        showStatus(response.ok ? 'Visibilidad actualizada.' : 'No se pudo actualizar.');
    });
</script>
