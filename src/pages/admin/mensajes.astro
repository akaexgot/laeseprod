---
/**
 * Admin - Messages
 * View and manage messages from the portal
 * Restyled with a premium Zinc Dark Mode aesthetic natively
 */
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getServiceSupabase } from "../../lib/supabase";

const supabase = getServiceSupabase();
let messages: any[] = [];
let error = null;

if (supabase) {
    const { data, error: sbError } = await supabase
        .from('contacts')
        .select('*')
        .order('created_at', { ascending: false });
        
    if (data) {
        messages = data;
    }
    if (sbError) {
        error = sbError.message;
    }
}
---

<AdminLayout title="Mensajes" activeSection="mensajes">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between" style="margin-bottom: 1.5rem; gap: 1rem;">
        <div>
            <p class="text-zinc-400 text-sm">Bandeja de entrada de las consultas de clientes. Total: <span class="text-zinc-100 font-medium">{messages.length}</span></p>
        </div>
        <div class="flex items-center" style="gap: 0.5rem;">
            <span class="inline-flex items-center rounded-md text-xs font-medium bg-zinc-900 border border-zinc-800 text-zinc-300" style="padding: 0.375rem 0.75rem; gap: 0.375rem;">
                <span class="w-2 h-2 rounded-full bg-rose-500 shadow-[0_0_8px_rgba(244,63,94,0.6)]"></span>
                {messages.filter(m => m.status === 'nuevo').length} Nuevos
            </span>
        </div>
    </div>

    {error && (
        <div class="mb-6 p-4 bg-red-500/10 border border-red-500/20 rounded-md text-red-400 text-sm">
            Error al cargar mensajes: {error}
        </div>
    )}

    <div class="bg-zinc-900 border border-zinc-800 rounded-xl overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
                <thead class="text-xs text-zinc-400 bg-zinc-950/50 uppercase border-b border-zinc-800">
                    <tr>
                        <th class="font-semibold w-64" style="padding: 1rem 1.5rem;">De / Empresa</th>
                        <th class="font-semibold" style="padding: 1rem 1.5rem;">Mensaje</th>
                        <th class="font-semibold w-40" style="padding: 1rem 1.5rem;">Fecha</th>
                        <th class="font-semibold text-right w-24" style="padding: 1rem 1.5rem;">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-800">
                    {messages.map((msg) => (
                        <tr class={`transition-colors group hover:bg-zinc-800/30 ${msg.status === 'nuevo' ? 'bg-zinc-800/20' : ''}`} data-id={msg.id}>
                            <td class="align-top" style="padding: 1rem 1.5rem;">
                                <div class="font-medium text-zinc-100 flex items-center" style="gap: 0.5rem; margin-bottom: 0.125rem;">
                                    {msg.name}
                                    {msg.status === 'nuevo' && <span class="w-2 h-2 rounded-full bg-rose-500 flex-shrink-0 shadow-[0_0_8px_rgba(244,63,94,0.6)]"></span>}
                                </div>
                                <div class="text-xs text-zinc-400 mb-1">
                                    <a href={`mailto:${msg.email}`} class="hover:text-rose-400 transition-colors">{msg.email}</a>
                                </div>
                                {msg.company && (
                                    <span class="inline-flex px-2 py-0.5 rounded text-[10px] font-medium bg-zinc-800 text-zinc-400 border border-zinc-700 mt-1">
                                        <i data-lucide="briefcase" class="w-3 h-3 mr-1 inline"></i> {msg.company}
                                    </span>
                                )}
                            </td>
                            <td class="align-top" style="padding: 1rem 1.5rem;">
                                <p class="text-zinc-300 text-sm whitespace-pre-wrap leading-relaxed">{msg.message}</p>
                            </td>
                            <td class="align-top text-xs text-zinc-500" style="padding: 1rem 1.5rem;">
                                {new Date(msg.created_at).toLocaleDateString('es-ES', { 
                                    year: 'numeric', month: 'short', day: 'numeric',
                                    hour: '2-digit', minute:'2-digit'
                                })}
                            </td>
                            <td class="align-top text-right" style="padding: 1rem 1.5rem;">
                                <div class="flex flex-col items-end opacity-0 group-hover:opacity-100 transition-opacity" style="gap: 0.5rem;">
                                    {msg.status === 'nuevo' && (
                                        <button 
                                            class="btn-mark-read inline-flex items-center gap-1.5 px-2.5 py-1.5 text-[10px] font-medium text-zinc-400 hover:text-emerald-400 hover:bg-emerald-400/10 rounded-md transition-colors w-full justify-end border border-transparent hover:border-emerald-400/20" 
                                            data-id={msg.id}
                                            title="Marcar como leído"
                                        >
                                            <i data-lucide="check-check" class="w-3.5 h-3.5"></i> Leer
                                        </button>
                                    )}
                                    <button 
                                        class="btn-delete inline-flex items-center gap-1.5 px-2.5 py-1.5 text-[10px] font-medium text-zinc-400 hover:text-red-400 hover:bg-red-400/10 rounded-md transition-colors w-full justify-end border border-transparent hover:border-red-400/20" 
                                        data-id={msg.id}
                                        title="Eliminar"
                                    >
                                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i> Borrar
                                    </button>
                                </div>
                            </td>
                        </tr>
                    ))}
                </tbody>
            </table>
        </div>
    </div>

    {messages.length === 0 && !error && (
        <div class="bg-zinc-900 border border-zinc-800 rounded-xl flex flex-col items-center justify-center text-center" style="padding: 3rem; margin-top: 1.5rem;">
            <div class="w-12 h-12 rounded-full bg-zinc-800/50 flex items-center justify-center border border-zinc-800" style="margin-bottom: 1rem;">
                <i data-lucide="mail-check" class="w-6 h-6 text-zinc-500"></i>
            </div>
            <h3 class="text-zinc-100 font-semibold" style="margin-bottom: 0.25rem;">Bandeja vacía</h3>
            <p class="text-zinc-400 text-sm max-w-sm">Aún no has recibido ningún mensaje de contacto.</p>
        </div>
    )}
</AdminLayout>

<!-- Delete Confirmation Modal -->
<div id="confirm-overlay" class="fixed inset-0 bg-zinc-950/80 backdrop-blur-md z-[60] hidden flex items-center justify-center p-4">
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl w-full max-w-[340px] shadow-2xl overflow-hidden" style="animation: toast-in 0.3s cubic-bezier(0.16, 1, 0.3, 1);">
        <div style="padding: 2rem 1.5rem 1.5rem; display: flex; flex-direction: column; align-items: center; text-align: center;">
            <div style="width: 56px; height: 56px; border-radius: 50%; background: rgba(225,29,72,0.1); border: 1px solid rgba(225,29,72,0.2); display: flex; justify-content: center; align-items: center; margin-bottom: 1.25rem;">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#fb7185" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
            </div>
            <h3 style="font-size: 1.15rem; font-weight: 600; color: #fff; margin-bottom: 0.5rem;">¿Eliminar permanentemente?</h3>
            <p style="font-size: 0.875rem; color: #a1a1aa; line-height: 1.4; margin: 0;">Esta acción no se puede deshacer. Los datos serán borrados del sistema.</p>
        </div>
        <div style="display: flex; border-top: 1px solid #27272a; padding: 1rem; gap: 0.75rem; background: #09090b;">
            <button id="confirm-cancel" style="flex: 1; padding: 0.75rem; border-radius: 12px; background: #27272a; color: #e4e4e7; font-weight: 500; font-size: 0.9rem; border: 1px solid #3f3f46; cursor: pointer;">Cancelar</button>
            <button id="confirm-yes" style="flex: 1; padding: 0.75rem; border-radius: 12px; background: #e11d48; color: #fff; font-weight: 600; font-size: 0.9rem; border: 1px solid #be123c; cursor: pointer; box-shadow: 0 4px 12px rgba(225,29,72,0.3);">Eliminar</button>
        </div>
    </div>
</div>
</div>

<!-- Toast Container -->
<div id="toast-container" class="fixed bottom-6 right-6 z-[70] flex flex-col gap-2" style="pointer-events: none;"></div>

<script>
    document.addEventListener('DOMContentLoaded', () => {

        // Toast notification
                                function showToast(message: string, type: 'error' | 'success' = 'error') {
            const container = document.getElementById('toast-container')!;
            const toast = document.createElement('div');
            toast.className = `flex items-center shadow-2xl font-semibold pointer-events-auto ${
                type === 'success' ? 'bg-emerald-500 text-white shadow-emerald-500/30' : 'bg-rose-500 text-white shadow-rose-500/30'
            }`;
            toast.style.cssText = 'padding: 16px 24px; gap: 16px; border-radius: 16px; font-size: 16px; animation: toast-in 0.4s cubic-bezier(0.16, 1, 0.3, 1);';
            if (type === 'success') {
                toast.innerHTML = `<div class="bg-white/20 p-1.5 rounded-full flex items-center justify-center"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-5 h-5" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg></div><span>${message}</span>`;
            } else {
                toast.innerHTML = `<div class="bg-white/20 p-1.5 rounded-full flex items-center justify-center"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-5 h-5" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg></div><span>${message}</span>`;
            }
            container.appendChild(toast);
            setTimeout(() => { toast.style.animation = 'toast-out 0.3s ease-in forwards'; setTimeout(() => toast.remove(), 300); }, 4000);
        }

        // Marcar como leído
        document.querySelectorAll('.btn-mark-read').forEach(btn => {
            btn.addEventListener('click', async () => {
                const id = (btn as HTMLElement).dataset.id;
                
                const icon = btn.querySelector('i')!;
                icon.setAttribute('data-lucide', 'loader-2');
                icon.classList.add('animate-spin');
                // @ts-ignore
                if (typeof lucide !== 'undefined') lucide.createIcons();

                try {
                    const res = await fetch('/api/admin/messages', {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ id, status: 'leido' })
                    });
                    
                    if (res.ok) {
                        location.reload();
                    } else {
                        showToast('Error al actualizar el mensaje', 'error');
                        location.reload();
                    }
                } catch (e) {
                    showToast('Error de conexión', 'error');
                }
            });
        });

        // Confirm modal logic
        const confirmOverlay = document.getElementById('confirm-overlay')!;
        const confirmYes = document.getElementById('confirm-yes')!;
        const confirmCancel = document.getElementById('confirm-cancel')!;
        let pendingDeleteId: string | null = null;

        function openConfirm(id: string) {
            pendingDeleteId = id;
            confirmOverlay.classList.remove('hidden');
        }
        function closeConfirm() {
            pendingDeleteId = null;
            confirmOverlay.classList.add('hidden');
        }
        confirmCancel.addEventListener('click', closeConfirm);
        confirmOverlay.addEventListener('click', (e) => { if (e.target === confirmOverlay) closeConfirm(); });

        confirmYes.addEventListener('click', async () => {
            if (!pendingDeleteId) return;
            confirmYes.textContent = 'Eliminando...';
            (confirmYes as HTMLButtonElement).disabled = true;
            try {
                const res = await fetch('/api/admin/messages', {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: pendingDeleteId })
                });
                if (res.ok) location.reload();
                else {
                    showToast('Error al eliminar', 'error');
                    closeConfirm();
                    confirmYes.textContent = 'Eliminar';
                    (confirmYes as HTMLButtonElement).disabled = false;
                }
            } catch (e) {
                showToast('Error de conexión', 'error');
                closeConfirm();
                confirmYes.textContent = 'Eliminar';
                (confirmYes as HTMLButtonElement).disabled = false;
            }
        });

        document.querySelectorAll('.btn-delete').forEach(btn => {
            btn.addEventListener('click', () => {
                openConfirm((btn as HTMLElement).dataset.id!);
            });
        });
    });
</script>
