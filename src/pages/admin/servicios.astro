---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getServices } from "../../lib/data";
const services = await getServices();
---

<AdminLayout title="Servicios" activeSection="servicios">
    <header class="mb-10"><h1 class="text-2xl font-bold text-white">Bodas y Videoclips</h1><p class="text-zinc-400 text-sm mt-2">Los dos servicios son fijos; puedes editar sus textos y vídeos.</p></header>
    <div class="grid xl:grid-cols-2 gap-6">
        {services.map((service: any) => (
            <form class="service-editor bg-zinc-900 border border-zinc-800 rounded-lg p-6 space-y-5" data-service-id={service.id}>
                <div class="flex items-center justify-between"><div><h2 class="text-xl font-semibold text-white">{service.title}</h2><p class="text-xs text-zinc-500 mt-1">/{service.slug}</p></div><i data-lucide={service.slug === "bodas" ? "heart" : "music-2"} class="w-6 h-6 text-zinc-400"></i></div>
                <label class="service-field">Título<input name="title" value={service.title} required /></label>
                <label class="service-field">Descripción<textarea name="description" rows="5">{service.description}</textarea></label>
                <label class="service-field">Vídeo horizontal
                    <div class="flex gap-2"><input id={`video-${service.id}`} name="video" value={service.video || ""} /><button class="service-upload" type="button" data-target={`video-${service.id}`}><i data-lucide="upload" class="w-4 h-4"></i></button></div>
                </label>
                <label class="service-field">Vídeo vertical
                    <div class="flex gap-2"><input id={`vertical-${service.id}`} name="video_vertical" value={service.video_vertical || ""} /><button class="service-upload" type="button" data-target={`vertical-${service.id}`}><i data-lucide="upload" class="w-4 h-4"></i></button></div>
                </label>
                <button class="save-service w-full py-2.5 bg-white text-black rounded-md font-semibold text-sm" type="submit">Guardar {service.title}</button>
                <p class="service-status min-h-5 text-xs text-zinc-400" aria-live="polite"></p>
            </form>
        ))}
    </div>
    <input id="service-file" type="file" accept="video/mp4,video/webm" class="hidden" />
</AdminLayout>

<style>
    .service-field { display: grid; gap: .4rem; color: #d4d4d8; font-size: .8rem; font-weight: 600; }
    .service-field input, .service-field textarea { width: 100%; padding: .65rem .75rem; color: #fff; background: #09090b; border: 1px solid #3f3f46; border-radius: 4px; }
    .service-field input:focus, .service-field textarea:focus { outline: none; border-color: #fff; }
    .service-upload { display: grid; place-items: center; flex: 0 0 42px; color: #fff; background: #27272a; border: 1px solid #52525b; border-radius: 4px; }
</style>

<script>
    const fileInput = document.getElementById('service-file') as HTMLInputElement;
    let targetId = '';
    document.querySelectorAll<HTMLButtonElement>('.service-upload').forEach((button) => button.addEventListener('click', () => {
        targetId = button.dataset.target || '';
        fileInput.click();
    }));
    fileInput.addEventListener('change', async () => {
        const file = fileInput.files?.[0];
        const target = document.getElementById(targetId) as HTMLInputElement | null;
        if (!file || !target) return;
        const form = target.closest<HTMLFormElement>('.service-editor')!;
        const status = form.querySelector<HTMLElement>('.service-status')!;
        status.textContent = 'Subiendo vídeo...';
        const body = new FormData(); body.append('file', file); body.append('folder', 'service_videos');
        const response = await fetch('/api/admin/upload', { method: 'POST', body });
        const result = await response.json();
        if (response.ok) { target.value = result.url; status.textContent = 'Vídeo subido. Guarda el servicio.'; }
        else status.textContent = result.error || 'No se pudo subir.';
        fileInput.value = '';
    });
    document.querySelectorAll<HTMLFormElement>('.service-editor').forEach((form) => form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const status = form.querySelector<HTMLElement>('.service-status')!;
        const button = form.querySelector<HTMLButtonElement>('.save-service')!;
        button.disabled = true; status.textContent = 'Guardando...';
        const body = { id: form.dataset.serviceId, ...Object.fromEntries(new FormData(form)) };
        const response = await fetch('/api/admin/services', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
        const result = await response.json().catch(() => ({}));
        status.textContent = response.ok ? 'Servicio guardado.' : (result.error || 'No se pudo guardar.');
        button.disabled = false;
    }));
</script>
