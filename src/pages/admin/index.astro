---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getProjects, getServices } from "../../lib/data";
import { getServiceSupabase } from "../../lib/supabase";
import { getUserFromCookie } from "../../lib/auth";

// SSR auth is handled by middleware
const serviceSupabase = getServiceSupabase()!;

const projects = await getProjects();
const services = await getServices();

// Get recent messages from the contacts table
let recentMessages: any[] = [];
if (serviceSupabase) {
    const { data } = await serviceSupabase
        .from('contacts')
        .select('*')
        .order('created_at', { ascending: false })
        .limit(5);
    if (data) recentMessages = data;
}

const stats = [
    { label: "Proyectos", value: projects.length, href: "/admin/proyectos", 
      icon: "video", textClass: "text-blue-500", bgClass: "bg-blue-500/10 border-blue-500/20" },
    { label: "Servicios", value: services.length, href: "/admin/servicios",
      icon: "layers", textClass: "text-zinc-100", bgClass: "bg-zinc-800 border-zinc-700" }
];
---

<AdminLayout title="Dashboard" activeSection="dashboard">
    <!-- Stats Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 mb-8 mt-2" style="gap: 1.5rem; margin-bottom: 2rem;">
        {stats.map(stat => (
            <a href={stat.href} class="block rounded-2xl bg-zinc-900 border border-zinc-800 hover:border-zinc-700 hover:bg-zinc-800/80 transition-all duration-300 group shadow-lg" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1.25rem;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div class={`w-12 h-12 rounded-xl flex items-center justify-center border ${stat.bgClass} ${stat.textClass} group-hover:scale-110 transition-transform duration-300 shadow-sm`}>
                        <i data-lucide={stat.icon} class="w-6 h-6"></i>
                    </div>
                </div>
                <div style="display: flex; flex-direction: column; gap: 0.35rem;">
                    <h3 class="text-3xl font-bold text-white tracking-tight leading-none" style="margin: 0;">{stat.value}</h3>
                    <p class="text-sm font-medium text-zinc-400" style="margin: 0;">{stat.label}</p>
                </div>
            </a>
        ))}
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3" style="gap: 2rem;">
        <!-- Recent Messages -->
        <div class="lg:col-span-2 space-y-4" style="display: flex; flex-direction: column; gap: 1rem;">
            <div class="flex items-center justify-between" style="margin-bottom: 1rem;">
                <h2 class="text-lg font-semibold text-zinc-50 flex items-center" style="gap: 0.5rem;">
                    Mensajes Recientes
                </h2>
                <a href="/admin/mensajes" class="text-sm font-medium text-zinc-400 hover:text-zinc-50 transition-colors bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 rounded-md" style="padding: 0.375rem 0.75rem;">Ver todos</a>
            </div>
            
            <div class="bg-zinc-900 border border-zinc-800 rounded-xl overflow-hidden shadow-sm">
                {recentMessages.length > 0 ? (
                    <div class="divide-y divide-zinc-800">
                        {recentMessages.map(msg => (
                            <a href="/admin/mensajes" class="block hover:bg-zinc-800/50 transition-colors group" style="padding: 1.25rem;">
                                <div class="flex flex-col sm:flex-row sm:items-start justify-between" style="gap: 1rem;">
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center" style="gap: 0.75rem; margin-bottom: 0.25rem;">
                                            <h4 class="font-medium text-zinc-100 flex items-center truncate" style="gap: 0.5rem;">
                                                {msg.name}
                                                {msg.status === 'nuevo' && <span class="flex-shrink-0 w-2 h-2 rounded-full bg-white shadow-[0_0_8px_rgba(0, 0, 0,0.6)]"></span>}
                                            </h4>
                                            <span class="text-xs text-zinc-500 whitespace-nowrap">
                                                {new Date(msg.created_at).toLocaleDateString('es-ES', { month: 'short', day: 'numeric', hour: '2-digit', minute:'2-digit' })}
                                            </span>
                                        </div>
                                        <p class="text-xs text-zinc-400 truncate" style="margin-bottom: 0.5rem;">{msg.email} · {msg.phone}</p>
                                        <p class="text-sm text-zinc-300 line-clamp-2">{msg.idea || 'Sin idea descrita'}</p>
                                    </div>
                                    <div class="hidden sm:block text-zinc-600 group-hover:text-zinc-400 transition-colors">
                                        <i data-lucide="chevron-right" class="w-5 h-5"></i>
                                    </div>
                                </div>
                            </a>
                        ))}
                    </div>
                ) : (
                    <div class="text-center text-zinc-500 flex flex-col items-center" style="padding: 3rem;">
                        <div class="w-16 h-16 rounded-full bg-zinc-800/50 flex items-center justify-center border border-zinc-800" style="margin-bottom: 1rem;">
                            <i data-lucide="mail-check" class="w-8 h-8 text-zinc-600"></i>
                        </div>
                        <p class="text-sm font-medium text-zinc-300" style="margin-bottom: 0.25rem;">Bandeja de entrada al día</p>
                        <p class="text-xs">No tienes mensajes nuevos de clientes cruzados.</p>
                    </div>
                )}
            </div>
        </div>

        <!-- Featured Projects -->
        <div class="space-y-4" style="display: flex; flex-direction: column; gap: 1rem;">
            <div class="flex items-center justify-between" style="margin-bottom: 1rem;">
                <h2 class="text-lg font-semibold text-zinc-50 flex items-center" style="gap: 0.5rem;">
                    Proyectos Destacados
                </h2>
                <a href="/admin/proyectos" class="text-sm font-medium text-zinc-400 hover:text-zinc-50 transition-colors bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 rounded-md" style="padding: 0.375rem 0.75rem;">Gestionar</a>
            </div>

            <div class="bg-zinc-900 border border-zinc-800 rounded-xl overflow-hidden shadow-sm">
                {projects.filter(p => (p as any).featured_home).length > 0 ? (
                    <div class="divide-y divide-zinc-800">
                        {projects.filter(p => (p as any).featured_home).map(project => (
                            <a href={`/admin/proyectos`} class="flex gap-4 hover:bg-zinc-800/50 transition-colors group" style="padding: 1rem;">
                                <div class="w-20 h-14 bg-zinc-950 rounded-md overflow-hidden border border-zinc-800 flex-shrink-0 relative">
                                    {(project as any).thumbnail ? (
                                        <img src={(project as any).thumbnail} alt={(project as any).title} class="w-full h-full object-cover opacity-90 group-hover:opacity-100 transition-opacity" />
                                    ) : (
                                        <div class="w-full h-full flex items-center justify-center text-zinc-600 text-[10px] uppercase font-semibold">Sin Img</div>
                                    )}
                                </div>
                                <div class="flex-1 min-w-0 flex flex-col justify-center">
                                    <h4 class="font-medium text-zinc-100 text-sm truncate group-hover:text-zinc-200 transition-colors">{(project as any).title}</h4>
                                    <p class="text-xs text-zinc-400 truncate" style="margin-top: 0.125rem;">
                                        {(project as any).client_name}
                                    </p>
                                </div>
                            </a>
                        ))}
                    </div>
                ) : (
                    <div class="text-center text-zinc-500" style="padding: 2.5rem;">
                        <div class="w-12 h-12 rounded-full bg-zinc-800/50 flex items-center justify-center mx-auto border border-zinc-800" style="margin-bottom: 0.75rem;">
                            <i data-lucide="star-off" class="w-5 h-5 text-zinc-600"></i>
                        </div>
                        <p class="text-sm font-medium text-zinc-300" style="margin-bottom: 0.25rem;">Sin destacados</p>
                        <p class="text-xs">No hay proyectos fijados para la página de inicio.</p>
                    </div>
                )}
            </div>
        </div>
    </div>
</AdminLayout>
