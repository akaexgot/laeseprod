---
/**
 * Admin - SEO Management
 * Edit meta tags, schema, pages SEO
 */
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="SEO" activeSection="seo">
    <!-- SEO Overview -->
    <div class="grid grid-cols-1 md:grid-cols-3" style="gap: 1rem; margin-bottom: 2rem;">
        <div class="glass rounded-2xl" style="padding: 1.5rem;">
            <h3 class="text-white font-[Outfit] font-semibold" style="margin-bottom: 0.25rem;">
                Estado SEO
            </h3>
            <p class="text-green-400 text-sm">✓ Schema.org activo</p>
            <p class="text-green-400 text-sm">✓ Open Graph configurado</p>
            <p class="text-green-400 text-sm">✓ Sitemap generado</p>
        </div>
        <div class="glass rounded-2xl" style="padding: 1.5rem;">
            <h3 class="text-white font-[Outfit] font-semibold" style="margin-bottom: 0.25rem;">
                Palabras Clave
            </h3>
            <div class="flex flex-wrap" style="gap: 0.375rem; margin-top: 0.5rem;">
                <span
                    class="bg-carmin/10 text-carmin-light rounded-full text-xs"
                    style="padding: 0.125rem 0.5rem;"
                    >video marketing sevilla</span
                >
                <span
                    class="bg-carmin/10 text-carmin-light rounded-full text-xs"
                    style="padding: 0.125rem 0.5rem;"
                    >productora audiovisual</span
                >
                <span
                    class="bg-carmin/10 text-carmin-light rounded-full text-xs"
                    style="padding: 0.125rem 0.5rem;"
                    >videos para empresas</span
                >
            </div>
        </div>
        <div class="glass rounded-2xl" style="padding: 1.5rem;">
            <h3 class="text-white font-[Outfit] font-semibold" style="margin-bottom: 0.25rem;">URLs</h3>
            <p class="text-light-muted text-sm">
                Sitemap: <a
                    href="/sitemap.xml"
                    class="text-carmin-light hover:underline">/sitemap.xml</a>
            </p>
            <p class="text-light-muted text-sm">
                Robots: <a
                    href="/robots.txt"
                    class="text-carmin-light hover:underline">/robots.txt</a>
            </p>
        </div>
    </div>

    <!-- Pages SEO Editor -->
    <h2 class="text-lg font-[Outfit] font-semibold text-white" style="margin-bottom: 1rem;">
        Meta por Página
    </h2>
    <div class="flex flex-col" style="gap: 0.75rem;">
        {
            [
                { path: "/", title: "Home", hasCustom: true },
                { path: "/proyectos", title: "Proyectos", hasCustom: true },
                { path: "/servicios", title: "Servicios", hasCustom: true },
                { path: "/sectores", title: "Sectores", hasCustom: true },
                {
                    path: "/quienes-somos",
                    title: "Quiénes Somos",
                    hasCustom: false,
                },
                { path: "/contacto", title: "Contacto", hasCustom: false },
            ].map((page) => (
                <div class="glass rounded-2xl flex items-center justify-between hover:border-carmin/20 transition-all duration-300" style="padding: 1.25rem;">
                    <div class="flex items-center" style="gap: 0.75rem;">
                        <span
                            class:list={[
                                "w-2 h-2 rounded-full",
                                page.hasCustom
                                    ? "bg-green-400"
                                    : "bg-yellow-400",
                            ]}
                        />
                        <div>
                            <h3 class="text-white text-sm font-medium">
                                {page.title}
                            </h3>
                            <p class="text-light-subtle text-xs">{page.path}</p>
                        </div>
                    </div>
                    <button class="text-sm text-light-muted hover:text-white hover:bg-dark-card rounded-xl transition-all" style="padding: 0.5rem 1rem;">
                        Editar meta
                    </button>
                </div>
            ))
        }
    </div>
</AdminLayout>
