---
/**
 * Admin - Cartas Management Main List
 */
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getServiceSupabase } from "../../../lib/supabase";

const sb = getServiceSupabase()!;
const userProfile = Astro.locals.userProfile;

// Permission check
if (!userProfile?.is_admin && !userProfile?.permissions?.includes('carta')) {
    return Astro.redirect('/admin');
}

const { data: cartas } = await sb.from('cartas').select('*').order('created_at', { ascending: false });
---

<AdminLayout title="Cartas de Servicios" activeSection="carta">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4" style="margin-bottom: 3.5rem !important;">
        <div>
            <h1 class="text-2xl font-bold text-white tracking-tight">Cartas</h1>
            <p class="text-zinc-400 text-sm" style="margin-top: 0.75rem !important;">Gestiona los listados de servicios públicos. Total: <span class="text-zinc-100 font-medium">{cartas?.length || 0}</span></p>
        </div>
        <button id="btn-add"
            class="inline-flex items-center justify-center bg-rose-600 text-white text-sm font-medium rounded-md hover:bg-rose-500 transition-colors shadow-sm"
            style="padding: 0.5rem 1rem; gap: 0.5rem;"
        >
            <i data-lucide="plus" class="w-4 h-4"></i>
            Nueva Carta
        </button>
    </div>

    <!-- Divider -->
    <div style="margin-bottom: 4rem !important;"></div>

    <div class="bg-zinc-900 border border-zinc-800 rounded-xl overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left" id="cartas-table">
                <thead class="text-xs text-zinc-500 uppercase tracking-wider font-semibold bg-zinc-900/50">
                    <tr class="border-b border-zinc-800/50">
                        <th style="padding: 1.25rem 1.5rem;">Nombre</th>
                        <th class="hidden sm:table-cell w-32" style="padding: 1.25rem 1.5rem;">Tipo</th>
                        <th class="hidden md:table-cell" style="padding: 1.25rem 1.5rem;">Enlace Público</th>
                        <th class="text-right w-40" style="padding: 1.25rem 1.5rem;">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-800">
                    {cartas?.map((req: any) => (
                        <tr class="hover:bg-zinc-800/30 transition-colors group">
                            <td style="padding: 1.25rem 1.5rem;">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded bg-zinc-950 border border-zinc-800 flex items-center justify-center text-zinc-400">
                                        <i data-lucide={req.tipo === 'imagenes' ? 'image' : (req.tipo === 'pdf' ? 'file-text' : 'layout-list')} class="w-4 h-4"></i>
                                    </div>
                                    <div class="font-medium text-zinc-100">{req.nombre}</div>
                                </div>
                            </td>
                            <td class="hidden sm:table-cell" style="padding: 1.25rem 1.5rem;">
                                <span class="capitalize text-xs px-2 py-1 bg-zinc-800 text-zinc-300 rounded border border-zinc-700">{req.tipo}</span>
                            </td>
                            <td class="hidden md:table-cell" style="padding: 1.25rem 1.5rem;">
                                <a href={`/carta/${req.slug}`} target="_blank" class="text-rose-400 hover:text-rose-300 transition-colors flex items-center gap-1.5 text-xs">
                                    /carta/{req.slug} <i data-lucide="external-link" class="w-3 h-3"></i>
                                </a>
                            </td>
                            <td class="text-right" style="padding: 1.25rem 1.5rem;">
                                <div class="flex items-center justify-end gap-1">
                                    <a href={`/admin/carta/${req.id}`} class="p-2 text-zinc-400 hover:text-zinc-50 hover:bg-zinc-800 rounded-lg transition-all" title="Editar Contenido">
                                        <i data-lucide="edit" class="w-4.5 h-4.5"></i>
                                    </a>
                                    <button class="p-2 text-zinc-500 hover:text-red-500 hover:bg-red-500/10 rounded-lg transition-all btn-delete" data-id={req.id} title="Eliminar">
                                        <i data-lucide="trash-2" class="w-4.5 h-4.5"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    ))}
                    {(!cartas || cartas.length === 0) && (
                        <tr>
                            <td colspan="4" class="text-center py-8 text-zinc-500">No hay cartas creadas todavía.</td>
                        </tr>
                    )}
                </tbody>
            </table>
        </div>
    </div>

</AdminLayout>

<!-- Modal de Creación -->
<div id="modal-overlay" class="fixed inset-0 bg-zinc-950/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-zinc-900 border border-zinc-800 rounded-xl w-[calc(100%-2rem)] sm:w-full max-w-lg shadow-2xl overflow-hidden">
        <div class="flex items-center justify-between border-b border-zinc-800 p-5">
            <h3 class="text-lg font-semibold text-zinc-50">Crear Nueva Carta</h3>
            <button id="modal-close" class="text-zinc-400 hover:text-zinc-100"><i data-lucide="x" class="w-5 h-5"></i></button>
        </div>
        <div style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1.5rem;">
            <div>
                <label class="block text-sm font-medium text-zinc-300 mb-2">Nombre interno *</label>
                <input type="text" id="c-nombre" class="w-full px-4 py-2.5 border border-zinc-800 bg-zinc-950 rounded-lg text-zinc-100 focus:outline-none focus:border-rose-500 shadow-sm" placeholder="Ej: Precios Bodas 2024" />
            </div>
            <div>
                <label class="block text-sm font-medium text-zinc-300 mb-2">Slug (Ruta URL pública)</label>
                <input type="text" id="c-slug" class="w-full px-4 py-2.5 border border-zinc-800 bg-zinc-950 rounded-lg text-zinc-100 focus:outline-none focus:border-rose-500 shadow-sm" placeholder="Dejar vacío para autogenerar" />
            </div>
            <div>
                <label class="block text-sm font-medium text-zinc-300 mb-3">Tipo de Contenido *</label>
                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem;">
                    <label class="cursor-pointer h-full">
                        <input type="radio" name="c-tipo" value="imagenes" class="peer hidden" checked />
                        <div class="h-full p-4 border border-zinc-800 bg-zinc-950/50 rounded-xl text-center peer-checked:border-rose-500 peer-checked:bg-rose-500/10 hover:border-zinc-700 transition-all flex flex-col items-center justify-center gap-2">
                            <i data-lucide="image" class="w-6 h-6 text-zinc-500 peer-checked:text-rose-400 m-0"></i>
                            <span class="text-xs font-semibold text-zinc-400 peer-checked:text-rose-300">Imágenes</span>
                        </div>
                    </label>
                    <label class="cursor-pointer h-full">
                        <input type="radio" name="c-tipo" value="pdf" class="peer hidden" />
                        <div class="h-full p-4 border border-zinc-800 bg-zinc-950/50 rounded-xl text-center peer-checked:border-rose-500 peer-checked:bg-rose-500/10 hover:border-zinc-700 transition-all flex flex-col items-center justify-center gap-2">
                            <i data-lucide="file-text" class="w-6 h-6 text-zinc-500 peer-checked:text-rose-400 m-0"></i>
                            <span class="text-xs font-semibold text-zinc-400 peer-checked:text-rose-300">PDF</span>
                        </div>
                    </label>
                    <label class="cursor-pointer h-full">
                        <input type="radio" name="c-tipo" value="manual" class="peer hidden" />
                        <div class="h-full p-4 border border-zinc-800 bg-zinc-950/50 rounded-xl text-center peer-checked:border-rose-500 peer-checked:bg-rose-500/10 hover:border-zinc-700 transition-all flex flex-col items-center justify-center gap-2">
                            <i data-lucide="layout-list" class="w-6 h-6 text-zinc-500 peer-checked:text-rose-400 m-0"></i>
                            <span class="text-xs font-semibold text-zinc-400 peer-checked:text-rose-300">Manual</span>
                        </div>
                    </label>
                </div>
            </div>

            <!-- Dynamic Content Area -->
            <div id="dynamic-upload-area" class="bg-zinc-900 border border-zinc-800 rounded-xl p-5 shadow-inner">
                <!-- Imagenes -->
                <div id="area-imagenes" class="upload-area block">
                    <label class="block text-sm font-medium text-zinc-300 mb-3">Imágenes de la carta</label>
                    <div id="drop-imgs" class="relative group cursor-pointer border-2 border-dashed border-zinc-800 hover:border-rose-500/50 bg-zinc-950/50 rounded-xl transition-all h-32 flex flex-col items-center justify-center p-4 text-center">
                        <input type="file" id="file-create-imgs" multiple accept="image/*" class="hidden" />
                        <i data-lucide="image-plus" class="w-8 h-8 text-zinc-500 group-hover:text-rose-400 mb-2 transition-colors"></i>
                        <span id="text-imgs" class="text-sm font-medium text-zinc-400 group-hover:text-zinc-300 transition-colors">Arrastra tus imágenes aquí o haz clic</span>
                    </div>
                </div>
                <!-- PDF -->
                <div id="area-pdf" class="upload-area hidden">
                    <label class="block text-sm font-medium text-zinc-300 mb-3">Archivo PDF</label>
                    <div id="drop-pdf" class="relative group cursor-pointer border-2 border-dashed border-zinc-800 hover:border-rose-500/50 bg-zinc-950/50 rounded-xl transition-all h-32 flex flex-col items-center justify-center p-4 text-center">
                        <input type="file" id="file-create-pdf" accept="application/pdf" class="hidden" />
                        <i data-lucide="file-up" class="w-8 h-8 text-zinc-500 group-hover:text-rose-400 mb-2 transition-colors"></i>
                        <span id="text-pdf" class="text-sm font-medium text-zinc-400 group-hover:text-zinc-300 transition-colors">Arrastra tu PDF aquí o haz clic</span>
                    </div>
                    <p class="text-xs text-zinc-500 mt-3 flex items-center gap-1.5"><i data-lucide="info" class="w-4 h-4"></i> El PDF se rasterizará y convertirá a imágenes.</p>
                </div>
                <!-- Manual -->
                <div id="area-manual" class="upload-area hidden">
                    <div class="flex items-start gap-3 bg-zinc-950/50 border border-zinc-800/80 p-4 rounded-lg text-zinc-400 text-sm">
                        <i data-lucide="info" class="w-5 h-5 shrink-0 text-rose-500 mt-0.5"></i>
                        <p class="leading-relaxed">Crearemos la carta base y te redirigiremos al <strong>editor avanzado</strong> para que puedas diseñar los bloques y servicios cómodamente.</p>
                    </div>
                </div>
                <!-- Uploading Status -->
                <div id="upload-status" class="hidden items-center gap-3 mt-5 px-4 py-3 bg-rose-500/10 border border-rose-500/20 rounded-lg text-xs font-semibold text-rose-400">
                    <i data-lucide="loader-2" class="w-4 h-4 animate-spin shrink-0"></i> 
                    <span id="upload-status-text">Subiendo archivos...</span>
                </div>
            </div>

            <div style="border-top: 1px solid #27272a; padding-top: 1.5rem;">
                <label class="block text-sm font-medium text-zinc-300 mb-2">Vídeo YouTube (Opcional)</label>
                <input type="url" id="c-video" class="w-full px-4 py-2.5 border border-zinc-800 bg-zinc-950 rounded-lg text-zinc-100 focus:outline-none focus:border-rose-500 shadow-sm" placeholder="https://youtube.com/..." />
            </div>
        </div>
        <div class="bg-zinc-950/80 backdrop-blur-sm relative" style="border-top: 1px solid #27272a; padding: 1.25rem 1.5rem; display: flex; justify-content: flex-end; gap: 1rem; align-items: center;">
            <span id="modal-err" class="text-rose-400 text-sm font-medium absolute left-6 top-6 hidden"></span>
            <button id="modal-btn-cancel" class="text-zinc-400 hover:text-white transition-colors" style="padding: 0.625rem 1.25rem; font-size: 0.875rem; font-weight: 500; border-radius: 0.5rem;">Cancelar</button>
            <button id="modal-btn-save" class="bg-rose-600 hover:bg-rose-500 text-white font-medium shadow-sm transition-all" style="padding: 0.625rem 1.5rem; font-size: 0.875rem; font-weight: 600; border-radius: 0.5rem;">Crear Carta</button>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="confirm-overlay" class="fixed inset-0 bg-zinc-950/80 backdrop-blur-md z-[60] hidden flex items-center justify-center p-4">
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl w-[calc(100%-2rem)] sm:w-full max-w-[340px] shadow-2xl overflow-hidden" style="animation: toast-in 0.3s cubic-bezier(0.16, 1, 0.3, 1);">
        <div style="padding: 2rem 1.5rem 1.5rem; display: flex; flex-direction: column; align-items: center; text-align: center;">
            <div style="width: 56px; height: 56px; border-radius: 50%; background: rgba(225,29,72,0.1); border: 1px solid rgba(225,29,72,0.2); display: flex; justify-content: center; align-items: center; margin-bottom: 1.25rem;">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#fb7185" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
            </div>
            <h3 style="font-size: 1.15rem; font-weight: 600; color: #fff; margin-bottom: 0.5rem;">¿Eliminar carta?</h3>
            <p style="font-size: 0.875rem; color: #a1a1aa; line-height: 1.4; margin: 0;">Esta acción borrará la carta y todos sus servicios asociados permanentemente.</p>
        </div>
        <div style="display: flex; border-top: 1px solid #27272a; padding: 1rem; gap: 0.75rem; background: #09090b;">
            <button id="confirm-cancel" style="flex: 1; padding: 0.75rem; border-radius: 12px; background: #27272a; color: #e4e4e7; font-weight: 500; font-size: 0.9rem; border: 1px solid #3f3f46; cursor: pointer;">Cancelar</button>
            <button id="confirm-yes" style="flex: 1; padding: 0.75rem; border-radius: 12px; background: #e11d48; color: #fff; font-weight: 600; font-size: 0.9rem; border: 1px solid #be123c; cursor: pointer; box-shadow: 0 4px 12px rgba(225,29,72,0.3);">Eliminar</button>
        </div>
    </div>
</div>

<!-- Toast Container -->
<div id="toast-container" class="fixed bottom-6 right-6 z-[70] flex flex-col gap-2" style="pointer-events: none;"></div>

<script>
    function initializeIndexInteractions() {
        // Modal Logic
        const overlay = document.getElementById('modal-overlay')!;
        const closeModals = [document.getElementById('modal-close'), document.getElementById('modal-btn-cancel')];
        const btnAdd = document.getElementById('btn-add');
        const errSpan = document.getElementById('modal-err')!;

        btnAdd?.addEventListener('click', () => {
            overlay.classList.remove('hidden');
        });

        closeModals.forEach(b => b?.addEventListener('click', () => {
            overlay.classList.add('hidden');
            errSpan.classList.add('hidden');
        }));

        // overlay.addEventListener('click', (e) => {
        //     if (e.target === overlay) overlay.classList.add('hidden');
        // });

        // Dynamic sections
        const radioBtns = document.querySelectorAll('input[name="c-tipo"]');
        radioBtns.forEach(r => {
            r.addEventListener('change', (e) => {
                const val = (e.target as HTMLInputElement).value;
                document.querySelectorAll('.upload-area').forEach(el => {
                    el.classList.add('hidden');
                    el.classList.remove('block');
                });
                const target = document.getElementById(`area-${val}`);
                if (target) {
                    target.classList.remove('hidden');
                    target.classList.add('block');
                }
            });
        });

        // Drag & Drop Setup
        function setupDropZone(dropId: string, inputId: string, textId: string, fileLabelPlural: boolean) {
            const drop = document.getElementById(dropId)!;
            const input = document.getElementById(inputId) as HTMLInputElement;
            const text = document.getElementById(textId)!;

            drop.addEventListener('click', () => input.click());
            
            drop.addEventListener('dragover', (e) => { 
                e.preventDefault(); 
                drop.classList.add('border-rose-500', 'bg-rose-500/10'); 
            });
            
            drop.addEventListener('dragleave', (e) => { 
                drop.classList.remove('border-rose-500', 'bg-rose-500/10'); 
            });
            
            drop.addEventListener('drop', (e) => {
                e.preventDefault();
                drop.classList.remove('border-rose-500', 'bg-rose-500/10');
                if (e.dataTransfer?.files.length) {
                    input.files = e.dataTransfer.files;
                    updateText();
                }
            });
            
            input.addEventListener('change', updateText);

            function updateText() {
                const count = input.files?.length || 0;
                if (count === 0) {
                    text.textContent = fileLabelPlural ? 'Arrastra tus imágenes aquí o haz clic' : 'Arrastra tu PDF aquí o haz clic';
                    text.classList.remove('text-rose-400');
                } else if (count === 1) {
                    text.textContent = input.files![0].name;
                    text.classList.add('text-rose-400');
                } else {
                    text.textContent = `${count} imágenes seleccionadas`;
                    text.classList.add('text-rose-400');
                }
            }
        }

        setupDropZone('drop-imgs', 'file-create-imgs', 'text-imgs', true);
        setupDropZone('drop-pdf', 'file-create-pdf', 'text-pdf', false);

        document.getElementById('modal-btn-save')?.addEventListener('click', async (e) => {
            const btn = e.target as HTMLButtonElement;
            const statusBox = document.getElementById('upload-status')!;
            const statusText = document.getElementById('upload-status-text')!;
            
            const nombre = (document.getElementById('c-nombre') as HTMLInputElement).value.trim();
            if(!nombre) {
                errSpan.textContent = 'El nombre es obligatorio';
                errSpan.classList.remove('hidden');
                return;
            }

            const tipo = (document.querySelector('input[name="c-tipo"]:checked') as HTMLInputElement).value;
            const slug = (document.getElementById('c-slug') as HTMLInputElement).value.trim() || undefined;
            const videoUrl = (document.getElementById('c-video') as HTMLInputElement).value.trim() || undefined;

            btn.textContent = 'Procesando...';
            btn.disabled = true;
            errSpan.classList.add('hidden');

            let imagenesToSave: {url: string, orden: number}[] = [];

            try {
                // Handle file uploads based on type BEFORE creating the carta
                if (tipo === 'imagenes') {
                    const fileIn = document.getElementById('file-create-imgs') as HTMLInputElement;
                    const files = fileIn.files;
                    if (files && files.length > 0) {
                        statusBox.classList.remove('hidden');
                        statusBox.classList.add('flex');
                        
                        for(let i=0; i<files.length; i++){
                            statusText.textContent = `Subiendo imagen ${i+1} de ${files.length}...`;
                            const fd = new FormData();
                            fd.append('file', files[i]);
                            fd.append('folder', 'cartas');
                            const r = await fetch('/api/admin/upload', { method: 'POST', body: fd });
                            if(r.ok) {
                                const d = await r.json();
                                imagenesToSave.push({ url: d.url, orden: i });
                            } else {
                                throw new Error(`Error en archivo ${i+1}`);
                            }
                        }
                    }
                } else if (tipo === 'pdf') {
                    const fileIn = document.getElementById('file-create-pdf') as HTMLInputElement;
                    const files = fileIn.files;
                    if (files && files.length > 0) {
                        statusBox.classList.remove('hidden');
                        statusBox.classList.add('flex');
                        statusText.textContent = 'Subiendo y procesando PDF...';

                        const fd = new FormData();
                        fd.append('file', files[0]);
                        fd.append('folder', 'cartas');
                        const r = await fetch('/api/admin/upload', { method: 'POST', body: fd });
                        
                        if(r.ok) {
                            const d = await r.json();
                            const bUrl = d.url.replace('.pdf', '.jpg');
                            for(let p = 1; p <= d.pages; p++) {
                                const split = bUrl.split('/upload/');
                                const pgUrl = `${split[0]}/upload/pg_${p}/${split[1]}`;
                                imagenesToSave.push({ url: pgUrl, orden: p });
                            }
                        } else {
                            throw new Error('Error subiendo PDF');
                        }
                    }
                }

                statusBox.classList.remove('flex');
                statusBox.classList.add('hidden');

                // 1. Create the Carta item
                statusText.textContent = 'Guardando configuración...';
                statusBox.classList.remove('hidden');
                statusBox.classList.add('flex');

                const res = await fetch('/api/admin/cartas', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ nombre, slug, tipo, video_url: videoUrl })
                });

                if (res.ok) {
                    const data = await res.json();
                    
                    // 2. If we collected images to save, save them using the detailed endpoint
                    if (imagenesToSave.length > 0) {
                        statusText.textContent = 'Guardando imágenes...';
                        await fetch(`/api/admin/cartas/${data.id}`, {
                            method: 'PUT',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ tipo, imagenes: imagenesToSave })
                        });
                    }

                    // Redirect to editor
                    window.location.href = `/admin/carta/${data.id}`;
                } else {
                    const errorObj = await res.json();
                    throw new Error(errorObj.error || 'Error interno');
                }

            } catch (err: any) {
                errSpan.textContent = err.message || 'Error en el proceso';
                errSpan.classList.remove('hidden');
                statusBox.classList.remove('flex');
                statusBox.classList.add('hidden');
                btn.textContent = 'Crear Carta';
                btn.disabled = false;
            }
        });

        // Toast notification
        function showToast(message: string, type: 'error' | 'success' = 'error') {
            const container = document.getElementById('toast-container')!;
            const toast = document.createElement('div');
            toast.className = `flex items-center shadow-2xl font-semibold pointer-events-auto ${
                type === 'success' ? 'bg-emerald-500 text-white shadow-emerald-500/30' : 'bg-rose-500 text-white shadow-rose-500/30'
            }`;
            toast.style.cssText = 'padding: 16px 24px; gap: 16px; border-radius: 16px; font-size: 16px; animation: toast-in 0.4s cubic-bezier(0.16, 1, 0.3, 1);';
            if (type === 'success') {
                toast.innerHTML = `<div class="bg-white/20 p-1.5 rounded-full flex items-center justify-center"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-5 h-5" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg></div><span>${message}</span>`;
            } else {
                toast.innerHTML = `<div class="bg-white/20 p-1.5 rounded-full flex items-center justify-center"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-5 h-5" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg></div><span>${message}</span>`;
            }
            container.appendChild(toast);
            setTimeout(() => { toast.style.animation = 'toast-out 0.3s ease-in forwards'; setTimeout(() => toast.remove(), 300); }, 4000);
        }

        // Eliminar logic
        const confirmOverlay = document.getElementById('confirm-overlay')!;
        const confirmYes = document.getElementById('confirm-yes')!;
        const confirmCancel = document.getElementById('confirm-cancel')!;
        let pendingDeleteId: string | null = null;

        function openConfirm(id: string) {
            pendingDeleteId = id;
            confirmOverlay.classList.remove('hidden');
        }
        function closeConfirm() {
            pendingDeleteId = null;
            confirmOverlay.classList.add('hidden');
        }
        confirmCancel.addEventListener('click', closeConfirm);
        // confirmOverlay.addEventListener('click', (e) => { if (e.target === confirmOverlay) closeConfirm(); });

        confirmYes.addEventListener('click', async () => {
            if (!pendingDeleteId) return;
            confirmYes.textContent = 'Eliminando...';
            (confirmYes as HTMLButtonElement).disabled = true;

            try {
                const res = await fetch('/api/admin/cartas', {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: pendingDeleteId })
                });
                if(res.ok) {
                    showToast('Carta eliminada correctamente', 'success');
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    showToast('Error al eliminar la carta', 'error');
                    closeConfirm();
                }
            } catch (err) {
                showToast('Error de conexión', 'error');
                closeConfirm();
            } finally {
                confirmYes.textContent = 'Eliminar';
                (confirmYes as HTMLButtonElement).disabled = false;
            }
        });

        document.querySelectorAll('.btn-delete').forEach(btn => {
            btn.addEventListener('click', () => {
                const id = (btn as HTMLElement).dataset.id;
                if(id) openConfirm(id);
            });
        });
    }

    initializeIndexInteractions();
</script>
