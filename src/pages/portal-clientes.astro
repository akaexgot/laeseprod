---
/**
 * Portal Cliente Page — Logo Grid Design
 * Grid of client logos with long-press password modal → Dropbox embed
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPortalClients } from '../lib/data';

const allClients = await getPortalClients();
const clients = allClients.filter((c: any) => c.is_active);
---

<BaseLayout
  title="Portal Cliente"
  description="Portal exclusivo para clientes de VideoMarketing Sevilla. Accede a tus archivos y materiales audiovisuales."
  noindex={true}
>

  <!-- ═══ HERO ═══ -->
  <section class="pc-hero">
      <div class="pc-hero__glow"></div>
      <div class="section-container pc-hero__inner">
          <div class="pc-hero__badge">
              <span class="pc-hero__dot"></span>
              <span>Acceso exclusivo</span>
          </div>
          <h1 class="pc-hero__title">
              Portal <span class="text-gradient-carmin">cliente</span>
          </h1>
          <p class="pc-hero__subtitle">
              Pulsa tu tarjeta para acceder a tus archivos
          </p>

          <!-- Search -->
          <div class="pc-search">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              <input type="text" id="client-search" placeholder="Buscar cliente..." />
          </div>
      </div>
  </section>

  <!-- ═══ LOGO GRID ═══ -->
  <section class="pc-grid-section">
      <div class="section-container">
          <div id="clients-grid" class="pc-grid">
              {clients.map((client, idx) => (
                  <div
                      class="pc-card group"
                      data-client-id={client.id}
                      data-client-name={client.client_name}
                      data-dropbox={client.dropbox_link || ''}
                      style={`animation-delay: ${idx * 0.1}s`}
                  >
                      <!-- Logo area -->
                      <div class="pc-card__logo-area">
                          {client.image ? (
                              <img src={client.image} alt={client.client_name} class={`pc-card__logo-img pc-card__logo-img--${client.image_type || 'logo'}`} loading="lazy" />
                          ) : (
                              <div class="pc-card__logo-placeholder">
                                  <span class="pc-card__logo-initial">{client.client_name.charAt(0)}</span>
                              </div>
                          )}
                          <!-- Long-press indicator ring -->
                          <div class="pc-card__ring"></div>
                          <!-- Lock icon -->
                          <div class="pc-card__lock">
                              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                              </svg>
                          </div>
                      </div>
                      <!-- Info -->
                      <div class="pc-card__info">
                          <h3 class="pc-card__name">{client.client_name}</h3>
                          <p class="pc-card__hint">Pulsa para acceder</p>
                      </div>
                  </div>
              ))}
          </div>
      </div>
  </section>

  <!-- ═══ PASSWORD MODAL ═══ -->
  <div id="password-modal" class="pc-modal">
      <div class="pc-modal__backdrop" id="modal-backdrop"></div>
      <div class="pc-modal__content" id="modal-content">
          <button id="modal-close" class="pc-modal__close">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
          <div class="pc-modal__icon">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
          </div>
          <h3 id="modal-title" class="pc-modal__title">Acceso cliente</h3>
          <p class="pc-modal__subtitle">Introduce tu contraseña para acceder a tus archivos</p>
          <form id="password-form">
              <input type="password" id="password-input" placeholder="Contraseña" class="pc-modal__input" autocomplete="off" />
              <div id="password-error" class="pc-modal__error hidden">Contraseña incorrecta</div>
              <button type="submit" class="pc-modal__submit">Acceder</button>
          </form>
      </div>
  </div>

  <!-- ═══ DROPBOX MODAL ═══ -->
  <div id="dropbox-modal" class="pc-modal">
      <div class="pc-modal__backdrop" id="dropbox-backdrop"></div>
      <div class="pc-modal__content" id="dropbox-content">
          <button id="dropbox-close" class="pc-modal__close">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
          
          <div class="pc-modal__icon" style="background: rgba(16, 185, 129, 0.1);">
              <svg fill="none" stroke="#10b981" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
          </div>
          
          <h3 id="dropbox-title" class="pc-modal__title" style="margin-bottom: 0.5rem;">Acceso verificado</h3>
          <p class="pc-modal__subtitle">Tu conexión es segura. Haz clic en el botón para acceder a la carpeta compartida con tus archivos.</p>
          
          <a id="dropbox-link-btn" href="#" target="_blank" class="pc-modal__submit" style="display: inline-block; text-decoration: none; box-sizing: border-box; background: linear-gradient(135deg, #0061FE, #004ecc);">
              Abrir archivos de cliente
          </a>
      </div>
  </div>

</BaseLayout>

<style>
/* ── GLOBAL OVERRIDES PARA LIGHT THEME ── */
:global(body), :global(main) {
    background-color: #ffffff !important;
}
:global(.nav-link) {
    color: #c42847 !important;
    font-weight: 500;
}
:global(.nav-link:hover), :global(.nav-link.active) {
    color: #9b1b30 !important;
}
:global(.navbar) {
    background: rgba(255, 255, 255, 0.9) !important;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
}

/* ── HERO ─────────────────────────────────────── */
.pc-hero {
    position: relative; padding-top: 9rem; padding-bottom: 3rem;
    background: #ffffff; overflow: hidden; text-align: center;
}
.pc-hero__glow {
    position: absolute; top: 0; left: 50%;
    transform: translateX(-50%);
    width: 600px; height: 400px; pointer-events: none;
    background: radial-gradient(circle, rgba(155,27,48,0.1) 0%, transparent 70%);
}
.pc-hero__inner {
    position: relative; z-index: 10;
    display: flex; flex-direction: column; align-items: center; gap: 1rem;
}
.pc-hero__badge {
    display: inline-flex; align-items: center; gap: .5rem;
    padding: .375rem 1rem; border-radius: 9999px;
    border: 1px solid rgba(155,27,48,.3); background: rgba(155,27,48,.05);
    font-size: .75rem; font-weight: 600; letter-spacing: .08em;
    text-transform: uppercase; color: #c42847;
    backdrop-filter: blur(8px);
}
.pc-hero__dot {
    display: block; width: 7px; height: 7px; border-radius: 50%;
    background: #c42847; animation: pc-pulse 2s infinite;
    box-shadow: 0 0 8px rgba(196,40,71,.7);
}
.pc-hero__title {
    font-family: 'Outfit', sans-serif;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 800; color: #18181b;
    line-height: 1.1; letter-spacing: -.03em; margin: 0;
}
.pc-hero__subtitle {
    font-size: 1rem; color: rgba(0,0,0,.6);
    line-height: 1.7; max-width: 440px; margin: 0;
}
.pc-search {
    position: relative; margin-top: .5rem; width: 100%; max-width: 380px;
}
.pc-search svg {
    position: absolute; left: 1rem; top: 50%; transform: translateY(-50%);
    width: 1.125rem; height: 1.125rem; color: rgba(0,0,0,.4);
}
.pc-search input {
    width: 100%; padding: .875rem 1rem .875rem 2.75rem;
    background: #ffffff; border: 1px solid rgba(0,0,0,.1);
    border-radius: 1rem; color: #18181b; font-size: .875rem;
    outline: none; transition: border-color .2s;
    box-shadow: 0 4px 12px rgba(0,0,0,.03);
}
.pc-search input::placeholder { color: rgba(0,0,0,.4); }
.pc-search input:focus { border-color: rgba(155,27,48,.4); }

/* ── GRID ─────────────────────────────────────── */
.pc-grid-section {
    position: relative; background: #ffffff; padding: 2rem 0 6rem;
}
.pc-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    position: relative; z-index: 10;
}
@media (min-width: 640px) { .pc-grid { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; } }
@media (min-width: 1024px) { .pc-grid { grid-template-columns: repeat(4, 1fr); gap: 2rem; } }

/* ── CARD ─────────────────────────────────────── */
.pc-card {
    cursor: pointer;
    text-align: center;
    user-select: none;
    -webkit-user-select: none;
    animation: pc-fade-up 0.6s ease both;
}
.pc-card__logo-area {
    position: relative;
    width: 100%; aspect-ratio: 1;
    border-radius: 1.5rem;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid rgba(0,0,0,.08);
    transition: border-color .3s, box-shadow .3s, transform .3s;
    display: flex; align-items: center; justify-content: center;
}
.pc-card:hover .pc-card__logo-area {
    border-color: rgba(155,27,48,.25);
    box-shadow: 0 16px 40px rgba(0,0,0,.08);
    transform: translateY(-4px);
}
.pc-card__logo-img {
    transition: filter .3s, transform .5s;
}
.pc-card__logo-img--logo {
    width: 70%; height: 70%;
    object-fit: contain;
    filter: grayscale(0.3) brightness(0.9);
}
.pc-card__logo-img--image {
    width: 100%; height: 100%;
    object-fit: cover;
    filter: brightness(0.95);
}
.pc-card:hover .pc-card__logo-img {
    filter: grayscale(0) brightness(1);
    transform: scale(1.05);
}
.pc-card__logo-placeholder {
    width: 100%; height: 100%;
    background: linear-gradient(135deg, rgba(155,27,48,.03), rgba(155,27,48,.01));
    display: flex; align-items: center; justify-content: center;
}
.pc-card__logo-initial {
    font-family: 'Outfit', sans-serif;
    font-size: 3rem; font-weight: 800;
    color: rgba(155,27,48,.25);
    transition: color .3s;
}
.pc-card:hover .pc-card__logo-initial {
    color: rgba(155,27,48,.45);
}

/* Ring animation on long-press */
.pc-card__ring {
    position: absolute; inset: 0;
    border-radius: 1.5rem;
    border: 2px solid transparent;
    pointer-events: none;
    transition: border-color .3s;
}
.pc-card--pressing .pc-card__ring {
    border-color: #c42847;
    animation: pc-ring-fill 2s linear;
}

/* Lock icon */
.pc-card__lock {
    position: absolute; bottom: .75rem; right: .75rem;
    width: 2rem; height: 2rem;
    border-radius: .625rem;
    background: rgba(255,255,255,.9);
    border: 1px solid rgba(0,0,0,.05);
    display: flex; align-items: center; justify-content: center;
    opacity: .4; transition: opacity .3s;
}
.pc-card__lock svg { width: 1rem; height: 1rem; color: rgba(0,0,0,.6); }
.pc-card:hover .pc-card__lock { opacity: .8; }

/* Info */
.pc-card__info { padding: .875rem .25rem 0; }
.pc-card__name {
    font-family: 'Outfit', sans-serif;
    font-size: .9375rem; font-weight: 600;
    color: #18181b; margin: 0;
}
.pc-card__hint {
    font-size: .6875rem; color: rgba(0,0,0,.5);
    margin: .25rem 0 0;
}

/* ── MODAL (shared) ───────────────────────────── */
.pc-modal {
    position: fixed; inset: 0; z-index: 50;
    display: flex; align-items: center; justify-content: center;
    opacity: 0; pointer-events: none;
    transition: opacity .3s;
}
.pc-modal--open {
    opacity: 1; pointer-events: auto;
}
.pc-modal__backdrop {
    position: absolute; inset: 0;
    background: rgba(0,0,0,.85);
    backdrop-filter: blur(16px);
}
.pc-modal__content {
    position: relative;
    background: #151520;
    border: 1px solid rgba(255,255,255,.06);
    border-radius: 1.5rem;
    padding: 2.5rem;
    max-width: 420px; width: calc(100% - 2rem);
    text-align: center;
    transform: scale(.95);
    transition: transform .3s;
}
.pc-modal--open .pc-modal__content {
    transform: scale(1);
}
.pc-modal__content--wide {
    max-width: 72rem;
    height: 80vh;
    padding: 0;
    display: flex; flex-direction: column;
    text-align: left;
}
.pc-modal__close {
    position: absolute; top: 1rem; right: 1rem;
    width: 2rem; height: 2rem;
    display: flex; align-items: center; justify-content: center;
    background: none; border: none; cursor: pointer;
    color: rgba(255,255,255,.35); transition: color .2s;
}
.pc-modal__close:hover { color: #fff; }
.pc-modal__close svg { width: 1.25rem; height: 1.25rem; }
.pc-modal__close--inline {
    position: static;
}
.pc-modal__header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid rgba(255,255,255,.06);
}
.pc-modal__icon {
    width: 3.5rem; height: 3.5rem; margin: 0 auto 1rem;
    border-radius: 1rem;
    background: rgba(155,27,48,.1);
    display: flex; align-items: center; justify-content: center;
}
.pc-modal__icon svg { width: 1.75rem; height: 1.75rem; color: #c42847; }
.pc-modal__title {
    font-family: 'Outfit', sans-serif;
    font-size: 1.25rem; font-weight: 700; color: #fff; margin: 0;
}
.pc-modal__subtitle {
    font-size: .8125rem; color: rgba(255,255,255,.4);
    margin: .375rem 0 1.5rem;
}
.pc-modal__input {
    width: 100%; padding: .875rem 1rem;
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(255,255,255,.08);
    border-radius: .875rem;
    color: #fff; font-size: .9375rem;
    outline: none; text-align: center;
    transition: border-color .2s;
    margin-bottom: 1rem;
}
.pc-modal__input:focus { border-color: rgba(155,27,48,.4); }
.pc-modal__error {
    font-size: .8125rem; color: #ef4444; margin-bottom: 1rem;
}
.pc-modal__submit {
    width: 100%; padding: .875rem;
    background: linear-gradient(135deg, #c42847, #9b1b30);
    color: #fff; font-weight: 700; font-size: .9375rem;
    border: none; border-radius: .875rem; cursor: pointer;
    transition: transform .2s, box-shadow .2s;
}
.pc-modal__submit:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 24px rgba(155,27,48,.3);
}
.pc-modal__iframe {
    flex: 1; width: 100%; border: 0;
}

/* ── Animations ───────────────────────────────── */
@keyframes pc-pulse {
    0%, 100% { opacity: 1; } 50% { opacity: .4; }
}
@keyframes pc-fade-up {
    from { opacity: 0; transform: translateY(1rem); }
    to   { opacity: 1; transform: translateY(0); }
}
@keyframes pc-ring-fill {
    0%   { clip-path: polygon(50% 0%, 50% 50%, 50% 0%, 50% 0%, 50% 0%, 50% 0%, 50% 0%); border-color: #c42847; }
    12.5% { clip-path: polygon(50% 0%, 50% 50%, 100% 0%, 50% 0%, 50% 0%, 50% 0%, 50% 0%); }
    25%  { clip-path: polygon(50% 0%, 50% 50%, 100% 100%, 100% 0%, 50% 0%, 50% 0%, 50% 0%); }
    37.5% { clip-path: polygon(50% 0%, 50% 50%, 100% 100%, 100% 100%, 50% 0%, 50% 0%, 50% 0%); }
    50%  { clip-path: polygon(50% 0%, 50% 50%, 0% 100%, 100% 100%, 100% 0%, 50% 0%, 50% 0%); }
    100% { clip-path: polygon(50% 0%, 50% 50%, 50% 0%, 0% 0%, 0% 100%, 100% 100%, 100% 0%); border-color: #c42847; }
}
@keyframes pc-click-bounce {
    0%   { transform: scale(1); box-shadow: 0 0 0 0 rgba(155,27,48,0); }
    20%  { transform: scale(0.93); }
    40%  { transform: scale(1.04); box-shadow: 0 0 0 8px rgba(155,27,48,.15); }
    60%  { transform: scale(0.98); box-shadow: 0 0 0 12px rgba(155,27,48,.08); }
    80%  { transform: scale(1.02); box-shadow: 0 0 0 16px rgba(155,27,48,.03); }
    100% { transform: scale(1); box-shadow: 0 0 0 20px rgba(155,27,48,0); }
}
@keyframes pc-lock-unlock {
    0%   { transform: rotate(0deg); color: rgba(0,0,0,.6); }
    30%  { transform: rotate(-15deg); color: #c42847; }
    60%  { transform: rotate(5deg); }
    100% { transform: rotate(0deg); color: #c42847; }
}
.pc-card--clicked .pc-card__logo-area {
    animation: pc-click-bounce 0.55s cubic-bezier(0.34, 1.56, 0.64, 1);
    border-color: rgba(155,27,48,.4);
    background: linear-gradient(135deg, rgba(155,27,48,.03), rgba(155,27,48,.01));
}
.pc-card--clicked .pc-card__lock {
    opacity: 1;
}
.pc-card--clicked .pc-card__lock svg {
    animation: pc-lock-unlock 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}
</style>

<script>
  // Real-time search
  const searchInput = document.getElementById('client-search') as HTMLInputElement;
  const clientCards = document.querySelectorAll('.pc-card');

  searchInput?.addEventListener('input', () => {
    const query = searchInput.value.toLowerCase();
    clientCards.forEach(card => {
      const name = (card as HTMLElement).dataset.clientName?.toLowerCase() || '';
      (card as HTMLElement).style.display = name.includes(query) ? '' : 'none';
    });
  });

  // Click detection (simple click)
  clientCards.forEach(card => {
    card.addEventListener('click', (e) => {
      e.preventDefault();
      const el = card as HTMLElement;
      el.classList.add('pc-card--clicked');
      setTimeout(() => {
        el.classList.remove('pc-card--clicked');
        openPasswordModal(el);
      }, 450);
    });
  });

  // Password Modal
  const passwordModal = document.getElementById('password-modal')!;
  const modalTitle = document.getElementById('modal-title')!;
  const passwordInput = document.getElementById('password-input') as HTMLInputElement;
  const passwordError = document.getElementById('password-error')!;
  const passwordForm = document.getElementById('password-form') as HTMLFormElement;
  let currentClientId = '';

  function openPasswordModal(card: HTMLElement) {
    currentClientId = card.dataset.clientId || '';
    const name = card.dataset.clientName || '';
    modalTitle.textContent = `Acceso: ${name}`;
    passwordInput.value = '';
    passwordError.classList.add('hidden');

    passwordModal.classList.add('pc-modal--open');
    passwordInput.focus();
  }

  function closePasswordModal() {
    passwordModal.classList.remove('pc-modal--open');
  }

  document.getElementById('modal-close')?.addEventListener('click', closePasswordModal);
  document.getElementById('modal-backdrop')?.addEventListener('click', closePasswordModal);

  const submitBtn = passwordForm.querySelector('.pc-modal__submit') as HTMLButtonElement;

  passwordForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const password = passwordInput.value;

    if (!password) {
      passwordError.textContent = 'Introduce tu contraseña';
      passwordError.classList.remove('hidden');
      return;
    }

    const oHtml = submitBtn.innerHTML;
    submitBtn.innerHTML = 'Verificando...';
    submitBtn.disabled = true;

    try {
      const res = await fetch('/api/portal/verify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: currentClientId, password })
      });

      if (res.ok) {
        closePasswordModal();
        openDropboxModal(currentClientId);
      } else {
        const err = await res.json();
        passwordError.textContent = err.error || 'Contraseña incorrecta';
        passwordError.classList.remove('hidden');
      }
    } catch (error) {
      passwordError.textContent = 'Error de conexión. Inténtalo de nuevo.';
      passwordError.classList.remove('hidden');
    } finally {
      submitBtn.innerHTML = oHtml;
      submitBtn.disabled = false;
    }
  });

  // Dropbox Modal
  const dropboxModal = document.getElementById('dropbox-modal')!;
  const dropboxLinkBtn = document.getElementById('dropbox-link-btn') as HTMLAnchorElement;

  function openDropboxModal(clientId: string) {
    const card = document.querySelector(`.pc-card[data-client-id="${clientId}"]`) as HTMLElement;
    const dropboxLink = card?.dataset.dropbox || '';
    const clientName = card?.dataset.clientName || 'Cliente';
    
    dropboxLinkBtn.href = dropboxLink;
    dropboxLinkBtn.textContent = `Abrir archivos de ${clientName}`;

    dropboxModal.classList.add('pc-modal--open');
  }

  function closeDropboxModal() {
    dropboxModal.classList.remove('pc-modal--open');
    dropboxLinkBtn.href = '#';
  }

  document.getElementById('dropbox-close')?.addEventListener('click', closeDropboxModal);
  document.getElementById('dropbox-backdrop')?.addEventListener('click', closeDropboxModal);
</script>
