---
const siteUrl = Astro.site?.toString() || "https://laeseprod.com";
Astro.response.headers.set("Cache-Control", "no-store");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Modo mantenimiento | LaesePROD</title>
    <meta
      name="description"
      content="LaesePROD está en mantenimiento temporal. Volvemos enseguida."
    />
    <link rel="canonical" href={`${siteUrl.replace(/\/$/, "")}/mantenimiento`} />
  </head>
  <body>
    <main class="maintenance-shell">
      <div class="grain" aria-hidden="true"></div>
      <section class="maintenance-stage" aria-labelledby="maintenance-title">
        <div class="maintenance-copy">
          <img class="maintenance-logo" src="/logopositivo.png" alt="LaesePROD" />
          <p class="eyebrow">Modo mantenimiento</p>
          <h1 id="maintenance-title">Estamos dejando la web fina.</h1>
          <p class="intro">
            Estamos ajustando la experiencia de LaesePROD. La web volverá a estar disponible en breve.
          </p>
        </div>

        <aside class="maintenance-panel" aria-label="Acceso interno">
          <div class="panel-top">
            <span>Acceso autorizado</span>
            <strong>Admin</strong>
          </div>
          <p>
            Si formas parte del equipo, entra al panel y podrás revisar la web aunque el modo
            mantenimiento siga activo.
          </p>
          <a class="admin-link" href="/admin/login?redirectTo=/admin">
            Entrar al panel
            <span aria-hidden="true">-></span>
          </a>
        </aside>

        <div class="maintenance-meta" aria-label="Datos de contacto">
          <div>
            <span>Contacto</span>
            <strong>laeseprod@gmail.com</strong>
          </div>
          <div>
            <span>Base</span>
            <strong>Andalucía, España</strong>
          </div>
          <div>
            <span>Estado</span>
            <strong>Volvemos pronto</strong>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  @font-face {
    font-family: "LaeseHeading";
    src: local("Impact");
    font-display: swap;
  }

  :root {
    color-scheme: dark;
    --bg: #050505;
    --fg: #ffffff;
    --muted: rgba(255, 255, 255, 0.68);
    --line: rgba(255, 255, 255, 0.18);
    --panel: rgba(255, 255, 255, 0.08);
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background: var(--bg);
    color: var(--fg);
    font-family: Arial, Helvetica, sans-serif;
  }

  .maintenance-shell {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background:
      radial-gradient(circle at 72% 25%, rgba(255, 255, 255, 0.16), transparent 18rem),
      radial-gradient(circle at 16% 80%, rgba(255, 255, 255, 0.1), transparent 22rem),
      linear-gradient(115deg, #080808 0%, #101010 45%, #000 100%);
  }

  .maintenance-shell::before {
    content: "LAESEPROD";
    position: absolute;
    right: -6vw;
    bottom: -9vw;
    color: rgba(255, 255, 255, 0.035);
    font-family: LaeseHeading, Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
    font-size: clamp(8rem, 21vw, 24rem);
    line-height: 0.8;
    pointer-events: none;
  }

  .grain {
    position: absolute;
    inset: 0;
    opacity: 0.32;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: linear-gradient(to bottom, #000, transparent 92%);
  }

  .maintenance-stage {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.06fr) minmax(320px, 0.66fr);
    grid-template-rows: 1fr auto;
    gap: clamp(1.5rem, 4vw, 5rem);
    min-height: 100svh;
    padding: clamp(1.25rem, 4vw, 5rem);
    align-items: center;
  }

  .maintenance-logo {
    width: clamp(96px, 11vw, 170px);
    height: auto;
    margin-bottom: clamp(2rem, 5vw, 5rem);
  }

  .eyebrow,
  .panel-top span,
  .maintenance-meta span {
    margin: 0;
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1 {
    max-width: 980px;
    margin: 0.35rem 0 0;
    font-family: LaeseHeading, Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
    font-size: clamp(5rem, 13.5vw, 13rem);
    line-height: 0.82;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .intro {
    max-width: 680px;
    margin: clamp(1.5rem, 3vw, 2.5rem) 0 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.5vw, 1.4rem);
    line-height: 1.45;
  }

  .maintenance-panel {
    align-self: center;
    border: 1px solid var(--line);
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.035)),
      rgba(0, 0, 0, 0.38);
    padding: clamp(1.35rem, 3vw, 2.2rem);
    backdrop-filter: blur(18px);
  }

  .panel-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .panel-top strong {
    font-size: clamp(2rem, 5vw, 4.2rem);
    line-height: 0.85;
    text-transform: uppercase;
  }

  .maintenance-panel p {
    margin: 1.4rem 0 1.8rem;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.5;
  }

  .admin-link {
    display: flex;
    min-height: 58px;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    border: 1px solid #fff;
    border-radius: 999px;
    background: #fff;
    color: #000;
    font-weight: 900;
    text-decoration: none;
    text-transform: uppercase;
    transition: transform 180ms ease, background 180ms ease, color 180ms ease;
  }

  .admin-link:hover {
    transform: translateY(-2px);
    background: transparent;
    color: #fff;
  }

  .maintenance-meta {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.045);
  }

  .maintenance-meta div {
    min-height: 72px;
    padding: 1rem;
    border-right: 1px solid var(--line);
  }

  .maintenance-meta div:last-child {
    border-right: 0;
  }

  .maintenance-meta strong {
    display: block;
    margin-top: 0.35rem;
    font-size: 1rem;
  }

  @media (max-width: 900px) {
    .maintenance-stage {
      grid-template-columns: 1fr;
      align-content: center;
    }

    .maintenance-logo {
      margin-bottom: 2.2rem;
    }

    .maintenance-meta {
      grid-template-columns: 1fr;
    }

    .maintenance-meta div {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .maintenance-meta div:last-child {
      border-bottom: 0;
    }
  }

  @media (max-width: 560px) {
    .maintenance-stage {
      padding: 1rem;
    }

    h1 {
      font-size: clamp(4.1rem, 20vw, 6.5rem);
    }
  }
</style>
