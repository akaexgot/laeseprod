---
const siteUrl = Astro.site?.toString() || "https://laeseprod.com";
Astro.response.headers.set("Cache-Control", "no-store");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Modo mantenimiento | LaeseProd S.L.</title>
    <meta
      name="description"
      content="LaeseProd S.L. está en mantenimiento temporal. Volvemos enseguida."
    />
    <link rel="canonical" href={`${siteUrl.replace(/\/$/, "")}/mantenimiento`} />
  </head>
  <body>
    <main class="maintenance-shell">
      <div class="grain" aria-hidden="true"></div>
      <section class="maintenance-stage" aria-labelledby="maintenance-title">
        <div class="maintenance-copy">
          <img class="maintenance-logo" src="/logopositivo.png" alt="LaeseProd S.L." />
          <p class="eyebrow">Modo mantenimiento</p>
          <h1 id="maintenance-title">Estamos dejando la web fina.</h1>
          <p class="intro">
            Estamos ajustando la experiencia de LaeseProd S.L. La web volverá a estar disponible en breve.
          </p>
        </div>
      </section>
      <a class="admin-link" href="/admin/login?redirectTo=/admin" aria-label="Acceso admin" title="Acceso admin">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 10V8a5 5 0 0 1 10 0v2" />
          <rect x="5" y="10" width="14" height="10" rx="2" />
          <path d="M12 14v2" />
        </svg>
      </a>
    </main>
  </body>
</html>

<style>
  @font-face {
    font-family: "LaeseHeading";
    src: local("Impact");
    font-display: swap;
  }

  :root {
    color-scheme: dark;
    --bg: #050505;
    --fg: #ffffff;
    --muted: rgba(255, 255, 255, 0.68);
    --line: rgba(255, 255, 255, 0.18);
    --panel: rgba(255, 255, 255, 0.08);
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    height: 100vh;
    overflow: hidden;
    background: var(--bg);
    color: var(--fg);
    font-family: Arial, Helvetica, sans-serif;
  }

  .maintenance-shell {
    position: relative;
    height: 100dvh;
    overflow: hidden;
    background:
      radial-gradient(circle at 72% 25%, rgba(255, 255, 255, 0.16), transparent 18rem),
      radial-gradient(circle at 16% 80%, rgba(255, 255, 255, 0.1), transparent 22rem),
      linear-gradient(115deg, #080808 0%, #101010 45%, #000 100%);
  }

  .maintenance-shell::before {
    content: "LAESEPROD";
    position: absolute;
    right: -6vw;
    bottom: -9vw;
    color: rgba(255, 255, 255, 0.035);
    font-family: LaeseHeading, Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
    font-size: clamp(8rem, 21vw, 24rem);
    line-height: 0.8;
    pointer-events: none;
  }

  .grain {
    position: absolute;
    inset: 0;
    opacity: 0.32;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: linear-gradient(to bottom, #000, transparent 92%);
  }

  .maintenance-stage {
    position: relative;
    z-index: 1;
    display: grid;
    height: 100%;
    max-width: 1120px;
    padding: clamp(1rem, 4.2vh, 3rem) clamp(1.25rem, 4vw, 5rem);
    align-items: center;
  }

  .maintenance-logo {
    width: clamp(96px, 9vw, 150px);
    height: auto;
    margin-bottom: clamp(1.4rem, 7vh, 4.2rem);
  }

  .eyebrow,
  .maintenance-meta span {
    margin: 0;
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1 {
    max-width: 920px;
    margin: 0.35rem 0 0;
    font-family: "Arial Black", LaeseHeading, Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
    font-size: clamp(4.4rem, min(12vw, 14.5vh), 11.4rem);
    line-height: 0.9;
    letter-spacing: 0;
    word-spacing: 0.04em;
    text-transform: uppercase;
    transform: scaleX(1.025);
    transform-origin: left center;
  }

  .intro {
    max-width: 680px;
    margin: clamp(1.1rem, 3vh, 2rem) 0 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.35vw, 1.32rem);
    line-height: 1.45;
  }

  .admin-link {
    position: fixed;
    right: clamp(1rem, 2.5vw, 2rem);
    bottom: clamp(1rem, 2.5vw, 2rem);
    z-index: 2;
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    backdrop-filter: blur(12px);
    transition: transform 180ms ease, background 180ms ease, color 180ms ease, border-color 180ms ease;
  }

  .admin-link svg {
    width: 21px;
    height: 21px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .admin-link:hover {
    transform: translateY(-2px);
    border-color: #fff;
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
  }

  @media (max-width: 900px) {
    .maintenance-stage {
      align-content: center;
    }

    .maintenance-logo {
      margin-bottom: 2.2rem;
    }
  }

  @media (max-width: 560px) {
    .maintenance-stage {
      padding: 1rem;
    }

    h1 {
      font-size: clamp(3.65rem, 18vw, 6.1rem);
      line-height: 0.94;
      transform: scaleX(1.015);
    }

    .intro {
      max-width: 25rem;
      font-size: 0.98rem;
    }
  }
</style>
