---
const siteUrl = Astro.site?.toString() || "https://laeseprod.com";
Astro.response.headers.set("Cache-Control", "no-store");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Modo mantenimiento | LaeseProd S.L.</title>
    <meta
      name="description"
      content="LaeseProd S.L. está en mantenimiento temporal. Volvemos enseguida."
    />
    <link rel="canonical" href={`${siteUrl.replace(/\/$/, "")}/mantenimiento`} />
  </head>
  <body>
    <main class="maintenance-shell">
      <div class="maintenance-grid" aria-hidden="true"></div>
      <div class="maintenance-frame" aria-hidden="true">
        <span class="corner corner--tl"></span>
        <span class="corner corner--tr"></span>
        <span class="corner corner--bl"></span>
        <span class="corner corner--br"></span>
      </div>

      <header class="maintenance-header" aria-label="LaeseProd">
        <div class="maintenance-status" aria-label="Estado del sitio">
          <span class="status-dot" aria-hidden="true"></span>
          <span>Update en curso</span>
        </div>
      </header>

      <section class="maintenance-stage" aria-labelledby="maintenance-title">
        <div class="maintenance-copy">
          <p class="eyebrow"><span>01</span> LaeseProd S.L. / Sistema público</p>
          <h1 id="maintenance-title">
            <span>Estamos</span>
            <span>calibrando</span>
            <span class="title-invert">la señal</span>
          </h1>
          <p class="intro">
            La web está en pausa unos minutos mientras ajustamos contenido, rendimiento y detalles visuales.
            Volvemos enseguida con todo en foco.
          </p>
          <div class="maintenance-actions" aria-label="Información de mantenimiento">
            <span class="corner-note">Frame temporal</span>
            <span class="corner-note corner-note--quiet">Sin pérdida de datos</span>
          </div>
        </div>

        <aside class="signal-panel" aria-label="Panel de estado">
          <div class="signal-panel__bar">
            <span>CAM A</span>
            <span>LIVE CHECK</span>
            <span class="rec"><i aria-hidden="true"></i>REC</span>
          </div>

          <div class="signal-screen" aria-hidden="true">
            <div class="signal-screen__scan"></div>
            <img src="/logopositivo.png" alt="" loading="eager" />
            <span class="focus-mark focus-mark--top"></span>
            <span class="focus-mark focus-mark--right"></span>
            <span class="focus-mark focus-mark--bottom"></span>
            <span class="focus-mark focus-mark--left"></span>
          </div>

          <div class="readout">
            <div>
              <span>Estado</span>
              <strong>Reencuadrando</strong>
            </div>
            <div>
              <span>Web</span>
              <strong>Offline temporal</strong>
            </div>
            <div>
              <span>ETA</span>
              <strong>En breve</strong>
            </div>
          </div>
        </aside>
      </section>

      <a class="admin-link" href="/admin/login?redirectTo=/admin" aria-label="Acceso admin" title="Acceso admin">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 10V8a5 5 0 0 1 10 0v2" />
          <rect x="5" y="10" width="14" height="10" rx="2" />
          <path d="M12 14v2" />
        </svg>
      </a>
    </main>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "LaeseHeading";
    src: local("Impact");
    font-display: swap;
  }

  :root {
    color-scheme: dark;
    --bg: #030303;
    --fg: #ffffff;
    --ink: #050505;
    --muted: rgba(255, 255, 255, 0.68);
    --soft: rgba(255, 255, 255, 0.42);
    --line: rgba(255, 255, 255, 0.18);
    --strong-line: rgba(255, 255, 255, 0.58);
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
    background: var(--bg);
    color: var(--fg);
    font-family: Arial, Helvetica, sans-serif;
  }

  body {
    overflow: hidden;
  }

  .maintenance-shell {
    position: relative;
    width: 100%;
    max-width: 100vw;
    min-height: 100dvh;
    overflow: hidden;
    background:
      linear-gradient(90deg, rgba(255, 255, 255, 0.08) 0 1px, transparent 1px 100%),
      linear-gradient(0deg, rgba(255, 255, 255, 0.07) 0 1px, transparent 1px 100%),
      linear-gradient(115deg, #080808 0%, #0f0f0f 46%, #000000 100%);
    background-size: 42px 42px, 42px 42px, auto;
  }

  .maintenance-shell::before {
    content: "LAESEPROD";
    position: absolute;
    right: -1.5rem;
    bottom: -1.4rem;
    color: rgba(255, 255, 255, 0.045);
    font-family: LaeseHeading, Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
    font-size: 13rem;
    line-height: 0.76;
    pointer-events: none;
    text-transform: uppercase;
  }

  .maintenance-shell::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.72), transparent 34%, rgba(0, 0, 0, 0.38)),
      repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.035) 0 1px, transparent 1px 4px);
    mix-blend-mode: screen;
    opacity: 0.38;
  }

  .maintenance-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, transparent 49.92%, rgba(255, 255, 255, 0.18) 50%, transparent 50.08%),
      linear-gradient(0deg, transparent 49.92%, rgba(255, 255, 255, 0.13) 50%, transparent 50.08%);
    opacity: 0.32;
  }

  .maintenance-frame {
    position: absolute;
    inset: 1.15rem;
    z-index: 2;
    pointer-events: none;
  }

  .corner {
    position: absolute;
    width: 4.6rem;
    height: 4.6rem;
    border-color: var(--strong-line);
  }

  .corner--tl {
    top: 0;
    left: 0;
    border-top: 2px solid;
    border-left: 2px solid;
  }

  .corner--tr {
    top: 0;
    right: 0;
    border-top: 2px solid;
    border-right: 2px solid;
  }

  .corner--bl {
    bottom: 0;
    left: 0;
    border-bottom: 2px solid;
    border-left: 2px solid;
  }

  .corner--br {
    right: 0;
    bottom: 0;
    border-right: 2px solid;
    border-bottom: 2px solid;
  }

  .maintenance-header {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.5rem;
    width: min(calc(100% - 4.5rem), 1180px);
    margin: 0 auto;
    padding: 2rem 0 0;
  }

  .maintenance-logo {
    width: 9.5rem;
    height: auto;
    filter: drop-shadow(0 1.2rem 2rem rgba(0, 0, 0, 0.54));
  }

  .maintenance-status {
    display: inline-flex;
    align-items: center;
    gap: 0.62rem;
    min-height: 2.45rem;
    padding: 0 0.9rem;
    border: 1px solid var(--line);
    background: rgba(0, 0, 0, 0.42);
    color: var(--fg);
    font-size: 0.74rem;
    font-weight: 900;
    text-transform: uppercase;
    backdrop-filter: blur(14px);
  }

  .status-dot {
    width: 0.52rem;
    height: 0.52rem;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.52);
    animation: pulse 1.55s ease-out infinite;
  }

  .maintenance-stage {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(26rem, 0.72fr);
    align-items: center;
    gap: 5.8rem;
    width: min(calc(100% - 4.5rem), 1320px);
    min-height: calc(100dvh - 6.2rem);
    margin: 0 auto;
    padding: 2.6rem 0 4rem;
  }

  .maintenance-copy {
    min-width: 0;
    max-width: 44rem;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: 0 0 1.1rem;
    color: var(--soft);
    font-family: "Courier New", Courier, monospace;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .eyebrow span {
    display: grid;
    width: 2.1rem;
    height: 2.1rem;
    place-items: center;
    border-radius: 50%;
    background: #fff;
    color: #000;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 0.68rem;
    font-weight: 950;
  }

  h1 {
    display: grid;
    gap: 0.12em;
    margin: 0;
    font-family: "Arial Black", LaeseHeading, Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
    font-size: 6.05rem;
    line-height: 0.82;
    text-transform: uppercase;
  }

  h1 span {
    display: block;
  }

  .title-invert {
    width: fit-content;
    padding: 0.02em 0.14em 0.08em;
    background: #fff;
    color: var(--ink);
    transform: translateX(-0.03em);
  }

  .intro {
    max-width: 42rem;
    margin: 1.55rem 0 0;
    padding-top: 1.3rem;
    border-top: 1px solid var(--strong-line);
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.55;
  }

  .maintenance-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.6rem;
  }

  .corner-note {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.6rem;
    padding: 0 1rem;
    color: var(--fg);
    font-size: 0.8rem;
    font-weight: 950;
    text-transform: uppercase;
  }

  .corner-note::before,
  .corner-note::after {
    content: "";
    position: absolute;
    width: 0.82rem;
    height: 0.82rem;
    pointer-events: none;
  }

  .corner-note::before {
    left: 0;
    bottom: 0;
    border-left: 1px solid var(--fg);
    border-bottom: 1px solid var(--fg);
  }

  .corner-note::after {
    top: 0;
    right: 0;
    border-top: 1px solid var(--fg);
    border-right: 1px solid var(--fg);
  }

  .corner-note--quiet {
    color: var(--soft);
  }

  .corner-note--quiet::before,
  .corner-note--quiet::after {
    border-color: rgba(255, 255, 255, 0.35);
  }

  .signal-panel {
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.34);
    background: rgba(0, 0, 0, 0.68);
    box-shadow: 1rem 1rem 0 rgba(255, 255, 255, 0.08), 0 2rem 5rem rgba(0, 0, 0, 0.46);
    backdrop-filter: blur(8px);
  }

  .signal-panel::before {
    content: "MAINTENANCE";
    position: absolute;
    top: 50%;
    right: -6.9rem;
    color: rgba(255, 255, 255, 0.78);
    font-family: "Arial Black", Arial, Helvetica, sans-serif;
    font-size: 0.88rem;
    text-transform: uppercase;
    transform: translateY(-50%) rotate(-90deg);
    transform-origin: center;
  }

  .signal-panel__bar,
  .readout {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: rgba(255, 255, 255, 0.16);
  }

  .signal-panel__bar span,
  .readout div {
    background: #070707;
  }

  .signal-panel__bar span {
    padding: 0.82rem 0.9rem;
    color: var(--soft);
    font-family: "Courier New", Courier, monospace;
    font-size: 0.72rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .signal-panel__bar .rec {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.42rem;
    color: #fff;
  }

  .rec i {
    width: 0.52rem;
    height: 0.52rem;
    border-radius: 50%;
    background: #fff;
    animation: blink 1.2s steps(2, start) infinite;
  }

  .signal-screen {
    position: relative;
    display: grid;
    min-height: 22rem;
    place-items: center;
    overflow: hidden;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    background:
      linear-gradient(130deg, rgba(255, 255, 255, 0.08), transparent 28%),
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.08) 0 1px, transparent 1px 38px),
      repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.055) 0 1px, transparent 1px 38px),
      #030303;
  }

  .signal-screen img {
    width: min(68%, 17rem);
    height: auto;
    opacity: 0.92;
    filter: drop-shadow(0 1.5rem 1.5rem rgba(0, 0, 0, 0.8));
    animation: signalFloat 5s ease-in-out infinite;
  }

  .signal-screen__scan {
    position: absolute;
    top: 0;
    bottom: 0;
    left: -18%;
    width: 18%;
    border-right: 1px solid rgba(255, 255, 255, 0.62);
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    animation: scan 3.8s linear infinite;
  }

  .focus-mark {
    position: absolute;
    background: rgba(255, 255, 255, 0.72);
  }

  .focus-mark--top,
  .focus-mark--bottom {
    left: 50%;
    width: 5rem;
    height: 2px;
    transform: translateX(-50%);
  }

  .focus-mark--top {
    top: 2rem;
  }

  .focus-mark--bottom {
    bottom: 2rem;
  }

  .focus-mark--left,
  .focus-mark--right {
    top: 50%;
    width: 2px;
    height: 5rem;
    transform: translateY(-50%);
  }

  .focus-mark--left {
    left: 2rem;
  }

  .focus-mark--right {
    right: 2rem;
  }

  .readout div {
    min-height: 5.2rem;
    padding: 1rem;
  }

  .readout span {
    display: block;
    color: var(--soft);
    font-family: "Courier New", Courier, monospace;
    font-size: 0.68rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .readout strong {
    display: block;
    margin-top: 0.42rem;
    color: #fff;
    font-size: 0.88rem;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .admin-link {
    position: fixed;
    right: 2rem;
    bottom: 2rem;
    z-index: 4;
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.72);
    text-decoration: none;
    backdrop-filter: blur(12px);
    transition: transform 180ms ease, background 180ms ease, color 180ms ease, border-color 180ms ease;
  }

  .admin-link svg {
    width: 1.32rem;
    height: 1.32rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .admin-link:hover {
    transform: translateY(-2px);
    border-color: #fff;
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.42);
    }

    72%,
    100% {
      box-shadow: 0 0 0 0.72rem rgba(255, 255, 255, 0);
    }
  }

  @keyframes blink {
    50% {
      opacity: 0.28;
    }
  }

  @keyframes scan {
    to {
      left: 100%;
    }
  }

  @keyframes signalFloat {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-0.45rem);
    }
  }

  @media (max-width: 1100px) {
    .maintenance-stage {
      grid-template-columns: 1fr;
      gap: 2.2rem;
      align-content: center;
    }

    .signal-panel {
      max-width: 42rem;
    }

    .signal-screen {
      min-height: 16rem;
    }

    h1 {
      font-size: 5.6rem;
    }
  }

  @media (max-width: 720px) {
    body {
      overflow: auto;
    }

    .maintenance-shell {
      min-height: 100svh;
    }

    .maintenance-shell::before {
      font-size: 6.5rem;
      right: -0.6rem;
      bottom: -0.6rem;
    }

    .maintenance-frame {
      inset: 0.7rem;
    }

    .corner {
      width: 2.7rem;
      height: 2.7rem;
    }

    .maintenance-header,
    .maintenance-stage {
      width: calc(100% - 2rem);
      max-width: 42rem;
      min-width: 0;
    }

    .maintenance-header {
      padding-top: 1.15rem;
    }

    .maintenance-logo {
      width: 7.8rem;
    }

    .maintenance-status {
      min-height: 2.15rem;
      padding: 0 0.7rem;
      font-size: 0.68rem;
    }

    .maintenance-stage {
      min-height: auto;
      padding: 4.2rem 0 5.2rem;
    }

    .eyebrow {
      align-items: flex-start;
      font-size: 0.72rem;
    }

    h1 {
      font-size: 3.72rem;
      line-height: 0.86;
    }

    .intro {
      font-size: 1rem;
    }

    .signal-panel {
      box-shadow: 0.55rem 0.55rem 0 rgba(255, 255, 255, 0.08);
    }

    .signal-panel::before {
      display: none;
    }

    .signal-panel__bar {
      grid-template-columns: 1fr 1fr;
    }

    .signal-panel__bar span:nth-child(2) {
      display: none;
    }

    .signal-screen {
      min-height: 14rem;
    }

    .readout {
      grid-template-columns: 1fr;
    }

    .readout div {
      min-height: 4.2rem;
    }

    .admin-link {
      right: 1rem;
      bottom: 1rem;
    }
  }

  @media (max-width: 420px) {
    .maintenance-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }

    h1 {
      font-size: clamp(2.55rem, 14.5vw, 3.1rem);
    }

    .maintenance-actions {
      gap: 0.65rem;
    }

    .corner-note {
      width: 100%;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
