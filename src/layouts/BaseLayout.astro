---
import Head from "../components/seo/Head.astro";
import GoogleTracking from "../components/seo/GoogleTracking.astro";
import Navbar from "../components/ui/Navbar.astro";
import Footer from "../components/ui/Footer.astro";
import { getSettings } from "../lib/data";
import "../styles/global.css";
import "../styles/contacto-chat.css";

interface Props {
    title?: string;
    description?: string;
    image?: string;
    imageAlt?: string;
    url?: string;
    type?: "website" | "article";
    noindex?: boolean;
    structuredData?: Record<string, any> | Array<Record<string, any> | null> | null;
}

const props = Astro.props;
const settings = await getSettings();
---

<!doctype html>
<html lang="es">
    <head>
        <Head {...props} />
        <GoogleTracking />
    </head>
    <body>
        <Navbar />
        <main><slot /></main>
        <Footer />

        <aside id="global-chat-panel" class="chat-panel" aria-label="Chat en vivo" aria-hidden="true">
            <header class="chat-panel__header">
                <div class="chat-panel__avatar">LP</div>
                <div class="chat-panel__header-info">
                    <h2>{settings.site_name || "LaesePROD"}</h2>
                    <p><span class="chat-panel__status-dot"></span>En línea</p>
                </div>
                <button id="global-chat-close" class="chat-panel__close" type="button" aria-label="Cerrar chat">×</button>
            </header>
            <div id="global-chat-name-form" class="chat-panel__name-form">
                <h3>Hola</h3>
                <p>¿Cómo te llamas?</p>
                <input type="text" id="global-chat-name-input" placeholder="Tu nombre" maxlength="50" />
                <button id="global-chat-start-btn" type="button">Empezar</button>
            </div>
            <div id="global-chat-messages" class="chat-panel__messages" hidden>
                <div class="chat-welcome">Cuéntanos qué tienes en mente.</div>
            </div>
            <div id="global-chat-input-area" class="chat-panel__input" hidden>
                <input type="text" id="global-chat-input" placeholder="Escribe un mensaje" maxlength="500" />
                <button id="global-chat-send" class="chat-panel__send" type="button" disabled aria-label="Enviar mensaje">↑</button>
            </div>
        </aside>

        <script>
            const panel = document.getElementById('global-chat-panel')!;
            const floatingButton = document.getElementById('floating-chat-btn') as HTMLButtonElement | null;
            const closeButton = document.getElementById('global-chat-close');
            const nameForm = document.getElementById('global-chat-name-form')!;
            const nameInput = document.getElementById('global-chat-name-input') as HTMLInputElement;
            const startButton = document.getElementById('global-chat-start-btn');
            const messages = document.getElementById('global-chat-messages')!;
            const inputArea = document.getElementById('global-chat-input-area')!;
            const input = document.getElementById('global-chat-input') as HTMLInputElement;
            const sendButton = document.getElementById('global-chat-send') as HTMLButtonElement;
            let conversationId: string | null = null;
            let pollTimer: ReturnType<typeof setInterval> | null = null;
            let visitorId = localStorage.getItem('laese_visitor_id');
            let visitorName = localStorage.getItem('laese_visitor_name');

            if (!visitorId) {
                visitorId = `v_${Date.now()}_${Math.random().toString(36).slice(2, 9)}`;
                localStorage.setItem('laese_visitor_id', visitorId);
            }
            document.cookie = `vm_visitor_id=${visitorId}; path=/; max-age=31536000; SameSite=Lax`;

            function openChat() {
                panel.classList.add('chat-panel--open');
                panel.setAttribute('aria-hidden', 'false');
                if (floatingButton) floatingButton.hidden = true;
                if (visitorName) startChat();
                else nameInput.focus();
            }

            function closeChat() {
                panel.classList.remove('chat-panel--open');
                panel.setAttribute('aria-hidden', 'true');
                if (floatingButton) floatingButton.hidden = false;
            }

            (window as any).laeseOpenChat = openChat;
            floatingButton?.addEventListener('click', openChat);
            document.addEventListener('click', (event) => {
                if ((event.target as Element).closest('.js-open-chat')) {
                    event.preventDefault();
                    openChat();
                }
            });
            closeButton?.addEventListener('click', closeChat);

            startButton?.addEventListener('click', () => {
                const value = nameInput.value.trim();
                if (!value) return nameInput.focus();
                visitorName = value;
                localStorage.setItem('laese_visitor_name', value);
                startChat();
            });
            nameInput.addEventListener('keydown', (event) => {
                if (event.key === 'Enter') startButton?.click();
            });

            async function startChat() {
                if (!visitorName || conversationId) return;
                nameForm.hidden = true;
                messages.hidden = false;
                inputArea.hidden = false;
                try {
                    const response = await fetch('/api/chat', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ action: 'create', visitor_id: visitorId, visitor_name: visitorName }),
                    });
                    if (!response.ok) throw new Error('No se pudo iniciar el chat');
                    const data = await response.json();
                    conversationId = data.conversation_id;
                    await loadMessages();
                    pollTimer = setInterval(loadMessages, 5000);
                    input.focus();
                } catch (error) {
                    console.error(error);
                }
            }

            async function loadMessages() {
                if (!conversationId) return;
                const response = await fetch(`/api/chat?conversation_id=${conversationId}`);
                if (!response.ok) return;
                const items = await response.json();
                messages.replaceChildren();
                items.forEach((item: any) => {
                    const bubble = document.createElement('div');
                    bubble.className = `chat-msg chat-msg--${item.sender_type}`;
                    const text = document.createElement('span');
                    text.textContent = item.message;
                    bubble.appendChild(text);
                    messages.appendChild(bubble);
                });
                messages.scrollTop = messages.scrollHeight;
            }

            input.addEventListener('input', () => { sendButton.disabled = !input.value.trim(); });
            input.addEventListener('keydown', (event) => {
                if (event.key === 'Enter' && !sendButton.disabled) sendMessage();
            });
            sendButton.addEventListener('click', sendMessage);

            async function sendMessage() {
                const message = input.value.trim();
                if (!message || !conversationId) return;
                input.value = '';
                sendButton.disabled = true;
                await fetch('/api/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action: 'send', conversation_id: conversationId, sender_type: 'visitor', message }),
                });
                await loadMessages();
            }

            window.addEventListener('pagehide', () => {
                if (pollTimer) clearInterval(pollTimer);
            });
        </script>
    </body>
</html>
