---
import Head from "../components/seo/Head.astro";
import GoogleTracking from "../components/seo/GoogleTracking.astro";
import Navbar from "../components/ui/Navbar.astro";
import Footer from "../components/ui/Footer.astro";
import "../styles/global.css";

interface Props {
    title?: string;
    description?: string;
    image?: string;
    imageAlt?: string;
    url?: string;
    type?: "website" | "article";
    noindex?: boolean;
    structuredData?: Record<string, any> | Array<Record<string, any> | null> | null;
}

const props = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <Head {...props} />
        <GoogleTracking />
    </head>
    <body>
        <Navbar />
        <main><slot /></main>
        <Footer />
    </body>
</html>
