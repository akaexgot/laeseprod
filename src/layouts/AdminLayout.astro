---
/**
 * Admin Layout
 * Clean, professional sidebar + main content area
 * Restyled with a premium Zinc Dark Mode aesthetic natively
 */
import "../styles/global.css";

interface Props {
    title: string;
    activeSection?: string;
}

const { title, activeSection } = Astro.props;

const menuGroups = [
    {
        name: "Principal",
        items: [
            { label: "Dashboard", href: "/admin", icon: "layout-dashboard", id: "dashboard" }
        ]
    },
    {
        name: "Contenido",
        items: [
            { label: "Proyectos", href: "/admin/proyectos", icon: "video", id: "proyectos" },
            { label: "Servicios", href: "/admin/servicios", icon: "layers", id: "servicios" },
            { label: "Sectores", href: "/admin/sectores", icon: "building-2", id: "sectores" },
            { label: "Empresas", href: "/admin/empresas", icon: "briefcase", id: "empresas" }
        ]
    },
    {
        name: "Comunicación",
        items: [
            { label: "Portal Clientes", href: "/admin/portal", icon: "users", id: "portal" },
            { label: "Mensajes", href: "/admin/mensajes", icon: "mail", id: "mensajes" }
        ]
    },
    {
        name: "Configuración",
        items: [
            { label: "SEO / Metadatos", href: "/admin/seo", icon: "search", id: "seo" },
            { label: "Ajustes Generales", href: "/admin/ajustes", icon: "settings", id: "ajustes" }
        ]
    }
];
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="robots" content="noindex, nofollow" />
        <title>{title} | Admin Panel</title>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
        <script src="https://cdn.jsdelivr.net/npm/lucide@latest/dist/umd/lucide.js"></script>
        
        <style is:global>
            /* GUARANTEE input padding bypassing Tailwind completely */
            .admin-layout input[type="text"], 
            .admin-layout input[type="email"], 
            .admin-layout input[type="url"], 
            .admin-layout input[type="number"], 
            .admin-layout input[type="password"], 
            .admin-layout textarea, 
            .admin-layout select {
                padding: 0.5rem 0.75rem !important;
                border-radius: 0.375rem !important;
            }
            .admin-layout input[type="color"] {
                padding: 0.25rem !important;
                border-radius: 0.375rem !important;
            }

            /* --- MODAL BULLETPROOFING (Bypass Tailwind cache bugs) --- */
            .admin-layout #modal-overlay > div > div:first-child { padding: 1.25rem 1.5rem !important; }
            .admin-layout #modal-overlay > div > div:nth-child(2) { padding: 1.5rem !important; }
            .admin-layout #modal-overlay form { display: flex !important; flex-direction: column !important; gap: 1.5rem !important; }
            .admin-layout #modal-overlay form .grid { display: grid !important; gap: 1.5rem !important; }
            .admin-layout #modal-overlay form label { margin-bottom: 0.5rem !important; display: block !important; }
            .admin-layout #modal-overlay form .space-y-4, .admin-layout #modal-overlay form .space-y-6 { display: flex !important; flex-direction: column !important; gap: 1.25rem !important; }
            /* Target wrapper divs inside grid columns but not the label/input groups */
            .admin-layout #modal-overlay form .col-span-1 > div { margin-bottom: 0.5rem !important; }
            /* Footer actions */
            .admin-layout #modal-overlay form .flex.justify-end, .admin-layout #modal-overlay form .mt-8 { margin-top: 1.5rem !important; padding-top: 1.25rem !important; border-top: 1px solid #27272a !important; display: flex !important; justify-content: flex-end !important; gap: 1rem !important; }
            .admin-layout #modal-overlay form button { padding: 0.5rem 1rem !important; border-radius: 0.375rem !important; font-weight: 500 !important; cursor: pointer !important; }
            .admin-layout #modal-overlay h4 { margin-bottom: 1rem !important; display: block !important; }
        </style>
    </head>
    <body class="bg-zinc-950 text-zinc-100 antialiased overflow-hidden selection:bg-rose-500/30 selection:text-white admin-layout" style="font-family: 'Inter', sans-serif;">
        <!-- Foolproof explicitly styled wrapper to guarantee padding/width constraints -->
        <div style="display: flex; height: 100vh; width: 100vw; background-color: #09090b; overflow: hidden;">
            
            <!-- Sidebar (Fixed Width, Flex-shrink 0) -->
            <aside
                id="admin-sidebar"
                class="bg-zinc-900 border-r border-zinc-800 z-40 transition-transform duration-300 lg:translate-x-0 -translate-x-full lg:static absolute top-0 left-0 h-full"
                style="width: 260px; flex-shrink: 0; display: flex; flex-direction: column;"
            >
                <!-- Logo -->
                <div class="border-b border-zinc-800" style="height: 64px; display: flex; align-items: center; padding: 0 1.5rem;">
                    <a href="/admin" class="flex items-center gap-3 group w-full">
                        <div class="w-8 h-8 rounded bg-rose-600 flex items-center justify-center text-white font-bold text-sm shadow-lg shadow-rose-900/20">
                            V
                        </div>
                        <div class="flex-1 overflow-hidden">
                            <span class="block text-sm font-semibold text-zinc-100 truncate">VideoMarketing</span>
                        </div>
                    </a>
                </div>

                <!-- Navigation -->
                <nav class="hidden-scrollbar" style="flex: 1; overflow-y: auto; padding: 1.5rem 1rem;">
                    <div style="display: flex; flex-direction: column; gap: 2rem;">
                        {menuGroups.map(group => (
                            <div>
                                <h3 class="text-xs font-semibold text-zinc-500 uppercase tracking-wider" style="padding: 0 0.75rem; margin-bottom: 0.5rem;">{group.name}</h3>
                                <ul style="display: flex; flex-direction: column; gap: 2px;">
                                    {group.items.map((item) => {
                                        const isActive = activeSection === item.id;
                                        return (
                                            <li>
                                                <a
                                                    href={item.href}
                                                    class:list={[
                                                        "group transition-colors",
                                                        isActive
                                                            ? "bg-zinc-800 text-zinc-50"
                                                            : "text-zinc-400 hover:text-zinc-50 hover:bg-zinc-800/50",
                                                    ]}
                                                    style="display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 0.75rem; border-radius: 0.375rem; font-size: 0.875rem; font-weight: 500;"
                                                >
                                                    <i data-lucide={item.icon} class:list={["w-4 h-4 transition-colors", isActive ? "text-rose-500" : "text-zinc-500 group-hover:text-zinc-400"]}></i>
                                                    <span>{item.label}</span>
                                                </a>
                                            </li>
                                        );
                                    })}
                                </ul>
                            </div>
                        ))}
                    </div>
                </nav>

                <!-- Footer -->
                <div class="border-t border-zinc-800 bg-zinc-900" style="padding: 1rem;">
                    <a
                        href="/"
                        target="_blank"
                        class="text-zinc-400 hover:text-zinc-50 transition-colors hover:bg-zinc-800/50"
                        style="display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 0.75rem; border-radius: 0.375rem; font-size: 0.875rem; font-weight: 500;"
                    >
                        <i data-lucide="external-link" class="w-4 h-4 text-zinc-500"></i>
                        Ver sitio web
                    </a>
                    <button
                        id="admin-logout"
                        class="group text-zinc-400 hover:text-red-400 transition-colors hover:bg-zinc-800/50 w-full"
                        style="display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 0.75rem; border-radius: 0.375rem; font-size: 0.875rem; font-weight: 500; margin-top: 0.25rem;"
                    >
                        <i data-lucide="log-out" class="w-4 h-4 text-zinc-500 group-hover:text-red-400"></i>
                        Cerrar sesión
                    </button>
                </div>
            </aside>

            <!-- Main Content Area (Flex-1 perfectly fills remaining width ALWAYS) -->
            <div style="flex: 1; display: flex; flex-direction: column; min-width: 0; overflow: hidden; background-color: #09090b;">
                <!-- Header (Fixed Height) -->
                <header class="bg-zinc-950/80 backdrop-blur-md border-b border-zinc-800 z-30 flex-shrink-0" style="height: 64px; display: flex; align-items: center; justify-content: space-between; padding: 0 2rem;">
                    <div style="display: flex; align-items: center; gap: 1rem;">
                        <button
                            id="sidebar-toggle"
                            class="lg:hidden flex items-center justify-center text-zinc-100 rounded-md hover:bg-zinc-800"
                            style="width: 32px; height: 32px;"
                        >
                            <i data-lucide="menu" class="w-5 h-5"></i>
                        </button>
                        <h1 class="text-xl font-semibold text-zinc-50 tracking-tight" style="margin: 0;">
                            {title}
                        </h1>
                    </div>
                    <div style="display: flex; align-items: center; gap: 1rem;">
                        <div class="bg-zinc-800 border-zinc-700 hover:border-zinc-500 transition-colors" style="width: 32px; height: 32px; border-radius: 50%; border-width: 1px; display: flex; align-items: center; justify-content: center; cursor: pointer;">
                            <i data-lucide="user" class="w-4 h-4 text-zinc-300"></i>
                        </div>
                    </div>
                </header>

                <!-- Scrollable Content Viewport -->
                <main class="hidden-scrollbar" style="flex: 1; overflow-y: auto; overflow-x: hidden; padding: 2rem; width: 100%;">
                    <!-- Constrained Content Container -->
                    <div style="max-width: 1280px; width: 100%; margin: 0 auto;">
                        <slot />
                    </div>
                </main>
            </div>
        </div>

        <!-- Mobile sidebar overlay -->
        <div
            id="sidebar-overlay"
            class="fixed inset-0 bg-zinc-950/80 backdrop-blur-sm z-30 hidden lg:hidden transition-opacity"
        >
        </div>

        <script>
            // Initialize Lucide icons securely
            document.addEventListener('DOMContentLoaded', () => {
                // @ts-ignore
                if (typeof lucide !== 'undefined') {
                    // @ts-ignore
                    lucide.createIcons();
                }
            });

            // Mobile sidebar toggle
            const sidebar = document.getElementById("admin-sidebar");
            const toggle = document.getElementById("sidebar-toggle");
            const overlay = document.getElementById("sidebar-overlay");

            toggle?.addEventListener("click", () => {
                sidebar?.classList.toggle("-translate-x-full");
                overlay?.classList.toggle("hidden");
            });

            overlay?.addEventListener("click", () => {
                sidebar?.classList.add("-translate-x-full");
                overlay?.classList.add("hidden");
            });
        </script>
        <style>
            /* Custom scrollbar for sidebar */
            .hidden-scrollbar::-webkit-scrollbar {
                width: 4px;
            }
            .hidden-scrollbar::-webkit-scrollbar-track {
                background: transparent;
            }
            .hidden-scrollbar::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,0.1);
                border-radius: 4px;
            }
            .hidden-scrollbar:hover::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,0.2);
            }
        </style>
    </body>
</html>
