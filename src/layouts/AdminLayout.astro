                gap: 1.25rem;
                margin-bottom: 1.5rem;
                padding-bottom: 1.2rem;
                border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            }
            .admin-page-kicker {
                margin: 0 0 0.45rem;
                color: #8b8b92;
                font-size: 0.68rem;
