---
/**
 * Admin Layout
 * Clean, professional sidebar + main content area
 * Restyled with a premium Zinc Dark Mode aesthetic natively
 */

import "../styles/global.css";

interface Props {
    title: string;
    activeSection?: string;
}

const { title, activeSection } = Astro.props;

const userProfile = Astro.locals.userProfile;
const isSuperAdmin = userProfile?.is_admin || false;
const permissions = userProfile?.permissions || [];

const allMenuGroups = [
    {
        name: "Principal",
        items: [
            { label: "Dashboard", href: "/admin", icon: "layout-dashboard", id: "dashboard" }
        ]
    },
    {
        name: "Contenido",
        items: [
            { label: "Proyectos", href: "/admin/proyectos", icon: "video", id: "proyectos" },
            { label: "Servicios", href: "/admin/servicios", icon: "layers", id: "servicios" },
            { label: "FAQs", href: "/admin/faqs", icon: "help-circle", id: "faqs" }
        ]
    },
    {
        name: "Comunicación",
        items: [
            { label: "Portal Clientes", href: "/admin/portal", icon: "users", id: "portal" },
            { label: "Contratos", href: "/admin/contratos", icon: "file-text", id: "contratos" },
            { label: "Facturacion", href: "/admin/facturacion", icon: "receipt", id: "facturacion" },
            { label: "Carta", href: "/admin/carta", icon: "scroll", id: "carta" },
            { label: "Mensajes", href: "/admin/mensajes", icon: "mail", id: "mensajes" }
        ]
    },
    {
        name: "Configuración",
        items: [
            { label: "Usuarios", href: "/admin/usuarios", icon: "user-cog", id: "usuarios" },
            { label: "SEO", href: "/admin/seo", icon: "search", id: "seo" },
            { label: "Ajustes Generales", href: "/admin/ajustes", icon: "settings", id: "ajustes" }
        ]
    }
];

// Filter groups and items based on permissions
const menuGroups = allMenuGroups.map(group => {
    return {
        ...group,
        items: group.items.filter(item => isSuperAdmin || permissions.includes(item.id))
    };
}).filter(group => group.items.length > 0);

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || '';
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="robots" content="noindex, nofollow" />
        <title>{title} | Admin Panel</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
        <script src="https://cdn.jsdelivr.net/npm/lucide@latest/dist/umd/lucide.js"></script>
        
        <style is:global>
            /* GUARANTEE input padding bypassing Tailwind completely */
            .admin-layout input[type="text"], 
            .admin-layout input[type="email"], 
            .admin-layout input[type="url"], 
            .admin-layout input[type="number"], 
            .admin-layout input[type="password"], 
            .admin-layout textarea, 
            .admin-layout select {
                padding: 0.5rem 0.75rem !important;
                border-radius: 0.375rem !important;
            }
            .admin-layout input,
            .admin-layout textarea,
            .admin-layout select,
            .admin-layout [contenteditable="true"] {
                -webkit-user-select: text !important;
                user-select: text !important;
            }
            .admin-layout input:not([type="checkbox"]):not([type="radio"]):not([type="file"]):not([type="color"]),
            .admin-layout textarea,
            .admin-layout [contenteditable="true"] {
                cursor: text !important;
            }
            .admin-layout input::selection,
            .admin-layout textarea::selection,
            .admin-layout [contenteditable="true"]::selection {
                background: rgba(255, 255, 255, 0.28) !important;
                color: #ffffff !important;
            }
            .admin-layout input[type="color"] {
                padding: 0.25rem !important;
                border-radius: 0.375rem !important;
            }
            .admin-layout [data-lucide],
            .admin-layout svg.lucide {
                display: block !important;
                flex-shrink: 0 !important;
            }
            .admin-user-dot {
                width: 32px;
                height: 32px;
                display: grid !important;
                place-items: center !important;
                color: #d4d4d8;
                background: #27272a;
                border: 1px solid #3f3f46;
                border-radius: 50%;
                cursor: pointer;
                transition: border-color 160ms ease, background 160ms ease, color 160ms ease;
            }
            .admin-user-dot:hover {
                color: #fff;
                background: #18181b;
                border-color: #71717a;
            }
            .admin-user-dot [data-lucide],
            .admin-user-dot svg {
                width: 16px !important;
                height: 16px !important;
                margin: 0 !important;
            }
            .admin-sidebar {
                background:
                    radial-gradient(circle at 20% 0%, rgba(255, 255, 255, 0.06), transparent 28%),
                    linear-gradient(180deg, #18181b 0%, #101012 100%) !important;
            }
            .admin-brand {
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                min-width: 0 !important;
                width: 100% !important;
                text-decoration: none !important;
            }
            .admin-brand img {
                display: block !important;
                width: auto !important;
                height: 76px !important;
                max-width: 96px !important;
                object-fit: contain !important;
                object-position: center !important;
            }
            .admin-layout main {
                background:
                    linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
                    linear-gradient(90deg, rgba(255, 255, 255, 0.018) 1px, transparent 1px),
