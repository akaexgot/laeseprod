---
/**
 * Admin Layout
 * Sidebar + main content area
 * Protected by Supabase Auth
 */
import "../styles/global.css";

interface Props {
    title: string;
    activeSection?: string;
}

const { title, activeSection } = Astro.props;

const menuItems = [
    { label: "Dashboard", href: "/admin", icon: "📊", id: "dashboard" },
    {
        label: "Proyectos",
        href: "/admin/proyectos",
        icon: "🎬",
        id: "proyectos",
    },
    {
        label: "Servicios",
        href: "/admin/servicios",
        icon: "⚙️",
        id: "servicios",
    },
    { label: "Sectores", href: "/admin/sectores", icon: "🏢", id: "sectores" },
    { label: "Empresas", href: "/admin/empresas", icon: "🏷️", id: "empresas" },
    {
        label: "Portal Clientes",
        href: "/admin/portal",
        icon: "👥",
        id: "portal",
    },
    { label: "Mensajes", href: "/admin/mensajes", icon: "✉️", id: "mensajes" },
    { label: "SEO", href: "/admin/seo", icon: "🔍", id: "seo" },
    { label: "Ajustes", href: "/admin/ajustes", icon: "🎨", id: "ajustes" },
];
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="robots" content="noindex, nofollow" />
        <title>{title} | Admin - VideoMarketing Sevilla</title>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&display=swap"
            rel="stylesheet"
        />
    </head>
    <body class="bg-dark text-light antialiased">
        <div class="flex min-h-screen">
            <!-- Sidebar -->
            <aside
                id="admin-sidebar"
                class="fixed left-0 top-0 h-full w-64 bg-dark-surface border-r border-dark-border flex flex-col z-40 transition-transform duration-300 lg:translate-x-0 -translate-x-full"
            >
                <!-- Logo -->
                <div class="p-6 border-b border-dark-border">
                    <a href="/admin" class="flex items-center gap-3">
                        <div
                            class="w-9 h-9 bg-gradient-carmin rounded-xl flex items-center justify-center text-white font-bold text-sm font-[Outfit]"
                        >
                            V
                        </div>
                        <div>
                            <span
                                class="text-sm font-bold font-[Outfit] text-white"
                                >VideoMarketing</span
                            >
                            <span class="block text-xs text-light-subtle"
                                >Panel Admin</span
                            >
                        </div>
                    </a>
                </div>

                <!-- Navigation -->
                <nav class="flex-1 p-4 space-y-1 overflow-y-auto">
                    {
                        menuItems.map((item) => (
                            <a
                                href={item.href}
                                class:list={[
                                    "flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium transition-all duration-200",
                                    activeSection === item.id
                                        ? "bg-carmin/10 text-carmin-light border border-carmin/20"
                                        : "text-light-muted hover:text-white hover:bg-dark-hover",
                                ]}
                            >
                                <span class="text-base">{item.icon}</span>
                                <span>{item.label}</span>
                            </a>
                        ))
                    }
                </nav>

                <!-- Footer -->
                <div class="p-4 border-t border-dark-border">
                    <a
                        href="/"
                        target="_blank"
                        class="flex items-center gap-2 px-4 py-2 text-light-subtle hover:text-white text-sm transition-colors rounded-xl hover:bg-dark-hover"
                    >
                        <svg
                            class="w-4 h-4"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                            ></path></svg
                        >
                        Ver web
                    </a>
                    <button
                        id="admin-logout"
                        class="w-full flex items-center gap-2 px-4 py-2 text-light-subtle hover:text-red-400 text-sm transition-colors rounded-xl hover:bg-dark-hover mt-1"
                    >
                        <svg
                            class="w-4 h-4"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
                            ></path></svg
                        >
                        Cerrar sesión
                    </button>
                </div>
            </aside>

            <!-- Mobile sidebar toggle -->
            <button
                id="sidebar-toggle"
                class="lg:hidden fixed top-4 left-4 z-50 w-10 h-10 bg-dark-surface border border-dark-border rounded-xl flex items-center justify-center text-white"
            >
                <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 6h16M4 12h16M4 18h16"></path></svg
                >
            </button>

            <!-- Main Content -->
            <main class="flex-1 lg:ml-64 min-h-screen">
                <!-- Top Bar -->
                <header
                    class="sticky top-0 z-30 bg-dark/80 backdrop-blur-xl border-b border-dark-border px-6 py-4"
                >
                    <div class="flex items-center justify-between">
                        <h1 class="text-xl font-[Outfit] font-bold text-white">
                            {title}
                        </h1>
                        <div class="flex items-center gap-3">
                            <span
                                id="admin-user-email"
                                class="text-light-subtle text-sm hidden sm:block"
                            ></span>
                            <div
                                class="w-8 h-8 bg-carmin/20 rounded-full flex items-center justify-center"
                            >
                                <span class="text-carmin text-sm font-bold"
                                    >A</span
                                >
                            </div>
                        </div>
                    </div>
                </header>

                <!-- Content -->
                <div class="p-6">
                    <slot />
                </div>
            </main>
        </div>

        <!-- Mobile sidebar overlay -->
        <div
            id="sidebar-overlay"
            class="fixed inset-0 bg-dark/60 z-30 hidden lg:hidden"
        >
        </div>

        <script>
            // Mobile sidebar toggle
            const sidebar = document.getElementById("admin-sidebar");
            const toggle = document.getElementById("sidebar-toggle");
            const overlay = document.getElementById("sidebar-overlay");

            toggle?.addEventListener("click", () => {
                sidebar?.classList.toggle("-translate-x-full");
                overlay?.classList.toggle("hidden");
            });

            overlay?.addEventListener("click", () => {
                sidebar?.classList.add("-translate-x-full");
                overlay?.classList.add("hidden");
            });
        </script>
    </body>
</html>
