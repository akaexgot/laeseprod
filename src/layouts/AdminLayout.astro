                letter-spacing: 0.08em;
                text-transform: uppercase;
            }
            .admin-page-title {
                margin: 0;
                color: #fff;
                font-size: clamp(1.8rem, 3vw, 2.65rem);
                line-height: 0.95;
            }
            .admin-page-copy {
                max-width: 62ch;
                margin: 0.65rem 0 0;
                color: #a1a1aa;
                font-size: 0.92rem;
                line-height: 1.45;
            }
            .admin-layout main > div > :first-child:is(.flex.flex-col, header):not(.chat-admin-shell) {
                align-items: flex-end !important;
                justify-content: space-between !important;
                gap: 1.25rem !important;
                margin-bottom: 1.5rem !important;
                padding-bottom: 1.2rem !important;
                border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
            }
            .admin-layout main > div > :first-child:is(.flex.flex-col, header):not(.chat-admin-shell) nav,
            .admin-layout main > div > :first-child:is(.flex.flex-col, header):not(.chat-admin-shell) [aria-label="Breadcrumb"],
            .admin-layout main > div > :first-child:is(.flex.flex-col, header):not(.chat-admin-shell) p:first-child,
            .admin-layout main > div > :first-child:is(.flex.flex-col, header):not(.chat-admin-shell) .portal-admin-kicker,
            .admin-layout main > div > :first-child:is(.flex.flex-col, header):not(.chat-admin-shell) .services-admin-kicker,
            .admin-layout main > div > :first-child:is(.flex.flex-col, header):not(.chat-admin-shell) .settings-kicker,
            .admin-layout main > div > :first-child:is(.flex.flex-col, header):not(.chat-admin-shell) .faq-admin-kicker {
                margin: 0 0 0.45rem !important;
                color: #8b8b92 !important;
                font-size: 0.68rem !important;
                font-weight: 850 !important;
                letter-spacing: 0.08em !important;
                line-height: 1 !important;
                text-transform: uppercase !important;
            }
            .admin-layout main > div > :first-child:is(.flex.flex-col, header):not(.chat-admin-shell) nav ol,
            .admin-layout main > div > :first-child:is(.flex.flex-col, header):not(.chat-admin-shell) nav li,
            .admin-layout main > div > :first-child:is(.flex.flex-col, header):not(.chat-admin-shell) nav span {
                color: inherit !important;
                font: inherit !important;
                letter-spacing: inherit !important;
                text-transform: inherit !important;
            }
            .admin-layout main > div > :first-child:is(.flex.flex-col, header):not(.chat-admin-shell) nav i,
            .admin-layout main > div > :first-child:is(.flex.flex-col, header):not(.chat-admin-shell) nav svg {
                display: none !important;
            }
            .admin-layout main > div > :first-child:is(.flex.flex-col, header):not(.chat-admin-shell) h1 {
                margin: 0 !important;
                color: #fff !important;
                font-size: clamp(1.8rem, 3vw, 2.65rem) !important;
                font-weight: 500 !important;
                letter-spacing: 0 !important;
                line-height: 0.95 !important;
            }
            .admin-layout main > div > :first-child:is(.flex.flex-col, header):not(.chat-admin-shell) h1 + p,
            .admin-layout main > div > :first-child:is(.flex.flex-col, header):not(.chat-admin-shell) p:not(:first-child) {
                max-width: 62ch !important;
                margin: 0.65rem 0 0 !important;
                color: #a1a1aa !important;
                font-size: 0.92rem !important;
                line-height: 1.45 !important;
            }
            .admin-surface {
                color: #fff;
                background: linear-gradient(180deg, #18181b 0%, #101012 100%);
                border: 1px solid #303036;
                border-radius: 16px;
                box-shadow: 0 18px 44px rgba(0, 0, 0, 0.22);
                overflow: hidden;
            }
            .admin-pill {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 0.45rem;
                min-height: 38px;
                padding: 0 0.85rem;
                color: #e4e4e7;
                background: #141417;
                border: 1px solid #333339;
                border-radius: 999px;
                font-size: 0.76rem;
                font-weight: 850;
                text-transform: uppercase;
            }
            .admin-icon-button {
                width: 38px;
                height: 38px;
                display: grid !important;
                place-items: center !important;
                color: #a1a1aa;
                background: #111113;
                border: 1px solid #333339;
                border-radius: 50%;
                cursor: pointer;
                transition: color 160ms ease, background 160ms ease, border-color 160ms ease, transform 160ms ease, opacity 160ms ease;
            }
            .admin-icon-button:hover,
            .admin-icon-button:focus-visible {
                color: #000;
                background: #fff;
                border-color: #fff;
                transform: translateY(-1px);
            }
            .admin-icon-button--success:hover,
            .admin-icon-button--success:focus-visible {
                color: #022c22;
                background: #34d399;
                border-color: #34d399;
            }
            .admin-icon-button--danger:hover,
            .admin-icon-button--danger:focus-visible {
                color: #fff;
                background: #000000;
                border-color: #000000;
            }
            .admin-icon-button svg,
            .admin-icon-button [data-lucide] {
                width: 17px !important;
                height: 17px !important;
                margin: 0 !important;
            }
            .admin-layout .bg-zinc-900.border.border-zinc-800.rounded-xl,
            .admin-layout .bg-zinc-900.border.border-zinc-800.rounded-2xl,
            .admin-layout .bg-zinc-900.border.border-zinc-800.rounded-lg {
                background: linear-gradient(180deg, #18181b 0%, #101012 100%) !important;
                border-color: #303036 !important;
                box-shadow: 0 18px 44px rgba(0, 0, 0, 0.22) !important;
            }
            .admin-layout .bg-zinc-950,
            .admin-layout .bg-zinc-950\/80 {
                background-color: rgba(9, 9, 11, 0.94) !important;
            }
            .admin-layout table {
                border-collapse: collapse !important;
            }
            .admin-layout thead {
                background: rgba(255, 255, 255, 0.025) !important;
            }
            .admin-layout th {
                color: #8b8b92 !important;
                font-size: 0.68rem !important;
                font-weight: 850 !important;
                letter-spacing: 0.08em !important;
                text-transform: uppercase !important;
            }
            .admin-layout td {
                border-color: rgba(255, 255, 255, 0.06) !important;
            }
            .admin-layout input:not([type="checkbox"]):not([type="radio"]):not([type="file"]):not([type="color"]),
            .admin-layout textarea,
            .admin-layout select {
                background: #09090b !important;
                border-color: #36363c !important;
                color: #f4f4f5 !important;
                font-weight: 650 !important;
            }
            .admin-layout input:not([type="checkbox"]):not([type="radio"]):not([type="file"]):not([type="color"]):focus,
            .admin-layout textarea:focus,
            .admin-layout select:focus {
                border-color: #fff !important;
                box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.08) !important;
                outline: none !important;
            }
            .admin-layout button {
                font-family: inherit;
            }
            .admin-layout button.bg-white,
            .admin-layout a.bg-white,
            .admin-layout .portal-primary-button,
            .admin-layout .settings-save,
            .admin-layout .save-service,
            .admin-layout .seo-save,
            .admin-layout #btn-add,
            .admin-layout #btn-new-user,
            .admin-layout #btn-add-contract,
            .admin-layout #btn-add-template,
            .admin-layout #btn-save,
            .admin-layout #btn-save-all,
            .admin-layout #modal-save,
            .admin-layout #modal-btn-save {
                min-height: 42px !important;
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                gap: 0.55rem !important;
                padding: 0 1rem !important;
                color: #000 !important;
                background: #fff !important;
                border: 1px solid #fff !important;
                border-radius: 999px !important;
                box-shadow: none !important;
                font-size: 0.78rem !important;
                font-weight: 900 !important;
                letter-spacing: 0 !important;
                text-transform: uppercase !important;
                transition: color 160ms ease, background 160ms ease, border-color 160ms ease, transform 160ms ease, opacity 160ms ease !important;
            }
            .admin-layout button.bg-white:hover,
            .admin-layout button.bg-white:focus-visible,
            .admin-layout a.bg-white:hover,
            .admin-layout a.bg-white:focus-visible,
            .admin-layout .portal-primary-button:hover,
            .admin-layout .portal-primary-button:focus-visible,
            .admin-layout .settings-save:hover,
            .admin-layout .settings-save:focus-visible,
            .admin-layout .save-service:hover,
            .admin-layout .save-service:focus-visible,
            .admin-layout .seo-save:hover,
            .admin-layout .seo-save:focus-visible,
            .admin-layout #btn-add:hover,
            .admin-layout #btn-add:focus-visible,
            .admin-layout #btn-new-user:hover,
            .admin-layout #btn-new-user:focus-visible,
            .admin-layout #btn-add-contract:hover,
            .admin-layout #btn-add-contract:focus-visible,
            .admin-layout #btn-add-template:hover,
            .admin-layout #btn-add-template:focus-visible,
            .admin-layout #btn-save:hover,
            .admin-layout #btn-save:focus-visible,
            .admin-layout #btn-save-all:hover,
            .admin-layout #btn-save-all:focus-visible,
            .admin-layout #modal-save:hover,
            .admin-layout #modal-save:focus-visible,
            .admin-layout #modal-btn-save:hover,
            .admin-layout #modal-btn-save:focus-visible {
                color: #fff !important;
                background: #000 !important;
                border-color: #fff !important;
                transform: translateY(-1px) !important;
            }
            .admin-layout a.bg-zinc-800,
            .admin-layout button.bg-zinc-800,
            .admin-layout .portal-secondary-button,
            .admin-layout #modal-cancel,
            .admin-layout #modal-btn-cancel,
            .admin-layout #btn-templates-link,
            .admin-layout #btn-add-block,
            .admin-layout #btn-upload-imgs,
            .admin-layout #btn-upload-pdf {
                min-height: 42px !important;
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                gap: 0.55rem !important;
                padding: 0 0.95rem !important;
                color: #e4e4e7 !important;
                background: #141417 !important;
                border: 1px solid #3f3f46 !important;
                border-radius: 999px !important;
                box-shadow: none !important;
                font-size: 0.78rem !important;
                font-weight: 850 !important;
                text-transform: uppercase !important;
            }
            .admin-layout a.bg-zinc-800:hover,
            .admin-layout a.bg-zinc-800:focus-visible,
            .admin-layout button.bg-zinc-800:hover,
            .admin-layout button.bg-zinc-800:focus-visible,
            .admin-layout .portal-secondary-button:hover,
            .admin-layout .portal-secondary-button:focus-visible,
            .admin-layout #modal-cancel:hover,
            .admin-layout #modal-cancel:focus-visible,
            .admin-layout #modal-btn-cancel:hover,
            .admin-layout #modal-btn-cancel:focus-visible,
            .admin-layout #btn-templates-link:hover,
            .admin-layout #btn-templates-link:focus-visible,
            .admin-layout #btn-add-block:hover,
            .admin-layout #btn-add-block:focus-visible,
            .admin-layout #btn-upload-imgs:hover,
            .admin-layout #btn-upload-imgs:focus-visible,
            .admin-layout #btn-upload-pdf:hover,
            .admin-layout #btn-upload-pdf:focus-visible {
                color: #000 !important;
                background: #fff !important;
                border-color: #fff !important;
            }
            .admin-layout .btn-delete,
            .admin-layout .btn-del-img,
            .admin-layout .btn-del-block,
            .admin-layout .btn-del-s {
                color: #ffffff !important;
                background: #111113 !important;
                border: 1px solid #333339 !important;
                border-radius: 50% !important;
            }
            .admin-layout .btn-delete:hover,
            .admin-layout .btn-delete:focus-visible,
            .admin-layout .btn-del-img:hover,
            .admin-layout .btn-del-img:focus-visible,
            .admin-layout .btn-del-block:hover,
            .admin-layout .btn-del-block:focus-visible,
            .admin-layout .btn-del-s:hover,
            .admin-layout .btn-del-s:focus-visible {
                color: #fff !important;
                background: #000000 !important;
                border-color: #000000 !important;
            }

            /* --- MODAL BULLETPROOFING (Bypass Tailwind cache bugs) --- */
            .admin-layout #modal-overlay > div > div:first-child { padding: 1.25rem 1.5rem !important; }
            .admin-layout #modal-overlay > div > div:nth-child(2) { padding: 1.5rem !important; }
            .admin-layout #modal-overlay form { display: flex !important; flex-direction: column !important; gap: 1.5rem !important; }
            .admin-layout #modal-overlay form .grid { display: grid !important; gap: 1.5rem !important; }
            .admin-layout #modal-overlay form label { margin-bottom: 0.5rem !important; display: block !important; }
            .admin-layout #modal-overlay form .space-y-4, .admin-layout #modal-overlay form .space-y-6 { display: flex !important; flex-direction: column !important; gap: 1.25rem !important; }
            /* Target wrapper divs inside grid columns but not the label/input groups */
            .admin-layout #modal-overlay form .col-span-1 > div { margin-bottom: 0.5rem !important; }
            /* Footer actions */
            .admin-layout #modal-overlay form .flex.justify-end, .admin-layout #modal-overlay form .mt-8 { margin-top: 1.5rem !important; padding-top: 1.25rem !important; border-top: 1px solid #27272a !important; display: flex !important; justify-content: flex-end !important; gap: 1rem !important; }
            .admin-layout #modal-overlay form button { padding: 0.5rem 1rem !important; border-radius: 0.375rem !important; font-weight: 500 !important; cursor: pointer !important; }
            .admin-layout #modal-overlay form .flex.justify-end button, .admin-layout #modal-overlay form .mt-8 button { padding: 0.625rem 1.5rem !important; border-radius: 0.5rem !important; font-size: 0.875rem !important; font-weight: 600 !important; }
            .admin-layout #modal-overlay h4 { margin-bottom: 1rem !important; display: block !important; }
        </style>
    </head>
    <body class="bg-zinc-950 text-zinc-100 antialiased overflow-hidden selection:bg-white/30 selection:text-white admin-layout" style="font-family: 'Inter', sans-serif;">
        <script define:vars={{ supabaseUrl, supabaseKey }}>
        import { createClient } from 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js/+esm';
        
        async function checkSession() {
            if (!supabaseUrl || !supabaseKey) {
                console.warn('Supabase config missing');
                return;
            }
            
            const supabase = createClient(supabaseUrl, supabaseKey);
            const { data } = await supabase.auth.getUser();
            
            if (!data?.user && window.location.pathname !== '/admin/login') {
                window.location.href = '/admin/login';
            }
        }
        
        // Wait for page load to ensure everything is ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', checkSession);
        } else {
            checkSession();
        }
        </script>
        <!-- Foolproof explicitly styled wrapper to guarantee padding/width constraints -->
        <div class="admin-layout" style="display: flex; height: 100vh; width: 100vw; background-color: #09090b; overflow: hidden;">
            
            <!-- Sidebar (Fixed Width, Flex-shrink 0) -->
            <aside
                id="admin-sidebar"
                class="admin-sidebar border-r border-zinc-800 z-40 transition-transform duration-300 lg:translate-x-0 -translate-x-full lg:static absolute top-0 left-0 h-full"
                style="width: 260px; flex-shrink: 0; display: flex; flex-direction: column;"
            >
                <!-- Logo -->
                <div class="border-b border-zinc-800" style="height: 96px; display: flex; align-items: center; justify-content: center; padding: 0 1rem;">
                    <a href="/admin" class="admin-brand" aria-label="LaeseProd S.L. admin">
                        <img src="/logopositivo.png" alt="LaeseProd S.L." width="386" height="353" />
                    </a>
                </div>

                <!-- Navigation -->
                <nav class="hidden-scrollbar" style="flex: 1; overflow-y: auto; padding: 1.5rem 1rem;">
                    <div style="display: flex; flex-direction: column; gap: 2rem;">
                        {menuGroups.map(group => (
                            <div>
                                <h3 class="text-xs font-semibold text-zinc-500 uppercase tracking-wider" style="padding: 0 0.75rem; margin-bottom: 0.5rem;">{group.name}</h3>
                                <ul style="display: flex; flex-direction: column; gap: 2px;">
                                    {group.items.map((item) => {
                                        const isActive = activeSection === item.id;
                                        return (
                                            <li>
                                                <a
                                                    href={item.href}
                                                    class:list={[
                                                        "group transition-colors",
                                                        isActive
                                                            ? "bg-zinc-800 text-zinc-50"
                                                            : "text-zinc-400 hover:text-zinc-50 hover:bg-zinc-800/50",
                                                    ]}
                                                    style="display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 0.75rem; border-radius: 0.375rem; font-size: 0.875rem; font-weight: 500;"
                                                >
                                                    <i data-lucide={item.icon} class:list={["w-4 h-4 transition-colors", isActive ? "text-white" : "text-zinc-500 group-hover:text-zinc-400"]}></i>
                                                    <span class="flex-1">{item.label}</span>
                                                    {item.id === 'mensajes' && (
                                                        <span 
                                                            id={`badge-sidebar-${item.id}`} 
                                                            class="hidden items-center justify-center bg-white text-white text-[10px] font-bold rounded-full h-4.5 min-w-[18px] px-1.5 shadow-sm"
                                                        ></span>
                                                    )}
                                                </a>
                                            </li>
                                        );
                                    })}
                                </ul>
                            </div>
                        ))}
                    </div>
                </nav>

                <!-- Footer -->
                <div class="border-t border-zinc-800 bg-zinc-900" style="padding: 1rem;">
                    <a
                        href="/"
                        target="_blank"
                        class="text-zinc-400 hover:text-zinc-50 transition-colors hover:bg-zinc-800/50"
                        style="display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 0.75rem; border-radius: 0.375rem; font-size: 0.875rem; font-weight: 500;"
                    >
                        <i data-lucide="external-link" class="w-4 h-4 text-zinc-500"></i>
                        Ver sitio web
                    </a>
                    <button
                        id="admin-logout"
                        class="group text-zinc-400 hover:text-white transition-colors hover:bg-zinc-800/50 w-full"
                        style="display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 0.75rem; border-radius: 0.375rem; font-size: 0.875rem; font-weight: 500; margin-top: 0.25rem;"
                    >
                        <i data-lucide="log-out" class="w-4 h-4 text-zinc-500 group-hover:text-white"></i>
                        Cerrar sesión
                    </button>
                </div>
            </aside>

            <!-- Main Content Area (Flex-1 perfectly fills remaining width ALWAYS) -->
            <div style="flex: 1; display: flex; flex-direction: column; min-width: 0; overflow: hidden; background-color: #09090b;">
                <!-- Header (Fixed Height) -->
                <header class="bg-zinc-950/80 backdrop-blur-md border-b border-zinc-800 z-30 flex-shrink-0" style="height: 64px; display: flex; align-items: center; justify-content: space-between; padding: 0 2rem;">
                    <div style="display: flex; align-items: center; gap: 1rem;">
                        <button
                            id="sidebar-toggle"
                            class="lg:hidden flex items-center justify-center text-zinc-100 rounded-md hover:bg-zinc-800"
                            style="width: 32px; height: 32px;"
                        >
                            <i data-lucide="menu" class="w-5 h-5"></i>
                        </button>
                        <h1 class="text-xl font-semibold text-zinc-50 tracking-tight" style="margin: 0;">
                            {title}
                        </h1>
                    </div>
                    <div style="display: flex; align-items: center; gap: 1rem;">
                        <div class="admin-user-dot">
                            <i data-lucide="user" class="w-4 h-4"></i>
                        </div>
                    </div>
                </header>

                <!-- Scrollable Content Viewport -->
                <main class="hidden-scrollbar" style="flex: 1; overflow-y: auto; overflow-x: hidden; padding: 2rem; width: 100%;">
                    <!-- Constrained Content Container -->
                    <div style="max-width: 1280px; width: 100%; margin: 0 auto;">
                        <slot />
                    </div>
                </main>
            </div>
        </div>

        <!-- Mobile sidebar overlay -->
        <div
            id="sidebar-overlay"
            class="fixed inset-0 bg-zinc-950/80 backdrop-blur-sm z-30 hidden lg:hidden transition-opacity"
        >
        </div>

        <script>
            // Initialize Lucide icons securely
            document.addEventListener('DOMContentLoaded', () => {
                // @ts-ignore
                if (typeof lucide !== 'undefined') {
                    // @ts-ignore
                    lucide.createIcons();
                }

                // Logout logic
                const logoutBtn = document.getElementById('admin-logout');
                logoutBtn?.addEventListener('click', async () => {
                    const originalText = logoutBtn.innerHTML;
                    logoutBtn.innerHTML = 'Cerrando...';
                    logoutBtn.setAttribute('disabled', 'true');
                    
                    try {
                        await fetch('/api/auth/logout', { method: 'POST' });
                        // Clear cookies manually as fallback
                        document.cookie = 'sb-access-token=; Path=/; Expires=Thu, 01 Jan 1970 00:00:01 GMT;';
                        document.cookie = 'sb-refresh-token=; Path=/; Expires=Thu, 01 Jan 1970 00:00:01 GMT;';
                        window.location.href = '/admin/login';
                    } catch (err) {
                        window.location.href = '/admin/login';
                    }
                });
            });

            // Mobile sidebar toggle
            const sidebar = document.getElementById("admin-sidebar");
            const toggle = document.getElementById("sidebar-toggle");
            const overlay = document.getElementById("sidebar-overlay");

            toggle?.addEventListener("click", () => {
                sidebar?.classList.toggle("-translate-x-full");
                overlay?.classList.toggle("hidden");
            });

            overlay?.addEventListener("click", () => {
                sidebar?.classList.add("-translate-x-full");
                overlay?.classList.add("hidden");
            });

            const restoreDraggable = (element: HTMLElement | null) => {
                if (!element || element.dataset.adminDragDisabled !== "true") return;
                element.setAttribute("draggable", "true");
                delete element.dataset.adminDragDisabled;
            };

            document.addEventListener("pointerdown", (event) => {
                const field = (event.target as HTMLElement).closest("input, textarea, select, [contenteditable='true']");
                const draggable = field?.closest<HTMLElement>("[draggable='true']");
                if (!draggable) return;
                draggable.dataset.adminDragDisabled = "true";
                draggable.setAttribute("draggable", "false");
            });

            document.addEventListener("focusout", (event) => {
                const field = (event.target as HTMLElement).closest("input, textarea, select, [contenteditable='true']");
                restoreDraggable(field?.closest<HTMLElement>("[data-admin-drag-disabled='true']") || null);
            });
        </script>
        <style>
            /* Custom scrollbar for sidebar */
            .hidden-scrollbar::-webkit-scrollbar {
                width: 4px;
            }
            .hidden-scrollbar::-webkit-scrollbar-track {
                background: transparent;
            }
            .hidden-scrollbar::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,0.1);
                border-radius: 4px;
            }
            .hidden-scrollbar:hover::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,0.2);
            }

            @media (max-width: 768px) {
                /* Reduce main content padding on mobile */
                .admin-layout main {
                    padding: 1rem !important;
                }


                /* Mobile table interaction hint - rows are clickable */
                .mobile-row-click {
                    cursor: pointer;
                }
                .mobile-row-click:active {
                    background-color: rgba(63, 63, 70, 0.4);
                }

                /* Remove divide lines between rows (cards have own borders) */
                .admin-responsive-table .divide-y > * + * {
                    border-top-width: 0 !important;
                }

                /* Toast container: position bottom-center on mobile */
                #toast-container {
                    left: 1rem !important;
                    right: 1rem !important;
                    bottom: 1rem !important;
                }
                #toast-container > div {
                    font-size: 14px !important;
                    padding: 12px 16px !important;
                }

                /* Modal improvements for mobile */
                .fixed.inset-0.flex.items-center.justify-center {
                    align-items: flex-end !important;
                }
                .fixed.inset-0.flex.items-center.justify-center > div {
                    max-height: 92vh !important;
                    overflow-y: auto !important;
                    border-bottom-left-radius: 0 !important;
                    border-bottom-right-radius: 0 !important;
                }

                /* Reduce form padding on mobile */
                .settings-form-content {
                    padding: 1rem !important;
                }
            }

            /* Tablet adjustments */
            @media (min-width: 769px) and (max-width: 1024px) {
                .admin-layout main {
                    padding: 1.5rem !important;
                }
            }
        </style>

        <!-- Responsive Table Accordion Script -->
        <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Only apply on mobile
            function initResponsiveTables() {
                const isMobile = window.matchMedia('(max-width: 768px)').matches;
                const tables = document.querySelectorAll('.admin-responsive-table');

                tables.forEach(tableWrapper => {
                    const rows = tableWrapper.querySelectorAll('tbody tr');
                    rows.forEach(row => {
                        if (isMobile) {
                            // Find the card-header-cell and add click handler
                            const headerCell = row.querySelector('.card-header-cell');
                            if (headerCell && !headerCell.hasAttribute('data-accordion-init')) {
                                headerCell.setAttribute('data-accordion-init', '1');
                                headerCell.addEventListener('click', (e) => {
                                    // Don't toggle if clicking a button inside
                                    if ((e.target as HTMLElement).closest('button') || (e.target as HTMLElement).closest('a')) return;
                                    row.classList.toggle('card-expanded');
                                });
                            }
                        }
                    });
                });
            }

            initResponsiveTables();
            window.addEventListener('resize', initResponsiveTables);

            // --- SIDEBAR NOTIFICATIONS POLLING ---
            async function updateBadges() {
                try {
                    const res = await fetch('/api/admin/notifications');
                    if (res.ok) {
                        const data = await res.json();
                        
                        const msgBadge = document.getElementById('badge-sidebar-mensajes');
                        if (msgBadge) {
                            if (data.messages > 0) {
                                msgBadge.textContent = data.messages > 99 ? '99+' : data.messages;
                                msgBadge.classList.replace('hidden', 'flex');
                            } else {
                                msgBadge.classList.replace('flex', 'hidden');
                            }
                        }

                    }
                } catch (err) {
                    console.error('Failed to update badges:', err);
                }
            }

            // Initial load and poll every 15s
            updateBadges();
            setInterval(updateBadges, 15000);
        });
        </script>
    </body>
</html>
