---
import { getFooterData, getNavigation, getServices, getSettings } from "../../lib/data";
const [footer, navigation, services, settings] = await Promise.all([
    getFooterData(), getNavigation(), getServices(), getSettings(),
]);

const visibleNavigation = navigation.filter((item: any) => item.is_visible !== false);
const normalizeInstagramUrl = (value?: string | null) => {
    const raw = String(value || "").trim();
    if (!raw) return "";
    if (/^https?:\/\//i.test(raw)) return raw;
    const user = raw.replace(/^@/, "").replace(/^instagram\.com\//i, "").replace(/^www\.instagram\.com\//i, "").replace(/^\/+/, "");
    return `https://www.instagram.com/${user}`;
};
const instagramUrl = normalizeInstagramUrl(settings.instagram);
const BRAND_NAME = "LaeseProd S.L.";
const normalizeBrandText = (value?: string | null) => String(value || "")
    .replace(/LaesePROD/g, BRAND_NAME)
    .replace(/LaeseProd S\.L\.\./g, BRAND_NAME)
    .replace(/Bodas\s*y\s*videoclips/gi, "Arte visual")
    .replace(/Bodas\s*\/\s*Videoclips/gi, "Arte visual")
    .trim();
const siteName = normalizeBrandText(settings.site_name) || BRAND_NAME;
const legalCopyright = normalizeBrandText(footer.copyright) || `© ${new Date().getFullYear()} ${BRAND_NAME}. Todos los derechos reservados.`;
---

<footer class="site-footer site-footer--cinema">
    <div class="site-footer__stage">
        <p class="site-footer__kicker">LaeseProd S.L.</p>
        <a class="site-footer__wordmark" href="/" aria-label={`${siteName}, inicio`}>
            <img src="/logopositivo.png" alt={siteName} width="386" height="353" />
        </a>
        <div class="site-footer__cta">
            <a href="/contacto">Empezar proyecto</a>
            <button class="js-open-chat" type="button">Chat en vivo</button>
        </div>
    </div>

    <div class="site-footer__directory">
        <nav aria-label="Navegacion del pie">
            <span>Menu</span>
            {visibleNavigation.map((item: any) => <a href={item.href}>{item.label}</a>)}
        </nav>

        <nav aria-label="Servicios del pie">
            <span>Servicios</span>
            {services.map((service: any) => <a href={`/servicios/${service.slug}`}>{service.title}</a>)}
        </nav>

        <div class="site-footer__contact">
            <span>Contacto</span>
            {settings.email && <a href={`mailto:${settings.email}`}>{settings.email}</a>}
            {settings.phone && <a href={`tel:${String(settings.phone).replace(/\s/g, "")}`}>{settings.phone}</a>}
            {instagramUrl && <a href={instagramUrl} target="_blank" rel="noreferrer">Instagram</a>}
        </div>
    </div>

    <div class="site-footer__legal">
        <span>{legalCopyright}</span>
        <a href="/legal#privacidad">Privacidad</a>
        <a href="/legal#aviso-legal">Aviso legal</a>
        <a href="/legal#cookies">Cookies</a>
    </div>
</footer>

<style>
    footer.site-footer--cinema {
        position: relative !important;
        min-height: 100svh !important;
        display: grid !important;
        grid-template-rows: minmax(0, 1fr) auto auto !important;
        gap: clamp(1.5rem, 4vh, 3rem) !important;
        padding: clamp(5.5rem, 11vh, 8rem) clamp(1.1rem, 5vw, 5rem) clamp(1.1rem, 3vw, 2rem) !important;
        color: #fff !important;
        background: #000 !important;
        overflow: hidden !important;
        border-top: 1px solid rgba(255, 255, 255, .16) !important;
        isolation: isolate !important;
    }

    footer.site-footer--cinema::before {
        content: "" !important;
        position: absolute !important;
        inset: 0 !important;
        z-index: -2 !important;
        background:
            linear-gradient(180deg, rgba(255, 255, 255, .08), transparent 24%),
            linear-gradient(110deg, rgba(255, 255, 255, .1), transparent 34%),
            #000 !important;
    }

    footer.site-footer--cinema::after {
        content: "LAESEPROD S.L." !important;
        position: absolute !important;
        right: -2vw !important;
        bottom: 13vh !important;
        z-index: -1 !important;
        color: rgba(255, 255, 255, .035) !important;
        font-family: Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif !important;
        font-size: clamp(8rem, 24vw, 23rem) !important;
        line-height: .75 !important;
        text-transform: uppercase !important;
        white-space: nowrap !important;
        pointer-events: none !important;
    }

    footer.site-footer--cinema .site-footer__stage {
        align-self: center !important;
        display: grid !important;
        justify-items: center !important;
        gap: clamp(.9rem, 2vh, 1.4rem) !important;
        text-align: center !important;
    }

    footer.site-footer--cinema .site-footer__kicker {
        margin: 0 !important;
        color: rgba(255, 255, 255, .52) !important;
        font-size: .76rem !important;
        font-weight: 800 !important;
        line-height: 1 !important;
        text-transform: uppercase !important;
    }

    footer.site-footer--cinema .site-footer__wordmark {
        display: block !important;
        width: min(620px, 78vw) !important;
        color: #fff !important;
        text-decoration: none !important;
        transition: transform 280ms cubic-bezier(.16, 1, .3, 1) !important;
    }

    footer.site-footer--cinema .site-footer__wordmark img {
        display: block !important;
        width: 100% !important;
        height: auto !important;
        object-fit: contain !important;
    }

    footer.site-footer--cinema .site-footer__wordmark:hover,
    footer.site-footer--cinema .site-footer__wordmark:focus-visible {
        transform: translateY(-4px) !important;
    }

    footer.site-footer--cinema .site-footer__claim {
        max-width: 680px !important;
        margin: 0 !important;
        color: rgba(255, 255, 255, .76) !important;
        font-size: clamp(1.05rem, 1.9vw, 1.5rem) !important;
        font-weight: 500 !important;
        line-height: 1.35 !important;
    }

    footer.site-footer--cinema .site-footer__cta {
        display: flex !important;
        flex-wrap: wrap !important;
        justify-content: center !important;
        gap: .7rem !important;
        margin-top: .35rem !important;
    }

    footer.site-footer--cinema .site-footer__cta a,
    footer.site-footer--cinema .site-footer__cta button {
        min-height: 46px !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        padding: 0 1.15rem !important;
        color: #000 !important;
        background: #fff !important;
        border: 1px solid #fff !important;
        border-radius: 999px !important;
        font: inherit !important;
        font-size: .76rem !important;
        font-weight: 800 !important;
        line-height: 1 !important;
        text-decoration: none !important;
        text-transform: uppercase !important;
        cursor: pointer !important;
        transition: transform 180ms ease, color 180ms ease, background 180ms ease !important;
    }

    footer.site-footer--cinema .site-footer__cta button {
        color: #fff !important;
        background: rgba(255, 255, 255, .08) !important;
        border-color: rgba(255, 255, 255, .42) !important;
    }

    footer.site-footer--cinema .site-footer__cta a:hover,
    footer.site-footer--cinema .site-footer__cta a:focus-visible,
    footer.site-footer--cinema .site-footer__cta button:hover,
    footer.site-footer--cinema .site-footer__cta button:focus-visible {
        transform: translateY(-2px) !important;
    }

    footer.site-footer--cinema .site-footer__directory {
        display: grid !important;
        grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
        gap: clamp(1rem, 4vw, 4rem) !important;
        padding-top: clamp(1.1rem, 3vh, 1.8rem) !important;
        border-top: 1px solid rgba(255, 255, 255, .18) !important;
    }

    footer.site-footer--cinema nav,
    footer.site-footer--cinema .site-footer__contact {
        display: grid !important;
        align-content: start !important;
        gap: .55rem !important;
    }

    footer.site-footer--cinema nav span,
    footer.site-footer--cinema .site-footer__contact span {
        margin: 0 0 .2rem !important;
        color: rgba(255, 255, 255, .46) !important;
        font-size: .68rem !important;
        font-weight: 800 !important;
        line-height: 1 !important;
        text-transform: uppercase !important;
    }

    footer.site-footer--cinema .site-footer__directory a {
        width: fit-content !important;
        color: #fff !important;
        background: transparent !important;
        border: 0 !important;
        padding: 0 !important;
        font: inherit !important;
        font-size: clamp(.94rem, 1.25vw, 1.14rem) !important;
        font-weight: 800 !important;
        line-height: 1.1 !important;
        text-align: left !important;
        text-decoration: none !important;
        text-transform: uppercase !important;
        transition: color 160ms ease, transform 160ms ease !important;
    }

    footer.site-footer--cinema .site-footer__directory a:hover,
    footer.site-footer--cinema .site-footer__directory a:focus-visible {
        color: rgba(255, 255, 255, .58) !important;
        transform: translateX(4px) !important;
    }

    footer.site-footer--cinema .site-footer__legal {
        display: flex !important;
        flex-wrap: wrap !important;
        align-items: center !important;
        gap: .75rem 1.25rem !important;
        padding-top: 1rem !important;
        color: rgba(255, 255, 255, .5) !important;
        border-top: 1px solid rgba(255, 255, 255, .12) !important;
        font-size: .72rem !important;
        line-height: 1.2 !important;
    }

    footer.site-footer--cinema .site-footer__legal span {
        margin-right: auto !important;
    }

    footer.site-footer--cinema .site-footer__legal a {
        color: rgba(255, 255, 255, .56) !important;
        background: transparent !important;
        border: 0 !important;
        padding: 0 !important;
        font: inherit !important;
        font-size: .72rem !important;
        font-weight: 700 !important;
        text-decoration: none !important;
        text-transform: uppercase !important;
    }

    @media (max-width: 760px) {
        footer.site-footer--cinema {
            grid-template-rows: minmax(0, 1fr) auto auto !important;
            gap: 1.4rem !important;
            padding: 6.5rem 1rem 6.5rem !important;
        }

        footer.site-footer--cinema::after {
            right: auto !important;
            left: 0 !important;
            bottom: 28vh !important;
            font-size: 32vw !important;
        }

        footer.site-footer--cinema .site-footer__stage {
            align-self: end !important;
        }

        footer.site-footer--cinema .site-footer__wordmark {
            width: 100% !important;
        }

        footer.site-footer--cinema .site-footer__cta {
            width: 100% !important;
        }

        footer.site-footer--cinema .site-footer__cta a,
        footer.site-footer--cinema .site-footer__cta button {
            flex: 1 1 150px !important;
        }

        footer.site-footer--cinema .site-footer__directory {
            grid-template-columns: 1fr !important;
            gap: 1rem !important;
        }

        footer.site-footer--cinema nav,
        footer.site-footer--cinema .site-footer__contact {
            gap: .42rem !important;
        }

        footer.site-footer--cinema .site-footer__directory a {
            font-size: 1rem !important;
        }

        footer.site-footer--cinema .site-footer__legal span {
            flex-basis: 100% !important;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        footer.site-footer--cinema .site-footer__wordmark,
        footer.site-footer--cinema .site-footer__cta a,
        footer.site-footer--cinema .site-footer__cta button,
        footer.site-footer--cinema .site-footer__directory a {
            transition: none !important;
        }
    }
</style>
