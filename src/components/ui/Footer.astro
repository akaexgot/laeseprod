---
/**
 * Footer — Editorial Minimal
 * Clean grid with large branding and minimal links
 */
import {
    getNavigation,
    getServices,
    getSettings,
    getFooterData,
} from "../../lib/data";
const navigation = await getNavigation();
const services = await getServices();
const settings = await getSettings();
const footerData = await getFooterData();
---

<footer class="border-t border-dark-border bg-dark-surface/50 relative">
    <!-- Main Footer -->
    <div class="section-container py-16 lg:py-24">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8">
            <!-- Brand Column -->
            <div class="lg:col-span-5">
                <a href="/" class="flex items-center gap-3 mb-6">
                    <div
                        class="w-10 h-10 bg-gradient-carmin rounded-xl flex items-center justify-center"
                    >
                        <span class="text-white font-bold text-lg font-display"
                            >V</span
                        >
                    </div>
                    <span
                        class="font-display font-bold text-lg text-white tracking-tight"
                        >VideoMarketing</span
                    >
                </a>
                <p
                    class="text-light-subtle text-sm leading-relaxed max-w-sm mb-8"
                >
                    {footerData.description}
                </p>
                <div class="flex items-center gap-4">
                    <a
                        href={settings.instagram}
                        target="_blank"
                        rel="noopener"
                        class="w-10 h-10 border border-dark-border rounded-full flex items-center justify-center text-light-subtle hover:text-white hover:border-white/20 transition-all duration-300"
                        aria-label="Instagram"
                    >
                        <svg
                            class="w-4 h-4"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                            ></path></svg
                        >
                    </a>
                    <a
                        href={settings.linkedin}
                        target="_blank"
                        rel="noopener"
                        class="w-10 h-10 border border-dark-border rounded-full flex items-center justify-center text-light-subtle hover:text-white hover:border-white/20 transition-all duration-300"
                        aria-label="LinkedIn"
                    >
                        <svg
                            class="w-4 h-4"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                            ></path></svg
                        >
                    </a>
                    <a
                        href={`https://wa.me/${settings.whatsapp_number}`}
                        target="_blank"
                        rel="noopener"
                        class="w-10 h-10 border border-dark-border rounded-full flex items-center justify-center text-light-subtle hover:text-[#25D366] hover:border-[#25D366]/30 transition-all duration-300"
                        aria-label="WhatsApp"
                    >
                        <svg
                            class="w-4 h-4"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"
                            ></path></svg
                        >
                    </a>
                </div>
            </div>

            <!-- Navigation -->
            <div class="lg:col-span-2">
                <h4 class="text-label text-light-subtle mb-5">Navegación</h4>
                <nav class="space-y-3">
                    {
                        navigation.map((item: any) => (
                            <a
                                href={item.href}
                                class="block text-sm text-light-muted hover:text-white transition-colors duration-300 line-animated w-fit"
                            >
                                {item.label}
                            </a>
                        ))
                    }
                </nav>
            </div>

            <!-- Services -->
            <div class="lg:col-span-2">
                <h4 class="text-label text-light-subtle mb-5">Servicios</h4>
                <nav class="space-y-3">
                    {
                        services.slice(0, 5).map((service: any) => (
                            <a
                                href={`/servicios/${service.slug}`}
                                class="block text-sm text-light-muted hover:text-white transition-colors duration-300 line-animated w-fit"
                            >
                                {service.title}
                            </a>
                        ))
                    }
                </nav>
            </div>

            <!-- Contact -->
            <div class="lg:col-span-3">
                <h4 class="text-label text-light-subtle mb-5">Contacto</h4>
                <div class="space-y-3 text-sm text-light-muted">
                    <p class="flex items-start gap-2">
                        <svg
                            class="w-4 h-4 text-carmin mt-0.5 flex-shrink-0"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                            ></path><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                            ></path></svg
                        >
                        {settings.address}
                    </p>
                    <p class="flex items-center gap-2">
                        <svg
                            class="w-4 h-4 text-carmin flex-shrink-0"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                            ></path></svg
                        >
                        <a
                            href={`tel:${settings.phone}`}
                            class="hover:text-white transition-colors"
                            >{settings.phone}</a
                        >
                    </p>
                    <p class="flex items-center gap-2">
                        <svg
                            class="w-4 h-4 text-carmin flex-shrink-0"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                            ></path></svg
                        >
                        <a
                            href={`mailto:${settings.email}`}
                            class="hover:text-white transition-colors"
                            >{settings.email}</a
                        >
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-dark-border">
        <div
            class="section-container py-6 flex flex-col sm:flex-row items-center justify-between gap-4"
        >
            <p class="text-light-subtle text-xs">{footerData.copyright}</p>
            <div class="flex items-center gap-6">
                <a
                    href="/privacidad"
                    class="text-light-subtle text-xs hover:text-white transition-colors line-animated"
                    >Privacidad</a
                >
                <a
                    href="/aviso-legal"
                    class="text-light-subtle text-xs hover:text-white transition-colors line-animated"
                    >Legal</a
                >
                <a
                    href="/cookies"
                    class="text-light-subtle text-xs hover:text-white transition-colors line-animated"
                    >Cookies</a
                >
            </div>
        </div>
    </div>
</footer>
