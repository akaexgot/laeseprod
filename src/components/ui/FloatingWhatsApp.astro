---
import { getSettings } from "../../lib/data";

const settings = await getSettings();
const number = String(settings.whatsapp_number || settings.phone || "34662908416").replace(/\D/g, "");
const url = `https://wa.me/${number}?text=Hola%20LaeseProd,%20quiero%20hablar%20sobre%20un%20proyecto.`;
---

<a class="floating-whatsapp" href={url} target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp" title="Contactar por WhatsApp">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M20.52 3.48A11.9 11.9 0 0 0 12.05 0C5.47 0 .11 5.35.1 11.93c0 2.1.55 4.16 1.6 5.97L0 24l6.25-1.64a11.94 11.94 0 0 0 5.8 1.48h.01c6.58 0 11.94-5.35 11.94-11.93a11.85 11.85 0 0 0-3.48-8.43ZM12.06 21.83a9.9 9.9 0 0 1-5.05-1.38l-.36-.21-3.71.97.99-3.62-.24-.37a9.88 9.88 0 0 1-1.52-5.29c0-5.47 4.46-9.92 9.93-9.92a9.86 9.86 0 0 1 7.02 2.91 9.86 9.86 0 0 1 2.9 7.02c0 5.46-4.46 9.91-9.96 9.91Zm5.45-7.42c-.3-.15-1.77-.87-2.04-.97-.28-.1-.48-.15-.68.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.18-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.2 5.09 4.49.71.31 1.27.49 1.7.63.71.23 1.36.2 1.88.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35Z" />
    </svg>
</a>

<style>
    .floating-whatsapp {
        position: fixed;
        right: calc(clamp(1rem, 2.4vw, 1.6rem) + env(safe-area-inset-right, 0px));
        bottom: calc(clamp(1rem, 2.4vw, 1.6rem) + env(safe-area-inset-bottom, 0px));
        z-index: 100001;
        display: grid;
        place-items: center;
        width: 58px;
        height: 58px;
        border: 1px solid rgba(255, 255, 255, .3);
        border-radius: 50%;
        background: #25d366;
        color: #fff;
        box-shadow: 0 6px 24px rgba(0, 0, 0, .28);
        transition: background 160ms ease, transform 160ms ease;
    }
    .floating-whatsapp svg { width: 30px; height: 30px; }
    .floating-whatsapp:hover { background: #128c7e; transform: translateY(-2px); }
    .floating-whatsapp:focus-visible { outline: 3px solid #fff; outline-offset: 4px; }
    @media (prefers-reduced-motion: reduce) {
        .floating-whatsapp { transition: none; }
    }
</style>
