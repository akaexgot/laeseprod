---
import { getVideoId } from "../../lib/display";
import { optimizeCloudinaryVideo } from "../../lib/cloudinary";

interface Props {
    desktop?: string | null;
    mobile?: string | null;
    title?: string;
    overlay?: "light" | "dark" | "none";
}

const {
    desktop = "",
    mobile = desktop,
    title = "Video de fondo",
    overlay = "dark",
} = Astro.props;

function source(value: string | null | undefined, width: number, bitRate: string) {
    const url = String(value || "").trim();
    const native = /cloudinary\.com|\.(mp4|webm)(\?.*)?$/i.test(url);
    const youtubeId = native ? "" : getVideoId(url) || "";
    return {
        url: native ? optimizeCloudinaryVideo(url, { width, quality: "auto:good", bitRate }) : "",
        youtubeId,
        poster: youtubeId ? `https://i.ytimg.com/vi/${youtubeId}/maxresdefault.jpg` : cloudinaryPoster(url, width),
    };
}

function cloudinaryPoster(value: string, width: number) {
    if (!value.includes("cloudinary.com") || !value.includes("/upload/")) return "";

    const [path, query = ""] = value.split("?");
    const imagePath = path.replace(/\.(mp4|webm|mov)$/i, ".jpg");
    const transformed = imagePath.replace("/upload/", `/upload/so_0,f_jpg,q_auto,w_${width}/`);

    return query ? `${transformed}?${query}` : transformed;
}

const sources = {
    desktop: source(desktop || mobile, 1600, "4m"),
    mobile: source(mobile || desktop, 720, "2m"),
};
const poster = sources.desktop.poster || sources.mobile.poster;
---

<div
    class="video-background"
    data-video-background
    data-sources={JSON.stringify(sources)}
    style={poster ? `background-image:url(${poster})` : undefined}
    aria-hidden="true"
>
    <video class="video-background__native" muted loop playsinline preload="none"></video>
    <iframe
        class="video-background__youtube"
        title={title}
        tabindex="-1"
        style="border: 0"
        allow="autoplay; encrypted-media"
    ></iframe>
    {overlay !== "none" && <span class={`video-background__overlay video-background__overlay--${overlay}`}></span>}
</div>

<script>
    function disableBackgroundYouTubeCaptions(frame: HTMLIFrameElement) {
        const send = (func: string, args: unknown[] = []) => {
            frame.contentWindow?.postMessage(JSON.stringify({ event: 'command', func, args }), '*');
        };
        const clean = () => {
            send('unloadModule', ['captions']);
            send('unloadModule', ['cc']);
            send('setOption', ['captions', 'track', {}]);
        };

        frame.addEventListener('load', clean, { once: true });
        window.setTimeout(clean, 450);
        window.setTimeout(clean, 1400);
    }

    function initVideoBackgrounds() {
        document.querySelectorAll<HTMLElement>('[data-video-background]:not([data-ready])').forEach((root) => {
            root.dataset.ready = 'true';
            const sources = JSON.parse(root.dataset.sources || '{}');
            const isMobile = window.matchMedia('(max-width: 767px)').matches;
            const selected = isMobile ? sources.mobile : sources.desktop;
            const video = root.querySelector<HTMLVideoElement>('.video-background__native');
            const iframe = root.querySelector<HTMLIFrameElement>('.video-background__youtube');
            if (!selected || (!selected.url && !selected.youtubeId)) return;
            if (selected.poster) root.style.backgroundImage = `url(${selected.poster})`;
            if (isMobile) {
                root.classList.add('video-background--poster-only');
                return;
            }

            const load = () => {
                if (selected.url && video) {
                    video.src = selected.url;
                    video.autoplay = true;
                    video.addEventListener('playing', () => video.classList.add('is-visible'), { once: true });
                    video.play().catch(() => {});
                } else if (selected.youtubeId && iframe) {
                    const origin = encodeURIComponent(window.location.origin);
                    iframe.src = `https://www.youtube-nocookie.com/embed/${selected.youtubeId}?autoplay=1&mute=1&controls=0&showinfo=0&rel=0&modestbranding=1&playsinline=1&loop=1&playlist=${selected.youtubeId}&cc_load_policy=0&iv_load_policy=3&disablekb=1&fs=0&enablejsapi=1&origin=${origin}`;
                    disableBackgroundYouTubeCaptions(iframe);
                    iframe.addEventListener('load', () => iframe.classList.add('is-visible'), { once: true });
                }
            };

            if (!('IntersectionObserver' in window)) return load();
            const observer = new IntersectionObserver((entries) => {
                if (entries.some((entry) => entry.isIntersecting)) {
                    load();
                    observer.disconnect();
                }
            }, { rootMargin: '240px' });
            observer.observe(root);
        });
    }

    document.addEventListener('DOMContentLoaded', initVideoBackgrounds);
</script>

<style is:global>
    .video-background {
        position: absolute;
        inset: 0;
        overflow: hidden;
        background: #050505 center / cover no-repeat;
        pointer-events: none;
    }

    .video-background * {
        pointer-events: none;
    }

    .video-background__native,
    .video-background__youtube {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 100%;
        height: 100%;
        min-width: 177.78vh;
        min-height: 56.25vw;
        transform: translate(-50%, -50%) scale(1.02);
        object-fit: cover;
        opacity: 0;
        transition: opacity 500ms ease;
    }

    .video-background__native.is-visible,
    .video-background__youtube.is-visible {
        opacity: 1;
    }

    .video-background__youtube {
        width: 120%;
        height: 120%;
        min-width: 213.34vh;
        min-height: 67.5vw;
    }

    .video-background__overlay {
        position: absolute;
        inset: 0;
    }

    .video-background__overlay--dark {
        background: rgba(0, 0, 0, 0.28);
    }

    .video-background__overlay--light {
        background: rgba(255, 255, 255, 0.18);
    }

    @media (prefers-reduced-motion: reduce) {
        .video-background__native,
        .video-background__youtube {
            display: none;
        }
    }
</style>
