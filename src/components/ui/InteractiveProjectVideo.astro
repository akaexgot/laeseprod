---
import { Play } from "@lucide/astro";
import { getInstagramEmbedUrl, getVideoId, isInstagramReel } from "../../lib/display";
import { optimizeCloudinaryVideo } from "../../lib/cloudinary";

interface Props {
    url?: string | null;
    desktop?: string | null;
    mobile?: string | null;
    title?: string;
    poster?: string | null;
    orientation?: "auto" | "vertical";
}

const { url = "", desktop = "", mobile = "", title = "Video del proyecto", poster = "", orientation = "auto" } = Astro.props;
const forceVertical = orientation === "vertical";

function source(value: string | null | undefined, width: number, bitRate: string) {
    const cleanUrl = String(value || "").trim();
    const isNative = /cloudinary\.com|\.(mp4|webm)(\?.*)?$/i.test(cleanUrl);
    const isInstagram = isInstagramReel(cleanUrl);
    const isShort = /youtube(?:-nocookie)?\.com\/shorts\//i.test(cleanUrl);
    const youtubeId = !isNative && !isInstagram ? getVideoId(cleanUrl) : "";

    return {
        nativeUrl: isNative ? optimizeCloudinaryVideo(cleanUrl, { width, quality: "auto:good", bitRate }) : "",
        nativePoster: isNative ? cloudinaryPoster(cleanUrl, width) : "",
        youtubeId,
        youtubePoster: youtubeId ? `https://i.ytimg.com/vi/${youtubeId}/maxresdefault.jpg` : "",
        instagramEmbed: isInstagram ? getInstagramEmbedUrl(cleanUrl) : "",
        isVertical: forceVertical || isShort || isInstagram,
        hasMedia: Boolean(cleanUrl),
    };
}

function cloudinaryPoster(value: string, width: number) {
    if (!value.includes("cloudinary.com") || !value.includes("/upload/")) return "";

    const [path, query = ""] = value.split("?");
    const imagePath = path.replace(/\.(mp4|webm|mov)$/i, ".jpg");
    const transformed = imagePath.replace("/upload/", `/upload/so_0,f_jpg,q_auto,w_${width}/`);

    return query ? `${transformed}?${query}` : transformed;
}

const desktopUrl = desktop || url || mobile;
const mobileUrl = mobile || url || desktop;
const sources = {
    desktop: source(desktopUrl, 1600, "5m"),
    mobile: source(mobileUrl, 720, "3m"),
};
---

<div
    class="interactive-project-video"
    data-interactive-project-video
    data-sources={JSON.stringify(sources)}
    data-title={title}
    data-poster={poster || ""}
>
    <video class="interactive-project-video__media interactive-project-video__native" controls playsinline preload="metadata"></video>
    <iframe
        class="interactive-project-video__media interactive-project-video__youtube"
        title={title}
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
    ></iframe>
    <iframe
        class="interactive-project-video__media interactive-project-video__instagram"
        title={title}
        allowtransparency="true"
        allowfullscreen
    ></iframe>
    <img class="interactive-project-video__media interactive-project-video__poster" alt={title} />
    <button class="interactive-project-video__play" type="button" aria-label={`Reproducir ${title}`}>
        <Play size={34} stroke-width={2.6} fill="currentColor" aria-hidden="true" />
    </button>
    <div class="interactive-project-video__empty">Video no disponible</div>
</div>

<script>
    function disableInteractiveYouTubeCaptions(frame: HTMLIFrameElement) {
        const send = (func: string, args: unknown[] = []) => {
            frame.contentWindow?.postMessage(JSON.stringify({ event: 'command', func, args }), '*');
        };
        const clean = () => {
            send('unloadModule', ['captions']);
            send('unloadModule', ['cc']);
            send('setOption', ['captions', 'track', {}]);
        };

        frame.addEventListener('load', clean, { once: true });
        window.setTimeout(clean, 450);
        window.setTimeout(clean, 1400);
    }

    function initInteractiveProjectVideos() {
        const pauseVideoRoot = (root: HTMLElement) => {
            const nativeVideo = root.querySelector<HTMLVideoElement>('.interactive-project-video__native');
            const youtubeFrame = root.querySelector<HTMLIFrameElement>('.interactive-project-video__youtube');
            const instagramFrame = root.querySelector<HTMLIFrameElement>('.interactive-project-video__instagram');
            const posterImage = root.querySelector<HTMLImageElement>('.interactive-project-video__poster');
            const playButton = root.querySelector<HTMLButtonElement>('.interactive-project-video__play');
            nativeVideo?.pause();
            youtubeFrame?.contentWindow?.postMessage(JSON.stringify({ event: 'command', func: 'pauseVideo', args: [] }), '*');
            if (instagramFrame?.getAttribute('src')) {
                instagramFrame.removeAttribute('src');
                const instagramEmbed = root.dataset.instagramEmbed || '';
                if (instagramEmbed) {
                    window.setTimeout(() => {
                        if (!root.classList.contains('is-playing')) instagramFrame.src = instagramEmbed;
                    }, 40);
                } else {
                    instagramFrame.classList.remove('is-visible');
                    if (posterImage?.getAttribute('src')) posterImage.classList.add('is-visible');
                    playButton?.classList.add('is-visible');
                }
            }
            root.classList.remove('is-playing');
        };

        const pauseOtherVideos = (activeRoot: HTMLElement) => {
            document.querySelectorAll<HTMLElement>('[data-interactive-project-video]').forEach((otherRoot) => {
                if (otherRoot !== activeRoot) pauseVideoRoot(otherRoot);
            });
        };

        document.querySelectorAll<HTMLElement>('[data-interactive-project-video]:not([data-ready])').forEach((root) => {
            root.dataset.ready = 'true';
            const sources = JSON.parse(root.dataset.sources || '{}');
            const selected = window.matchMedia('(max-width: 767px)').matches ? sources.mobile : sources.desktop;
            const poster = root.dataset.poster || '';
            const title = root.dataset.title || 'Video del proyecto';
            const nativeVideo = root.querySelector<HTMLVideoElement>('.interactive-project-video__native');
            const youtubeFrame = root.querySelector<HTMLIFrameElement>('.interactive-project-video__youtube');
            const instagramFrame = root.querySelector<HTMLIFrameElement>('.interactive-project-video__instagram');
            const posterImage = root.querySelector<HTMLImageElement>('.interactive-project-video__poster');
            const playButton = root.querySelector<HTMLButtonElement>('.interactive-project-video__play');
            const empty = root.querySelector<HTMLElement>('.interactive-project-video__empty');

            const hideAll = () => {
                root.querySelectorAll<HTMLElement>('.interactive-project-video__media, .interactive-project-video__empty, .interactive-project-video__play').forEach((item) => {
                    item.classList.remove('is-visible');
                });
                if (nativeVideo) {
                    nativeVideo.pause();
                    nativeVideo.removeAttribute('src');
                    nativeVideo.removeAttribute('poster');
                    nativeVideo.load();
                }
                if (youtubeFrame) youtubeFrame.removeAttribute('src');
                if (instagramFrame) instagramFrame.removeAttribute('src');
                if (posterImage) posterImage.removeAttribute('src');
            };

            hideAll();
            root.classList.toggle('interactive-project-video--vertical', Boolean(selected?.isVertical));

            if (selected?.nativeUrl && nativeVideo) {
                nativeVideo.src = selected.nativeUrl;
                const nativePoster = poster || selected.nativePoster || '';
                if (nativePoster) nativeVideo.poster = nativePoster;
                nativeVideo.addEventListener('play', () => {
                    pauseOtherVideos(root);
                    root.classList.add('is-playing');
                });
                nativeVideo.addEventListener('pause', () => root.classList.remove('is-playing'));
                nativeVideo.classList.add('is-visible');
                return;
            }

            if (selected?.youtubeId && youtubeFrame) {
                const loadYouTube = () => {
                    const origin = encodeURIComponent(window.location.origin);
                    pauseOtherVideos(root);
                    posterImage?.classList.remove('is-visible');
                    playButton?.classList.remove('is-visible');
                    youtubeFrame.src = `https://www.youtube-nocookie.com/embed/${selected.youtubeId}?autoplay=1&rel=0&modestbranding=1&playsinline=1&controls=1&cc_load_policy=0&iv_load_policy=3&disablekb=1&enablejsapi=1&origin=${origin}`;
                    youtubeFrame.title = title;
                    disableInteractiveYouTubeCaptions(youtubeFrame);
                    youtubeFrame.classList.add('is-visible');
                    root.classList.add('is-playing');
                };

                if (posterImage) {
                    posterImage.src = poster || selected.youtubePoster || `https://i.ytimg.com/vi/${selected.youtubeId}/hqdefault.jpg`;
                    posterImage.alt = title;
                    posterImage.classList.add('is-visible');
                }
                playButton?.classList.add('is-visible');
                playButton?.addEventListener('click', loadYouTube, { once: true });
                return;
            }

            if (selected?.instagramEmbed && instagramFrame) {
                const markInstagramActive = () => {
                    pauseOtherVideos(root);
                    root.classList.add('is-playing');
                };

                root.classList.add('interactive-project-video--instagram');
                root.dataset.instagramEmbed = selected.instagramEmbed;
                instagramFrame.src = selected.instagramEmbed;
                instagramFrame.title = title;
                instagramFrame.classList.add('is-visible');
                instagramFrame.addEventListener('pointerdown', markInstagramActive);
                instagramFrame.addEventListener('focus', markInstagramActive);
                return;
            }

            if (poster && posterImage) {
                posterImage.src = poster;
                posterImage.alt = title;
                posterImage.classList.add('is-visible');
                return;
            }

            empty?.classList.add('is-visible');
        });
    }

    document.addEventListener('DOMContentLoaded', initInteractiveProjectVideos);
</script>

<style>
    .interactive-project-video {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        overflow: hidden;
        background: #050505;
    }

    .interactive-project-video__media {
        display: none;
        width: 100%;
        height: 100%;
        border: 0;
        object-fit: contain;
        background: #050505;
    }

    .interactive-project-video__poster {
        object-fit: cover;
        filter: grayscale(1) contrast(1.05);
    }

    .interactive-project-video__media.is-visible,
    .interactive-project-video__play.is-visible,
    .interactive-project-video__empty.is-visible {
        display: block;
    }

    .interactive-project-video__play {
        position: absolute;
        z-index: 4;
        inset: 50% auto auto 50%;
        width: 78px;
        height: 78px;
        display: none;
        place-items: center;
        color: #fff;
        background: rgba(0, 0, 0, .42);
        border: 1px solid rgba(255, 255, 255, .72);
        border-radius: 50%;
        cursor: pointer;
        transform: translate(-50%, -50%);
        backdrop-filter: blur(10px);
        transition: color 160ms ease, background 160ms ease, transform 160ms ease, border-color 160ms ease;
    }

    .interactive-project-video__play.is-visible {
        display: grid;
    }

    .interactive-project-video__play:hover,
    .interactive-project-video__play:focus-visible {
        color: #000;
        background: #fff;
        border-color: #fff;
        transform: translate(-50%, -50%) scale(1.04);
        outline: none;
    }

    .interactive-project-video--vertical {
        background: #000;
    }

    .interactive-project-video--vertical .interactive-project-video__media {
        width: auto;
        height: 100%;
        max-width: 100%;
        aspect-ratio: 9 / 16;
        box-shadow: 0 0 0 1px rgba(255, 255, 255, .16);
    }

    iframe.interactive-project-video__media {
        object-fit: initial;
    }

    .interactive-project-video--vertical iframe.interactive-project-video__media {
        width: min(100%, calc(100svh * .5625));
        height: 100%;
    }

    .interactive-project-video--vertical.interactive-project-video--instagram {
        overflow: hidden;
        background: #000;
    }

    .interactive-project-video--vertical.interactive-project-video--instagram .interactive-project-video__instagram {
        width: min(100%, calc(100svh * .5625));
        height: 100%;
        max-width: 100%;
        aspect-ratio: 9 / 16;
        transform: none;
        transform-origin: center;
        background: #000;
        box-shadow: none;
    }

    @media (max-width: 760px) {
        .interactive-project-video--vertical .interactive-project-video__media,
        .interactive-project-video--vertical iframe.interactive-project-video__media {
            width: 100%;
            height: auto;
            max-height: 100%;
        }

        .interactive-project-video--vertical.interactive-project-video--instagram .interactive-project-video__instagram {
            width: min(100%, calc(100svh * .5625));
            height: 100%;
            transform: none;
        }
    }

    .interactive-project-video__empty {
        display: none;
        color: #fff;
        font-size: .82rem;
        font-weight: 900;
        text-transform: uppercase;
    }
</style>
