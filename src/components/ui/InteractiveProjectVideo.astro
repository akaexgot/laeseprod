---
import { getInstagramEmbedUrl, getVideoId, isInstagramReel } from "../../lib/display";
import { optimizeCloudinaryVideo } from "../../lib/cloudinary";

interface Props {
    url?: string | null;
    title?: string;
    poster?: string | null;
}

const { url = "", title = "Video del proyecto", poster = "" } = Astro.props;
const cleanUrl = String(url || "").trim();
const isNative = /cloudinary\.com|\.(mp4|webm)(\?.*)?$/i.test(cleanUrl);
const isInstagram = isInstagramReel(cleanUrl);
const youtubeId = !isNative && !isInstagram ? getVideoId(cleanUrl) : "";
const nativeUrl = isNative ? optimizeCloudinaryVideo(cleanUrl, { width: 1920, quality: "auto:best" }) : "";
const instagramEmbed = isInstagram ? getInstagramEmbedUrl(cleanUrl) : "";
---

<div class="interactive-project-video">
    {nativeUrl ? (
        <video
            class="interactive-project-video__media"
            src={nativeUrl}
            poster={poster || undefined}
            controls
            playsinline
            preload="metadata"
        ></video>
    ) : youtubeId ? (
        <iframe
            class="interactive-project-video__media"
            src={`https://www.youtube-nocookie.com/embed/${youtubeId}?rel=0&modestbranding=1&playsinline=1&controls=1`}
            title={title}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
        ></iframe>
    ) : instagramEmbed ? (
        <iframe
            class="interactive-project-video__media"
            src={instagramEmbed}
            title={title}
            allowtransparency="true"
            allowfullscreen
        ></iframe>
    ) : poster ? (
        <img class="interactive-project-video__media" src={poster} alt={title} />
    ) : (
        <div class="interactive-project-video__empty">Video no disponible</div>
    )}
</div>

<style>
    .interactive-project-video {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        overflow: hidden;
        background: #050505;
    }

    .interactive-project-video__media {
        width: 100%;
        height: 100%;
        border: 0;
        object-fit: contain;
        background: #050505;
    }

    iframe.interactive-project-video__media {
        object-fit: initial;
    }

    .interactive-project-video__empty {
        color: #fff;
        font-size: .82rem;
        font-weight: 900;
        text-transform: uppercase;
    }
</style>
