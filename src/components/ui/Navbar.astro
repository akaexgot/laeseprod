---
import { Camera, ChevronDown, FolderLock, Menu, MessageCircle, Moon, Sun, X } from "@lucide/astro";
import { getNavigation, getSettings } from "../../lib/data";

const [navigation, settings] = await Promise.all([getNavigation(), getSettings()]);
const links = navigation.filter((item: any) => item.is_visible !== false);
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) => href === "/" ? currentPath === "/" : currentPath === href || currentPath.startsWith(`${href}/`);
const isHome = currentPath === "/";
const isSplitLeft = (href: string) => href === "/" || href === "/proyectos";
const siteName = String(settings.site_name || "LaeseProd S.L.")
    .replace(/LaesePROD/g, "LaeseProd S.L.")
    .replace(/LaeseProd S\.L\.\./g, "LaeseProd S.L.");
const normalizeInstagramUrl = (value?: string | null) => {
    const raw = String(value || "").trim();
    if (!raw) return "https://www.instagram.com/laeseprod";
    if (/^https?:\/\//i.test(raw)) return raw;
    const user = raw.replace(/^@/, "").replace(/^instagram\.com\//i, "").replace(/^www\.instagram\.com\//i, "").replace(/^\/+/, "");
    return `https://www.instagram.com/${user}`;
};
const whatsappNumber = String(settings.whatsapp_number || settings.phone || "34662908416").replace(/\D/g, "");
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=Hola%20LaeseProd,%20quiero%20hablar%20sobre%20un%20proyecto.`;
const instagramUrl = normalizeInstagramUrl(settings.instagram);
---

<header class:list={["site-header", "nav-theme-light", { "is-home": isHome }]} data-site-header>
    <nav class="site-nav" aria-label="Navegacion principal">
        <a class="site-nav__brand" href="/" aria-label={`${siteName}, inicio`}>
            <img class="site-nav__brand-logo site-nav__brand-logo--negative" src="/logonegativo.png" alt={siteName} width="386" height="353" />
            <img class="site-nav__brand-logo site-nav__brand-logo--positive" src="/logopositivo.png" alt="" width="386" height="353" aria-hidden="true" />
        </a>

        <div class="site-nav__desktop" data-nav-desktop>
            {links.map((item: any) => item.href === "/servicios" ? (
                <div class:list={[
                    "site-nav__group",
                    "site-nav__item",
                    {
                        "site-nav__item--split-left": isSplitLeft(item.href),
                        "site-nav__item--split-right": !isSplitLeft(item.href),
                        "site-nav__item--split-break": item.href === "/proyectos",
                    },
                ]}>
                    <a class:list={["site-nav__link", { "is-active": isActive(item.href) }]} href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
                        <span class="nav-reveal"><span>{item.label}</span></span><ChevronDown size={16} stroke-width={2.2} aria-hidden="true" />
                    </a>
                    <div class="site-nav__submenu">
                        <p>Servicios</p>
                        <a href="/servicios/bodas"><span>Bodas</span><small>Historias para volver a vivirlas</small></a>
                        <a href="/servicios/videoclips"><span>Videoclips</span><small>Imagen con identidad propia</small></a>
                    </div>
                </div>
            ) : (
                <a class:list={[
                    "site-nav__link",
                    "site-nav__item",
                    {
                        "is-active": isActive(item.href),
                        "site-nav__item--split-left": isSplitLeft(item.href),
                        "site-nav__item--split-right": !isSplitLeft(item.href),
                        "site-nav__item--split-break": item.href === "/proyectos",
                    },
                ]} href={item.href} aria-current={isActive(item.href) ? "page" : undefined}><span class="nav-reveal"><span>{item.label}</span></span></a>
            ))}
        </div>

        <div class="site-nav__actions">
            <button class="site-nav__portal" type="button" aria-label="Portal de clientes" title="Portal de clientes" data-portal-open>
                <FolderLock size={19} stroke-width={2} aria-hidden="true" />
            </button>
            <a class="site-nav__whatsapp" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="WhatsApp" title="WhatsApp">
                <MessageCircle size={21} stroke-width={2} aria-hidden="true" />
                <span class="site-nav__whatsapp-status"></span>
            </a>
            <button class="site-nav__toggle" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobile-navigation" data-nav-toggle>
                <Menu class="site-nav__menu-icon" size={23} stroke-width={2} aria-hidden="true" />
                <X class="site-nav__close-icon" size={23} stroke-width={2} aria-hidden="true" />
            </button>
            <button class="site-nav__theme" type="button" aria-label="Cambiar tema del menu" title="Cambiar tema del menu" data-nav-theme-toggle>
                <Sun class="site-nav__theme-sun" size={18} stroke-width={2} aria-hidden="true" />
                <Moon class="site-nav__theme-moon" size={18} stroke-width={2} aria-hidden="true" />
            </button>
        </div>
    </nav>

    <div id="mobile-navigation" class="mobile-navigation" aria-hidden="true" data-mobile-nav>
        <div class="mobile-navigation__inner">
            <div class="mobile-navigation__primary">
                {links.map((item: any, index: number) => (
                    <a class:list={[{ "is-active": isActive(item.href) }]} href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
                        <small>{String(index + 1).padStart(2, "0")}</small><span class="nav-reveal"><span>{item.label}</span></span>
                    </a>
                ))}
            </div>

            <div class="mobile-navigation__actions">
                <button type="button" data-portal-open><FolderLock size={18} aria-hidden="true" />Portal cliente</button>
                <a href={instagramUrl} target="_blank" rel="noreferrer"><Camera size={18} aria-hidden="true" />Instagram</a>
                <a class="mobile-navigation__whatsapp" href={whatsappUrl} target="_blank" rel="noreferrer"><MessageCircle size={18} aria-hidden="true" />WhatsApp</a>
            </div>
        </div>
    </div>
</header>

<div class="portal-access-modal" data-portal-modal aria-hidden="true">
    <button class="portal-access-modal__backdrop" type="button" aria-label="Cerrar acceso cliente" data-portal-close></button>
    <div class="portal-access-modal__panel" role="dialog" aria-modal="true" aria-labelledby="portal-access-title">
        <button class="portal-access-modal__close" type="button" aria-label="Cerrar" data-portal-close>
            <X size={19} stroke-width={2} aria-hidden="true" />
        </button>
        <div class="portal-access-modal__icon" aria-hidden="true">
            <FolderLock size={24} stroke-width={1.9} />
        </div>
        <h2 id="portal-access-title" data-portal-title>Acceso cliente</h2>
        <p data-portal-copy>Introduce tu codigo privado para abrir tu carpeta de Dropbox.</p>
        <form class="portal-access-modal__form" data-portal-form>
            <input data-portal-code type="password" inputmode="text" autocomplete="one-time-code" placeholder="Codigo de acceso" />
            <p class="portal-access-modal__error" data-portal-error hidden></p>
            <button type="submit" data-portal-submit>Introducir codigo</button>
        </form>
        <a class="portal-access-modal__dropbox" href="#" target="_blank" rel="noopener noreferrer" data-portal-dropbox hidden>Abrir Dropbox</a>
    </div>
</div>

<script>
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const mobileNav = document.querySelector<HTMLElement>('[data-mobile-nav]');
    const portalModal = document.querySelector<HTMLElement>('[data-portal-modal]');
    const portalForm = document.querySelector<HTMLFormElement>('[data-portal-form]');
    const portalCode = document.querySelector<HTMLInputElement>('[data-portal-code]');
    const portalError = document.querySelector<HTMLElement>('[data-portal-error]');
    const portalSubmit = document.querySelector<HTMLButtonElement>('[data-portal-submit]');
    const portalDropbox = document.querySelector<HTMLAnchorElement>('[data-portal-dropbox]');
    const portalCopy = document.querySelector<HTMLElement>('[data-portal-copy]');
    const portalTitle = document.querySelector<HTMLElement>('[data-portal-title]');
    const themeToggle = document.querySelector<HTMLButtonElement>('[data-nav-theme-toggle]');
    const applyMenuTheme = (theme: 'dark' | 'light') => {
        if (!header || !themeToggle) return;
        header.dataset.menuTheme = theme;
        header.classList.toggle('nav-theme-light', theme === 'light');
        header.classList.toggle('nav-theme-dark', theme === 'dark');
        themeToggle.setAttribute('aria-label', theme === 'light' ? 'Cambiar menu a oscuro' : 'Cambiar menu a claro');
        themeToggle.setAttribute('title', theme === 'light' ? 'Menu oscuro' : 'Menu claro');
        try { window.localStorage.setItem('laeseprod-menu-theme', theme); } catch {}
    };
    const savedTheme = (() => {
        try { return window.localStorage.getItem('laeseprod-menu-theme'); } catch { return null; }
    })();
    applyMenuTheme(savedTheme === 'dark' ? 'dark' : 'light');
    const setMenuOpen = (open: boolean) => {
        if (!header || !toggle || !mobileNav) return;
        header.classList.toggle('menu-is-open', open);
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Cerrar menu' : 'Abrir menu');
        mobileNav.setAttribute('aria-hidden', String(!open));
        document.body.classList.toggle('mobile-menu-open', open);
    };

    const setPortalError = (message = '') => {
        if (!portalError) return;
        portalError.textContent = message;
        portalError.hidden = !message;
    };

    const resetPortalModal = () => {
        if (portalCode) portalCode.value = '';
        if (portalForm) portalForm.hidden = false;
        if (portalSubmit) {
            portalSubmit.disabled = false;
            portalSubmit.textContent = 'Introducir codigo';
        }
        if (portalDropbox) {
            portalDropbox.hidden = true;
            portalDropbox.href = '#';
            portalDropbox.textContent = 'Abrir Dropbox';
        }
        if (portalTitle) portalTitle.textContent = 'Acceso cliente';
        if (portalCopy) portalCopy.textContent = 'Introduce tu codigo privado para abrir tu carpeta de Dropbox.';
        setPortalError();
    };

    const setPortalModalOpen = (open: boolean) => {
        if (!portalModal) return;
        portalModal.classList.toggle('is-open', open);
        portalModal.setAttribute('aria-hidden', String(!open));
        document.body.classList.toggle('portal-modal-open', open);
        if (open) {
            resetPortalModal();
            setMenuOpen(false);
            window.setTimeout(() => portalCode?.focus(), 80);
        }
    };

    document.querySelectorAll<HTMLElement>('[data-portal-open]').forEach((button) => {
        button.addEventListener('click', () => setPortalModalOpen(true));
    });
    document.querySelectorAll<HTMLElement>('[data-portal-close]').forEach((button) => {
        button.addEventListener('click', () => setPortalModalOpen(false));
    });
    portalForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const code = portalCode?.value.trim() || '';
        if (!code) {
            setPortalError('Introduce tu codigo de acceso.');
            return;
        }

        if (portalSubmit) {
            portalSubmit.disabled = true;
            portalSubmit.textContent = 'Verificando...';
        }
        setPortalError();

        try {
            const response = await fetch('/api/portal/verify', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ code }),
            });
            const result = await response.json();

            if (!response.ok || !result.dropbox_link) {
                setPortalError(result.error || 'No se ha podido verificar el codigo.');
                return;
            }

            if (portalForm) portalForm.hidden = true;
            if (portalTitle) portalTitle.textContent = `Bienvenido ${result.client_name || 'cliente'}`;
            if (portalCopy) portalCopy.textContent = 'Tu carpeta de Dropbox esta lista.';
            if (portalDropbox) {
                portalDropbox.href = result.dropbox_link;
                portalDropbox.textContent = 'Abrir carpeta de Dropbox';
                portalDropbox.hidden = false;
                portalDropbox.focus();
            }
        } catch {
            setPortalError('Error de conexion. Intentalo de nuevo.');
        } finally {
            if (portalSubmit) {
                portalSubmit.disabled = false;
                portalSubmit.textContent = 'Introducir codigo';
            }
        }
    });

    toggle?.addEventListener('click', () => setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    themeToggle?.addEventListener('click', () => {
        const nextTheme = header?.classList.contains('nav-theme-light') ? 'dark' : 'light';
        applyMenuTheme(nextTheme);
    });
    mobileNav?.querySelectorAll('a, button').forEach((element) => element.addEventListener('click', () => setMenuOpen(false)));
    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
            setMenuOpen(false);
            setPortalModalOpen(false);
        }
    });
    window.addEventListener('resize', () => {
        if (window.innerWidth > 1080) setMenuOpen(false);
    });
    const updateHeader = () => {
        const isScrolled = window.scrollY > 20;
        header?.classList.toggle('is-scrolled', isScrolled);
    };
    updateHeader();
    window.addEventListener('scroll', updateHeader, { passive: true });
</script>

<style>
    .site-header { position: fixed; inset: 0 0 auto; z-index: 60; display: flex; justify-content: center; padding: 12px 18px 0; color: #fff; pointer-events: none; }
    .site-nav { position: relative; z-index: 2; width: clamp(780px, 52vw, 1020px); height: 70px; display: grid; grid-template-columns: minmax(96px, .9fr) auto minmax(92px, auto); align-items: center; padding: 0 10px 0 22px; background: rgba(0, 0, 0, .96); border: 1px solid rgba(255, 255, 255, .18); border-radius: 14px; box-shadow: 0 14px 38px rgba(0, 0, 0, .34); backdrop-filter: blur(18px); pointer-events: auto; animation: nav-drop-in 620ms cubic-bezier(.16, 1, .3, 1) both; transition: box-shadow 180ms ease, background 220ms ease, border-color 220ms ease; }
    .site-header.is-scrolled .site-nav, .site-header.menu-is-open .site-nav { background: rgba(0, 0, 0, .96); box-shadow: 0 18px 48px rgba(0, 0, 0, .34); }
    .site-nav:has(:is(.site-nav__brand, .site-nav__link, .site-nav__portal, .site-nav__whatsapp, .site-nav__toggle):hover),
    .site-nav:has(:is(.site-nav__brand, .site-nav__link, .site-nav__portal, .site-nav__whatsapp, .site-nav__toggle):focus-visible),
    .site-nav:has(.site-nav__group:hover),
    .site-nav:has(.site-nav__group:focus-within) { background: rgba(255, 255, 255, .96); border-color: rgba(0, 0, 0, .08); box-shadow: 0 18px 48px rgba(0, 0, 0, .26); }
    .site-nav__brand { position: relative; z-index: 3; justify-self: start; min-width: 0; display: inline-grid; align-items: center; color: #fff; text-decoration: none; line-height: 1; white-space: nowrap; }
    .site-nav__brand-logo { grid-area: 1 / 1; display: block; width: auto; height: 44px; object-fit: contain; object-position: left center; transition: opacity 180ms ease, transform 420ms cubic-bezier(.16, 1, .3, 1), filter 220ms ease; transform-origin: center; }
    .site-nav__brand-logo--negative { opacity: 0; }
    .site-nav__brand-logo--positive { opacity: 1; animation: none; }
    .site-nav:has(:is(.site-nav__brand, .site-nav__link, .site-nav__portal, .site-nav__whatsapp, .site-nav__toggle):hover) .site-nav__brand-logo,
    .site-nav:has(:is(.site-nav__brand, .site-nav__link, .site-nav__portal, .site-nav__whatsapp, .site-nav__toggle):focus-visible) .site-nav__brand-logo,
    .site-nav:has(.site-nav__group:hover) .site-nav__brand-logo,
    .site-nav:has(.site-nav__group:focus-within) .site-nav__brand-logo { transform: translateY(-1px) scale(1.025); }
    .site-nav:has(:is(.site-nav__brand, .site-nav__link, .site-nav__portal, .site-nav__whatsapp, .site-nav__toggle):hover) .site-nav__brand-logo--negative,
    .site-nav:has(:is(.site-nav__brand, .site-nav__link, .site-nav__portal, .site-nav__whatsapp, .site-nav__toggle):focus-visible) .site-nav__brand-logo--negative,
    .site-nav:has(.site-nav__group:hover) .site-nav__brand-logo--negative,
    .site-nav:has(.site-nav__group:focus-within) .site-nav__brand-logo--negative { opacity: 1; filter: drop-shadow(0 8px 16px rgba(0, 0, 0, .08)); }
    .site-nav:has(:is(.site-nav__brand, .site-nav__link, .site-nav__portal, .site-nav__whatsapp, .site-nav__toggle):hover) .site-nav__brand-logo--positive,
    .site-nav:has(:is(.site-nav__brand, .site-nav__link, .site-nav__portal, .site-nav__whatsapp, .site-nav__toggle):focus-visible) .site-nav__brand-logo--positive,
    .site-nav:has(.site-nav__group:hover) .site-nav__brand-logo--positive,
    .site-nav:has(.site-nav__group:focus-within) .site-nav__brand-logo--positive { opacity: 0; }
    .site-nav__desktop { position: absolute; top: 0; bottom: 0; left: 50%; z-index: 2; display: flex; align-items: stretch; justify-content: center; gap: .2rem; transform: translateX(-50%); transition: inset 620ms cubic-bezier(.16, 1, .3, 1), gap 620ms cubic-bezier(.16, 1, .3, 1), transform 620ms cubic-bezier(.16, 1, .3, 1), width 620ms cubic-bezier(.16, 1, .3, 1); }
    .site-nav__link { position: relative; display: inline-flex; align-items: center; gap: .35rem; padding: 0 .8rem; color: rgba(255, 255, 255, .72); text-decoration: none; font-family: Arial, Helvetica, sans-serif; font-size: .8rem; font-weight: 500; text-transform: uppercase; transition: color 160ms ease, min-height 620ms cubic-bezier(.16, 1, .3, 1), padding 620ms cubic-bezier(.16, 1, .3, 1); }
    .site-nav__item { transition: margin 620ms cubic-bezier(.16, 1, .3, 1), color 160ms ease; }
    .nav-reveal { display: inline-block; overflow: hidden; vertical-align: bottom; white-space: nowrap; }
    .nav-reveal > span { display: inline-block; animation: text-mask-reveal 720ms cubic-bezier(.16, 1, .3, 1) both; }
    .site-nav__brand .nav-reveal > span { animation-delay: 180ms; }
    .site-nav__desktop > :nth-child(1) .nav-reveal > span { animation-delay: 260ms; }
    .site-nav__desktop > :nth-child(2) .nav-reveal > span { animation-delay: 340ms; }
    .site-nav__desktop > :nth-child(3) .nav-reveal > span { animation-delay: 420ms; }
    .site-nav__desktop > :nth-child(4) .nav-reveal > span { animation-delay: 500ms; }
    .site-nav__desktop > :nth-child(5) .nav-reveal > span { animation-delay: 580ms; }
    .site-nav__actions > * { animation: action-pop 520ms cubic-bezier(.16, 1, .3, 1) 480ms both; }
    .site-nav__link::after { content: ""; position: absolute; right: .8rem; bottom: 13px; left: .8rem; height: 3px; background: #fff; border-radius: 3px; transform: scaleX(0); transform-origin: right; transition: transform 180ms ease; }
    .site-nav__link:hover, .site-nav__link:focus-visible, .site-nav__link.is-active { color: #fff; }
    .site-nav__link:hover::after, .site-nav__link:focus-visible::after, .site-nav__link.is-active::after { transform: scaleX(1); transform-origin: left; }
    .site-nav:has(:is(.site-nav__brand, .site-nav__link, .site-nav__portal, .site-nav__whatsapp, .site-nav__toggle):hover) .site-nav__link,
    .site-nav:has(:is(.site-nav__brand, .site-nav__link, .site-nav__portal, .site-nav__whatsapp, .site-nav__toggle):focus-visible) .site-nav__link,
    .site-nav:has(.site-nav__group:hover) .site-nav__link,
    .site-nav:has(.site-nav__group:focus-within) .site-nav__link { color: #5d5d5d; }
    .site-nav:has(:is(.site-nav__brand, .site-nav__link, .site-nav__portal, .site-nav__whatsapp, .site-nav__toggle):hover) .site-nav__link:hover,
    .site-nav:has(:is(.site-nav__brand, .site-nav__link, .site-nav__portal, .site-nav__whatsapp, .site-nav__toggle):focus-visible) .site-nav__link:focus-visible,
    .site-nav:has(:is(.site-nav__brand, .site-nav__link, .site-nav__portal, .site-nav__whatsapp, .site-nav__toggle):hover) .site-nav__link.is-active,
    .site-nav:has(:is(.site-nav__brand, .site-nav__link, .site-nav__portal, .site-nav__whatsapp, .site-nav__toggle):focus-visible) .site-nav__link.is-active,
    .site-nav:has(.site-nav__group:hover) .site-nav__link.is-active,
    .site-nav:has(.site-nav__group:focus-within) .site-nav__link.is-active { color: #000; }
    .site-nav:has(:is(.site-nav__brand, .site-nav__link, .site-nav__portal, .site-nav__whatsapp, .site-nav__toggle):hover) .site-nav__link::after,
    .site-nav:has(:is(.site-nav__brand, .site-nav__link, .site-nav__portal, .site-nav__whatsapp, .site-nav__toggle):focus-visible) .site-nav__link::after,
    .site-nav:has(.site-nav__group:hover) .site-nav__link::after,
    .site-nav:has(.site-nav__group:focus-within) .site-nav__link::after { background: #000; }
    .site-nav__group { position: relative; display: flex; }
    .site-nav__group .site-nav__link svg { transition: transform 160ms ease; }
    .site-nav__group:hover .site-nav__link svg, .site-nav__group:focus-within .site-nav__link svg { transform: rotate(180deg); }
    .site-nav__submenu { position: absolute; top: calc(100% + 10px); left: 50%; width: 340px; padding: 1.15rem; color: #000; background: #fff; border: 1px solid rgba(0, 0, 0, .15); border-radius: 18px; box-shadow: 0 22px 50px rgba(0, 0, 0, .25); opacity: 0; visibility: hidden; transform: translate(-50%, 8px); transition: opacity 160ms ease, transform 160ms ease, visibility 160ms ease; }
    .site-nav__group:hover .site-nav__submenu, .site-nav__group:focus-within .site-nav__submenu { opacity: 1; visibility: visible; transform: translate(-50%, 0); }
    .site-nav__submenu p { padding: .25rem .7rem .8rem; border-bottom: 1px solid #d8d8d8; color: #666; font-size: .72rem; font-weight: 500; text-transform: uppercase; }
    .site-nav__submenu a { display: grid; gap: .15rem; padding: 1rem .7rem; color: #000; text-decoration: none; border-bottom: 1px solid #e6e6e6; }
    .site-nav__submenu a:last-child { border-bottom: 0; }
    .site-nav__submenu a:hover, .site-nav__submenu a:focus-visible { background: #f1f1f1; border-radius: 8px; }
    .site-nav__submenu span { font-family: Arial, Helvetica, sans-serif; font-size: 1rem; font-weight: 500; text-transform: uppercase; }
    .site-nav__submenu small { color: #5b5b5b; font-size: .8rem; }
    .site-nav__actions { position: relative; z-index: 3; justify-self: end; display: flex; align-items: center; gap: .4rem; padding-left: .8rem; }
    .site-nav__actions::before { content: ""; position: absolute; top: 8px; bottom: 8px; left: 0; width: 1px; background: rgba(255, 255, 255, .24); }
    .site-nav__theme, .site-nav__portal, .site-nav__whatsapp, .site-nav__toggle { width: 40px; height: 40px; display: grid; place-items: center; color: #fff; background: rgba(255, 255, 255, .1); border: 0; border-radius: 50%; text-decoration: none; cursor: pointer; transition: color 160ms ease, background 160ms ease, transform 160ms ease; }
    .site-nav__theme { position: relative; overflow: hidden; }
    .site-nav__theme svg { grid-area: 1 / 1; transition: opacity 160ms ease, transform 180ms ease; }
