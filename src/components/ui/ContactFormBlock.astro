---
import { createCaptchaChallenge } from "../../lib/captcha";
const captcha = createCaptchaChallenge();
---

<form class="minimal-contact-form" data-contact-form novalidate>
    <label>Nombre<input type="text" name="name" autocomplete="name" required /></label>
    <div class="minimal-contact-form__row">
        <label>Telefono<input type="tel" name="phone" autocomplete="tel" required /></label>
        <label>Email<input type="email" name="email" autocomplete="email" required /></label>
    </div>
    <label>Idea <span>(opcional)</span><textarea name="idea" rows="3" placeholder="Cuentanos lo justo para empezar"></textarea></label>
    <div class="minimal-contact-form__honeypot" aria-hidden="true"><input type="text" name="website" tabindex="-1" autocomplete="off" /></div>
    <input type="hidden" name="captchaToken" value={captcha.token} />
    <input type="hidden" name="formStartedAt" value={captcha.startedAt} />
    <label class="minimal-contact-form__captcha">Cuanto es {captcha.question}?<input type="number" name="captchaAnswer" required inputmode="numeric" /></label>
    <button type="submit">Enviar</button>
    <p class="minimal-contact-form__status" data-form-status aria-live="polite"></p>
</form>

<script>
    document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
        form.addEventListener('submit', async (event) => {
            event.preventDefault();
            const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
            const status = form.querySelector<HTMLElement>('[data-form-status]')!;
            if (!form.reportValidity()) return;
            button.disabled = true;
            button.textContent = 'Enviando';
            status.textContent = '';
            try {
                const response = await fetch('/api/contact', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(Object.fromEntries(new FormData(form))),
                });
                const data = await response.json().catch(() => ({}));
                if (!response.ok) throw new Error(data.error || 'No se pudo enviar');
                form.reset();
                status.textContent = 'Recibido. Te contactaremos pronto.';
            } catch (error) {
                status.textContent = error instanceof Error ? error.message : 'No se pudo enviar.';
            } finally {
                button.disabled = false;
                button.textContent = 'Enviar';
            }
        });
    });
</script>

<style>
    .minimal-contact-form { display: grid; gap: .86rem; color: #fff; }
    .minimal-contact-form label { display: grid; gap: .38rem; color: rgba(255, 255, 255, .9); font-size: .74rem; font-weight: 900; line-height: 1; text-transform: uppercase; }
    .minimal-contact-form label span { color: rgba(255, 255, 255, .48); font-weight: 700; }
    .minimal-contact-form input, .minimal-contact-form textarea { width: 100%; padding: .82rem 0; color: #fff; background: transparent; border: 0; border-bottom: 1px solid rgba(255, 255, 255, .46); border-radius: 0; outline: none; font: inherit; font-size: 1.06rem; transition: border-color 160ms ease, background 160ms ease; }
    .minimal-contact-form input:focus, .minimal-contact-form textarea:focus { border-color: #fff; background: rgba(255, 255, 255, .035); }
    .minimal-contact-form input::placeholder, .minimal-contact-form textarea::placeholder { color: rgba(255, 255, 255, .48); font-weight: 800; }
    .minimal-contact-form textarea { min-height: 104px; resize: vertical; }
    .minimal-contact-form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
    .minimal-contact-form__captcha { grid-template-columns: auto 92px; align-items: end; justify-content: start; gap: 1rem; }
    .minimal-contact-form__captcha input { text-align: center; }
    .minimal-contact-form button { min-height: 54px; color: #000; background: #fff; border: 1px solid #fff; border-radius: 999px; font: inherit; font-size: .82rem; font-weight: 900; text-transform: uppercase; cursor: pointer; transition: transform 160ms ease, opacity 160ms ease, color 160ms ease, background 160ms ease; }
    .minimal-contact-form button:hover, .minimal-contact-form button:focus-visible { color: #fff; background: #000; transform: translateY(-2px); }
    .minimal-contact-form button:disabled { opacity: .5; transform: none; }
    .minimal-contact-form__honeypot { position: absolute; left: -9999px; }
    .minimal-contact-form__status { min-height: 1.4em; color: rgba(255, 255, 255, .72); font-size: .85rem; font-weight: 700; }

    @media (max-width: 560px) {
        .minimal-contact-form__row { grid-template-columns: 1fr; }
        .minimal-contact-form__captcha { grid-template-columns: 1fr 84px; }
    }
</style>
