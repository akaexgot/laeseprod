---
/**
 * Mobile Bottom Navigation Bar
 * Premium iOS-style bottom tab bar with 5 tabs
 * Only visible on mobile (≤1024px)
 */
---

<nav id="mobile-bottom-bar" class="mobile-bottom-bar" aria-label="Navegación móvil">
    <div class="mbb-inner">
        <a href="/" class="mbb-item" data-path="/" aria-label="Inicio">
            <div class="mbb-icon-wrap">
                <svg class="mbb-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                </svg>
            </div>
            <span class="mbb-label">Inicio</span>
        </a>
        <a href="/proyectos" class="mbb-item" data-path="/proyectos" aria-label="Proyectos">
            <div class="mbb-icon-wrap">
                <svg class="mbb-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                </svg>
            </div>
            <span class="mbb-label">Proyectos</span>
        </a>
        <a href="/quienes-somos" class="mbb-item" data-path="/quienes-somos" aria-label="Nosotros">
            <div class="mbb-icon-wrap">
                <svg class="mbb-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
            </div>
            <span class="mbb-label">Nosotros</span>
        </a>
        <a href="/contacto" class="mbb-item" data-path="/contacto" aria-label="Contacto">
            <div class="mbb-icon-wrap">
                <svg class="mbb-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
            </div>
            <span class="mbb-label">Contacto</span>
        </a>
        <a href="/portal-clientes" class="mbb-item" data-path="/portal-clientes" aria-label="Portal">
            <div class="mbb-icon-wrap">
                <svg class="mbb-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
            </div>
            <span class="mbb-label">Portal</span>
        </a>
    </div>
</nav>

<style>
/* ═══════════════════════════════════════════
   MOBILE BOTTOM BAR — Premium Tab Bar
   Only visible on mobile (≤1024px)
   ═══════════════════════════════════════════ */

.mobile-bottom-bar {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 45;
    padding-bottom: env(safe-area-inset-bottom, 0px);
    background: linear-gradient(180deg, 
        rgba(10, 10, 15, 0.92) 0%, 
        rgba(5, 5, 8, 0.98) 100%
    );
    backdrop-filter: saturate(180%) blur(24px);
    -webkit-backdrop-filter: saturate(180%) blur(24px);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

@media (max-width: 1024px) {
    .mobile-bottom-bar {
        display: block;
    }
}

.mobile-bottom-bar.is-hidden {
    transform: translateY(100%);
    pointer-events: none;
}

.mbb-inner {
    display: flex;
    align-items: stretch;
    justify-content: space-around;
    max-width: 480px;
    margin: 0 auto;
    padding: 0.4rem 0.5rem 0.3rem;
}

.mbb-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    flex: 1;
    padding: 0.3rem 0.15rem;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.35);
    transition: color 0.3s ease;
    -webkit-tap-highlight-color: transparent;
    position: relative;
}

.mbb-item:active {
    transform: scale(0.9);
    transition: transform 0.1s ease;
}

/* Icon wrapper */
.mbb-icon-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.75rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.mbb-item.active .mbb-icon-wrap {
    background: rgba(196, 40, 71, 0.15);
}

.mbb-icon {
    width: 1.25rem;
    height: 1.25rem;
    transition: all 0.3s ease;
}

.mbb-item.active {
    color: #e8364f;
}

.mbb-item.active .mbb-icon {
    stroke-width: 2.2;
}

.mbb-label {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1;
    opacity: 0.7;
    transition: all 0.3s ease;
}

.mbb-item.active .mbb-label {
    font-weight: 700;
    opacity: 1;
    color: #e8364f;
}
</style>

<script>
(function() {
    const bar = document.getElementById('mobile-bottom-bar');
    if (!bar) return;

    const path = window.location.pathname;
    const items = bar.querySelectorAll('.mbb-item');

    // Set active state
    items.forEach(item => {
        const itemPath = item.getAttribute('data-path');
        if (!itemPath) return;

        if (itemPath === '/' && path === '/') {
            item.classList.add('active');
        } else if (itemPath !== '/' && path.startsWith(itemPath)) {
            item.classList.add('active');
        }
    });

    // Auto-hide on scroll down, show on scroll up
    let lastScrollY = window.scrollY;
    let ticking = false;

    window.addEventListener('scroll', () => {
        if (!ticking) {
            window.requestAnimationFrame(() => {
                const currentScrollY = window.scrollY;
                const diff = currentScrollY - lastScrollY;

                if (diff > 10 && currentScrollY > 120) {
                    bar.classList.add('is-hidden');
                } else if (diff < -8) {
                    bar.classList.remove('is-hidden');
                }

                lastScrollY = currentScrollY;
                ticking = false;
            });
            ticking = true;
        }
    }, { passive: true });
})();
</script>
