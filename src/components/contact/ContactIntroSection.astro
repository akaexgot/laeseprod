---
import VideoBackground from "../ui/VideoBackground.astro";
import ContactFormBlock from "../ui/ContactFormBlock.astro";
import { getSettings } from "../../lib/data";

const settings = await getSettings();
const aboutText = settings.about_summary || "Somos una productora audiovisual centrada en arte visual. Trabajamos cada proyecto de forma cercana, agil y con una mirada cinematografica.";
const contactBase = "Andalucia, Espa\u00f1a";
const whatsappNumber = String(settings.whatsapp_number || settings.phone || "34662908416").replace(/\D/g, "");
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=Hola%20LaeseProd,%20quiero%20hablar%20sobre%20un%20proyecto.`;
---

<section class="contact-page">
    <VideoBackground
        desktop={settings.contact_hero_video || settings.hero_video_desktop}
        mobile={settings.contact_hero_video || settings.hero_video_mobile || settings.hero_video_desktop}
        title="Fondo de contacto"
        overlay="none"
    />
    <div class="contact-page__shade" aria-hidden="true"></div>

    <div class="contact-page__layout">
        <section class="contact-page__about" aria-label="Contacto y sobre nosotros">
            <p class="contact-page__kicker">Contacto / Sobre nosotros</p>
            <h1><span>Hablemos</span><span>de tu proximo</span><span>video.</span></h1>
            <p class="contact-page__summary">{aboutText}</p>

            <div class="contact-page__badges" aria-label="Servicios principales">
                <span>Bodas</span>
                <span>Videoclips</span>
                <span>Produccion audiovisual</span>
            </div>
        </section>

        <section class="contact-page__form" aria-label="Formulario de contacto">
            <div class="contact-page__form-heading">
                <p>Cu&eacute;ntanos lo esencial</p>
                <span>Respondemos personalmente.</span>
            </div>
            <ContactFormBlock />
        </section>
    </div>

    <aside class="contact-page__direct" aria-label="Contacto directo">
        {settings.phone && (
            <a href={`tel:${String(settings.phone).replace(/\s/g, "")}`}>
                <span>Telefono</span>
                <strong>{settings.phone}</strong>
            </a>
        )}
        {settings.email && (
            <a href={`mailto:${settings.email}`}>
                <span>Email</span>
                <strong>{settings.email}</strong>
            </a>
        )}
        <a class="contact-page__whatsapp" href={whatsappUrl} target="_blank" rel="noreferrer">
            <span>WhatsApp</span>
            <strong>Escribir ahora</strong>
        </a>
        {settings.address && (
            <div>
                <span>Base</span>
                <strong>{contactBase}</strong>
            </div>
        )}
    </aside>
</section>

<style>
    .contact-page { position: relative; height: 100svh; display: grid; grid-template-rows: minmax(0, 1fr) auto; gap: clamp(.55rem, 1.3vh, .9rem); padding: clamp(5.35rem, 9.2vh, 6.65rem) clamp(1.1rem, 4.4vw, 4rem) .65rem; color: #fff; background: #000; overflow: hidden; isolation: isolate; }
    .contact-page__shade { position: absolute; inset: 0; z-index: 1; background: linear-gradient(90deg, rgba(0, 0, 0, .68) 0%, rgba(0, 0, 0, .38) 42%, rgba(0, 0, 0, .62) 100%), linear-gradient(180deg, rgba(0, 0, 0, .08) 0%, rgba(0, 0, 0, .62) 100%); }
    .contact-page__layout { position: relative; z-index: 2; min-height: 0; display: grid; grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr); gap: clamp(.2rem, .45vw, .55rem); align-items: center; }
    .contact-page__about { display: grid; align-content: center; gap: clamp(.55rem, 1.05vh, .82rem); max-width: 780px; }
    .contact-page__kicker { margin: 0; color: rgba(255, 255, 255, .68); font-size: .7rem; font-weight: 800; text-transform: uppercase; }
    .contact-page h1 { max-width: 880px; margin: 0; font-family: var(--font-display); font-size: clamp(5rem, 10vw, min(10rem, 19vh)); font-weight: 400; line-height: .86; text-transform: uppercase; }
    .contact-page h1 span { display: block; }
    .contact-page__summary { max-width: 660px; margin: 0; color: rgba(255, 255, 255, .82); font-size: clamp(.9rem, 1.25vw, 1.08rem); line-height: 1.3; }
    .contact-page__badges { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: .1rem; }
    .contact-page__badges span { min-height: 29px; display: inline-flex; align-items: center; padding: 0 .68rem; color: rgba(255, 255, 255, .84); border: 1px solid rgba(255, 255, 255, .34); border-radius: 999px; font-size: .62rem; font-weight: 800; text-transform: uppercase; backdrop-filter: blur(12px); }
    .contact-page__form { align-self: center; width: min(100%, 720px); justify-self: start; display: grid; align-content: center; gap: 1.05rem; padding: .25rem 0 .25rem clamp(.75rem, 1.15vw, 1.15rem); border-left: 1px solid rgba(255, 255, 255, .26); }
    .contact-page__form-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; padding-bottom: .55rem; border-bottom: 1px solid rgba(255, 255, 255, .24); }
    .contact-page__form-heading p { margin: 0; font-size: clamp(1.8rem, 2.85vw, 3rem); font-weight: 900; line-height: .92; text-transform: uppercase; }
    .contact-page__form-heading span { max-width: 150px; color: rgba(255, 255, 255, .58); font-size: .7rem; font-weight: 800; line-height: 1.18; text-align: right; text-transform: uppercase; }
    .contact-page__direct { position: relative; z-index: 2; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; background: rgba(255, 255, 255, .2); border: 1px solid rgba(255, 255, 255, .2); }
    .contact-page__direct a, .contact-page__direct div { min-height: 56px; display: grid; align-content: center; gap: .18rem; padding: .62rem .85rem; color: #fff; background: rgba(0, 0, 0, .62); text-decoration: none; backdrop-filter: blur(14px); }
    .contact-page__direct .contact-page__whatsapp { background: #25d366; }
    .contact-page__direct span { color: rgba(255, 255, 255, .5); font-size: .6rem; font-weight: 800; text-transform: uppercase; }
    .contact-page__direct strong { min-width: 0; overflow-wrap: anywhere; font-size: clamp(.8rem, 1.2vw, .98rem); line-height: 1.12; }
    .contact-page__direct a:hover strong, .contact-page__direct a:focus-visible strong { text-decoration: underline; text-underline-offset: 4px; }

    @media (max-width: 940px) {
        .contact-page { height: auto; min-height: 100svh; overflow: visible; }
        .contact-page__layout { grid-template-columns: 1fr; min-height: auto; align-items: start; }
        .contact-page__about { align-content: start; }
        .contact-page__form { padding: 1.4rem 0 0; border-top: 1px solid rgba(255, 255, 255, .26); border-left: 0; }
    }

    @media (max-width: 680px) {
        .contact-page { padding: 6.2rem 1rem 5.8rem; background: radial-gradient(circle at 50% 0%, rgba(255, 255, 255, .08), transparent 38%), #000; }
        .contact-page :global(.video-background) { display: none; }
        .contact-page__shade { background: linear-gradient(180deg, rgba(0, 0, 0, .2) 0%, rgba(0, 0, 0, .72) 52%, #000 100%); }
        .contact-page h1 { font-size: clamp(3.2rem, 15vw, 5.4rem); }
        .contact-page__direct { grid-template-columns: 1fr; }
        .contact-page__form {
            gap: .95rem;
            padding: 1rem;
            background: rgba(0, 0, 0, .74);
            border: 1px solid rgba(255, 255, 255, .18);
            border-radius: 16px;
            box-shadow: 0 22px 60px rgba(0, 0, 0, .36);
            -webkit-backdrop-filter: blur(14px);
            backdrop-filter: blur(14px);
        }
        .contact-page__form-heading { align-items: flex-start; flex-direction: column; }
        .contact-page__form-heading span { max-width: none; text-align: left; }
    }
</style>
