---
/**
 * SEO Head Component
 * Generates meta tags, Open Graph, Twitter cards and JSON-LD markup.
 */
import { getPageSeo, getSettings } from "../../lib/data";
import { absoluteUrl, canonicalFromUrl, cleanPath, getSiteUrl } from "../../lib/seo";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  url?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  structuredData?: Record<string, any> | Array<Record<string, any> | null> | null;
}

const settings = await getSettings();
const pageSeo = await getPageSeo(cleanPath(Astro.url.pathname));
const BRAND_NAME = 'LaeseProd S.L.';
const normalizeBrandText = (value?: string | null) => String(value || '')
  .replace(/LaesePROD/g, BRAND_NAME)
  .replace(/LaeseProd S\.L\.\./g, BRAND_NAME)
  .replace(/Bodas\s*y\s*videoclips/gi, 'Arte visual')
  .replace(/Bodas\s*\/\s*Videoclips/gi, 'Arte visual')
  .trim();

const siteUrl = getSiteUrl();
const siteName = normalizeBrandText(settings.site_name) || BRAND_NAME;
const defaultDescription = normalizeBrandText(settings.site_description) || 'Productora audiovisual especializada en arte visual.';

const {
  title,
  description,
  image,
  imageAlt,
  url = Astro.url.href,
  type = 'website',
  noindex = false,
  structuredData,
} = Astro.props;

const rawTitle = normalizeBrandText(pageSeo?.title || title);
const fullTitle = rawTitle
  ? (rawTitle.includes(siteName) || rawTitle.includes('|') ? rawTitle : `${rawTitle} | ${siteName}`)
  : `${siteName} | Arte visual`;

const metaDescription = normalizeBrandText(pageSeo?.description || description || defaultDescription);
const canonicalUrl = pageSeo?.canonical_url || canonicalFromUrl(url);
const resolvedImage = absoluteUrl(pageSeo?.og_image || image || settings.logo_url);
const resolvedImageAlt = imageAlt || `${siteName} - productora audiovisual en Sevilla`;
const shouldNoindex = noindex || pageSeo?.no_index === true;
const themeColor = '#000000';

const youtubeId = settings.hero_video_desktop?.match(/(?:youtube\.com\/(?:watch\?v=|embed\/)|youtu\.be\/)([A-Za-z0-9_-]{11})/)?.[1] || 'D91q99QK11k';

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${siteUrl}/#business`,
  name: siteName,
  description: defaultDescription,
  url: siteUrl,
  logo: absoluteUrl(settings.logo_url),
  image: resolvedImage,
  telephone: settings.phone || '+34662908416',
  email: settings.email || 'laeseprod@gmail.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: settings.address || 'Sevilla',
    addressLocality: 'Sevilla',
    addressRegion: 'Andalucia',
    addressCountry: 'ES',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 37.3886,
    longitude: -5.9823,
  },
  areaServed: [
    { '@type': 'City', name: 'Sevilla' },
    { '@type': 'City', name: 'Cadiz' },
    { '@type': 'AdministrativeArea', name: 'Andalucia' },
    { '@type': 'Country', name: 'ES' },
  ],
  priceRange: 'EUR',
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: settings.phone || '+34662908416',
    email: settings.email || 'laeseprod@gmail.com',
    contactType: 'sales',
    areaServed: 'ES',
    availableLanguage: ['es'],
  },
  sameAs: [
    settings.instagram,
    settings.linkedin,
  ].filter(Boolean),
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  name: siteName,
  url: siteUrl,
  publisher: { '@id': `${siteUrl}/#business` },
  inLanguage: 'es-ES',
};

const extraStructuredData = Array.isArray(structuredData)
  ? structuredData.filter(Boolean)
  : structuredData ? [structuredData] : [];

const schemaItems = [
  localBusinessSchema,
  websiteSchema,
  ...extraStructuredData,
];
---

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<meta name="title" content={fullTitle} />
<meta name="description" content={metaDescription} />
<meta name="robots" content={shouldNoindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
<meta name="theme-color" content={themeColor} />
<meta name="format-detection" content="telephone=no" />
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={metaDescription} />
{resolvedImage && <meta property="og:image" content={resolvedImage} />}
{resolvedImage && <meta property="og:image:alt" content={resolvedImageAlt} />}
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="es_ES" />

<!-- Twitter -->
<meta name="twitter:card" content={resolvedImage ? "summary_large_image" : "summary"} />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={metaDescription} />
{resolvedImage && <meta name="twitter:image" content={resolvedImage} />}
{resolvedImage && <meta name="twitter:image:alt" content={resolvedImageAlt} />}

<!-- Schema.org -->
{schemaItems.map((schema) => (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
))}

<!-- Preload critical video poster -->
<link rel="preload" href={`https://i.ytimg.com/vi_webp/${youtubeId}/hqdefault.webp`} as="image" fetchpriority="high" />

<!-- Security Meta Tags -->
<meta http-equiv="X-Content-Type-Options" content="nosniff" />
<meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests" />

<!-- Media connections -->
<link rel="preconnect" href="https://i.ytimg.com" crossorigin />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="dns-prefetch" href="https://www.youtube-nocookie.com" />
<link rel="dns-prefetch" href="https://res.cloudinary.com" />

<!-- Public typography -->
<link
  href="https://fonts.googleapis.com/css2?family=Anton&family=Outfit:wght@400;600;700;800;900&family=Space+Grotesk:wght@500;700&display=swap"
  rel="stylesheet"
/>

<!-- Favicons / app icons -->
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="512x512" href="/favicon-512x512.png" />
<link rel="shortcut icon" href="/favicon.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
