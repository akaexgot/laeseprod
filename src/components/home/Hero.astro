---
import { getSettings } from "../../lib/data";
import VideoBackground from "../ui/VideoBackground.astro";
const settings = await getSettings();
const fallback = "https://www.youtube.com/watch?v=D91q99QK11k";
---

<section id="hero" class="home-hero" aria-label="LaesePROD">
    <VideoBackground
        desktop={settings.hero_video_desktop || fallback}
        mobile={settings.hero_video_mobile || settings.hero_video_desktop || fallback}
        title="Showreel de LaesePROD"
        overlay="none"
    />
    <div class="home-hero__shade" aria-hidden="true"></div>
    <div class="home-hero__content">
        <p class="home-hero__eyebrow">Bodas / Videoclips</p>
        <h1 class="home-hero__logo-title">
            <img src="/palabralogotipo-white.png?v=20260717-1" alt="LAESEPROD" width="1030" height="173" />
        </h1>
        <p class="home-hero__text">Bodas y videoclips con mirada cinematografica.</p>
        <div class="home-hero__actions">
            <a href="/proyectos">Ver proyectos</a>
            <a href="/contacto">Contactar</a>
        </div>
    </div>
    <div class="home-hero__next" aria-hidden="true">
        <span>Proyectos seleccionados</span>
        <span></span>
    </div>
</section>

<style>
    .home-hero { position: relative; min-height: 100svh; overflow: hidden; background: #000; color: #fff; isolation: isolate; }
    .home-hero__shade { position: absolute; inset: 0; z-index: 1; background: linear-gradient(90deg, rgba(0, 0, 0, .76) 0%, rgba(0, 0, 0, .42) 44%, rgba(0, 0, 0, .1) 100%), linear-gradient(180deg, rgba(0, 0, 0, .36) 0%, transparent 42%, rgba(0, 0, 0, .58) 100%); }
    .home-hero__content { position: relative; z-index: 2; min-height: 100svh; display: flex; flex-direction: column; justify-content: flex-end; align-items: flex-start; padding: clamp(8rem, 16vh, 12rem) clamp(1.25rem, 7vw, 6rem) clamp(5.4rem, 10vh, 7rem); perspective: 1500px; }
    .home-hero__eyebrow { margin: 0 0 .9rem; color: rgba(255, 255, 255, .78); font-size: clamp(.72rem, 1.2vw, .9rem); font-weight: 800; text-transform: uppercase; animation: hero-copy-in 720ms cubic-bezier(.16, 1, .3, 1) 240ms both; }
    .home-hero__logo-title { position: relative; margin: 0; width: min(1080px, 76vw); max-width: 100%; transform-style: preserve-3d; transform-origin: left bottom; animation: hero-title-in 1100ms cubic-bezier(.16, 1, .3, 1) 120ms both; transition: transform 280ms ease; }
    .home-hero__logo-title img { display: block; width: 100%; height: auto; object-fit: contain; object-position: left center; filter: none; }
    .home-hero__logo-title:hover { transform: rotateX(4deg) rotateY(-6deg) translateZ(34px); }
    .home-hero__text { max-width: 540px; margin: 1.1rem 0 0; color: rgba(255, 255, 255, .84); font-size: clamp(1rem, 2vw, 1.45rem); line-height: 1.35; animation: hero-copy-in 760ms cubic-bezier(.16, 1, .3, 1) 520ms both; }
    .home-hero__actions { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 1.7rem; animation: hero-copy-in 780ms cubic-bezier(.16, 1, .3, 1) 680ms both; }
    .home-hero__actions a { min-height: 46px; display: inline-flex; align-items: center; justify-content: center; padding: 0 1.2rem; color: #000; background: #fff; border: 1px solid #fff; border-radius: 999px; text-decoration: none; font-size: .78rem; font-weight: 800; text-transform: uppercase; transition: transform 180ms ease, color 180ms ease, background 180ms ease; }
    .home-hero__actions a + a { color: #fff; background: rgba(255, 255, 255, .08); border-color: rgba(255, 255, 255, .52); backdrop-filter: blur(12px); }
    .home-hero__actions a:hover, .home-hero__actions a:focus-visible { transform: translateY(-2px); }
    .home-hero__next { position: absolute; right: clamp(1.25rem, 5vw, 4rem); bottom: 1.3rem; left: clamp(1.25rem, 5vw, 4rem); z-index: 2; display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 1rem; color: rgba(255, 255, 255, .7); font-size: .72rem; font-weight: 800; text-transform: uppercase; }
    .home-hero__next span:last-child { height: 1px; background: rgba(255, 255, 255, .34); transform-origin: left; animation: hero-line 1600ms cubic-bezier(.16, 1, .3, 1) 640ms both; }

    @keyframes hero-line {
        from { transform: scaleX(0); }
        to { transform: scaleX(1); }
    }

    @keyframes hero-title-in {
        from {
            opacity: 0;
            filter: blur(10px);
            transform: translate3d(0, 58px, -160px) rotateX(22deg) rotateY(-10deg);
        }
        to {
            opacity: 1;
            filter: blur(0);
            transform: translate3d(0, 0, 0) rotateX(0) rotateY(0);
        }
    }

    @keyframes hero-copy-in {
        from { opacity: 0; transform: translateY(18px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 720px) {
        .home-hero, .home-hero__content { min-height: 100svh; }
        .home-hero__shade { background: linear-gradient(180deg, rgba(0, 0, 0, .25) 0%, rgba(0, 0, 0, .34) 35%, rgba(0, 0, 0, .82) 100%); }
        .home-hero__content { padding: 7.5rem 1rem 5.5rem; }
        .home-hero__logo-title { width: min(100%, 520px); }
        .home-hero__logo-title img { max-height: 34vh; }
        .home-hero__actions { width: 100%; }
        .home-hero__actions a { flex: 1 1 150px; }
    }

    @media (prefers-reduced-motion: reduce) {
        .home-hero__logo-title,
        .home-hero__eyebrow,
        .home-hero__text,
        .home-hero__actions,
        .home-hero__next span:last-child { animation: none; }
    }
</style>
