---
/**
 * Hero Section — Fullscreen Video Background
 * Uses dynamic video from settings DB
 */
import { getSettings } from "../../lib/data";
const settings = await getSettings();

// Extract YouTube ID from any URL format
function extractYouTubeId(url: string | null | undefined): string | null {
    if (!url) return null;
    const m = url.match(/(?:youtube\.com\/(?:watch\?v=|embed\/)|youtu\.be\/)([A-Za-z0-9_-]{11})/);
    if (m) return m[1];
    if (/^[A-Za-z0-9_-]{11}$/.test(url.trim())) return url.trim();
    return null;
}

const isNativeVideo = settings.hero_video_desktop && 
                      (settings.hero_video_desktop.includes('cloudinary.com') || 
                       settings.hero_video_desktop.endsWith('.mp4') || 
                       settings.hero_video_desktop.endsWith('.webm'));

const videoUrl = settings.hero_video_desktop;
const youtubeId = !isNativeVideo ? (extractYouTubeId(videoUrl) || 'D91q99QK11k') : null;

// Prepare dynamic title lines (split by newlines)
const defaultTitle = 'Creamos\n**historias** que\nimpulsan\nmarcas';
const titleLines = (settings.hero_title || defaultTitle).split('\n');
const heroSubtitle = settings.hero_subtitle || '';
---

<section
    id="hero"
    class="relative flex items-center justify-center overflow-hidden"
    style={!isNativeVideo ? `height: 100vh; height: 100dvh; min-height: 600px; background: #050508 url(https://i.ytimg.com/vi/${youtubeId}/maxresdefault.jpg) center/cover no-repeat;` : `height: 100vh; height: 100dvh; min-height: 600px; background: #050508;`}
>
    <!-- Fullscreen Video Background -->
    <div
        id="hero-video-container"
        class="absolute inset-0 z-0 overflow-hidden pointer-events-none bg-black"
    >
        {isNativeVideo ? (
            <video aria-hidden="true" src={videoUrl} 
                class="absolute inset-0 w-full h-full object-cover" 
                autoplay loop muted playsinline 
                onloadeddata="window.dispatchEvent(new CustomEvent('vm-hero-ready'))"
            ></video>
        ) : (
            <!-- Contenedor con la clase video-bg que se encarga del tamaño y posición -->
            <div id="hero-player-wrapper" class="video-bg opacity-0 transition-opacity duration-1000">
                <div id="hero-player"></div>
            </div>
        )}

        <div class="absolute inset-0 bg-dark/10"></div>
    </div>

    {!isNativeVideo && (

    <script is:inline define:vars={{ youtubeId }}>
        // Carga de la API de YouTube diferida para no penalizar el rendimiento inicial (Lighthouse)
        function loadYouTubeAPI() {
            if (!window.YT) {
                const tag = document.createElement('script');
                tag.src = "https://www.youtube-nocookie.com/iframe_api";
                const firstScriptTag = document.getElementsByTagName('script')[0];
                if (firstScriptTag && firstScriptTag.parentNode) {
                    firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);
                } else {
                    document.head.appendChild(tag);
                }
            }
        }

        // Retrasar la carga para priorizar el FCP/LCP y evitar bloqueos de Best Practices
        if (document.readyState === 'complete') {
            setTimeout(loadYouTubeAPI, 2000);
        } else {
            window.addEventListener('load', () => setTimeout(loadYouTubeAPI, 2000));
        }

        function initHeroPlayer() {
            const playerEl = document.getElementById('hero-player');
            if (!playerEl) return;
            
            new window.YT.Player(playerEl, {
                host: 'https://www.youtube-nocookie.com',
                videoId: youtubeId,
                width: '100%',
                height: '100%',
                playerVars: {
                    autoplay: 1,
                    mute: 1,
                    controls: 0,
                    showinfo: 0,
                    rel: 0,
                    modestbranding: 1,
                    playsinline: 1,
                    enablejsapi: 1,
                    origin: window.location.origin
                },
                events: {
                    onReady: (event) => {
                        // Ensure video is muted before playing
                        event.target.mute();
                        
                        // Force allow attribute for autoplay
                        const iframe = event.target.getIframe();
                        if (iframe) {
                            iframe.setAttribute('allow', 'autoplay; encrypted-media; compute-pressure');
                        }
                        
                        event.target.playVideo();
                        
                        // Pre-end loop specifically for Hero to avoid YouTube UI flash
                        setInterval(() => {
                            try {
                                const time = event.target.getCurrentTime();
                                const duration = event.target.getDuration();
                                if (duration > 0 && time >= duration - 0.4) {
                                    const wrapper = document.getElementById('hero-player-wrapper');
                                    if (wrapper) wrapper.style.opacity = '0';
                                    
                                    event.target.seekTo(0);
                                }
                            } catch(e) {}
                        }, 200);
                    },
                    onStateChange: (event) => {
                        // 1 = PLAYING
                        if (event.data === 1) {
                            const wrapper = document.getElementById('hero-player-wrapper');
                            if (wrapper) wrapper.style.opacity = '1';
                            
                            // Emitir el evento para el preloader
                            window.dispatchEvent(new CustomEvent('vm-hero-ready'));
                        }
                        
                        // Fallback
                        if (event.data === 0) {
                            const wrapper = document.getElementById('hero-player-wrapper');
                            if (wrapper) wrapper.style.opacity = '0';
                            
                            event.target.seekTo(0);
                            event.target.playVideo();
                        }
                    }
                }
            });
        }

        if (window.YT && window.YT.Player) {
            initHeroPlayer();
        } else {
            const previousOnReady = window.onYouTubeIframeAPIReady;
            window.onYouTubeIframeAPIReady = () => {
                if (previousOnReady) previousOnReady();
                initHeroPlayer();
            };
        }
    </script>

    )}

    <!-- Content (Centered) -->
    <div
        class="relative z-10 w-full px-6 flex flex-col items-center justify-center text-center pt-20 lg:pt-12"
    >
        <!-- Badge -->
        <div
            class="inline-flex items-center gap-3 px-5 py-2.5 rounded-full border border-white/10 bg-white/5 backdrop-blur-md mb-10 animate-fade-up shadow-2xl"
        >
            <div
                class="w-2 h-2 bg-carmin rounded-full animate-pulse shadow-[0_0_10px_rgba(232,54,79,0.8)]"
            >
            </div>
            <span class="text-label text-white tracking-widest uppercase"
                >Productora Audiovisual</span
            >
        </div>

        <!-- Headline -->
        <h1
            class="text-editorial-lg text-white text-center mb-10 uppercase tracking-tight drop-shadow-2xl px-4"
            style="line-height: 1.15 !important;"
        >
            {titleLines.map((line: string, idx: number) => {
                const isLeft = idx % 2 !== 0;
                const animClass = isLeft ? 'animate-slide-left-in' : 'animate-slide-right-in';
                const delay = (0.1 + idx * 0.2).toFixed(1) + 's';
                
                // Process **text** into styled spans
                const parts = line.split(/(\*\*.*?\*\*)/g);
                
                return (
                    <div class="mb-4 last:mb-0">
                        <span 
                            class={`inline-block ${animClass} opacity-0`}
                            style={`animation-fill-mode: forwards; animation-delay: ${delay}`}
                        >
                            {parts.map((part: string) => {
                                if (part.startsWith('**') && part.endsWith('**')) {
                                    return <span class="text-gradient-carmin italic pr-2">{part.slice(2, -2)}</span>;
                                }
                                return part;
                            })}
                        </span>
                    </div>
                );
            })}
        </h1>

        {heroSubtitle && (
            <p 
                class="text-zinc-400 text-lg md:text-xl max-w-2xl animate-fade-up opacity-0"
                style={`animation-fill-mode: forwards; animation-delay: ${(0.3 + titleLines.length * 0.2).toFixed(1)}s`}
            >
                {heroSubtitle}
            </p>
        )}

        {/* CTA Buttons */}
        <div 
            class="flex flex-wrap items-center justify-center gap-4 mt-20 lg:mt-36 animate-fade-up opacity-0"
            style={`animation-fill-mode: forwards; animation-delay: ${(0.5 + titleLines.length * 0.2).toFixed(1)}s`}
        >
            <button type="button" class="js-open-chat hero-cta hero-cta--primary group">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                </svg>
                <span>Hablar en tiempo real</span>
            </button>
            <a href="/contacto" class="hero-cta hero-cta--secondary group">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                </svg>
                <span>Ir al formulario</span>
            </a>
        </div>
    </div>

    <!-- Scroll Indicator -->
    <div
        class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-3 animate-fade-up"
        style="animation-delay: 0.8s"
    >
        <span
            class="text-[10px] font-mono uppercase tracking-[0.3em] text-white/50"
            >Explorar</span
        >
        <div class="w-[1px] h-16 bg-white/10 relative overflow-hidden">
            <div
                class="absolute top-0 left-0 w-full h-1/2 bg-carmin animate-scroll-down"
            >
            </div>
        </div>
    </div>
</section>

<style>
    .video-bg {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 100%;
        height: 56.25vw;
        min-height: 100vh;
        min-height: 100dvh;
        min-width: 177.77vh;
        pointer-events: none;
    }

    @keyframes scroll-down {
        0% {
            transform: translateY(-100%);
            opacity: 0;
        }
        50% {
            opacity: 1;
        }
        100% {
            transform: translateY(200%);
            opacity: 0;
        }
    }
    .animate-scroll-down {
        animation: scroll-down 2s infinite cubic-bezier(0.65, 0, 0.35, 1);
    }

    @keyframes slide-right-in {
        0% {
            transform: translateX(-100%);
            opacity: 0;
        }
        100% {
            transform: translateX(0);
            opacity: 1;
        }
    }
    @keyframes slide-left-in {
        0% {
            transform: translateX(100%);
            opacity: 0;
        }
        100% {
            transform: translateX(0);
            opacity: 1;
        }
    }

    .animate-slide-right-in {
        animation: slide-right-in 1s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .animate-slide-left-in {
        animation: slide-left-in 1s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Hero CTA Buttons */
    .hero-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.625rem;
        padding: 0.875rem 1.75rem;
        border-radius: 1rem;
        font-family: 'Outfit', sans-serif;
        font-size: 0.9375rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        text-decoration: none;
        cursor: pointer;
        transition: transform 0.25s, box-shadow 0.25s, background 0.25s;
        border: none;
    }
    .hero-cta:hover { transform: translateY(-2px); }
    .hero-cta:active { transform: scale(0.97); }

    .hero-cta--primary {
        background: linear-gradient(135deg, #c42847, #9b1b30);
        color: #fff;
        box-shadow: 0 10px 30px rgba(155,27,48,0.35), inset 0 1px 0 rgba(255,255,255,0.12);
    }
    .hero-cta--primary:hover {
        box-shadow: 0 16px 40px rgba(155,27,48,0.45), inset 0 1px 0 rgba(255,255,255,0.15);
    }

    .hero-cta--secondary {
        background: rgba(255,255,255,0.08);
        color: #fff;
        border: 1px solid rgba(255,255,255,0.15);
        backdrop-filter: blur(12px);
    }
    .hero-cta--secondary:hover {
        background: rgba(255,255,255,0.14);
        border-color: rgba(255,255,255,0.25);
        box-shadow: 0 8px 25px rgba(0,0,0,0.2);
    }
</style>
