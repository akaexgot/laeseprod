<section class="rolling-study" data-rolling-content-reveal aria-labelledby="rolling-title">
    <div class="rolling-study__content" data-reveal-target>
        <div
            class="object-viewer"
            data-lens-explorer
            aria-label="Visor interactivo del logo 3D de LaeseProd"
        >
            <img
                class="object-viewer__fallback"
                src="/logopositivo.png"
                alt=""
                aria-hidden="true"
            />
            <canvas
                class="object-viewer__canvas"
                data-explorer-canvas
                tabindex="0"
                aria-label="Logo 3D interactivo de LaeseProd. Arrastra para girarlo o usa las flechas del teclado para rotarlo."
            ></canvas>

            <div class="object-viewer__rings" aria-hidden="true">
                <span></span><span></span><span></span>
            </div>

            <p class="object-viewer__index" aria-hidden="true">
                <span>LOGO / HOME</span>
                <span data-heavy-label>3D - INTERACTIVE</span>
                <span data-lite-label hidden>LAESEPROD</span>
            </p>

            <div class="object-viewer__loading" aria-live="polite">
                <span data-explorer-status>Cargando logo</span>
                <i><b data-explorer-progress></b></i>
            </div>

            <p class="object-viewer__hint">
                <span class="object-viewer__drag" aria-hidden="true">
                    <i></i><i></i><i></i>
                </span>
                Arrastra para girar
            </p>
        </div>

        <div class="object-copy">
            <p class="object-copy__eyebrow"><span>01</span> LaeseProd S.L.</p>
            <h1 id="rolling-title">
                <span>La mirada</span>
                <span>que lo cambia</span>
                <span class="object-copy__title-accent">todo</span>
                <img src="/palabralogotipo-white.png" alt="LaeseProd S.L." width="1030" height="173" />
            </h1>
            <p class="object-copy__text">
                Arte visual con mirada cinematografica para convertir cada instante en una imagen capaz de permanecer.
            </p>
            <div class="object-copy__actions">
                <a href="/proyectos">Ver proyectos</a>
                <a href="/contacto">Contactar</a>
            </div>
            <nav class="object-copy__service-links" aria-label="Accesos directos a servicios">
                <a href="/servicios/videoclips">Videoclips</a>
                <a href="/servicios/bodas">Bodas</a>
            </nav>
            <div class="object-copy__footer" aria-hidden="true">
                <span>LAESEPROD</span>
                <span>SEVILLA - ESP</span>
                <span>2026</span>
            </div>
        </div>
    </div>

    <div class="rolling-study__veil" aria-hidden="true"></div>
    <div class="rolling-study__frame" aria-hidden="true">
        <span class="corner corner--tl"></span>
        <span class="corner corner--tr"></span>
        <span class="corner corner--bl"></span>
        <span class="corner corner--br"></span>
    </div>

    <div class="rolling-study__meta rolling-study__meta--left" aria-hidden="true">
        <span class="rolling-study__dot"></span>
        <span>LAESEPROD IN MOTION</span>
    </div>
    <div class="rolling-study__meta rolling-study__meta--right" aria-hidden="true">
        <span>LAESEPROD</span>
        <span>HOME FRAME</span>
    </div>

    <div class="rolling-study__shadow" data-reveal-shadow aria-hidden="true"></div>
    <canvas class="rolling-study__canvas" data-reveal-canvas aria-hidden="true"></canvas>

    <div class="rolling-study__loading" aria-live="polite">
        <span data-reveal-status>Preparando optica</span>
        <i><b data-reveal-progress></b></i>
    </div>

    <p class="rolling-study__counter" aria-hidden="true">
        <span>HOME</span>
        <i></i>
        <span>ROLL / DISCOVER</span>
    </p>
</section>

<script>
    const hero = document.querySelector<HTMLElement>("[data-rolling-content-reveal]");
    const revealTarget = hero?.querySelector<HTMLElement>("[data-reveal-target]");
    const explorer = hero?.querySelector<HTMLElement>("[data-lens-explorer]");
    const isMobileViewport = window.matchMedia("(max-width: 767px)").matches;
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const revealWithout3D = () => {
        hero?.classList.add("is-lite", "is-content-revealed", "is-status-hidden");
        explorer?.classList.add("is-fallback");
        hero?.querySelector<HTMLElement>("[data-heavy-label]")?.setAttribute("hidden", "");
        hero?.querySelector<HTMLElement>("[data-lite-label]")?.removeAttribute("hidden");
        revealTarget?.style.setProperty("--content-reveal", "100%");
        document.documentElement.style.setProperty("--rolling-nav-reveal", "100%");
    };

    let explorerStarted = false;
    const startExplorer = () => {
        if (explorerStarted) return;
        explorerStarted = true;
        void import("../../scripts/lens-explorer").catch(() => explorer?.classList.add("is-fallback"));
    };

    if (prefersReducedMotion) {
        hero?.classList.add("is-content-revealed", "is-status-hidden", "is-reduced-motion");
        revealTarget?.style.setProperty("--content-reveal", "100%");
        document.documentElement.style.setProperty("--rolling-nav-reveal", "100%");
        startExplorer();
    } else if (isMobileViewport) {
        hero?.classList.add("is-content-revealed", "is-status-hidden", "is-mobile-direct");
        revealTarget?.style.setProperty("--content-reveal", "100%");
        document.documentElement.style.setProperty("--rolling-nav-reveal", "100%");
        startExplorer();
    } else {
        window.addEventListener("laese:rolling-reveal-finished", startExplorer, { once: true });
        void import("../../scripts/rolling-content-reveal").catch(() => {
            revealWithout3D();
            startExplorer();
        });
    }
</script>

