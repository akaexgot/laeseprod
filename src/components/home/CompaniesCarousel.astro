---
/**
 * Companies — Clean Infinite Marquee with logos
 * Uses actual logo_url from DB when available
 */
import { getCompanies } from "../../lib/data";
const companies = await getCompanies();
---

<section
    id="companies-section"
    class="bg-white border-b border-black/5 relative overflow-hidden z-10"
    style="padding-top: 64px;"
>
    <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 20px 20px;"></div>
    <!-- Label -->
    <div class="flex items-center justify-center gap-4 py-3 invisible">
        <div class="h-px w-16 bg-gradient-to-r from-transparent to-black/10"></div>
        <span class="text-[10px] text-dark/70 font-mono tracking-[0.3em] uppercase font-bold whitespace-nowrap">
            Marcas que confían en nosotros
        </span>
        <div class="h-px w-16 bg-gradient-to-l from-transparent to-black/10"></div>
    </div>

    <!-- Marquee -->
    <div class="overflow-hidden pb-3">
        <div class="marquee-track flex items-center">
            {
                [...companies, ...companies, ...companies, ...companies].map(
                    (company: any) => (
                        <div class="flex items-center justify-center px-10 lg:px-16 flex-shrink-0 cursor-default">
                            <img
                                src={company.logo_url || `https://placehold.co/120x40/transparent/333333?text=${company.name.replace(/\s/g, '+')}`}
                                alt={company.name}
                                class="h-7 lg:h-9 opacity-50 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-500 object-contain hover:scale-110"
                            />
                        </div>
                    )
                )
            }
        </div>
    </div>
</section>