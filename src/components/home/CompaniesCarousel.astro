---
/**
 * Companies — Clean Infinite Marquee with logos
 */
import { getCompanies } from "../../lib/data";
const companies = await getCompanies();
---

<section
    class="py-4 lg:py-6 border-y border-black/5 bg-white relative overflow-hidden flex flex-col justify-center min-h-[15vh]"
    id="companies-section"
>
    <div class="section-container mb-4">
        <div class="flex items-center justify-center gap-4">
            <div
                class="h-px w-16 bg-gradient-to-r from-transparent to-black/10"
            >
            </div>
            <span class="text-[10px] text-dark/60 font-mono tracking-widest uppercase"
                >Marcas que confían en nosotros</span
            >
            <div
                class="h-px w-16 bg-gradient-to-l from-transparent to-black/10"
            >
            </div>
        </div>
    </div>

    <div class="overflow-hidden">
        <div class="marquee-track flex items-center">
            {
                [...companies, ...companies, ...companies, ...companies].map(
                    (company: any) => (
                        <div class="flex items-center justify-center px-12 flex-shrink-0 group cursor-default">
                            <img src={`https://placehold.co/120x60/transparent/333333?text=${company.name.replace(/\s/g, '+')}`} alt={company.name} class="h-6 lg:h-8 opacity-40 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300 object-contain" />
                        </div>
                    ),
                )
            }
        </div>
    </div>
</section>
