---
/**
 * Companies — Clean Infinite Marquee with logos
 * Uses actual logo_url from DB when available
 */
import { getCompanies } from "../../lib/data";
const companies = await getCompanies();
---

<div
    id="companies-section"
    class="bg-white border-b border-black/5 relative overflow-hidden z-10 companies-carousel-wrap pb-16 lg:pb-0"
>
    <!-- Label (compact) -->

    <!-- Marquee -->
    <div class="overflow-hidden pb-2">
        <div class="marquee-track flex items-center gap-6 lg:gap-10">
            {
                [...companies, ...companies, ...companies, ...companies].map(
                    (company: any) => (
                        <div class="flex items-center justify-center min-w-[120px] lg:min-w-[160px] flex-shrink-0">
                            {company.website ? (
                                <a 
                                    href={company.website} 
                                    target="_blank" 
                                    rel="noopener noreferrer"
                                    class="block transition-all duration-500 hover:scale-110"
                                    title={`Visitar web de ${company.name}`}
                                >
                                    <img
                                        src={company.logo_url || `https://placehold.co/120x40/transparent/333333?text=${company.name.replace(/\s/g, '+')}`}
                                        alt={company.name}
                                        class="h-8 lg:h-12 opacity-50 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-500 object-contain hover:scale-110"
                                        loading="lazy"
                                        decoding="async"
                                    />
                                </a>
                            ) : (
                                <img
                                    src={company.logo_url || `https://placehold.co/120x40/transparent/333333?text=${company.name.replace(/\s/g, '+')}`}
                                    alt={company.name}
                                    class="h-8 lg:h-12 opacity-50 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-500 object-contain hover:scale-110"
                                />
                            )}
                        </div>
                    )
                )
            }
        </div>
    </div>
</div>