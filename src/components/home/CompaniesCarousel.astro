---
/**
 * Companies — Clean Infinite Marquee with logos
 * Uses actual logo_url from DB when available
 */
import { getCompanies } from "../../lib/data";
const companies = await getCompanies();
---

<div
    id="companies-section"
    class="bg-white border-b border-black/5 relative overflow-hidden z-10 companies-carousel-wrap h-[10vh] flex items-center"
>
    <!-- Label (compact) -->

    <!-- Marquee -->
    <div class="overflow-hidden w-full">
        <div class="marquee-track flex items-center gap-10 lg:gap-20">
            {
                [...companies, ...companies, ...companies, ...companies].map(
                    (company: any) => (
                        <div class="flex items-center justify-center min-w-[160px] lg:min-w-[220px] flex-shrink-0">
                            {company.website ? (
                                <a 
                                    href={company.website} 
                                    target="_blank" 
                                    rel="noopener noreferrer"
                                    class="block transition-all duration-500"
                                    title={`Visitar web de ${company.name}`}
                                >
                                    <img
                                        src={company.logo_url ? company.logo_url.replace('/upload/', '/upload/f_auto,q_auto,w_400/') : `https://placehold.co/120x40/transparent/333333?text=${company.name.replace(/\s/g, '+')}`}
                                        alt={company.name}
                                        width="160"
                                        height="64"
                                        class="h-10 lg:h-16 opacity-50 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-500 object-contain"
                                        loading="lazy"
                                        decoding="async"
                                    />
                                </a>
                            ) : (
                                <img
                                    src={company.logo_url ? company.logo_url.replace('/upload/', '/upload/f_auto,q_auto,w_400/') : `https://placehold.co/120x40/transparent/333333?text=${company.name.replace(/\s/g, '+')}`}
                                    alt={company.name}
                                    width="160"
                                    height="64"
                                    class="h-10 lg:h-16 opacity-50 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-500 object-contain"
                                    loading="lazy"
                                    decoding="async"
                                />
                            )}
                        </div>
                    )
                )
            }
        </div>
    </div>
</div>