---
/**
 * Awards — Clean Infinite Marquee with award logos
 */
import { getAwards } from "../../lib/data";
const awards = await getAwards();

// If no awards, don't render or show a placeholder?
// User wants it to be exactly like CompaniesCarousel.
---

{awards.length > 0 && (
<div
    id="awards-section"
    class="bg-white border-b border-black/5 relative overflow-hidden z-10 awards-carousel-wrap h-32 lg:h-48 flex items-center"
>
    <div class="overflow-hidden w-full">
        <div class="marquee-track flex items-center gap-10 lg:gap-20">
            {
                [...awards, ...awards, ...awards, ...awards].map(
                    (award: any) => (
                        <div class="flex items-center justify-center min-w-[200px] lg:min-w-[300px] flex-shrink-0">
                            {award.website ? (
                                <a 
                                    href={award.website} 
                                    target="_blank" 
                                    rel="noopener noreferrer"
                                    class="block transition-all duration-500 hover:scale-110"
                                    title={`Ver premio ${award.name}`}
                                >
                                    <img
                                        src={award.image_url}
                                        alt={award.name}
                                        class="h-24 lg:h-36 opacity-50 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-500 object-contain hover:scale-110"
                                        loading="lazy"
                                        decoding="async"
                                    />
                                </a>
                            ) : (
                                <img
                                    src={award.image_url}
                                    alt={award.name}
                                    class="h-24 lg:h-36 opacity-50 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-500 object-contain hover:scale-110"
                                />
                            )}
                        </div>
                    )
                )
            }
        </div>
    </div>
</div>
)}
