---
/**
 * Sectors — Premium Carousel (Desktop 3D Coverflow / Mobile Horizontal Scroll)
 * Renders ALL sectors that have a video dynamically from DB
 */
import { getSectors } from '../../lib/data';
const allSectors = await getSectors();

// Only show sectors that have a video URL
const sectors = allSectors.filter((s: any) => s.video);

function extractYouTubeId(url: string | null | undefined): string | null {
  if (!url) return null;
  const m = url.match(/(?:youtube\.com\/(?:watch\?v=|embed\/)|youtu\.be\/)([A-Za-z0-9_-]{11})/);
  if (m) return m[1];
  if (/^[A-Za-z0-9_-]{11}$/.test(url.trim())) return url.trim();
  return null;
}
---

{sectors.length > 0 && (
<section id="sectors-section" class="relative bg-white overflow-hidden text-dark lg:min-h-screen flex flex-col justify-center sectors-section-wrap" style="padding: 3rem 1rem 2.5rem;">

  <!-- Section Title -->
  <div class="relative z-10 text-center mb-6 lg:mb-8 reveal" style="padding: 0 1.5rem;">
    <h2 style="font-family: 'Outfit', sans-serif; font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; color: #111; line-height: 1.1; margin: 0;">
      Nuestros <span class="text-gradient-carmin" style="font-style: italic;">Sectores</span>
    </h2>
  </div>

  <!-- MOBILE: Horizontal scroll cards -->
  <div class="sectors-mobile-scroll lg:hidden">
    <div class="sectors-mobile-track">
      {sectors.length > 0 && [sectors[sectors.length - 1], ...sectors, sectors[0]].map((sector: any, idx: number) => {
        const videoUrl = sector.video;
        const isNative = videoUrl && (videoUrl.includes('cloudinary.com') || videoUrl.endsWith('.mp4') || videoUrl.endsWith('.webm'));
        const videoId = !isNative ? extractYouTubeId(videoUrl) : null;
        if (!isNative && !videoId) return null;
        return (
          <a href={`/sectores/${sector.slug}`} class="sct-card reveal" style={`animation-delay: ${idx * 0.1}s`}>
            {isNative ? (
               <video aria-hidden="true" src={videoUrl} class="sct-card__img" style="object-fit: cover;" autoplay loop muted playsinline></video>
            ) : (
               <img 
                 src={`https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`} 
                 alt={sector.title}
                 loading="lazy"
                 decoding="async"
                 class="sct-card__img"
               />
            )}
            <div class="sct-card__gradient"></div>
            <div class="sct-card__content">
              <h3 class="sct-card__title">{sector.title}</h3>
              <span class="sct-card__cta">
                Explorar
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 17L17 7M17 7H7M17 7v10"/></svg>
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
  
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const track = document.querySelector('.sectors-mobile-scroll');
      if (track && window.innerWidth < 1024) {
        setTimeout(() => {
          const cards = track.querySelectorAll('.sct-card');
          if (cards.length > 1) {
            const target = cards[1];
            track.scrollLeft = target.offsetLeft - (window.innerWidth - target.offsetWidth) / 2;
          }
        }, 100);
      }
    });
  </script>

  <!-- DESKTOP: 3D Coverflow Carousel (unchanged) -->
  <div class="relative w-full hidden lg:flex items-center justify-center perspective-2000">
    
    <div id="sectors-carousel" class="relative w-full max-w-[900px] aspect-[4/3] z-20 reveal-scale">
      {sectors.map((sector: any, idx: number) => {
        const videoUrl = sector.video;
        const isNative = videoUrl && (videoUrl.includes('cloudinary.com') || videoUrl.endsWith('.mp4') || videoUrl.endsWith('.webm'));
        const videoId = !isNative ? extractYouTubeId(videoUrl) : null;
        if (!isNative && !videoId) return null;
        return (
        <div class="carousel-item-sectors absolute inset-0 transition-all duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] flex items-center justify-center" data-index={idx} data-slug={sector.slug}>
          <div class="w-full h-full rounded-[2rem] shadow-[0_30px_60px_rgba(0,0,0,0.3)] relative overflow-hidden group border border-white/20 bg-dark">
            {isNative ? (
              <video aria-hidden="true" class="video-iframe opacity-100 transition-opacity duration-700 z-10 pointer-events-none"
                data-src={sector.video}
                src={sector.video}
                style="position:absolute; top:0; left:0; width:100%; height:100%; object-fit: cover;"
                autoplay loop muted playsinline
              ></video>
            ) : (
              <iframe title="Reproductor multimedia" 
                class="video-iframe opacity-0 transition-opacity duration-700 z-10 pointer-events-none"
                data-src={`https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&mute=1&controls=0&showinfo=0&rel=0&modestbranding=1&playsinline=1&enablejsapi=1&disablekb=1&iv_load_policy=3&playlist=${videoId}&loop=1`}
                src=""
                style="position:absolute; top:50%; left:50%; width:100%; height:100%; transform: translate(-50%, -50%) scale(1.4); object-fit: cover;"
                frameborder="0" allow="autoplay; encrypted-media" tabindex="-1" aria-hidden="true"
              ></iframe>
              <div class="absolute inset-0 z-10 bg-transparent pointer-events-auto"></div>
            )}
            <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-dark/90 via-dark/40 to-transparent z-20 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="absolute inset-0 z-30 flex flex-col items-center justify-center text-center p-8 pointer-events-none transition-all duration-700">
                <div class="transform translate-y-8 group-hover:translate-y-0 transition-transform duration-700 ease-out">
                    <h3 class="text-4xl md:text-5xl lg:text-7xl font-display font-bold text-white mb-8 drop-shadow-[0_10px_30px_rgba(0,0,0,0.8)] leading-tight pointer-events-auto uppercase tracking-tighter">{sector.title}</h3>
                    <div class="flex justify-center">
                        <div class="btn btn-primary btn-xl btn-detail inline-flex items-center gap-4 pointer-events-auto active:scale-95">
  <span class="uppercase tracking-[0.2em] font-bold">Explorar Sector</span>
  <svg class="w-5 h-5 transition-transform duration-500 group-hover:translate-x-1 group-hover:-translate-y-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 17L17 7M17 7H7M17 7v10"/></svg>
</div>
                    </div>
                </div>
            </div>
          </div>
        </div>
        );
      })}
    </div>

    <button id="btn-prev-sectors" aria-label="Sector anterior" class="btn btn-circle absolute left-12 lg:left-32 top-1/2 -translate-y-1/2 w-16 h-16 rounded-full bg-white/90 backdrop-blur-sm border border-gray-200 flex items-center justify-center text-dark hover:bg-carmin hover:border-carmin hover:text-white hover:scale-110 transition-all duration-300 z-50 shadow-xl reveal-left delay-3">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    </button>
    <button id="btn-next-sectors" aria-label="Siguiente sector" class="absolute right-12 lg:right-32 top-1/2 -translate-y-1/2 w-16 h-16 rounded-full bg-white/90 backdrop-blur-sm border border-gray-200 flex items-center justify-center text-dark hover:bg-carmin hover:border-carmin hover:text-white hover:scale-110 transition-all duration-300 z-50 shadow-xl reveal-right delay-3">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </button>
  </div>
</section>
)}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('sectors-carousel');
    if (!container) return;
    
    const items = container.querySelectorAll('.carousel-item-sectors');
    const prevBtn = document.getElementById('btn-prev-sectors');
    const nextBtn = document.getElementById('btn-next-sectors');
    
    if (items.length === 0) return;
    
    let currentIndex = 0;
    const total = items.length;

    function updateCarousel() {
      items.forEach((itemDom, idx) => {
        const item = itemDom as HTMLElement;
        const media = item.querySelector('.video-iframe') as HTMLElement;
        
        item.style.zIndex = '10';
        item.style.transform = 'scale(0.5) translateX(0) translateZ(-500px)';
        item.style.opacity = '0';
        item.style.pointerEvents = 'none';
        item.style.filter = 'blur(10px) brightness(0.5)';
        
        if (media) {
            if (media.tagName === 'IFRAME') {
                (media as HTMLIFrameElement).src = ''; 
                media.style.opacity = '0';
            } else if (media.tagName === 'VIDEO') {
                (media as HTMLVideoElement).pause();
            }
        }

        item.onclick = null;

        if (idx === currentIndex) {
          item.style.zIndex = '30';
          item.style.transform = 'scale(1) translateX(0) translateZ(0)';
          item.style.opacity = '1';
          item.style.pointerEvents = 'auto'; 
          item.style.filter = 'blur(0px) brightness(1)';
          
          if (media) {
              if (media.tagName === 'IFRAME') {
                  const iframe = media as HTMLIFrameElement;
                  if (!iframe.src.includes('youtube')) {
                     iframe.src = iframe.dataset.src || '';
                  }
                  setTimeout(() => { iframe.style.opacity = '1'; }, 800);
              } else if (media.tagName === 'VIDEO') {
                  const video = media as HTMLVideoElement;
                  video.play().catch(e => console.log('Autoplay blocked', e));
              }
          }
          
          item.onclick = (e) => {
             const target = e.target as HTMLElement;
             const isNavButton = target.closest('.btn-detail');
             if(isNavButton && idx === currentIndex) {
                 const slug = item.dataset.slug;
                 if(slug) window.location.href = `/sectores/${slug}`;
             }
          };

        } else if (idx === (currentIndex - 1 + total) % total) {
          item.style.zIndex = '20';
          item.style.transform = 'scale(0.8) translateX(-50%) translateZ(-300px) rotateY(20deg)';
          item.style.opacity = '0.6';
          item.style.pointerEvents = 'auto'; 
          item.style.filter = 'blur(4px) brightness(0.5)';
          item.onclick = (e) => { e.preventDefault(); currentIndex = idx; updateCarousel(); };

        } else if (idx === (currentIndex + 1) % total) {
          item.style.zIndex = '20';
          item.style.transform = 'scale(0.8) translateX(50%) translateZ(-300px) rotateY(-20deg)';
          item.style.opacity = '0.6';
          item.style.pointerEvents = 'auto';
          item.style.filter = 'blur(4px) brightness(0.5)';
          item.onclick = (e) => { e.preventDefault(); currentIndex = idx; updateCarousel(); };
        }
      });
    }

    if(prevBtn) prevBtn.addEventListener('click', () => {
      currentIndex = (currentIndex - 1 + total) % total;
      updateCarousel();
    });

    if(nextBtn) nextBtn.addEventListener('click', () => {
      currentIndex = (currentIndex + 1) % total;
      updateCarousel();
    });

    let touchStartX = 0;
    let touchEndX = 0;
    container.addEventListener('touchstart', e => { touchStartX = e.changedTouches[0].screenX; }, {passive: true});
    container.addEventListener('touchend', e => {
      touchEndX = e.changedTouches[0].screenX;
      if (touchEndX < touchStartX - 50) { currentIndex = (currentIndex + 1) % total; updateCarousel(); }
      if (touchEndX > touchStartX + 50) { currentIndex = (currentIndex - 1 + total) % total; updateCarousel(); }
    }, {passive: true});

    updateCarousel();
  });
</script>

<style>
  .perspective-2000 {
    perspective: 2000px;
    transform-style: preserve-3d;
  }
  @media (min-width: 1025px) {
    .sectors-section-wrap {
        padding: 8rem 2.5rem 5rem !important;
    }
  }

  /* ═══ MOBILE CINEMATIC CARDS ═══ */
  .sectors-mobile-scroll {
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 0.5rem 0 1.5rem;
    scroll-snap-type: x mandatory;
  }
  .sectors-mobile-scroll::-webkit-scrollbar { display: none; }

  .sectors-mobile-track {
    display: flex;
    gap: 1rem;
    padding: 0 17.5vw;
    width: max-content;
  }

  .sct-card {
    position: relative;
    display: block;
    width: 65vw;
    max-width: 320px;
    aspect-ratio: 3/4;
    flex-shrink: 0;
    border-radius: 1.25rem;
    overflow: hidden;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    box-shadow: 0 8px 32px rgba(0,0,0,0.2);
    scroll-snap-align: center;
  }
  .sct-card:active {
    transform: scale(0.97);
    transition: transform 0.15s ease;
  }

  .sct-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .sct-card:active .sct-card__img {
    transform: scale(1.05);
  }

  .sct-card__gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0,0,0,0.85) 0%,
      rgba(0,0,0,0.4) 35%,
      rgba(0,0,0,0.05) 65%,
      transparent 100%
    );
    z-index: 1;
  }

  .sct-card__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 2;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .sct-card__title {
    font-family: 'Outfit', sans-serif;
    font-size: 1.375rem;
    font-weight: 800;
    color: #fff;
    margin: 0;
    line-height: 1.15;
    text-shadow: 0 2px 12px rgba(0,0,0,0.5);
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .sct-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    font-weight: 700;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    background: rgba(196, 40, 71, 0.8);
    backdrop-filter: blur(8px);
    width: fit-content;
  }
  .sct-card__cta svg {
    width: 0.875rem;
    height: 0.875rem;
  }
</style>

