---
import { getFeaturedProjects } from "../../lib/data";
import VideoBackground from "../ui/VideoBackground.astro";

interface Props {
    projects?: any[];
    showAllLink?: boolean;
}

const { projects: providedProjects, showAllLink = true } = Astro.props;
const projects = (providedProjects || await getFeaturedProjects()).slice(0, 3);
---

{projects.length > 0 && (
    <section id="featured-projects" class:list={["featured-projects", `featured-projects--count-${projects.length}`]}>
        <h2>Proyectos</h2>
        {showAllLink && <a class="featured-projects__all" href="/proyectos">Ver todos</a>}
        <div class="featured-projects__cuts" aria-label="Proyectos destacados">
            {projects.map((project: any, index: number) => (
                <a class={`project-cut project-cut--${index + 1}`} href={`/proyectos/${project.slug}`}>
                    <VideoBackground desktop={project.video_project} mobile={project.video_project} title={project.title} overlay="dark" />
                </a>
            ))}
        </div>
    </section>
)}

<style>
    .featured-projects { position: relative; min-height: 100svh; overflow: hidden; color: #fff; background: #000; isolation: isolate; }
    .featured-projects h2 { position: absolute; top: 50%; left: 50%; z-index: 4; margin: 0; font-family: Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif; font-size: clamp(4.2rem, 14vw, 14rem); font-weight: 400; line-height: .82; text-transform: uppercase; transform: translate(-50%, -50%); text-align: center; pointer-events: none; mix-blend-mode: difference; }
    .featured-projects__all { position: absolute; right: clamp(1.2rem, 4vw, 3.5rem); bottom: clamp(1.2rem, 4vw, 3rem); z-index: 5; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; padding: 0 1.05rem; color: #000; background: #fff; border: 1px solid rgba(255, 255, 255, .72); border-radius: 999px; font-size: .76rem; font-weight: 800; text-decoration: none; text-transform: uppercase; transition: transform 180ms ease, background 180ms ease, color 180ms ease; }
    .featured-projects__all:hover, .featured-projects__all:focus-visible { color: #fff; background: #000; transform: translateY(-2px); }
    .featured-projects__cuts { position: absolute; inset: 0; z-index: 1; }
    .project-cut { position: absolute; inset: 0; overflow: hidden; color: #fff; text-decoration: none; background: #060606; }
    .project-cut::before { content: ""; position: absolute; inset: 0; z-index: 2; background: linear-gradient(115deg, rgba(0, 0, 0, .28), rgba(0, 0, 0, .05) 48%, rgba(0, 0, 0, .55)); transition: opacity 280ms ease; }
    .project-cut::after { content: ""; position: absolute; inset: 0; z-index: 3; border: 1px solid rgba(255, 255, 255, .22); pointer-events: none; }
    .project-cut--1 { z-index: 3; clip-path: polygon(0 0, 43% 0, 25% 100%, 0 100%); }
    .project-cut--2 { z-index: 2; clip-path: polygon(34% 0, 78% 0, 60% 100%, 16% 100%); }
    .project-cut--3 { z-index: 1; clip-path: polygon(69% 0, 100% 0, 100% 100%, 51% 100%); }
    .featured-projects--count-1 .project-cut--1 { clip-path: none; }
    .featured-projects--count-2 .project-cut--1 { clip-path: polygon(0 0, 60% 0, 42% 100%, 0 100%); }
    .featured-projects--count-2 .project-cut--2 { clip-path: polygon(48% 0, 100% 0, 100% 100%, 30% 100%); }
    .project-cut :global(.video-background) { filter: grayscale(1) contrast(1.04); transition: transform 700ms cubic-bezier(.16, 1, .3, 1), filter 700ms cubic-bezier(.16, 1, .3, 1); }
    .project-cut:hover::before, .project-cut:focus-visible::before { opacity: .58; }
    .project-cut:hover :global(.video-background), .project-cut:focus-visible :global(.video-background) { transform: scale(1.055); filter: grayscale(0) contrast(1.04); }

    @media (max-width: 760px) {
        .featured-projects h2 { font-size: clamp(3.4rem, 19vw, 6.8rem); }
        .featured-projects__all { right: 1rem; bottom: 1rem; }
        .project-cut--1 { clip-path: polygon(0 0, 100% 0, 100% 38%, 0 52%); }
        .project-cut--2 { clip-path: polygon(0 34%, 100% 20%, 100% 72%, 0 86%); }
        .project-cut--3 { clip-path: polygon(0 70%, 100% 56%, 100% 100%, 0 100%); }
        .featured-projects--count-1 .project-cut--1 { clip-path: none; }
        .featured-projects--count-2 .project-cut--1 { clip-path: polygon(0 0, 100% 0, 100% 54%, 0 66%); }
        .featured-projects--count-2 .project-cut--2 { clip-path: polygon(0 48%, 100% 36%, 100% 100%, 0 100%); }
    }

    @media (prefers-reduced-motion: reduce) {
        .project-cut :global(.video-background),
        .featured-projects__all {
            transition: none;
        }
    }
</style>
