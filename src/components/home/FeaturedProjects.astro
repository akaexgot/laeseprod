---
/**
 * Featured Projects — Cinematic Mosaic Grid
 */
import { getFeaturedProjects } from '../../lib/data';
const allProjects = await getFeaturedProjects();
const projects = allProjects.slice(0, 3);

// Vídeos reales de Laese Producciones — uno por slot
const slotVideos = [
  'n8F2cllaiN0',  // slot izquierda grande
  'DDavZ2BUVJo',  // slot derecha arriba
  'Wheffh2Cg10',  // slot derecha abajo
];

// IDs de demo a ignorar (valores de placeholder en BD)
const DEMO_IDS = new Set(['dQw4w9WgXcQ', 'D91q99QK11k']);

/**
 * Devuelve el ID real del proyecto si existe y no es demo.
 * Si no, usa el vídeo de Laese asignado a ese slot.
 */
function getVideoId(value: string | null | undefined, slot: number): string {
  if (value) {
    const match = value.match(/(?:youtube\.com\/(?:watch\?v=|embed\/)|youtu\.be\/)([A-Za-z0-9_-]{11})/);
    const id = match ? match[1] : (/^[A-Za-z0-9_-]{11}$/.test(value.trim()) ? value.trim() : null);
    if (id && !DEMO_IDS.has(id)) return id;
  }
  return slotVideos[slot];
}
---

<section id="featured-projects" class="relative bg-dark z-10 w-full overflow-hidden">

  <div class="fp-header reveal-left">
    <h2 class="text-editorial-lg text-white drop-shadow-[0_15px_35px_rgba(0,0,0,1)] leading-[0.9]">
      Proyectos<br />
      <span class="text-gradient-carmin font-italic">destacados</span>
    </h2>
    <a href="/proyectos" class="btn group inline-flex items-center gap-4 px-6 py-3 text-sm font-bold uppercase tracking-widest mt-6 shadow-2xl pointer-events-auto text-white border border-carmin/40 bg-carmin/15 backdrop-blur-md hover:bg-carmin/30 hover:border-carmin/60 transition-all duration-500" style="border-radius: 1rem;">
      Ver portfolio completo
      <svg class="w-5 h-5 transition-transform duration-500 group-hover:translate-x-1 group-hover:-translate-y-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 17L17 7M17 7H7M17 7v10"/>
      </svg>
    </a>
  </div>

  <div class="w-full h-[90vh] flex flex-col lg:flex-row relative">

    <!-- Slot 0 — izquierda grande -->
    {projects[0] && (() => {
      const videoId = getVideoId(projects[0].video_project, 0);
      return (
        <a href={`/proyectos/${projects[0].slug}`} class="group relative w-full lg:w-1/2 h-1/2 lg:h-full overflow-hidden block reveal-left">
          <div class="absolute inset-0 z-0 bg-dark pointer-events-none group-hover:scale-105 transition-transform duration-1000">
            <iframe
              src={`https://www.youtube.com/embed/${videoId}?autoplay=1&mute=1&loop=1&playlist=${videoId}&controls=0&showinfo=0&rel=0&modestbranding=1&playsinline=1`}
              style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:177.78vh; height:56.25vw; min-width:100%; min-height:100%;"
              frameborder="0" allow="autoplay; encrypted-media"
            ></iframe>
            <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-black via-black/40 to-transparent"></div>
          </div>
          <div class="fp-info fp-info--large relative z-40">
            <div class="transform translate-y-4 group-hover:translate-y-0 transition-transform duration-700">
              <div class="flex items-center gap-4 mb-3">
                <span class="text-carmin-light font-mono text-xs tracking-[0.2em]">01</span>
                <div class="w-8 h-px bg-white/30"></div>
                <span class="text-white/80 text-[10px] font-mono tracking-widest uppercase">{projects[0].client_name}</span>
              </div>
              <h3 class="font-display font-bold text-white text-3xl lg:text-5xl mb-2 leading-tight drop-shadow-2xl">{projects[0].title}</h3>
              {projects[0].subtitle && <p class="text-white/60 text-sm font-medium tracking-wide uppercase italic">{projects[0].subtitle}</p>}
              <div class="fp-explore opacity-0 group-hover:opacity-100 transition-all duration-500 delay-100 transform translate-y-3 group-hover:translate-y-0">
                <div class="w-10 h-10 rounded-xl border border-white/30 bg-white/10 backdrop-blur-md flex items-center justify-center group-hover:bg-carmin group-hover:border-carmin transition-all duration-500">
                  <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </div>
                <span class="text-white text-xs font-mono tracking-[0.3em] uppercase font-bold">Explorar Proyecto</span>
              </div>
            </div>
          </div>
        </a>
      );
    })()}

    <!-- Slots 1 y 2 — derecha apilados -->
    <div class="w-full lg:w-1/2 h-1/2 lg:h-full flex flex-col reveal-right delay-2">
      {projects.slice(1, 3).map((project: any, idx: number) => {
        const slot = idx + 1;
        const videoId = getVideoId(project.video_project, slot);
        return (
          <a href={`/proyectos/${project.slug}`} class={`group relative w-full h-1/2 overflow-hidden block border-l border-white/5 ${idx === 0 ? 'border-b border-white/5' : ''}`}>
            <div class="absolute inset-0 z-0 bg-dark pointer-events-none group-hover:scale-105 transition-transform duration-1000">
              <iframe
                src={`https://www.youtube.com/embed/${videoId}?autoplay=1&mute=1&loop=1&playlist=${videoId}&controls=0&showinfo=0&rel=0&modestbranding=1&playsinline=1`}
                style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:177.78vh; height:56.25vw; min-width:100%; min-height:100%;"
                frameborder="0" allow="autoplay; encrypted-media"
              ></iframe>
              <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            </div>
            <div class="fp-info fp-info--small relative z-40">
              <div class="transform translate-y-4 group-hover:translate-y-0 transition-transform duration-700">
                <div class="flex items-center gap-3 mb-2">
                  <span class="text-carmin-light font-mono text-xs tracking-[0.2em]">0{slot + 1}</span>
                  <div class="w-8 h-px bg-white/30"></div>
                  <span class="text-white/80 text-[10px] font-mono tracking-widest uppercase">{project.client_name}</span>
                </div>
                <h3 class="font-display font-bold text-white text-2xl lg:text-3xl leading-tight drop-shadow-2xl">{project.title}</h3>
                <div class="fp-explore opacity-0 group-hover:opacity-100 transition-all duration-500 delay-100 transform translate-y-3 group-hover:translate-y-0">
                  <div class="w-10 h-10 rounded-xl border border-white/30 bg-white/10 backdrop-blur-md flex items-center justify-center group-hover:bg-carmin group-hover:border-carmin transition-all duration-500">
                    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                  </div>
                  <span class="text-white text-xs font-mono tracking-[0.3em] uppercase font-bold">Explorar Proyecto</span>
                </div>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .fp-header {
    position: absolute; top: 6rem; left: 0; width: 50%;
    z-index: 30; pointer-events: none;
    display: flex; flex-direction: column; align-items: flex-start;
    padding-left: 5rem;
  }
  @media (min-width: 1024px) {
    .fp-header { top: 8rem; padding-left: 7rem; }
  }
  .fp-info {
    position: absolute; bottom: 0; left: 0; right: 0;
    display: flex; flex-direction: column; justify-content: flex-end;
  }
  .fp-info--large { padding: 0 1.5rem 5rem 5rem; }
  .fp-info--small { padding: 0 1.5rem 3.5rem 3rem; }
  @media (min-width: 1024px) {
    .fp-info--large { padding: 0 2rem 6rem 7rem; }
    .fp-info--small { padding: 0 2rem 4rem 4rem; }
  }
  .fp-explore { display: flex; align-items: center; gap: 0.75rem; margin-top: 1.25rem; }
</style>










