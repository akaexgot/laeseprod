---
import { getFeaturedProjects } from "../../lib/data";
import VideoBackground from "../ui/VideoBackground.astro";

interface Props {
    projects?: any[];
    showAllLink?: boolean;
}

const { projects: providedProjects, showAllLink = true } = Astro.props;
const projects = (providedProjects || await getFeaturedProjects()).slice(0, 3);
---

{projects.length > 0 && (
    <section id="featured-projects" class:list={["featured-projects", `featured-projects--count-${projects.length}`]}>
        {showAllLink && <a class="featured-projects__all" href="/proyectos">Ver todos</a>}
        <div class="featured-projects__cuts" aria-label="Proyectos destacados">
            {projects.map((project: any, index: number) => (
                <a class={`project-cut project-cut--${index + 1}`} href={`/proyectos/${project.slug}`}>
                    <VideoBackground desktop={project.video_project} mobile={project.video_project} title={project.title} overlay="dark" />
                </a>
            ))}
        </div>
    </section>
)}

<style>
    .featured-projects { position: relative; min-height: 100svh; overflow: hidden; color: #fff; background: #000; isolation: isolate; }
    .featured-projects__all { position: absolute; right: clamp(1.2rem, 4vw, 3.5rem); bottom: clamp(1.2rem, 4vw, 3rem); z-index: 5; display: inline-flex; align-items: center; justify-content: center; padding: .8rem .9rem; color: rgba(255, 255, 255, .78); background: rgba(0, 0, 0, .18); border: 0; border-radius: 0; font-family: "Courier New", monospace; font-size: .68rem; font-weight: 800; letter-spacing: 0; text-decoration: none; text-transform: uppercase; backdrop-filter: blur(8px); transition: color 180ms ease, transform 180ms ease; }
    .featured-projects__all::before, .featured-projects__all::after { content: ""; position: absolute; width: 14px; height: 14px; color: currentColor; opacity: .72; }
    .featured-projects__all::before { top: 0; left: 0; border-top: 1px solid currentColor; border-left: 1px solid currentColor; }
    .featured-projects__all::after { right: 0; bottom: 0; border-right: 1px solid currentColor; border-bottom: 1px solid currentColor; }
    .featured-projects__all:hover, .featured-projects__all:focus-visible { color: #fff; transform: translateY(-2px); }
    .featured-projects__cuts { position: absolute; inset: 0; z-index: 1; }
    .project-cut { position: absolute; inset: 0; overflow: hidden; color: #fff; text-decoration: none; background: #060606; }
    .project-cut::before { content: ""; position: absolute; inset: 0; z-index: 2; background: linear-gradient(115deg, rgba(0, 0, 0, .28), rgba(0, 0, 0, .05) 48%, rgba(0, 0, 0, .55)); transition: opacity 280ms ease; }
    .project-cut::after { content: ""; position: absolute; inset: 0; z-index: 3; border: 1px solid rgba(255, 255, 255, .22); pointer-events: none; }
    .project-cut--1 { z-index: 3; clip-path: polygon(0 0, 43% 0, 25% 100%, 0 100%); }
    .project-cut--2 { z-index: 2; clip-path: polygon(34% 0, 78% 0, 60% 100%, 16% 100%); }
    .project-cut--3 { z-index: 1; clip-path: polygon(69% 0, 100% 0, 100% 100%, 51% 100%); }
    .featured-projects--count-1 .project-cut--1 { clip-path: none; }
    .featured-projects--count-2 .project-cut--1 { clip-path: polygon(0 0, 60% 0, 42% 100%, 0 100%); }
    .featured-projects--count-2 .project-cut--2 { clip-path: polygon(48% 0, 100% 0, 100% 100%, 30% 100%); }
    .project-cut :global(.video-background__native),
    .project-cut :global(.video-background__youtube) { object-position: center center; }
    .project-cut--1 :global(.video-background) { background-position: 22% center; }
    .project-cut--1 :global(.video-background__native),
    .project-cut--1 :global(.video-background__youtube) { left: 22%; }
    .project-cut--2 :global(.video-background) { background-position: center center; }
    .project-cut--2 :global(.video-background__native),
    .project-cut--2 :global(.video-background__youtube) { left: 50%; }
    .project-cut--3 :global(.video-background) { background-position: 78% center; }
    .project-cut--3 :global(.video-background__native),
    .project-cut--3 :global(.video-background__youtube) { left: 78%; }
    .project-cut :global(.video-background) { filter: grayscale(1) contrast(1.04); transition: transform 700ms cubic-bezier(.16, 1, .3, 1), filter 700ms cubic-bezier(.16, 1, .3, 1); }
    .project-cut:hover::before, .project-cut:focus-visible::before { opacity: .58; }
    .project-cut:hover :global(.video-background), .project-cut:focus-visible :global(.video-background) { transform: scale(1.055); filter: grayscale(0) contrast(1.04); }

    @media (max-width: 760px) {
        .featured-projects { min-height: auto; padding: 4.25rem 1rem 5rem; }
        .featured-projects__all { right: 1rem; bottom: 1rem; }
        .featured-projects__cuts { position: relative; inset: auto; display: grid; gap: .9rem; width: min(100%, 520px); margin: 0 auto; }
        .project-cut,
        .project-cut--1,
        .project-cut--2,
        .project-cut--3,
        .featured-projects--count-1 .project-cut--1,
        .featured-projects--count-2 .project-cut--1,
        .featured-projects--count-2 .project-cut--2 {
            position: relative;
            inset: auto;
            aspect-ratio: 16 / 9;
            min-height: 0;
            clip-path: none;
            border: 1px solid rgba(255, 255, 255, .16);
        }
        .project-cut--1 :global(.video-background),
        .project-cut--2 :global(.video-background),
        .project-cut--3 :global(.video-background) { background-position: center center; }
        .project-cut--1 :global(.video-background__native),
        .project-cut--1 :global(.video-background__youtube),
        .project-cut--2 :global(.video-background__native),
        .project-cut--2 :global(.video-background__youtube),
        .project-cut--3 :global(.video-background__native),
        .project-cut--3 :global(.video-background__youtube) { left: 50%; }
    }

    @media (prefers-reduced-motion: reduce) {
        .project-cut :global(.video-background),
        .featured-projects__all {
            transition: none;
        }
    }
</style>
