---
/**
 * Featured Projects — Cinematic Mosaic Grid
 * Uses video_project from DB, hides empty slots
 */
import { getFeaturedProjects } from '../../lib/data';
import { optimizeCloudinaryVideo } from '../../lib/cloudinary';
import { getVideoId } from '../../lib/display';
const allProjects = await getFeaturedProjects();
const projects = allProjects.slice(0, 3);

function getVideoPoster(value: string | null | undefined): string | null {
  if (!value) return null;
  if (value.includes('cloudinary.com') && /\.(mp4|webm)(\?.*)?$/.test(value)) {
    return value.replace(/\.(mp4|webm)(\?.*)?$/, '.jpg');
  }
  const videoId = getVideoId(value);
  return videoId ? `https://img.youtube.com/vi/${videoId}/maxresdefault.jpg` : null;
}
---

{projects.length > 0 && (
<section id="featured-projects" class="relative bg-dark z-10 w-full overflow-hidden">

  <div class="fp-header reveal-left">
    <h2 class="text-editorial-lg text-white drop-shadow-[0_15px_35px_rgba(0,0,0,1)] leading-[0.9]">
      Proyectos<br />
      <span class="text-gradient-carmin font-italic">destacados</span>
    </h2>
    <a href="/proyectos" class="btn group inline-flex items-center gap-4 px-6 py-3 text-sm font-bold uppercase tracking-widest mt-6 shadow-2xl pointer-events-auto text-white border border-carmin/40 bg-carmin/15 backdrop-blur-md hover:bg-carmin/30 hover:border-carmin/60 transition-all duration-500" style="border-radius: 1rem;">
      Ver portfolio completo
      <svg class="w-5 h-5 transition-transform duration-500 group-hover:translate-x-1 group-hover:-translate-y-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 17L17 7M17 7H7M17 7v10"/>
      </svg>
    </a>
  </div>
  <div class="w-full h-[90vh] flex flex-col lg:flex-row relative">
    <!-- Slot 0 — Left large -->
    {projects[0] && (() => {
      const videoUrl = projects[0].video_project;
      const isNative = !!videoUrl && (videoUrl.includes('cloudinary.com') || videoUrl.endsWith('.mp4') || videoUrl.endsWith('.webm'));
      const videoId = !isNative ? getVideoId(videoUrl) : null;
      const posterUrl = projects[0].thumbnail || getVideoPoster(videoUrl);
      
      const makingOfUrl = projects[0].video_explanation_mobile || projects[0].video_explanation_desktop;
      const isMakingOfNative = !!makingOfUrl && (makingOfUrl.includes('cloudinary.com') || makingOfUrl.endsWith('.mp4') || makingOfUrl.endsWith('.webm'));
      const makingOfId = !isMakingOfNative ? (getVideoId(projects[0].video_explanation_mobile) || getVideoId(projects[0].video_explanation_desktop)) : null;

      if (!isNative && !videoId) return null;
      return (
        <a href={`/proyectos/${projects[0].slug}`} class="group relative w-full lg:w-1/2 h-1/2 lg:h-full overflow-hidden block reveal-left project-card"
           data-pm-title={projects[0].title}
           data-pm-subtitle={projects[0].subtitle || ''}
           data-pm-description={projects[0].description || ''}
           data-pm-video={isNative ? videoUrl : videoId}
           data-pm-makingof={isMakingOfNative ? makingOfUrl : makingOfId}
           data-pm-slug={projects[0].slug}
           data-pm-client={projects[0].client_name || ''}>
          <div class="absolute inset-0 z-0 bg-dark pointer-events-none group-hover:scale-105 transition-transform duration-1000"
               style={posterUrl ? `background-image: url(${posterUrl}); background-size: cover; background-position: center;` : ''}>
            {isNative ? (
              <video aria-hidden="true" data-src={optimizeCloudinaryVideo(videoUrl, { width: 1920, quality: 'auto:best', bitRate: '6m' })} poster={posterUrl || undefined} class="project-native-video absolute inset-0 w-full h-full object-cover" loop muted playsinline preload="none"></video>
            ) : (
              <iframe
                data-src={`https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&mute=1&controls=0&showinfo=0&rel=0&modestbranding=1&playsinline=1&enablejsapi=1&disablekb=1&iv_load_policy=3&playlist=${videoId}&loop=1`}
                class="lazy-iframe"
                style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%) scale(1.5); width:100%; height:100%; opacity: 0; transition: opacity 1s; pointer-events: none;"
                frameborder="0" allow="autoplay; encrypted-media"
                onload="setTimeout(() => this.style.opacity='1', 800)"
                loading="lazy"
                title="Vídeo destacado del proyecto principal"
              ></iframe>
              <div class="absolute inset-0 z-10 bg-transparent pointer-events-auto"></div>
            )}
            <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-black via-black/40 to-transparent"></div>
          </div>
          <div class="fp-info fp-info--large relative z-40">
            <div class="transform translate-y-4 group-hover:translate-y-0 transition-transform duration-700">
              <div class="flex items-center gap-4 mb-3">
                <span class="text-carmin-light font-mono text-xs tracking-[0.2em]">01</span>
                <div class="w-8 h-px bg-white/30"></div>
                <span class="text-white/80 text-[10px] font-mono tracking-widest uppercase">{projects[0].client_name}</span>
              </div>
              <h3 class="font-display font-bold text-white text-3xl lg:text-5xl mb-2 leading-tight drop-shadow-2xl">{projects[0].title}</h3>
              {projects[0].subtitle && <p class="text-white/60 text-sm font-medium tracking-wide uppercase italic">{projects[0].subtitle}</p>}
              <div class="fp-explore opacity-0 group-hover:opacity-100 transition-all duration-500 delay-100 transform translate-y-3 group-hover:translate-y-0">
                <div class="w-10 h-10 rounded-xl border border-white/30 bg-white/10 backdrop-blur-md flex items-center justify-center group-hover:bg-carmin group-hover:border-carmin transition-all duration-500">
                  <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </div>
                <span class="text-white text-xs font-mono tracking-[0.3em] uppercase font-bold">Explorar Proyecto</span>
              </div>
            </div>
          </div>
        </a>
      );
    })()}

    <!-- Slots 1 & 2 — Right stacked -->
    {projects.length > 1 && (
    <div class="w-full lg:w-1/2 h-1/2 lg:h-full flex flex-col reveal-right delay-2">
      {projects.slice(1, 3).map((project: any, idx: number) => {
        const slot = idx + 1;
        const videoUrl = project.video_project;
        const isNative = !!videoUrl && (videoUrl.includes('cloudinary.com') || videoUrl.endsWith('.mp4') || videoUrl.endsWith('.webm'));
        const videoId = !isNative ? getVideoId(videoUrl) : null;
        const posterUrl = project.thumbnail || getVideoPoster(videoUrl);
        
        const makingOfUrl = project.video_explanation_mobile || project.video_explanation_desktop;
        const isMakingOfNative = !!makingOfUrl && (makingOfUrl.includes('cloudinary.com') || makingOfUrl.endsWith('.mp4') || makingOfUrl.endsWith('.webm'));
        const makingOfId = !isMakingOfNative ? (getVideoId(project.video_explanation_mobile) || getVideoId(project.video_explanation_desktop)) : null;

        if (!isNative && !videoId) return null;
        return (
          <a href={`/proyectos/${project.slug}`} class="group relative w-full h-1/2 overflow-hidden block project-card"
             data-pm-title={project.title}
             data-pm-subtitle={project.subtitle || ''}
             data-pm-description={project.description || ''}
             data-pm-video={isNative ? videoUrl : videoId}
             data-pm-makingof={isMakingOfNative ? makingOfUrl : makingOfId}
             data-pm-slug={project.slug}
             data-pm-client={project.client_name || ''}>
            <div class="absolute inset-0 z-0 bg-dark pointer-events-none group-hover:scale-105 transition-transform duration-1000"
                 style={posterUrl ? `background-image: url(${posterUrl}); background-size: cover; background-position: center;` : ''}>
             {isNative ? (
                <video aria-hidden="true" data-src={optimizeCloudinaryVideo(videoUrl, { width: 1280, quality: 'auto:best', bitRate: '5m' })} poster={posterUrl || undefined} class="project-native-video absolute inset-0 w-full h-full object-cover" loop muted playsinline preload="none"></video>
              ) : (
              <iframe
                data-src={`https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&mute=1&controls=0&showinfo=0&rel=0&modestbranding=1&playsinline=1&enablejsapi=1&disablekb=1&iv_load_policy=3&playlist=${videoId}&loop=1`}
                class="lazy-iframe"
                style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%) scale(1.5); width:100%; height:100%; opacity: 0; transition: opacity 1s; pointer-events: none;"
                frameborder="0" allow="autoplay; encrypted-media"
                onload="setTimeout(() => this.style.opacity='1', 800)"
                loading="lazy"
                title="Vídeo destacado del proyecto"
              ></iframe>
                <div class="absolute inset-0 z-10 bg-transparent pointer-events-auto"></div>
              )}
              <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            </div>
            <div class="fp-info fp-info--small relative z-40">
              <div class="transform translate-y-4 group-hover:translate-y-0 transition-transform duration-700">
                <div class="flex items-center gap-3 mb-2">
                  <span class="text-carmin-light font-mono text-xs tracking-[0.2em]">0{slot + 1}</span>
                  <div class="w-8 h-px bg-white/30"></div>
                  <span class="text-white/80 text-[10px] font-mono tracking-widest uppercase">{project.client_name}</span>
                </div>
                <h3 class="font-display font-bold text-white text-2xl lg:text-3xl leading-tight drop-shadow-2xl">{project.title}</h3>
                {project.subtitle && <p class="text-white/60 text-xs font-medium tracking-wide uppercase italic mt-1">{project.subtitle}</p>}
                <div class="fp-explore opacity-0 group-hover:opacity-100 transition-all duration-500 delay-100 transform translate-y-3 group-hover:translate-y-0">
                  <div class="w-10 h-10 rounded-xl border border-white/30 bg-white/10 backdrop-blur-md flex items-center justify-center group-hover:bg-carmin group-hover:border-carmin transition-all duration-500">
                    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                  </div>
                  <span class="text-white text-xs font-mono tracking-[0.3em] uppercase font-bold">Explorar Proyecto</span>
                </div>
              </div>
            </div>
          </a>
        );
      })}
    </div>
    )}
  </div>
  <slot />
</section>
)}

<style>
  .fp-header {
    position: absolute; top: 6rem; left: 0; width: 50%;
    z-index: 30; pointer-events: none;
    display: flex; flex-direction: column; align-items: flex-start;
    padding-left: 1.5rem;
  }
  @media (min-width: 1024px) {
    .fp-header { top: 8rem; padding-left: 7rem; width: 50%; }
  }
  .fp-info {
    position: absolute; bottom: 0; left: 0; right: 0;
    display: flex; flex-direction: column; justify-content: flex-end;
    transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Ocultar info en móvil por defecto hasta interacción */
  @media (max-width: 1024px) {
    .fp-info { 
      opacity: 0; 
      transform: translateY(20px);
      pointer-events: none;
    }
    .project-card.active .fp-info {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
    /* El degradado también se oculta para ver la imagen limpia */
    .project-card .bg-gradient-to-t {
      opacity: 0;
      transition: opacity 0.5s ease;
    }
    .project-card.active .bg-gradient-to-t {
      opacity: 1;
    }
  }

  .fp-info--large { padding: 0 1.5rem 5rem 1.5rem; }
  .fp-info--small { padding: 0 1.5rem 3.5rem 1.5rem; }
  @media (min-width: 1024px) {
    .fp-info--large { padding: 0 2rem 6rem 7rem; }
    .fp-info--small { padding: 0 2rem 4rem 4rem; }
  }
  .fp-explore { display: flex; align-items: center; gap: 0.75rem; margin-top: 1.25rem; }
  .project-native-video {
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .project-native-video.is-ready {
    opacity: 1;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll('.project-card');
    
    cards.forEach(card => {
      card.addEventListener('click', (e) => {
        // Solo en móvil/tablet
        if (window.innerWidth <= 1024) {
          if (!card.classList.contains('active')) {
            e.preventDefault();
            // Desactivar otros
            cards.forEach(c => c.classList.remove('active'));
            // Activar este
            card.classList.add('active');
          }
        }
      });
    });

    // Cerrar si se pincha fuera
    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('.project-card')) {
        cards.forEach(c => c.classList.remove('active'));
      }
    });

    const shouldLoadDecorativeVideos = window.matchMedia('(min-width: 1025px) and (hover: hover) and (pointer: fine)').matches;
    if (!shouldLoadDecorativeVideos) return;

    document.querySelectorAll('video.project-native-video[data-src]').forEach(video => {
      const el = video as HTMLVideoElement;
      const src = el.dataset.src;
      if (!src) return;
      const markReady = () => el.classList.add('is-ready');
      el.addEventListener('loadeddata', markReady, { once: true });
      el.addEventListener('canplay', markReady, { once: true });
      el.addEventListener('playing', markReady, { once: true });
      el.src = src;
      el.autoplay = true;
      el.muted = true;
      el.playsInline = true;
      if (el.readyState >= 2) markReady();
      el.play().catch(() => {});
    });

    // Lazy load real para iframes de YouTube en escritorio.
    const lazyIframes = document.querySelectorAll('iframe.lazy-iframe');
    if ('IntersectionObserver' in window && lazyIframes.length > 0) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const iframe = entry.target as HTMLIFrameElement;
            if (iframe.dataset.src) {
              iframe.src = iframe.dataset.src;
              iframe.classList.remove('lazy-iframe');
            }
            observer.unobserve(iframe);
          }
        });
      }, { rootMargin: '300px 0px' });
      lazyIframes.forEach(iframe => observer.observe(iframe));
    } else {
      lazyIframes.forEach(iframe => {
        const frame = iframe as HTMLIFrameElement;
        if (frame.dataset.src) frame.src = frame.dataset.src;
      });
    }
  });
</script>
