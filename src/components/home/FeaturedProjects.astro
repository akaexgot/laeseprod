---
/**
 * Featured Projects — Cinematic Mosaic Grid
 * Edge-to-edge bento grid: 1 large on left, 2 stacked on right
 * Every block has an active background video
 */
import { getFeaturedProjects } from '../../lib/data';
const allProjects = await getFeaturedProjects();

// We take exactly 3 projects for this specific 1-left 2-right layout
const projects = allProjects.slice(0, 3);
const demoYoutubeId = 'D91q99QK11k';
---

<section id="featured-projects" class="relative bg-dark z-10 w-full overflow-hidden">
  
  <!-- Floating Header Overlay -->
  <div class="absolute top-12 lg:top-24 left-0 w-full z-30 pointer-events-none">
    <div class="section-container">
      <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-6 reveal">
        <div class="transform translate-z-0">
          <div class="inline-flex items-center gap-3 px-5 py-2.5 rounded-full border border-white/20 bg-dark/40 backdrop-blur-xl mb-6 pointer-events-auto shadow-2xl">
            <div class="w-2 h-2 bg-carmin rounded-full animate-pulse shadow-[0_0_10px_rgba(232,54,79,0.8)]"></div>
            <span class="text-label text-white tracking-widest uppercase">Portfolio</span>
          </div>
          <h2 class="text-editorial-lg text-white drop-shadow-[0_10px_30px_rgba(0,0,0,0.9)]">
            Proyectos<br />
            <span class="text-gradient-carmin font-italic">destacados</span>
          </h2>
        </div>
        <a href="/proyectos" class="group inline-flex items-center gap-3 px-6 py-4 bg-dark/40 backdrop-blur-xl border border-white/20 text-white text-sm font-medium rounded-2xl hover:bg-carmin/80 hover:border-carmin transition-all duration-500 pointer-events-auto shadow-2xl mt-4 lg:mt-0">
          Ver portfolio completo
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10"/></svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Edge-to-Edge Mosaic Grid reduced height to share screen -->
  <div class="w-full h-[85vh] min-h-[600px] flex flex-col lg:flex-row">
    
    <!-- Left: 1 Large Project (Index 0) -->
    {projects[0] && (
      <a
        href={`/proyectos/${projects[0].slug}`}
        class="group relative w-full lg:w-1/2 h-1/2 lg:h-full overflow-hidden block border-b lg:border-b-0 lg:border-r border-white/10"
      >
        <!-- Background Video -->
        <div class="absolute inset-0 z-0 bg-dark pointer-events-none group-hover:scale-105 transition-transform duration-1000">
          <iframe 
            src={`https://www.youtube.com/embed/${demoYoutubeId}?autoplay=1&mute=1&loop=1&playlist=${demoYoutubeId}&controls=0&showinfo=0&rel=0&modestbranding=1&playsinline=1`}
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[150vw] h-[150vh] md:w-[150%] md:h-[150%] opacity-90 group-hover:opacity-100 transition-opacity duration-700"
            style="min-width: 100%; min-height: 100%; object-fit: cover;"
            frameborder="0" allow="autoplay; encrypted-media" tabindex="-1" aria-hidden="true"
          ></iframe>
          <!-- Gradient for text readability only at the very bottom -->
          <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-dark/90 via-dark/40 to-transparent"></div>
        </div>

        <!-- Content -->
        <div class="relative z-10 w-full h-full flex flex-col justify-end p-8 lg:p-12">
          <div class="transform translate-y-4 group-hover:translate-y-0 transition-transform duration-700">
            <div class="flex items-center gap-4 mb-3 opacity-80 group-hover:opacity-100 transition-opacity duration-500">
              <span class="text-carmin-light font-mono text-xs tracking-[0.2em]">01</span>
              <div class="w-8 h-px bg-white/30"></div>
              <span class="text-white text-xs font-mono tracking-widest uppercase">{projects[0].client_name}</span>
            </div>
            <h3 class="font-display font-bold text-white text-3xl lg:text-5xl mb-3 leading-[1.1] tracking-tight drop-shadow-2xl">
              {projects[0].title}
            </h3>
            {projects[0].subtitle && (
              <p class="text-white/90 text-base font-medium drop-shadow-md line-clamp-2">
                {projects[0].subtitle}
            </p>
            )}
            <div class="flex items-center gap-3 mt-6 opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-100">
              <div class="w-8 h-8 rounded-full border border-white/30 backdrop-blur-sm bg-black/30 flex items-center justify-center">
                <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </div>
              <span class="text-white text-xs font-mono tracking-widest uppercase font-semibold">Explorar</span>
            </div>
          </div>
        </div>
      </a>
    )}

    <!-- Right: 2 Stacked Projects -->
    <div class="w-full lg:w-1/2 h-1/2 lg:h-full flex flex-col">
      {projects.slice(1, 3).map((project: any, idx: number) => {
        const actualIdx = idx + 1;
        return (
          <a
            href={`/proyectos/${project.slug}`}
            class={`group relative w-full h-1/2 overflow-hidden block ${idx === 0 ? 'border-b border-white/10' : ''}`}
          >
            <!-- Background Video -->
            <div class="absolute inset-0 z-0 bg-dark pointer-events-none group-hover:scale-105 transition-transform duration-1000">
              <iframe 
                src={`https://www.youtube.com/embed/${demoYoutubeId}?autoplay=1&mute=1&loop=1&playlist=${demoYoutubeId}&controls=0&showinfo=0&rel=0&modestbranding=1&playsinline=1`}
                class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[150vw] h-[150vh] md:w-[150%] md:h-[150%] opacity-90 group-hover:opacity-100 transition-opacity duration-700"
                style="min-width: 100%; min-height: 100%; object-fit: cover;"
                frameborder="0" allow="autoplay; encrypted-media" tabindex="-1" aria-hidden="true"
              ></iframe>
              <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-dark/90 via-dark/30 to-transparent"></div>
            </div>

            <!-- Content -->
            <div class="relative z-10 w-full h-full flex flex-col justify-end p-6 lg:p-10">
              <div class="transform translate-y-4 group-hover:translate-y-0 transition-transform duration-700">
                <div class="flex items-center gap-3 mb-2 opacity-90 group-hover:opacity-100 transition-opacity duration-500">
                  <span class="text-carmin-light font-mono text-xs tracking-[0.2em]">0{actualIdx + 1}</span>
                  <div class="w-8 h-px bg-white/30"></div>
                  <span class="text-white text-[10px] font-mono tracking-widest uppercase">{project.client_name}</span>
                </div>
                <h3 class="font-display font-bold text-white text-2xl lg:text-3xl leading-[1.1] tracking-tight drop-shadow-2xl">
                  {project.title}
                </h3>
                <div class="flex items-center gap-2 mt-4 opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-100">
                  <span class="text-white text-[10px] font-mono tracking-widest uppercase text-carmin-light font-semibold">Explorar</span>
                  <svg class="w-3 h-3 text-carmin-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </div>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>
